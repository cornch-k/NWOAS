@echo off
echo S248 D33 DWM STATE
powershell -NoProfile -Command "Get-PnpDevice -InstanceId 'ACPI\APPL0002\0' | ForEach-Object { 'DEV '+$_.Status }; Get-Process dwm -ErrorAction SilentlyContinue | ForEach-Object { 'DWM '+$_.Id+' START '+$_.StartTime.ToString('HH:mm:ss')+' CPU '+$_.CPU }; $e=@(Get-WinEvent -FilterHashtable @{LogName='Application';Id=1000;StartTime=(Get-Date).AddMinutes(-20)} -ErrorAction SilentlyContinue); 'APPCRASH '+$e.Count; $e|Select-Object -First 3|ForEach-Object{ $_.TimeCreated.ToString('HH:mm:ss')+' '+$_.Properties[0].Value+' '+$_.Properties[6].Value }; $s=@(Get-WinEvent -FilterHashtable @{LogName='System';StartTime=(Get-Date).AddMinutes(-20)} -ErrorAction SilentlyContinue | Where-Object { $_.ProviderName -match 'Display|dxgkrnl|WHEA|Kernel-PnP' }); 'SYSEV '+$s.Count; $s|Select-Object -First 5|ForEach-Object{ $_.TimeCreated.ToString('HH:mm:ss')+' '+$_.ProviderName+' '+$_.Id }; Get-Date -Format 'HH:mm:ss'; if(Test-Path C:\NWOAS\umd-trace.log){ $l=Get-Content C:\NWOAS\umd-trace.log -Tail 3; $l }"
exit /b 0
