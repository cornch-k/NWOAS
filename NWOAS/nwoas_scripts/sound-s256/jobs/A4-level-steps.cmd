@echo off
echo S256 A4 LEVEL STEPS (440 Hz, -30/-20/-12/-6 dBFS, 1.5 s each, 0.6 s gaps; amp volume unchanged)
powershell -NoProfile -Command "$k='HKLM:\SYSTEM\CurrentControlSet\Enum\ACPI\NWAU0001\0\Device Parameters'; $n='NwAudioStarts','NwAudioDescSubmitted','NwAudioPushBytes','NwAudioPadChunks','NwAudioDmaRanDry','NwAudioOsStarved','NwAudioAmpState','NwAudioVolReg','NwAudioI2cErrors'; $i=Get-ItemProperty $k; 'BEFORE '+(($n | ForEach-Object { $_.Substring(7)+'='+('{0:x}' -f [uint32]$i.$_) }) -join ' '); $sr=48000; $ms=New-Object IO.MemoryStream; $bw=New-Object IO.BinaryWriter $ms; $lv=@(-30,-20,-12,-6); $fr=New-Object Collections.Generic.List[int16]; for($z=0;$z -lt 9600;$z++){$fr.Add(0)}; foreach($d in $lv){ $a=32767*[math]::Pow(10,$d/20); $n2=[int](1.5*$sr); $f=[int](0.02*$sr); for($j=0;$j -lt $n2;$j++){ $g=[math]::Min(1.0,[math]::Min($j/$f,($n2-1-$j)/$f)); $fr.Add([int16]([math]::Round($a*$g*[math]::Sin(2*[math]::PI*440*$j/$sr)))) }; for($z=0;$z -lt 28800;$z++){$fr.Add(0)} }; $cnt=$fr.Count; $bw.Write([Text.Encoding]::ASCII.GetBytes('RIFF')); $bw.Write([int](36+$cnt*4)); $bw.Write([Text.Encoding]::ASCII.GetBytes('WAVEfmt ')); $bw.Write([int]16); $bw.Write([int16]1); $bw.Write([int16]2); $bw.Write([int]$sr); $bw.Write([int]($sr*4)); $bw.Write([int16]4); $bw.Write([int16]16); $bw.Write([Text.Encoding]::ASCII.GetBytes('data')); $bw.Write([int]($cnt*4)); foreach($s in $fr){ $bw.Write($s); $bw.Write($s) }; $bw.Flush(); $ms.Position=0; Start-Sleep -Seconds 12; $t0=Get-Date; try { $p=New-Object Media.SoundPlayer $ms; $p.PlaySync(); 'PLAYSYNC OK '+[int]((Get-Date)-$t0).TotalMilliseconds+' ms' } catch { 'PLAYSYNC FAIL '+$_.Exception.Message }; Start-Sleep -Seconds 4; $i=Get-ItemProperty $k; 'AFTER  '+(($n | ForEach-Object { $_.Substring(7)+'='+('{0:x}' -f [uint32]$i.$_) }) -join ' ')"
echo S256 A4 DONE
exit /b 0
