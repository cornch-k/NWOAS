		spmi@23d0d9300 {
			compatible = "apple,t8103-spmi", "apple,spmi";
			reg = <0x02 0x3d0d9300 0x00 0x100>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;

			pmic@f {
				compatible = "apple,sera-pmic", "apple,spmi-nvmem";
				reg = <0x0f 0x00>;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					boot-stage@9f01 {
						reg = <0x9f01 0x01>;
						phandle = <0x88>;
					};

					boot-error-count@9f02,0 {
						reg = <0x9f02 0x01>;
						bits = <0x00 0x04>;
						phandle = <0x89>;
					};

					panic-count@9f02,4 {
						reg = <0x9f02 0x01>;
						bits = <0x04 0x04>;
						phandle = <0x8a>;
					};

					boot-error-stage@9f03 {
						reg = <0x9f03 0x01>;
					};

					shutdown-flag@9f0f,3 {
						reg = <0x9f0f 0x01>;
						bits = <0x03 0x01>;
						phandle = <0x87>;
					};

					fault-shadow@a67b {
						reg = <0xa67b 0x10>;
					};

					socd@ab00 {
						reg = <0xab00 0x400>;
					};

					pm-setting@d001 {
						reg = <0xd001 0x01>;
						phandle = <0x8b>;
					};

					rtc-offset@d100 {
						reg = <0xd100 0x06>;
						phandle = <0x8c>;
					};
				};
			};
		};

