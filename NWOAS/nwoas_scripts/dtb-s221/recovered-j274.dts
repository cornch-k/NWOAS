					compatible = "pci14e4,4425";
					reg = <0x10000 0x00 0x00 0x00 0x00>;
					local-mac-address = [00 00 00 00 00 00];
					apple,antenna-sku = "XX";
					brcm,board-type = "apple,atlantisb";
				};

				bluetooth@0,1 {
					compatible = "pci14e4,5f69";
					reg = <0x10100 0x00 0x00 0x00 0x00>;
					local-bd-address = [00 00 00 00 00 00];
					brcm,board-type = "apple,atlantisb";
				};
			};

			pci@1,0 {
				device_type = "pci";
				reg = <0x800 0x00 0x00 0x00 0x00>;
				reset-gpios = <0x3e 0x99 0x01>;
				#address-cells = <0x03>;
				#size-cells = <0x02>;
				ranges;
				interrupt-controller;
				#interrupt-cells = <0x01>;
				interrupt-map-mask = <0x00 0x00 0x00 0x07>;
				interrupt-map = <0x00 0x00 0x00 0x01 0xb6 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x02 0xb6 0x00 0x00 0x00 0x01 0x00 0x00 0x00 0x03 0xb6 0x00 0x00 0x00 0x02 0x00 0x00 0x00 0x04 0xb6 0x00 0x00 0x00 0x03>;
				status = "okay";
				bus-range = <0x02 0x02>;
				phandle = <0xb6>;
			};

			pci@2,0 {
				device_type = "pci";
				reg = <0x1000 0x00 0x00 0x00 0x00>;
				reset-gpios = <0x3e 0x21 0x01>;
				#address-cells = <0x03>;
				#size-cells = <0x02>;
				ranges;
				interrupt-controller;
				#interrupt-cells = <0x01>;
				interrupt-map-mask = <0x00 0x00 0x00 0x07>;
				interrupt-map = <0x00 0x00 0x00 0x01 0xb7 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x02 0xb7 0x00 0x00 0x00 0x01 0x00 0x00 0x00 0x03 0xb7 0x00 0x00 0x00 0x02 0x00 0x00 0x00 0x04 0xb7 0x00 0x00 0x00 0x03>;
				status = "okay";
				bus-range = <0x03 0x03>;
				phandle = <0xb7>;

				ethernet@0,0 {
					reg = <0x30000 0x00 0x00 0x00 0x00>;
					local-mac-address = [00 10 18 00 00 00];
				};
			};
		};
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0";

		framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0x00 0x00 0x00 0x00>;
			power-domains = <0x1f>;
			status = "disabled";
		};
	};

	memory@800000000 {
		device_type = "memory";
		reg = <0x08 0x00 0x02 0x00>;
	};

	sound {
		compatible = "apple,j274-macaudio", "apple,macaudio";
		model = "Mac mini J274";

		dai-link@0 {
			link-name = "Speaker";

			cpu {
				sound-dai = <0xb8 0x00>;
			};

			codec {
				sound-dai = <0xb9>;
			};
		};

		dai-link@1 {
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <0xb8 0x02>;
			};

			codec {
				sound-dai = <0xba>;
			};
		};
	};
};
