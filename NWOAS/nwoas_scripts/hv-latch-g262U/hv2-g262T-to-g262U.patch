diff -ruN a/src/nwoas_latch.h b/src/nwoas_latch.h
--- a/src/nwoas_latch.h	1970-01-01 09:00:00
+++ b/src/nwoas_latch.h	2026-11-20 18:22:23
@@ -0,0 +1,36 @@
+/* NWOAS g262U: the LATCHED decision of the DCP scanout service, kept free of
+ * hardware access so the host test (nwoas_scripts/hv-latch-g262U/hosttest)
+ * compiles the same code.
+ *
+ * Background (2026-11-20, bugcheck 0x116 after a monitor reconnect): a present
+ * retired during an S254 reconnect gets a synthetic id; the reconnect's modeset
+ * then swaps the active surface itself and replaces the applied id with its
+ * own.  The service asked "is <the present's id> latched" and got "wrong id",
+ * the broker raised IRQ_ERROR and kept applied != latched, so every later
+ * PRESENT was refused as BUSY and Windows' display driver stopped for good. */
+#ifndef NWOAS_LATCH_H
+#define NWOAS_LATCH_H
+
+/* The id a modeset replaces: remembered only when it differs from the new one. */
+static inline unsigned int nwoas_latch_supersede(unsigned int previous, unsigned int now)
+{
+    return previous && previous != now ? previous : 0u;
+}
+
+/* 1 = latched, 0 = not yet, -2 = not this present.
+ * `superseded` is the applied id the last modeset replaced: the modeset showed
+ * the active surface again, which is that present's surface, so the present
+ * counts as latched as soon as the modeset is applied. */
+static inline int nwoas_latch_decide(unsigned int expected, unsigned int applied,
+                                     unsigned int superseded, int delay_elapsed)
+{
+    if (!expected)
+        return -2;
+    if (expected == applied)
+        return delay_elapsed ? 1 : 0;
+    if (expected == superseded)
+        return 1;
+    return -2;
+}
+
+#endif
