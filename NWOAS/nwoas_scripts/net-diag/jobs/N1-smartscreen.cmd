@echo off
echo NWOAS N1 SMARTSCREEN REACHABILITY
echo DATE %DATE% %TIME%
w32tm /query /status 2>&1
w32tm /stripchart /computer:time.windows.com /samples:2 /dataonly 2>&1
powershell -NoProfile -Command "'UTC_NOW '+(Get-Date).ToUniversalTime().ToString('u'); Get-NetConnectionProfile | ForEach-Object { 'PROFILE '+$_.Name+' cat='+$_.NetworkCategory+' v4='+$_.IPv4Connectivity+' v6='+$_.IPv6Connectivity }; Get-DnsClientServerAddress -AddressFamily IPv4 | Where-Object {$_.ServerAddresses} | ForEach-Object { 'DNS '+$_.InterfaceAlias+' '+($_.ServerAddresses -join ',') }; netsh winhttp show proxy; foreach($h in 'apprep.smartscreen.microsoft.com','nav.smartscreen.microsoft.com','checkappexec.microsoft.com','smartscreen.microsoft.com','www.msftconnecttest.com'){ try { $r=Resolve-DnsName $h -Type A -ErrorAction Stop | Where-Object {$_.IPAddress} | Select-Object -First 1; 'DNS_OK '+$h+' '+$r.IPAddress } catch { 'DNS_FAIL '+$h+' '+$_.Exception.Message } }; [Net.ServicePointManager]::SecurityProtocol='Tls12,Tls13'; foreach($u in 'https://apprep.smartscreen.microsoft.com/','https://nav.smartscreen.microsoft.com/','https://checkappexec.microsoft.com/','https://www.microsoft.com/'){ $t=Get-Date; try { $w=Invoke-WebRequest -Uri $u -UseBasicParsing -TimeoutSec 15 -ErrorAction Stop; 'HTTPS '+$u+' status='+$w.StatusCode+' ms='+[int]((Get-Date)-$t).TotalMilliseconds } catch { $s=''; if($_.Exception.Response){$s=[int]$_.Exception.Response.StatusCode}; 'HTTPS '+$u+' http='+$s+' ms='+[int]((Get-Date)-$t).TotalMilliseconds+' err='+$_.Exception.Message } }; Get-WinEvent -LogName 'Microsoft-Windows-SmartScreen/Debug' -MaxEvents 5 -ErrorAction SilentlyContinue | ForEach-Object { 'SSEVT '+$_.TimeCreated+' '+$_.Id+' '+($_.Message -replace '\s+',' ').Substring(0,[Math]::Min(200,$_.Message.Length)) }"
reg query "HKLM\SYSTEM\CurrentControlSet\Enum\ACPI\NWOA4378\0\Device Parameters" /v NwoaConnected
reg query "HKLM\SYSTEM\CurrentControlSet\Enum\ACPI\NWOA4378\0\Device Parameters" /v NwoaEapolMsgs
echo NWOAS N1 DONE
