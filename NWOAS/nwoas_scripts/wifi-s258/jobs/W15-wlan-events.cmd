@echo off
echo S258 W15 WLAN EVENTS (WLAN-AutoConfig/Operational, adapter state without netsh; SSID/BSSID/MAC/profile/GUID masked)
powershell -NoProfile -NonInteractive -Command "$b=(Get-CimInstance Win32_OperatingSystem).LastBootUpTime; $now=Get-Date; 'W15 NOW '+$now.ToString('s')+' BOOT '+$b.ToString('s')+' UP_MS '+[int64]($now-$b).TotalMilliseconds; $mr='([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}'; $sk='SSID|Profile|Mac|Peer|Addr|Guid|Bss|Name'; $L='Microsoft-Windows-WLAN-AutoConfig/Operational'; $t=$now.AddHours(-3); foreach($i in 4003,8001,8002,8003,11004,11005,11010,12013){ 'W15 COUNT3H '+$i+' '+@(Get-WinEvent -FilterHashtable @{LogName=$L;Id=$i;StartTime=$t} -ErrorAction SilentlyContinue).Count }; $ev=@(Get-WinEvent -LogName $L -MaxEvents 40 -ErrorAction SilentlyContinue); [array]::Reverse($ev); foreach($e in $ev){ $x=[xml]$e.ToXml(); $s=@(); $kv=@(); foreach($d in @($x.Event.EventData.Data)){ if($d -is [System.Xml.XmlElement]){ $n=[string]$d.Name; $v=[string]$d.InnerText; if($n -match $sk -and $n -notmatch 'Description'){ if($v.Length -ge 2){ $s+=$v }; $v='<m>' }; $kv+=($n+'='+$v) } }; $m=[string]$e.Message; foreach($v in $s){ $m=$m.Replace($v,'<m>') }; $m=($m -replace $mr,'<mac>') -replace '\s+',' '; if($m.Length -gt 420){ $m=$m.Substring(0,420) }; 'W15 EV '+$e.Id+' t_ms='+[int64]($e.TimeCreated-$b).TotalMilliseconds+' '+$e.TimeCreated.ToString('HH:mm:ss.fff'); ' D '+(($kv -join ' ') -replace $mr,'<mac>'); ' M '+$m }" 2>&1
powershell -NoProfile -NonInteractive -Command "$a=@(Get-NetAdapter -ErrorAction SilentlyContinue | Where-Object {$_.InterfaceDescription -like '*BCM4378*' -and $_.Status -ne 'Not Present'}); 'W15 NICS '+$a.Count; foreach($n in $a){ 'W15 NIC status='+$n.Status+' media='+$n.MediaConnectionState+' speed='+$n.LinkSpeed; $s=Get-NetAdapterStatistics -Name $n.Name -ErrorAction SilentlyContinue; if($s){ 'W15 STAT rxB='+$s.ReceivedBytes+' txB='+$s.SentBytes+' rxU='+$s.ReceivedUnicastPackets+' txU='+$s.SentUnicastPackets+' rxDisc='+$s.ReceivedDiscardedPackets+' rxErr='+$s.ReceivedPacketErrors+' txDisc='+$s.OutboundDiscardedPackets+' txErr='+$s.OutboundPacketErrors }; foreach($p in @(Get-NetConnectionProfile -InterfaceIndex $n.ifIndex -ErrorAction SilentlyContinue)){ if($p){ 'W15 PROF cat='+$p.NetworkCategory+' v4='+$p.IPv4Connectivity+' v6='+$p.IPv6Connectivity } } }; foreach($k in 'MSNdis_80211_ReceivedSignalStrength','MSNdis_LinkSpeed','MSNdis_MediaConnectStatus'){ try { $w=@(Get-CimInstance -Namespace root/wmi -ClassName $k -ErrorAction Stop | Where-Object {$_.InstanceName -like '*BCM4378*'}); 'W15 WMI '+$k+' n='+$w.Count+' '+(($w | ForEach-Object { ($_.CimInstanceProperties | Where-Object {$_.Name -like 'Ndis*'} | ForEach-Object { $_.Name+'='+$_.Value }) -join ' ' }) -join ' | ') } catch { 'W15 WMI '+$k+' n/a '+$_.Exception.Message } }" 2>&1
for %%v in (NwoaDriverBuild NwoaNowMs NwoaConnected NwoaHostDisassocLog NwoaCmdBeforeLoss NwoaCmdHist NwoaLossLog NwoaCntStatsOk NwoaCntStatsFail NwoaCntStatsSmall NwoaStatsLastBytes NwoaStatsLastStatus NwoaRssiMin NwoaRssiMax) do reg query "HKLM\SYSTEM\CurrentControlSet\Enum\ACPI\NWOA4378\0\Device Parameters" /v %%v 2>nul | findstr /c:"Nwoa"
echo S258 W15 DONE
exit /b 0
