@echo off
powershell -NoProfile -Command "$src='using System; using System.Text; using System.Runtime.InteropServices; public static class CBWindows { public delegate bool CB(IntPtr h, IntPtr p); [DllImport(\"user32.dll\")] public static extern bool EnumWindows(CB c, IntPtr p); [DllImport(\"user32.dll\")] public static extern bool EnumChildWindows(IntPtr h, CB c, IntPtr p); [DllImport(\"user32.dll\", CharSet=CharSet.Unicode)] public static extern int GetWindowText(IntPtr h, StringBuilder s, int n); [DllImport(\"user32.dll\")] public static extern uint GetWindowThreadProcessId(IntPtr h, out uint p); public static void Dump(uint pid) { EnumWindows((h,p)=>{uint owner;GetWindowThreadProcessId(h,out owner);if(owner==pid){Text(h);EnumChildWindows(h,(c,q)=>{Text(c);return true;},IntPtr.Zero);}return true;},IntPtr.Zero); } static void Text(IntPtr h) {var b=new StringBuilder(2048);GetWindowText(h,b,b.Capacity);Console.WriteLine(h.ToInt64()+\": \"+b.ToString());} }'; Add-Type -TypeDefinition $src; Get-Process -Name Cinebench -ErrorAction Stop | ForEach-Object {Write-Output ('CINEBENCH WINDOW PID='+$_.Id); [CBWindows]::Dump([uint32]$_.Id)}" >"%PUBLIC%\Documents\NWOAS-BENCH\window-text-s176.log" 2>&1
exit /b %errorlevel%
