@echo off
echo S259 W1 WIFI DEVICE STATUS (ACPI\NWOA4378 under ACPI0004 NWC0; USB-A XHC0 regression)
powershell -NoProfile -NonInteractive -Command "$ErrorActionPreference='SilentlyContinue'; $ds=@(Get-PnpDevice | Where-Object { $_.InstanceId -like 'ACPI\NWOA4378\*' -or $_.InstanceId -like 'ACPI\ACPI0004\*' -or $_.InstanceId -like 'ACPI\PNP0D10\*' }); if (-not ($ds | Where-Object { $_.InstanceId -like 'ACPI\NWOA4378\*' })) { 'WIFI ABSENT (no ACPI\NWOA4378 instance: _STA=0, or old payload)' }; foreach ($d in $ds) { 'DEV '+$d.InstanceId+' status='+$d.Status+' problem='+$d.Problem+' present='+$d.Present+' class='+$d.Class+' name='+$d.FriendlyName; Get-PnpDeviceProperty -InstanceId $d.InstanceId -KeyName DEVPKEY_Device_ProblemCode,DEVPKEY_Device_ProblemStatus,DEVPKEY_Device_DevNodeStatus,DEVPKEY_Device_DriverInfPath,DEVPKEY_Device_Service,DEVPKEY_Device_PowerData | ForEach-Object { $v=$_.Data; if ($v -is [byte[]]) { $v=($v[4..7] -join ',') }; '  PROP '+$_.KeyName+' = '+$v } }"
powershell -NoProfile -NonInteractive -Command "$ErrorActionPreference='SilentlyContinue'; foreach ($e in @(Get-CimInstance Win32_PnPEntity | Where-Object { $_.PNPDeviceID -like 'ACPI\NWOA4378\*' -or $_.PNPDeviceID -like 'ACPI\PNP0D10\*' })) { 'RES '+$e.PNPDeviceID+' cfgerr='+$e.ConfigManagerErrorCode; foreach ($m in @(Get-CimAssociatedInstance -InputObject $e -ResultClassName Win32_DeviceMemoryAddress)) { '  MEM '+$m.StartingAddress.ToString('X')+'-'+$m.EndingAddress.ToString('X') }; foreach ($q in @(Get-CimAssociatedInstance -InputObject $e -ResultClassName Win32_IRQResource)) { '  IRQ '+$q.IRQNumber+' '+$q.TriggerType+' shareable='+$q.Shareable } }"
pnputil /enum-devices /instanceid "ACPI\NWOA4378\0" /resources /drivers
echo S259 W1 PNPUTIL EXIT %ERRORLEVEL%
powershell -NoProfile -NonInteractive -Command "$ErrorActionPreference='SilentlyContinue'; $u=@(Get-PnpDevice -PresentOnly | Where-Object { $_.InstanceId -like 'USB\*' }); 'USB present='+$u.Count+' ok='+@($u | Where-Object { $_.Status -eq 'OK' }).Count; Get-WinEvent -FilterHashtable @{LogName='System'; StartTime=(Get-Date).AddHours(-2)} -MaxEvents 400 | Where-Object { $_.Message -match 'NWOA4378|ACPI0004|USBXHCI' -or $_.ProviderName -match 'USBXHCI' } | Select-Object -First 15 | ForEach-Object { 'EVT '+$_.TimeCreated.ToString('HH:mm:ss')+' '+$_.ProviderName+' '+$_.Id+' '+($_.Message -replace '\s+',' ').Substring(0,[Math]::Min(160,($_.Message -replace '\s+',' ').Length)) }"
reg query "HKLM\SYSTEM\CurrentControlSet\Enum\ACPI\NWOA4378\0" /v ConfigFlags
echo S259 W1 DONE
exit /b 0
