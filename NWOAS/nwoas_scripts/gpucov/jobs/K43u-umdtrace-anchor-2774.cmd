powershell -NoProfile -Command "$p='K43u'; $t=@(Get-Content C:\NWOAS\gpucov\k43c-umd.log -ErrorAction SilentlyContinue); function Get-Cut($s){ $s.Substring(0,[math]::Min(300,$s.Length)) }; $p+' UMDTRACE lines='+$t.Count; $t | ForEach-Object { ($_ -split ' ')[0] } | Group-Object | Sort-Object Count -Descending | Select-Object -First 30 | ForEach-Object { $p+' UTSTAGE '+$_.Count+' '+$_.Name }; $t | Where-Object { $_ -match ' hr=0x[89a-f][0-9a-f]{7} ' -and $_ -notmatch ' hr=0x8000000a ' } | ForEach-Object { $w=$_ -split ' '; $w[0]+' '+$w[1] } | Group-Object | Sort-Object Count -Descending | Select-Object -First 30 | ForEach-Object { $p+' UTHRG '+$_.Count+' '+$_.Name }; $t | Where-Object { $_ -match '^(reject-|runtime-set-error|device-)' } | Select-Object -First 40 | ForEach-Object { $p+' UTFAIL '+(Get-Cut $_) }; $t | Where-Object { $_ -match '^measure-cpu-pool-rehome' } | Select-Object -First 16 | ForEach-Object { $p+' UTREHOME '+(Get-Cut $_) }"
powershell -NoProfile -Command "$p='K43u'; $t=@(Get-Content C:\NWOAS\gpucov\k43c-umd.log -ErrorAction SilentlyContinue); function Get-Cut($s){ $s.Substring(0,[math]::Min(300,$s.Length)) }; $a=@(); for($i=0;$i -lt $t.Count;$i++){ $s=$t[$i]; if(($s -match '^(reject-|runtime-set-error)') -or ($s -match '^measure-d3d12-(execute|owner-submit) hr=0x[89a-f]' -and $s -notmatch ' hr=0x8000000a ')){ if(($a.Count -eq 0) -or ($i -gt $a[-1]+60)){ $a+=$i } } }; $p+' ANCHORS count='+$a.Count+' at='+($a -join ','); foreach($i in ($a | Select-Object -First 3)){ $lo=[math]::Max(0,$i-16); $hi=[math]::Min($t.Count-1,$i+10); for($k=$lo;$k -le $hi;$k++){ $p+' UTCTX a'+$i+' '+$k+' '+(Get-Cut $t[$k]) } }; $t | Where-Object { $_ -match '^measure-d3d12-heap(-sizes)? hr' } | Select-Object -First 40 | ForEach-Object { $p+' UTHEAP '+(Get-Cut $_) }; $t | Select-Object -Last 12 | ForEach-Object { $p+' UTTAIL '+(Get-Cut $_) }"
