@echo off
echo GPUCOV K67 EXPORT of the K66 window pictures (read-only): C:\NWOAS\gpucov\k66\*.png as JPEG q75 (at most 8), zip, base64 (decode: bash gpucov/fetch-b64.sh K67 JOBLOG DIR)
powershell -NoProfile -Command "Add-Type -AssemblyName System.Drawing; $d='C:\NWOAS\gpucov\k66'; $o=$d+'\export'; if(-not (Test-Path $o)){ New-Item -ItemType Directory $o | Out-Null }; Remove-Item ($o+'\*.jpg') -ErrorAction SilentlyContinue; $enc=[Drawing.Imaging.ImageCodecInfo]::GetImageEncoders() | Where-Object { $_.MimeType -eq 'image/jpeg' }; $ep=New-Object Drawing.Imaging.EncoderParameters 1; $ep.Param[0]=New-Object Drawing.Imaging.EncoderParameter ([Drawing.Imaging.Encoder]::Quality),([long]75); $f=@(Get-ChildItem ($d+'\*.png') -ErrorAction SilentlyContinue | Sort-Object LastWriteTime); 'K67 PNG count='+$f.Count; foreach($p in ($f | Select-Object -First 8)){ 'K67 SRC '+$p.Name+' '+$p.Length+' '+$p.LastWriteTime.ToString('HH:mm:ss'); $b=New-Object Drawing.Bitmap $p.FullName; $b.Save($o+'\'+$p.BaseName+'.jpg',$enc,$ep); $b.Dispose() }; if(-not $f.Count){ 'K67 NO PICTURES'; exit }; $z=$d+'\k66-export.zip'; Remove-Item $z -ErrorAction SilentlyContinue; Compress-Archive -Path ($o+'\*.jpg') -DestinationPath $z -Force; $i=Get-Item $z; 'K67 ZIP bytes='+$i.Length+' sha256='+(Get-FileHash $z -Algorithm SHA256).Hash.ToLower(); 'K67 BEGIN-BASE64'; [Convert]::ToBase64String([IO.File]::ReadAllBytes($z),'InsertLineBreaks'); 'K67 END-BASE64'"
echo GPUCOV K67 DONE
exit /b 0
