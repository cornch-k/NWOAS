@echo off
echo GPUCOV K12 CB26 TRACE SUMMARY (latest cb26-umd.log; nothing is run): line counts per receipt, every failed receipt, draw refusals, PSO compiles
powershell -NoProfile -Command "$t='C:\NWOAS\gpucov\cb26-umd.log'; if(!(Test-Path $t)){'K12 NO TRACE';exit}; $l=Get-Content $t | ForEach-Object { $_ -replace ' pid=\d+ tid=\d+ session=\d+ qpc=\d+','' }; 'K12 lines='+$l.Count; $l | ForEach-Object { ($_ -split ' ')[0] } | Group-Object | Sort-Object Count -Descending | ForEach-Object { 'K12 COUNT '+$_.Count+' '+$_.Name }; $d=@($l -match '^measure-d3d12-draw '); 'K12 DRAWS total='+$d.Count; $d | ForEach-Object { ($_ -split ' ')[1]+' refusal='+(($_ -split ' ')[2]) } | Group-Object | ForEach-Object { 'K12 DRAW '+$_.Count+' '+$_.Name }; $d | Where-Object { $_ -notmatch 'hr=0x00000000' } | Select-Object -First 25 | ForEach-Object { 'K12 DRAWFAIL '+$_ }; $e=@($l -match '^measure-d3d12-pso-eager '); 'K12 PSO_EAGER total='+$e.Count+' failed='+@($e | Where-Object { $_ -notmatch 'hr=0x00000000' }).Count; $e | Where-Object { $_ -notmatch 'hr=0x00000000' } | Select-Object -First 25 | ForEach-Object { 'K12 PSOFAIL '+$_ }; $p=@($l -match '^measure-d3d12-pso '); 'K12 PSO total='+$p.Count; $p | ForEach-Object { ($_ -split ' ')[2..9] -join ' ' } | Group-Object | Sort-Object Count -Descending | Select-Object -First 15 | ForEach-Object { 'K12 PSOKIND '+$_.Count+' cs,vs,ps,nrt,rtv0,dsv,topo,samples='+$_.Name }; $l | Where-Object { $_ -notmatch '^measure-caps-|^measure-d3d12-draw |^reject-cxx' -and $_ -match ' hr=0x[8c]' } | Select-Object -First 40 | ForEach-Object { 'K12 FAIL '+$_ }"
echo GPUCOV K12 DONE
exit /b 0
