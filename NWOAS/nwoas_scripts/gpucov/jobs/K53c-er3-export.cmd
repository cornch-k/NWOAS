@echo off
echo GPUCOV K53c EXPORT of the K52 captures (read-only): er3-A/er3-B shots 1 and 2 as JPEG q80, shot 0 crop 600,420 380x140 as PNG; zip, base64 (decode: bash gpucov/fetch-b64.sh K53c JOBLOG DIR)
powershell -NoProfile -Command "Add-Type -AssemblyName System.Drawing; $d='C:\NWOAS\gpucov'; $o=$d+'\er3-export'; Remove-Item $o -Recurse -Force -ErrorAction SilentlyContinue; New-Item -ItemType Directory $o | Out-Null; $enc=[Drawing.Imaging.ImageCodecInfo]::GetImageEncoders() | Where-Object { $_.MimeType -eq 'image/jpeg' }; $ep=New-Object Drawing.Imaging.EncoderParameters 1; $ep.Param[0]=New-Object Drawing.Imaging.EncoderParameter ([Drawing.Imaging.Encoder]::Quality),([long]80); foreach($r in 'A','B'){ foreach($k in 0,1,2,3){ $f=$d+'\er3-'+$r+'-s'+$k+'.png'; if(-not (Test-Path $f)){ 'K53c missing '+$f; continue }; 'K53c SRC er3-'+$r+'-s'+$k+'.png '+(Get-Item $f).Length+' '+(Get-FileHash $f).Hash.ToLower(); $b=New-Object Drawing.Bitmap $f; if($k -eq 1 -or $k -eq 2){ $b.Save($o+'\er3-'+$r+'-s'+$k+'.jpg',$enc,$ep) }; if($k -eq 0){ $c=$b.Clone((New-Object Drawing.Rectangle 600,420,380,140),$b.PixelFormat); $c.Save($o+'\er3-'+$r+'-s0-crop.png',[Drawing.Imaging.ImageFormat]::Png); $c.Dispose() }; $b.Dispose() } }; $z=$d+'\er3-export.zip'; Remove-Item $z -ErrorAction SilentlyContinue; Compress-Archive -Path ($o+'\*') -DestinationPath $z -Force; $i=Get-Item $z; 'K53c ZIP bytes='+$i.Length+' sha256='+(Get-FileHash $z -Algorithm SHA256).Hash.ToLower(); 'K53c BEGIN-BASE64'; [Convert]::ToBase64String([IO.File]::ReadAllBytes($z),'InsertLineBreaks'); 'K53c END-BASE64'"
echo GPUCOV K53c DONE
exit /b 0
