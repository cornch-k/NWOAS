@echo off
echo GPUCOV K62 BLACK SCREEN EVIDENCE (read-only): GPU reset receipts, display and crash events of the last 90 minutes, DWM and Cinebench processes, kernel reports, one desktop capture (fetch-b64.sh K62)
set D=C:\NWOAS\gpucov
powershell -NoProfile -Command "$k='HKLM:\SYSTEM\CurrentControlSet\Enum\ACPI\APPL0002\0\Device Parameters'; $p=Get-ItemProperty $k; foreach($n in 'NwResetDisplay','Wom1GpuFault','Wom1GpuReset'){ $v=$p.$n; if($v -is [byte[]]){ $q=@(); for($i=0;$i+8 -le $v.Length -and $i -lt 200;$i+=8){ $q+=('{0:x16}' -f [BitConverter]::ToUInt64($v,$i)) }; 'K62 REG '+$n+' bytes='+$v.Length+' q='+($q -join ' ') } }; 'K62 UPTIME_MS '+[int64]([Environment]::TickCount)+' boot='+(Get-CimInstance Win32_OperatingSystem).LastBootUpTime.ToString('s')+' now='+(Get-Date).ToString('s'); 'K62 PIXELCENTER ['+(Get-ItemProperty 'HKLM:\SOFTWARE\NWOAS\AgxD3d' -ErrorAction SilentlyContinue).D3d11PixelCenter+']'; 'K62 VC '+(Get-CimInstance Win32_VideoController | Select-Object -First 1).DriverVersion"
powershell -NoProfile -Command "$t=(Get-Date).AddMinutes(-90); Get-WinEvent -FilterHashtable @{LogName='System'; StartTime=$t} -ErrorAction SilentlyContinue | Where-Object { $_.Id -in 4101,4097,4107,1001,41,506,507 -or $_.ProviderName -match 'Display' } | Select-Object -First 20 | ForEach-Object { $m=($_.Message -replace '\s+',' '); 'K62 SYS '+$_.TimeCreated.ToString('HH:mm:ss')+' '+$_.ProviderName+' id='+$_.Id+' '+$m.Substring(0,[Math]::Min(200,$m.Length)) }; Get-WinEvent -FilterHashtable @{LogName='Application'; StartTime=$t} -ErrorAction SilentlyContinue | Where-Object { $_.Id -in 1000,1001,1002 } | Select-Object -First 20 | ForEach-Object { $m=($_.Message -replace '\s+',' '); 'K62 APP '+$_.TimeCreated.ToString('HH:mm:ss')+' id='+$_.Id+' '+$m.Substring(0,[Math]::Min(260,$m.Length)) }; Get-Process dwm,Cinebench,explorer -ErrorAction SilentlyContinue | ForEach-Object { 'K62 PROC '+$_.Name+' pid='+$_.Id+' start='+$_.StartTime.ToString('HH:mm:ss')+' ws_mb='+[int]($_.WorkingSet64/1MB) }; Get-ChildItem C:\Windows\LiveKernelReports -Recurse -File -ErrorAction SilentlyContinue | Where-Object { $_.LastWriteTime -gt $t } | ForEach-Object { 'K62 LIVE '+$_.Name+' '+$_.Length }"
> %D%\k62-shot.ps1 echo Add-Type -AssemblyName System.Drawing,System.Windows.Forms
>> %D%\k62-shot.ps1 echo $b=[Windows.Forms.SystemInformation]::VirtualScreen
>> %D%\k62-shot.ps1 echo $bmp=New-Object Drawing.Bitmap $b.Width,$b.Height
>> %D%\k62-shot.ps1 echo $g=[Drawing.Graphics]::FromImage($bmp); $g.CopyFromScreen($b.X,$b.Y,0,0,$bmp.Size)
>> %D%\k62-shot.ps1 echo $bmp.Save('C:\NWOAS\gpucov\k62-screen.png'); 'done' ^| Out-File C:\NWOAS\gpucov\k62-done.txt
> %D%\k62-shot.cmd echo powershell -NoProfile -ExecutionPolicy Bypass -File %D%\k62-shot.ps1
del /q %D%\k62-screen.png %D%\k62-done.txt 2>nul
powershell -NoProfile -ExecutionPolicy Bypass -File %D%\usersess.ps1 -Name NWOAS-K62 -Cmd %D%\k62-shot.cmd -Done %D%\k62-done.txt -Timeout 60
powershell -NoProfile -Command "Add-Type -AssemblyName System.Drawing; $d='C:\NWOAS\gpucov'; $s=$d+'\k62-screen.png'; if(-not (Test-Path $s)){ 'K62 NO CAPTURE'; exit }; $o=$d+'\k62-export'; if(-not (Test-Path $o)){ New-Item -ItemType Directory $o | Out-Null }; $n=$o+'\screen-'+(Get-Date).ToString('HHmmss')+'.jpg'; $enc=[Drawing.Imaging.ImageCodecInfo]::GetImageEncoders() | Where-Object { $_.MimeType -eq 'image/jpeg' }; $ep=New-Object Drawing.Imaging.EncoderParameters 1; $ep.Param[0]=New-Object Drawing.Imaging.EncoderParameter ([Drawing.Imaging.Encoder]::Quality),([long]75); $b=New-Object Drawing.Bitmap $s; 'K62 CAPTURE '+$b.Width+'x'+$b.Height; $b.Save($n,$enc,$ep); $b.Dispose(); $z=$d+'\k62-export.zip'; Remove-Item $z -ErrorAction SilentlyContinue; Compress-Archive -Path $n -DestinationPath $z -Force; $i=Get-Item $z; 'K62 ZIP bytes='+$i.Length+' sha256='+(Get-FileHash $z -Algorithm SHA256).Hash.ToLower(); 'K62 BEGIN-BASE64'; [Convert]::ToBase64String([IO.File]::ReadAllBytes($z),'InsertLineBreaks'); 'K62 END-BASE64'"
echo GPUCOV K62 DONE
exit /b 0
