@echo off
echo GPUCOV K51 CRT32 FIND (read-only): where an x86 (PE machine 14C) vcruntime140.dll / msvcp140.dll already exists on this Windows (SysWOW64, WinSxS, VCLibs framework packages, Program Files (x86)); nothing is copied or installed
powershell -NoProfile -Command "function M($f){ try{ $b=[IO.File]::ReadAllBytes($f); $o=[BitConverter]::ToInt32($b,60); '{0:X}' -f [BitConverter]::ToUInt16($b,$o+4) }catch{ 'ERR' } }; foreach($n in 'vcruntime140.dll','msvcp140.dll'){ $f='C:\Windows\SysWOW64\'+$n; if(Test-Path $f){ 'K51 SYSWOW64 '+$n+' machine='+(M $f)+' ver='+(Get-Item $f).VersionInfo.FileVersion } else { 'K51 SYSWOW64 '+$n+' MISSING' } }; Get-ItemProperty 'HKLM:\SOFTWARE\WOW6432Node\Microsoft\VisualStudio\14.0\VC\Runtimes\*' -ErrorAction SilentlyContinue | ForEach-Object { 'K51 REG VC14 '+$_.PSChildName+' installed='+$_.Installed+' ver='+$_.Version }; Get-AppxPackage -AllUsers -Name 'Microsoft.VCLibs.140.00*' -ErrorAction SilentlyContinue | ForEach-Object { 'K51 APPX '+$_.PackageFullName+' arch='+$_.Architecture }"
powershell -NoProfile -Command "function M($f){ try{ $b=[IO.File]::ReadAllBytes($f); $o=[BitConverter]::ToInt32($b,60); '{0:X}' -f [BitConverter]::ToUInt16($b,$o+4) }catch{ 'ERR' } }; $t0=Get-Date; $roots='C:\Windows\WinSxS','C:\Program Files\WindowsApps','C:\Program Files (x86)'; $c=0; foreach($r in $roots){ foreach($n in 'vcruntime140.dll','msvcp140.dll'){ Get-ChildItem -LiteralPath $r -Recurse -Filter $n -File -ErrorAction SilentlyContinue | ForEach-Object { $m=M $_.FullName; if($m -eq '14C'){ $c++; if($c -le 30){ 'K51 X86 '+$n+' ver='+$_.VersionInfo.FileVersion+' '+$_.FullName } } } } }; 'K51 X86 total='+$c+' search_s='+[int]((Get-Date)-$t0).TotalSeconds"
