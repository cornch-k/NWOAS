@echo off
echo GPUCOV K45t 2775 WOM1POOLTIMELINE (read-only): decode Wom1PoolTimelineFirst (first census of this KMD start) and Wom1PoolTimeline (latest); entries by sequence: t_ms since KMD start, kind U=page-table update D=destroy C=census NOT_POOL, allocation, MiB, cpu-visible, pid, first segment, pool base MiB, pool/other MiB, folded updates, va
powershell -NoProfile -Command "Get-CimInstance Win32_VideoController | ForEach-Object { 'K45t VC '+$_.Name+' | '+$_.DriverVersion }"
powershell -NoProfile -Command "$k='HKLM:\SYSTEM\CurrentControlSet\Enum\ACPI\APPL0002\0\Device Parameters'; $now=[Diagnostics.Stopwatch]::GetTimestamp(); foreach($n in 'Wom1PoolTimelineFirst','Wom1PoolTimeline'){ $b=$null; try { $b=[byte[]](Get-ItemProperty -Path $k -Name $n -ErrorAction Stop).$n } catch {}; if(-not $b){ 'K45t '+$n+' present=0'; continue }; $U4={param($o) [BitConverter]::ToUInt32($b,$o)}; $U8={param($o) [BitConverter]::ToUInt64($b,$o)}; $f=& $U8 40; $st=& $U8 48; $wr=& $U8 56; $age=if($f -gt 0 -and $now -ge $wr){ [math]::Round(($now-$wr)/$f,1) } else { -1 }; 'K45t '+$n+' bytes='+$b.Length+' version='+(& $U4 0)+' entry_bytes='+(& $U4 8)+' total='+(& $U8 16)+' writes='+(& $U8 24)+' census='+(& $U8 32)+' written_age_s='+$age+' (negative or huge = an older boot)'; $e=@(); for($i=0;$i -lt (& $U4 12);$i++){ $o=64+88*$i; if($o+88 -gt $b.Length){ break }; $sq=& $U8 ($o+8); if($sq -gt 0){ $e+=,@($sq,$o) } }; foreach($x in ($e | Sort-Object { $_[0] })){ $o=$x[1]; $kd=@('?','U','D','C')[[math]::Min(3,(& $U4 ($o+80)))]; $pb=& $U8 ($o+48); $pbs=if($pb -eq [UInt64]::MaxValue){'-'}else{[math]::Round($pb/1MB,2)}; $t=[math]::Round(((& $U8 $o)-$st)*1000/$f,1); 'K45t '+$(if($n -like '*First'){'first'}else{'latest'})+' seq='+$x[0]+' t_ms='+$t+' '+$kd+' alloc=0x'+('{0:x}' -f (& $U8 ($o+16)))+' mib='+[math]::Round((& $U8 ($o+24))/1MB,1)+' cpuvis='+(& $U4 ($o+72))+' pid='+(& $U4 ($o+76))+' seg='+(& $U4 ($o+68))+' pool_base_mib='+$pbs+' pool_mib='+[math]::Round((& $U4 ($o+60))*4/1024,1)+' other_mib='+[math]::Round((& $U4 ($o+64))*4/1024,1)+' folded='+(& $U4 ($o+84))+' va=0x'+('{0:x}' -f (& $U8 ($o+32))) } }"
echo GPUCOV K45t DONE
exit /b 0
