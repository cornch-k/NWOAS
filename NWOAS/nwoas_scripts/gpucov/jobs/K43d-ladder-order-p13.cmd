@echo off
echo GPUCOV K43d MEMLADDER ORDER TEST (probe13 on 2774): (a) 2304 MiB alone in a fresh process, (b) 2048 then 2304 back to back (the K43c order), (c) 1792..3072 with settle=15000 (wait until the previous size's memory is gone); pre line, removal after each probe copy, receipts, UMD trace failure lines per run
set D=C:\NWOAS\gpucov
set P=%D%\nwgpuprobe13-arm64.exe
powershell -NoProfile -Command "Get-CimInstance Win32_VideoController | ForEach-Object { 'K43d VC '+$_.Name+' | '+$_.DriverVersion }"
if not exist %P% (echo K43d probe13 missing & echo GPUCOV K43d DONE & exit /b 0)
del /q %D%\k43d-a.txt %D%\k43d-b.txt %D%\k43d-c.txt %D%\k43d-a.log %D%\k43d-b.log %D%\k43d-c.log 2>nul
setlocal
set APPLE_AGX_UMD_REFUSALS_ONLY=1
set APPLE_AGX_UMD_TRACE_SYNC=1
set APPLE_AGX_UMD_TRACE_FILE=%D%\k43d-a.log
%P% pool memladder2 ladder=2304 > %D%\k43d-a.txt 2>&1
powershell -NoProfile -Command "Start-Sleep -Seconds 10"
set APPLE_AGX_UMD_TRACE_FILE=%D%\k43d-b.log
%P% memladder2 ladder=2048,2304 > %D%\k43d-b.txt 2>&1
powershell -NoProfile -Command "Start-Sleep -Seconds 10"
set APPLE_AGX_UMD_TRACE_FILE=%D%\k43d-c.log
%P% memladder2 settle=15000 ladder=1792,2048,2304,2560,3072 > %D%\k43d-c.txt 2>&1
endlocal
powershell -NoProfile -Command "$l=@(Get-Content C:\NWOAS\gpucov\k43d-a.txt -ErrorAction SilentlyContinue); 'K43d a lines='+$l.Count; $l | Where-Object { $_ -match 'NWGP (pool probe|pool demand|memladder2|d3d12 device|d3d12 end|begin|end|rcpt)' } | Select-Object -First 160 | ForEach-Object { 'K43d a '+$_ }"
powershell -NoProfile -Command "$f='C:\NWOAS\gpucov\k43d-a.log'; $p='K43d a'; $t=@(Get-Content $f -ErrorAction SilentlyContinue); $p+' UMDTRACE file='+$f+' lines='+$t.Count; $t | ForEach-Object { ($_ -split ' ')[0] } | Group-Object | Sort-Object Count -Descending | Select-Object -First 25 | ForEach-Object { $p+' UTSTAGE '+$_.Count+' '+$_.Name }; $t | Where-Object { ($_ -match ' hr=0x[89a-fA-F][0-9a-fA-F]{7} ' -and $_ -notmatch ' hr=0x8000000a ') -or $_ -match '^(reject-|runtime-set-error|device-|measure-cpu-pool-rehome|measure-make-resident|measure-d3d12-heap-refused)' } | Select-Object -First 80 | ForEach-Object { $p+' UTFAIL '+$_.Substring(0,[math]::Min(320,$_.Length)) }; $t | Where-Object { $_ -match '^measure-d3d12-heap hr' } | Select-Object -First 40 | ForEach-Object { $p+' UTHEAP '+$_.Substring(0,[math]::Min(200,$_.Length)) }"
powershell -NoProfile -Command "$l=@(Get-Content C:\NWOAS\gpucov\k43d-b.txt -ErrorAction SilentlyContinue); 'K43d b lines='+$l.Count; $l | Where-Object { $_ -match 'NWGP (pool probe|pool demand|memladder2|d3d12 device|d3d12 end|begin|end|rcpt)' } | Select-Object -First 160 | ForEach-Object { 'K43d b '+$_ }"
powershell -NoProfile -Command "$f='C:\NWOAS\gpucov\k43d-b.log'; $p='K43d b'; $t=@(Get-Content $f -ErrorAction SilentlyContinue); $p+' UMDTRACE file='+$f+' lines='+$t.Count; $t | ForEach-Object { ($_ -split ' ')[0] } | Group-Object | Sort-Object Count -Descending | Select-Object -First 25 | ForEach-Object { $p+' UTSTAGE '+$_.Count+' '+$_.Name }; $t | Where-Object { ($_ -match ' hr=0x[89a-fA-F][0-9a-fA-F]{7} ' -and $_ -notmatch ' hr=0x8000000a ') -or $_ -match '^(reject-|runtime-set-error|device-|measure-cpu-pool-rehome|measure-make-resident|measure-d3d12-heap-refused)' } | Select-Object -First 80 | ForEach-Object { $p+' UTFAIL '+$_.Substring(0,[math]::Min(320,$_.Length)) }; $t | Where-Object { $_ -match '^measure-d3d12-heap hr' } | Select-Object -First 40 | ForEach-Object { $p+' UTHEAP '+$_.Substring(0,[math]::Min(200,$_.Length)) }"
powershell -NoProfile -Command "$l=@(Get-Content C:\NWOAS\gpucov\k43d-c.txt -ErrorAction SilentlyContinue); 'K43d c lines='+$l.Count; $l | Where-Object { $_ -match 'NWGP (pool probe|pool demand|memladder2|d3d12 device|d3d12 end|begin|end|rcpt)' } | Select-Object -First 160 | ForEach-Object { 'K43d c '+$_ }"
powershell -NoProfile -Command "$f='C:\NWOAS\gpucov\k43d-c.log'; $p='K43d c'; $t=@(Get-Content $f -ErrorAction SilentlyContinue); $p+' UMDTRACE file='+$f+' lines='+$t.Count; $t | ForEach-Object { ($_ -split ' ')[0] } | Group-Object | Sort-Object Count -Descending | Select-Object -First 25 | ForEach-Object { $p+' UTSTAGE '+$_.Count+' '+$_.Name }; $t | Where-Object { ($_ -match ' hr=0x[89a-fA-F][0-9a-fA-F]{7} ' -and $_ -notmatch ' hr=0x8000000a ') -or $_ -match '^(reject-|runtime-set-error|device-|measure-cpu-pool-rehome|measure-make-resident|measure-d3d12-heap-refused)' } | Select-Object -First 80 | ForEach-Object { $p+' UTFAIL '+$_.Substring(0,[math]::Min(320,$_.Length)) }; $t | Where-Object { $_ -match '^measure-d3d12-heap hr' } | Select-Object -First 40 | ForEach-Object { $p+' UTHEAP '+$_.Substring(0,[math]::Min(200,$_.Length)) }"
powershell -NoProfile -Command "function Get-MlResult($f,$m){ $x=@(Get-Content $f -ErrorAction SilentlyContinue) -match ('memladder2 d3d12 size_mib='+$m+' .*result=(PASS|FAIL)'); if($x.Count -and ($x[0] -match 'result=(PASS|FAIL)')){ $Matches[1] } else { 'NONE' } }; $a=Get-MlResult 'C:\NWOAS\gpucov\k43d-a.txt' 2304; $b1=Get-MlResult 'C:\NWOAS\gpucov\k43d-b.txt' 2048; $b2=Get-MlResult 'C:\NWOAS\gpucov\k43d-b.txt' 2304; $c=@(); $call=1; foreach($s in 1792,2048,2304,2560,3072){ $r=Get-MlResult 'C:\NWOAS\gpucov\k43d-c.txt' $s; $c+=($s.ToString()+':'+$r); if($r -ne 'PASS'){ $call=0 } }; $v=if($a -eq 'FAIL'){'SIZE'}elseif($a -eq 'PASS' -and $b2 -eq 'FAIL' -and $call){'HISTORY'}elseif($a -eq 'PASS' -and $b2 -eq 'PASS' -and $call){'NOREPRO'}else{'MIXED'}; 'K43d VERDICT a2304='+$a+' b2048='+$b1+' b2304='+$b2+' c='+($c -join ',')+' c_all_pass='+$call+' => '+$v"
powershell -NoProfile -Command "Get-WinEvent -FilterHashtable @{LogName='System'; StartTime=(Get-Date).AddMinutes(-20)} -ErrorAction SilentlyContinue | Where-Object { $_.ProviderName -match 'Display|dxgkrnl|DxgKrnl|Resource-Exhaustion' -or $_.Id -in 4101,2004 } | Select-Object -First 8 | ForEach-Object { 'K43d SYSEVT '+$_.TimeCreated.ToString('HH:mm:ss')+' '+$_.ProviderName+' '+$_.Id }"
echo GPUCOV K43d DONE
exit /b 0
