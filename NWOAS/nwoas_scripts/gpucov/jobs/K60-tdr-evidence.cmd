@echo off
echo GPUCOV K60 TDR EVIDENCE (read-only): bugcheck 0x116 after a monitor reconnect on 2780. Prints the reset receipts the KMD keeps in the device key, the display and bugcheck events of the last 2 hours, the dump lists, then the newest minidump as zip + base64 (decode: bash gpucov/fetch-b64.sh K60 JOBLOG DIR)
powershell -NoProfile -Command "$k='HKLM:\SYSTEM\CurrentControlSet\Enum\ACPI\APPL0002\0\Device Parameters'; $p=Get-ItemProperty $k; foreach($n in ($p.PSObject.Properties.Name | Where-Object { $_ -match 'Reset|Tdr|Fault|StartSta|Scanout|Vsync' } | Sort-Object)){ $v=$p.$n; if($v -is [byte[]]){ $q=@(); for($i=0;$i+8 -le $v.Length -and $i -lt 160;$i+=8){ $q+=('{0:x16}' -f [BitConverter]::ToUInt64($v,$i)) }; 'K60 REG '+$n+' bytes='+$v.Length+' q='+($q -join ' ') } else { 'K60 REG '+$n+' = '+$v } }; 'K60 UPTIME_MS '+[int64]([Environment]::TickCount)+' boot='+(Get-CimInstance Win32_OperatingSystem).LastBootUpTime.ToString('s')"
powershell -NoProfile -Command "Get-WinEvent -FilterHashtable @{LogName='System'; StartTime=(Get-Date).AddHours(-2)} -ErrorAction SilentlyContinue | Where-Object { $_.ProviderName -match 'Display|dxgkrnl|WER-SystemErrorReporting|Kernel-Power|BugCheck|volmgr' -or $_.Id -in 4101,4097,4107,41,1001,1019,6008 } | Select-Object -First 40 | Sort-Object TimeCreated | ForEach-Object { $m=($_.Message -replace '\s+',' '); 'K60 EV '+$_.TimeCreated.ToString('HH:mm:ss')+' '+$_.ProviderName+' id='+$_.Id+' '+$m.Substring(0,[Math]::Min(240,$m.Length)) }"
powershell -NoProfile -Command "Get-ChildItem C:\Windows\Minidump -ErrorAction SilentlyContinue | Sort-Object LastWriteTime | ForEach-Object { 'K60 MINIDUMP '+$_.Name+' '+$_.Length+' '+$_.LastWriteTime.ToString('s') }; Get-ChildItem C:\Windows\LiveKernelReports -Recurse -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime | Select-Object -Last 12 | ForEach-Object { 'K60 LIVE '+$_.FullName+' '+$_.Length+' '+$_.LastWriteTime.ToString('s') }; if(Test-Path C:\Windows\MEMORY.DMP){ $m=Get-Item C:\Windows\MEMORY.DMP; 'K60 MEMORYDMP '+$m.Length+' '+$m.LastWriteTime.ToString('s') }"
powershell -NoProfile -Command "$f=Get-ChildItem C:\Windows\Minidump\*.dmp -ErrorAction SilentlyContinue | Sort-Object LastWriteTime | Select-Object -Last 1; if(-not $f){ 'K60 NO MINIDUMP'; exit }; 'K60 SRC '+$f.Name+' '+$f.Length+' '+(Get-FileHash $f.FullName).Hash.ToLower(); $d='C:\NWOAS\gpucov\k60-dump'; if(-not (Test-Path $d)){ New-Item -ItemType Directory $d | Out-Null }; $z=$d+'\'+$f.BaseName+'.zip'; if(-not (Test-Path $z)){ Compress-Archive -Path $f.FullName -DestinationPath $z }; $i=Get-Item $z; 'K60 ZIP bytes='+$i.Length+' sha256='+(Get-FileHash $z -Algorithm SHA256).Hash.ToLower(); 'K60 BEGIN-BASE64'; [Convert]::ToBase64String([IO.File]::ReadAllBytes($z),'InsertLineBreaks'); 'K60 END-BASE64'"
echo GPUCOV K60 DONE
exit /b 0
