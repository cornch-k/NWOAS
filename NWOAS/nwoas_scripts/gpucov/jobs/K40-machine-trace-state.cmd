@echo off
echo GPUCOV K40 MACHINE-WIDE UMD TRACE STATE (read only): the D17 setx /M variables every process inherits, and what C:\NWOAS\umd-trace.log holds
powershell -NoProfile -Command "foreach($n in 'APPLE_AGX_UMD_TRACE_FILE','APPLE_AGX_UMD_REFUSALS_ONLY','APPLE_AGX_UMD_TRACE_SYNC','APPLE_AGX_D3D_MSAA_CAPS','APPLE_AGX_D3D_SCREEN_MSAA'){ 'K40 MACHINE '+$n+'='+[Environment]::GetEnvironmentVariable($n,'Machine') }; $f='C:\NWOAS\umd-trace.log'; if(!(Test-Path $f)){ 'K40 NO FILE'; exit }; $i=Get-Item $f; 'K40 FILE bytes='+$i.Length+' written='+$i.LastWriteTime.ToString('MM-dd HH:mm:ss'); $l=@(Get-Content $f -Tail 200000); 'K40 tail_lines='+$l.Count; $l | Where-Object { $_ -match ' pid=([0-9]+) ' } | Group-Object { if($_ -match ' pid=([0-9]+) '){ $matches[1] } } | Sort-Object Count -Descending | Select-Object -First 12 | ForEach-Object { 'K40 PID '+$_.Name+' lines='+$_.Count+' last='+(($_.Group[-1] -split ' ')[0]) }; $l | Where-Object { $_ -match '^reject-' } | Group-Object { ($_ -split ' ')[0] } | ForEach-Object { 'K40 R '+$_.Name+' x'+$_.Count }; $l | Where-Object { $_ -match '^reject-' } | Select-Object -Last 25 | ForEach-Object { 'K40 RL '+$_.Substring(0,[math]::Min(280,$_.Length)) }"
echo GPUCOV K40 DONE
exit /b 0
