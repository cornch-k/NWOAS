@echo off
echo GPUCOV K43v 2774 K43c UMD TRACE WINDOWS (read-only, no reboot): per size, the lines from 12 before its big DEFAULT heap line to its first d3d12 owner-submit (GPU timing stages left out), then every trim / make-resident line with its index
powershell -NoProfile -Command "$p='K43v'; $t=@(Get-Content C:\NWOAS\gpucov\k43c-umd.log -ErrorAction SilentlyContinue); function Get-Cut($s){ $s.Substring(0,[math]::Min(240,$s.Length)) }; $skip='^measure-(gpu-|d3d12-(replay|owner-time|owner-fences|dispatch|cdm|query|wait|subresource)|batch-deps|native-ready|umd-submit|perf-reason|render-fence)'; $p+' lines='+$t.Count; for($i=0;$i -lt $t.Count;$i++){ if($t[$i] -match '^measure-d3d12-heap hr=0x[0-9a-f]{8} .* 00000002 0000(7000|8000|9000|a000|c000) '){ $z=$Matches[1]; $p+' BIG '+$z+' at='+$i; $n=0; for($k=[math]::Max(0,$i-12);$k -lt $t.Count -and $n -lt 70;$k++){ if($k -gt $i -and $t[$k] -match '^measure-d3d12-owner-submit'){ $p+' W'+$z+' '+$k+' '+(Get-Cut $t[$k]); break }; if($t[$k] -notmatch $skip){ $p+' W'+$z+' '+$k+' '+(Get-Cut $t[$k]); $n++ } } } }"
powershell -NoProfile -Command "$p='K43v'; $t=@(Get-Content C:\NWOAS\gpucov\k43c-umd.log -ErrorAction SilentlyContinue); for($i=0;$i -lt $t.Count;$i++){ if($t[$i] -match '^(measure-(trim|make-resident|d3d12-make-resident|d3d12-evict|watch-|cpu-pool)|reject-)'){ $p+' RES '+$i+' '+$t[$i].Substring(0,[math]::Min(220,$t[$i].Length)) } }" > C:\NWOAS\gpucov\k43v-res.txt
powershell -NoProfile -Command "$l=@(Get-Content C:\NWOAS\gpucov\k43v-res.txt); 'K43v RES total='+$l.Count; $l | Select-Object -First 150"
echo GPUCOV K43v DONE
exit /b 0
