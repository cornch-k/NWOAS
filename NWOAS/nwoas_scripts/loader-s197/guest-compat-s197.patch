diff --git a/src/i2c.c b/src/i2c.c
index 14ab5f70..df728c0b 100644
--- a/src/i2c.c
+++ b/src/i2c.c
@@ -20,8 +20,6 @@
 #define PASEMI_STATUS_XFER_ENDED BIT(27)
 
 #define PASEMI_CONTROL          0x1c
-#define PASEMI_CONTROL_ENABLE   BIT(11)
-#define PASEMI_REVISION         0x28
 #define PASEMI_CONTROL_CLEAR_RX BIT(10)
 #define PASEMI_CONTROL_CLEAR_TX BIT(9)
 
@@ -55,14 +53,6 @@ i2c_dev_t *i2c_init(const char *adt_node)
         return NULL;
 
     dev->base = base;
-    /* D71: Apple rev >= 6 requires CTL.EN; do not inherit the disabled
-     * controller left by a previous host-side I2C transaction. Preserve CLK.
-     * Same revision/enable rule as Linux i2c-pasemi-core.c. */
-    u32 rev = read32(base + PASEMI_REVISION);
-    if (rev != 0xffffffffu && rev >= 6)
-        set32(base + PASEMI_CONTROL, PASEMI_CONTROL_ENABLE);
-    printf("i2c: rev=%u ctl=0x%x ready %s\n", rev,
-           read32(base + PASEMI_CONTROL), adt_node);
     return dev;
 }
 
diff --git a/src/main.c b/src/main.c
index 9b978ede..e5c1ff92 100644
--- a/src/main.c
+++ b/src/main.c
@@ -161,15 +161,7 @@ void m1n1_main(void)
 #ifndef BRINGUP
     pmgr_init();
 #ifdef USE_FB
-    /* NWOAS S6-D4 [DESIGN]: preserve iBoot's DCP state until the host can
-     * observe its first handshake. Scope this diagnostic to the actual M1
-     * Tahoe firmware under test; explicit display proxy operations remain.
-     * HARDWARE-UNVERIFIED: this defers initialization, it does not fix display.
-     */
-    if (chip_id == 0x8103 && !strcmp(os_firmware.iboot, "mBoot-18000.121.3"))
-        printf("NWOAS-DCP-DEFER: automatic display init deferred to host\n");
-    else
-        display_init();
+    display_init();
     // Kick DCP to sleep, so dodgy monitors which cause reconnect cycles don't cause us to lose the
     // framebuffer.
     display_shutdown(DCP_SLEEP_IF_EXTERNAL);
