@echo off
chcp 65001 >nul
powershell -NoProfile -Command "$ErrorActionPreference = 'Stop'; $paths = @('C:\Windows\System32\ntoskrnl.exe','C:\Windows\System32\drivers\storport.sys','C:\Windows\System32\drivers\stornvme.sys','C:\Windows\System32\drivers\USBXHCI.SYS'); foreach ($path in $paths) { $b = [IO.File]::ReadAllBytes($path); $pe = [BitConverter]::ToInt32($b,0x3c); if ([BitConverter]::ToUInt32($b,$pe) -ne 0x4550) { throw 'Invalid PE' }; $sections = [BitConverter]::ToUInt16($b,$pe+6); $optSize = [BitConverter]::ToUInt16($b,$pe+20); $opt = $pe+24; if ([BitConverter]::ToUInt16($b,$opt) -ne 0x20b) { throw 'Expected PE32+' }; $debugRva = [BitConverter]::ToUInt32($b,$opt+160); $debugSize = [BitConverter]::ToUInt32($b,$opt+164); $debugOff = -1; for ($i=0; $i -lt $sections; $i++) { $s=$opt+$optSize+$i*40; $va=[BitConverter]::ToUInt32($b,$s+12); $rawSize=[BitConverter]::ToUInt32($b,$s+16); $raw=[BitConverter]::ToUInt32($b,$s+20); if ($debugRva -ge $va -and $debugRva -lt $va+$rawSize) { $debugOff=$raw+$debugRva-$va; break }; }; Write-Output ('IMAGE '+$path+' Size='+$b.Length+' Timestamp='+[BitConverter]::ToUInt32($b,$pe+8)); Write-Output ('SHA256 '+(Get-FileHash -Algorithm SHA256 $path).Hash); if ($debugOff -lt 0) { throw 'Debug RVA not backed by file' }; for ($j=0; $j+28 -le $debugSize; $j+=28) { $d=$debugOff+$j; if ([BitConverter]::ToUInt32($b,$d+12) -ne 2) { continue }; $size=[BitConverter]::ToUInt32($b,$d+16); $off=[BitConverter]::ToUInt32($b,$d+24); if ($off+$size -gt $b.Length -or $size -lt 24) { throw 'Bad CodeView bounds' }; if ([Text.Encoding]::ASCII.GetString($b,$off,4) -ne 'RSDS') { continue }; $guid = New-Object Guid (,[byte[]]$b[($off+4)..($off+19)]); $age=[BitConverter]::ToUInt32($b,$off+20); $name=[Text.Encoding]::ASCII.GetString($b,$off+24,$size-24).TrimEnd([char]0); Write-Output ('RSDS '+$guid.ToString('N').ToUpper()+$age.ToString('X')+' '+$name); }; }"
exit /b %errorlevel%
