+/* ---- P:471-517 _bring_up_port0 (reference set-only sequence, no --controller-reset) */
+static int bring_up_port0(struct s264w *w)
+{
+    const struct s264w_facts *f = &w->f;
+    u64 port = f->port0, phy = f->port0_phy;
+    int r;
+    w->up.port0_touched = true;
+    if ((r = rmw(w, port + PORT_APPCLK, 0, APPCLK_EN)))
+        return r;
+    r32(w, f->gpio + 4 * (u64)f->perst_pin); /* perst_gpio_original */
+    if ((r = perst(w, true)))
+        return r;
+    r32(w, port + PORT_PERST); /* before */
+    if ((r = rmw(w, phy + PHY_LANE_CTL, 0, CFGACC)) || (r = rmw(w, phy + PHY_LANE_CFG, 0, REFCLK0REQ)))
+        return r;
+    if (!poll(w, phy + PHY_LANE_CFG, REFCLK0ACK, REFCLK0ACK, 50, NULL))
+        return X_RT;
+    if ((r = rmw(w, phy + PHY_LANE_CFG, 0, REFCLK1REQ)))
+        return r;
+    if (!poll(w, phy + PHY_LANE_CFG, REFCLK1ACK, REFCLK1ACK, 50, NULL))
+        return X_RT;
+    if ((r = rmw(w, phy + PHY_LANE_CTL, CFGACC, 0)) || (r = rmw(w, phy + PHY_LANE_CFG, 0, REFCLKEN)) ||
+        (r = rmw(w, port + PORT_REFCLK, 0, REFCLK_EN)))
+        return r;
+    IO->sleep_us(f->t_refclk_to_perst_us);
+    if ((r = rmw(w, port + PORT_PERST, 0, PERST_OFF)) || (r = perst(w, false)))
+        return r;
+    IO->sleep_us((u64)f->perst_to_config_ms * 1000);
+    if (!poll(w, port + PORT_STATUS, STATUS_READY, STATUS_READY, 250, NULL))
+        return X_RT;
+    return w32(w, port + PORT_LTSSMCTL, 1);
+}
