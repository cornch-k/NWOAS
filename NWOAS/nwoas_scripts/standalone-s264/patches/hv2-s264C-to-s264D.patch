+/* ---- P:597-628 _size_bars (fn 0 results kept; fn 1 only for the MMIO trace) */
+static int size_bars(struct s264w *w, u32 fn)
+{
+    struct s264w_up *up = &w->up;
+    u32 i = 0, n = 0;
+    int r;
+    while (i < 6) {
+        u64 a = ecam_addr(w->f.ecam, 1, 0, fn, 0x10 + 4 * i);
+        u32 orig = r32(w, a);
+        struct s264w_bar bar = {i, 0, 0};
+        if (orig & 1) {
+            if ((r = w32(w, a, 0xffffffffu)))
+                return r;
+            u32 v = r32(w, a);
+            if ((r = w32(w, a, orig)))
+                return r;
+            bar.type = 1;
+            bar.size = (v & ~0x3u) ? ((~(v & ~0x3u)) + 1) & 0xffff : 0;
+            i += 1;
+        } else if (((orig >> 1) & 3) == 2 && i < 5) {
+            u64 ah = a + 4;
+            u32 orig_hi = r32(w, ah);
+            if ((r = w32(w, a, 0xffffffffu)) || (r = w32(w, ah, 0xffffffffu)))
+                return r;
+            u32 lo = r32(w, a), hi = r32(w, ah);
+            if ((r = w32(w, a, orig)) || (r = w32(w, ah, orig_hi)))
+                return r;
+            u64 mask = ((u64)hi << 32) | (lo & ~0xfu);
+            bar.type = 3;
+            bar.size = mask ? (~mask) + 1 : 0;
+            if (r32(w, a) == orig) /* 'restored': r32(a) == orig and r32(ah) == orig_hi */
+                r32(w, ah);
+            i += 2;
+        } else {
+            if ((r = w32(w, a, 0xffffffffu)))
+                return r;
+            u32 v = r32(w, a);
+            if ((r = w32(w, a, orig)))
+                return r;
+            bar.type = 2;
+            bar.size = (v & ~0xfu) ? ((~(v & ~0xfu)) + 1) & 0xffffffffu : 0;
+            r32(w, a); /* 'restored' */
+            i += 1;
+        }
+        if (fn == 0 && n < 6)
+            up->bars[n++] = bar;
+    }
+    if (fn == 0) {
+        up->n_bars = n;
+        up->bars_ok = 1;
+    }
+    return X_OK;
+}
