+#define EXP_GPIO_PH   106u
+#define EXP_PERST     0x98u
+#define EXP_P1PERST   0x99u
+#define EXP_SMC       0x23e400000ULL
+#define SMC_KEY_GP0D  0x67503064u /* 'gP0d' big-endian (smc.py write: int.from_bytes(key, 'big')) */
+#define SMC_GPIO_ON   0x800001u
+#define SMC_GPIO_OFF  0x800000u
+#define PORT_LTSSMCTL 0x080
+#define PORT_LINKSTS  0x208
+#define LINKSTS_UP    0x1
+#define PORT_APPCLK   0x800
+#define APPCLK_EN     0x1
+#define APPCLK_CGDIS  0x100
+#define PORT_STATUS   0x804
+#define STATUS_READY  0x1
+#define PORT_REFCLK   0x810
+#define REFCLK_EN     0x1
+#define REFCLK_CGDIS  0x100
+#define PORT_PERST    0x814
+#define PERST_OFF     0x1
+#define PHY_LANE_CFG  0x0
+#define PHY_LANE_CTL  0x4
+#define REFCLK0REQ    0x1
+#define REFCLK1REQ    0x2
+#define REFCLK0ACK    0x4
+#define REFCLK1ACK    0x8
+#define REFCLKEN      0x600
+#define CFGACC        0x8000
+#define GPIO_DATA     0x1
+#define GPIO_MODE_MASK 0xe
+#define GPIO_MODE_OUT 0x2
+#define GPIO_PERIPH   0x60
+#define GPIO_INPUT_EN 0x200
+#define GUARD_OFF     0
+#define GUARD_SKIP_SILENT 0x101
+#define WIFI_ID       0x442514e4u
+#define BT_ID         0x5f6914e4u
+#define APPLE_VENDOR  0x106b
+#define PD_GPIO_PERST_ASSERTED GPIO_MODE_OUT
+/* U:117-140 */
+#define CHIP_BASE     0x18000000u
+#define BAR0_WINDOW_CFG 0x80
+#define BAR0_WINDOW_SIZE 0x1000
+#define EP_LINKCTL_CFG 0xbc
+#define ASPM_MASK     0x3
+#define BRCM_CC_4378  0x4378
+#define CPU_OFFSET    0x600000000ULL
+#define BAR_BASE      0xe0000000ULL
+#define CMD_MEM       0x2
+#define CMD_BME       0x4
+#define CMD_INTX_DIS  0x400
+/* S:36-56 */
+#define D_STREAM_COMMAND 0x20
+#define D_CMD_INVALIDATE (1u << 20)
+#define D_CMD_BUSY    (1u << 2)
+#define D_STREAM_SELECT 0x34
+#define D_ERROR       0x40
+#define D_ERROR_ADDR_LO 0x50
+#define D_ERROR_ADDR_HI 0x54
+#define D_CONFIG      0x60
+#define D_CONFIG_LOCK (1u << 15)
+#define D_ENABLED     0xfc
+#define D_TCR         0x100
+#define D_TTBR        0x200
+#define D_TCR_TRANSLATE (1u << 7)
+#define D_TCR_BYPASS  (1u << 8)
+#define D_TTBR_VALID  (1u << 31)
+#define INVALIDATE_POLLS 1000
+#define DART0_BASE    0x681008000ULL
+#define DART1_BASE    0x682008000ULL
+/* W:30-74 */
+#define BAR2_BUS      0xe0000000u
+#define BAR2_SIZE     0x800000u
+#define BAR0_BUS      0xe0800000u
+#define BAR0_SIZE     0x10000u
+#define WIN_LO        0xe0000000u
+#define WIN_HI        0xe08fffffu
+#define MAGIC         0x4657574eu
+#define R_MAGIC       0x00
+#define R_VERSION     0x04
+#define R_STATE       0x08
+#define R_ERROR       0x0c
+#define R_CMD         0x10
+#define R_SEQ         0x14
+#define R_AVAIL       0x18
+#define R_IDS         0x1c
+#define R_CFG_OFF     0x20
+#define R_CFG_DATA    0x24
+#define R_CFG_ERR     0x28
+#define R_BAR0        0x2c
+#define R_BAR2        0x30
+#define R_LINKSTS     0x34
+#define R_DEVCTL      0x38
+#define R_EPCMD       0x3c
+#define R_DART_TTBR   0x40
+#define R_DART_CHECK  0x44
+#define R_CHIPID      0x48
+#define R_BAR0WIN     0x4c
+#define R_CMD_COUNT   0x50
+#define R_MAC_LO      0x60
+#define R_MAC_HI      0x64
+#define R_CAL_LEN     0x68
+#define R_ANTENNA     0x6c
+#define R_BOARD       0x70
+#define CAL_OFF       0x1000
+#define ST_OFF 0
+#define ST_UP 1
+#define ST_OFF_REQ 2
+#define ST_FAILED 3
+#define CMD_POWER_UP 1
+#define CMD_POWER_DOWN 2
+#define CFG_OK 0
+#define CFG_NOT_UP 1
+#define CFG_NOT_ALLOWED 2
+#define CFG_BAD_OFFSET 3
+#define CFG_EXCEPTION 4
+enum {
+    E_NONE = 0, E_DISABLED, E_RP0_BAD, E_PORT_NOT_READY, E_DART0_OFFLINE, E_LINK_ALREADY_UP,
+    E_SMC_KEY, E_SMC_ERROR, E_LINK_DOWN, E_NO_DEVICE, E_BAR_SETUP, E_BAR_LAYOUT, E_CHIP_ID,
+    E_DEVCTL, E_DART_MISMATCH, E_BUS_MASTER, E_PORT1_CHANGED, E_ERROR, E_POWER_OFF_UNCONFIRMED,
+    E_INTX_MASK
+};
+#define INTMSK        0x104
+#define INTMSKCLR     0x10c
+#define INTX_BITS     0xf
+#define DEVCTL_NS_RO  0x0810
+#define EP_CMD_UP     (CMD_MEM | CMD_BME)
+#define EP_CMD_QUIET  (CMD_MEM | CMD_INTX_DIS)
+#define LOG_BUDGET    4000
+
+/* "exception" classes (Python exception types that reach a handler) */
+#define X_OK      0
+#define X_FAIL    1 /* Fail(code, text): w->fail */
+#define X_REF_BAR 2 /* wp.Refusal whose text contains "BAR" (RangeMmio allowlist/BAR ranges) */
+#define X_REF     3 /* wp.Refusal without "BAR" (bus master guard) */
+#define X_RT      4 /* RuntimeError and anything else */
+
+static u32 w_fail; /* Fail code of the last X_FAIL */
+
+static u64 ecam_addr(u64 ecam, u32 bus, u32 dev, u32 fn, u32 off)
+{
+    return ecam + ((u64)bus << 20) + ((u64)dev << 15) + ((u64)fn << 12) + off;
+}
+
+/* facts (adt_facts / validate_facts): pure, in nwoas_s264_plan.c (the host planner links it) */
+
+/* ================================================================== driver */
+#define IO (w->io)
+
+static void wlog(struct s264w *w, const char *m)
+{
+    w->lines++;
+    if (IO->log && (w->lines <= LOG_BUDGET || !strncmp(m, "READY", 5) || !strncmp(m, "FAIL", 4) ||
+                    !strncmp(m, "OFF", 3) || !strncmp(m, "BOOT", 4)))
+        IO->log(m);
+}
+#ifdef S264_HOST
+#define WLOGF(...) (snprintf(w->msg, sizeof(w->msg), __VA_ARGS__), wlog(w, w->msg))
+#else
+#define WLOGF(...) (snprintf(w->msg, sizeof(w->msg), __VA_ARGS__), wlog(w, w->msg))
+#endif
+
+/* ---- guarded() (P:367-381): before = get_exc_count; guard SKIP|SILENT ... guard OFF; delta */
+static u32 g_begin(struct s264w *w)
+{
+    u32 b = IO->exc_count();
+    IO->set_guard(GUARD_SKIP_SILENT);
+    return b;
+}
+static u32 g_end(struct s264w *w, u32 before)
+{
+    IO->set_guard(GUARD_OFF);
+    return IO->exc_count() - before;
+}
+static void g_abort(struct s264w *w)
+{
+    IO->set_guard(GUARD_OFF); /* exception path: no count read */
+}
+
+/* ---- RangeMmio (U:284-316) */
+static bool in_allowlist(struct s264w *w, u64 a)
+{
+    const struct s264w_facts *f = &w->f;
+    u64 p0 = f->port0, phy = f->port0_phy, e = f->ecam;
+    if (a == p0 + PORT_LTSSMCTL || a == p0 + PORT_APPCLK || a == p0 + PORT_REFCLK || a == p0 + PORT_PERST)
+        return true;
+    if (a == phy + PHY_LANE_CFG || a == phy + PHY_LANE_CTL)
+        return true;
+    if (a == f->gpio + 4 * (u64)f->perst_pin || a == ecam_addr(e, 0, 0, 0, 0x18))
+        return true;
+    for (u32 fn = 0; fn < 2; fn++)
+        for (u32 i = 0; i < 6; i++)
+            if (a == ecam_addr(e, 1, 0, fn, 0x10 + 4 * i))
+                return true;
+    static const u32 rp[5] = {0x04, 0x20, 0x24, 0x28, 0x2c};
+    for (u32 i = 0; i < 5; i++)
+        if (a == ecam_addr(e, 0, 0, 0, rp[i]))
+            return true;
+    if (a == ecam_addr(e, 1, 0, 0, 0x04) || a == ecam_addr(e, 1, 0, 0, BAR0_WINDOW_CFG) ||
+        a == ecam_addr(e, 1, 0, 0, EP_LINKCTL_CFG))
+        return true;
+    if (a == p0 + INTMSKCLR)
+        return true;
+    u64 d = DART0_BASE;
+    if (a == d + D_STREAM_COMMAND || a == d + D_STREAM_SELECT || a == d + D_ERROR || a == d + D_ENABLED)
+        return true;
+    if (a >= d + D_TCR && a < d + D_TCR + 4 * 16 && !(a & 3))
+        return true;
+    if (a >= d + D_TTBR && a < d + D_TTBR + 16 * 16 && !(a & 3))
+        return true;
+    return false;
+}
+
+static u32 r32(struct s264w *w, u64 a)
+{
+    return IO->rd32(a);
+}
+
+static int w32(struct s264w *w, u64 a, u32 v)
+{
+    struct s264w_up *up = &w->up;
+    const struct s264w_facts *f = &w->f;
+    bool cmd = a == ecam_addr(f->ecam, 1, 0, 0, 0x04) || a == ecam_addr(f->ecam, 0, 0, 0, 0x04);
+    if (cmd && (v & CMD_BME) && !up->bme_ok)
+        return X_REF;
+    if (in_allowlist(w, a)) {
+        IO->wr32(a, v);
+        return X_OK;
+    }
+    for (u32 i = 0; i < up->n_late; i++)
+        if (up->late[i] == a) {
+            IO->wr32(a, v);
+            return X_OK;
+        }
+    for (u32 i = 0; i < up->n_ranges; i++)
+        if (up->r_base[i] <= a && a + 4 <= up->r_base[i] + up->r_size[i]) {
+            IO->wr32(a, v);
+            return X_OK;
+        }
+    return X_REF_BAR;
+}
+
+/* GuardedMmio.rmw (P:222-226): read, write, read again */
+static int rmw(struct s264w *w, u64 a, u32 clr, u32 set)
+{
+    u32 old = r32(w, a);
+    int r = w32(w, a, (old & ~clr) | set);
+    if (r)
+        return r;
+    r32(w, a);
+    return X_OK;
+}
+
+/* WifiProbe.poll (P:356-365) */
+static bool poll(struct s264w *w, u64 a, u32 mask, u32 want, u32 timeout_ms, u32 *out)
+{
+    u64 end = IO->now_us() + (u64)timeout_ms * 1000;
+    for (;;) {
+        u32 v = r32(w, a);
+        if ((v & mask) == want) {
+            if (out)
+                *out = v;
+            return true;
+        }
+        if (IO->now_us() >= end) {
+            if (out)
+                *out = v;
+            return false;
+        }
+        IO->sleep_us(100);
+    }
+}
+
+static u64 ecfg(struct s264w *w, u32 off)
+{
+    return ecam_addr(w->f.ecam, 1, 0, 0, off);
+}
+static u64 rcfg(struct s264w *w, u32 off)
+{
+    return ecam_addr(w->f.ecam, 0, 0, 0, off);
+}
+static u32 cfg(struct s264w *w, u32 bus, u32 dev, u32 fn, u32 off)
+{
+    return r32(w, ecam_addr(w->f.ecam, bus, dev, fn, off));
+}
+
+static void port1_snapshot(struct s264w *w, struct s264w_snap *s)
+{
+    /* P:386-394 */
+    static const u32 offs[5] = {PORT_LINKSTS, PORT_APPCLK, PORT_STATUS, PORT_REFCLK, PORT_PERST};
+    for (u32 i = 0; i < 5; i++)
+        s->v[i] = r32(w, w->f.port1 + offs[i]);
+    s->v[5] = r32(w, w->f.gpio + 4 * (u64)w->f.port1_perst_pin);
+    u32 b = g_begin(w);
+    s->v[6] = cfg(w, 0, 1, 0, 0x00);
+    s->v[7] = cfg(w, 0, 1, 0, 0x18);
+    s->exc = g_end(w, b);
+}
+static bool snap_eq(const struct s264w_snap *a, const struct s264w_snap *b)
+{
+    return !memcmp(a->v, b->v, sizeof(a->v)) && a->exc == b->exc;
+}
+
+static bool link_up(struct s264w *w)
+{
+    return r32(w, w->f.port0 + PORT_LINKSTS) & LINKSTS_UP;
+}
+
+static void new_up(struct s264w *w)
+{
+    memset(&w->up, 0, sizeof(w->up));
+}
+
+/* ---- W:263-305 _power_off.  Returns confirmed; *link_down_after set. */
+static bool power_off(struct s264w *w, const char *why, bool bme_off, bool *link_down_after)
+{
+    struct s264w_up *up = &w->up;
+    const struct s264w_facts *f = &w->f;
+    bool err = false;
+    IO->nop(); /* resync */
+    up->bme_ok = false;
+    if (bme_off) {
+        u32 b = g_begin(w);
+        int r = X_OK;
+        if (link_up(w)) {
+            r = w32(w, ecfg(w, 0x04), EP_CMD_QUIET);
+            if (!r)
+                IO->sleep_us(10000);
+        }
+        if (r) {
+            g_abort(w);
+            err = true;
+        } else {
+            g_end(w, b);
+        }
+    }
+    if (w32(w, f->gpio + 4 * (u64)f->perst_pin, PD_GPIO_PERST_ASSERTED))
+        err = true;
+    /* smc_off */
+    {
+        bool ok = true;
+        if (!up->smc_obj) {
+            up->smc_obj = true;
+            if (IO->smc_start()) {
+                ok = false;
+            } else {
+                u32 kl = 0, kt = 0;
+                if (IO->smc_key_info(SMC_KEY_GP0D, &kl, &kt) || kl != 4 ||
+                    !(kt == 0x32336975u /* "ui32" */ || kt == 0x5f786568u /* "hex_" */))
+                    ok = false;
+            }
+        }
+        if (ok && IO->smc_write32(SMC_KEY_GP0D, SMC_GPIO_OFF))
+            ok = false;
+        if (!ok)
+            err = true;
+    }
+    if (up->smc_obj) {
+        if (IO->smc_stop())
+            err = true;
+        up->smc_obj = false;
+    }
+    u32 ls = 0;
+    bool down = poll(w, f->port0 + PORT_LINKSTS, LINKSTS_UP, 0, 200, &ls);
+    *link_down_after = down;
+    int p1 = -1; /* -1 n/a, 0 changed, 1 unchanged */
+    if (up->have_p1before) {
+        struct s264w_snap after;
+        port1_snapshot(w, &after);
+        p1 = snap_eq(&after, &up->p1before);
+    }
+    bool confirmed = !err && down && p1 != 0;
+    up->n_ranges = 0;
+    WLOGF("power off (%s) confirmed=%s errors=%s port1_unchanged=%s", why, confirmed ? "True" : "False",
+          err ? "yes" : "none", p1 < 0 ? "n/a" : p1 ? "True" : "False");
+    return confirmed;
+}
+
+int s264w_boot_force_off(struct s264w *w)
+{
+    /* W:308-335 */
+    new_up(w);
+    const struct s264w_facts *f = &w->f;
+    u32 b = g_begin(w);
+    u32 st = r32(w, f->port0 + PORT_STATUS);
+    u32 perst = r32(w, f->port0 + PORT_PERST);
+    u32 ls = r32(w, f->port0 + PORT_LINKSTS);
+    u32 id = cfg(w, 0, 0, 0, 0x00);
+    u32 bus = cfg(w, 0, 0, 0, 0x18);
+    u32 exc = g_end(w, b);
+    port1_snapshot(w, &w->up.p1before);
+    w->up.have_p1before = true;
+    WLOGF("BOOT port0 port_status=0x%x port_perst=0x%x linksts=0x%x rp0_id=0x%x rp0_bus=0x%x exc=0x%x", st,
+          perst, ls, id, bus, exc);
+    if (!(perst & PERST_OFF))
+        wlog(w, "BOOT note: port 0 PORT_PERST_OFF clear (pcie_init not run?) - dart-apcie0 not reachable");
+    bool down = false;
+    bool ok = power_off(w, "boot force-off", false, &down);
+    if (!ok) {
+        wlog(w, down ? "BOOT STOP force-off not confirmed (chip power state unknown)"
+                     : "BOOT STOP port 0 link still up after power off (UEFI would enumerate Wi-Fi)");
+        return down ? 2 : 1;
+    }
+    w->state = w->enabled ? ST_OFF : ST_FAILED;
+    WLOGF("BOOT force-off confirmed; Wi-Fi %s; control page 0x348000000+0x4000",
+          w->enabled ? "armed" : "DISABLED (NWOAS_WIFI=0)");
+    return 0;
+}
