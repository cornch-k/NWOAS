--- a/src/nwoas_s264_audio.h	1970-01-01 09:00:00
+++ b/src/nwoas_s264_audio.h	2026-11-20 00:45:46
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * NWOAS S264D: sound-s256/audio_module.py stage B (power, MCA, DART-sio stream 2, ADMAC TX ch0,
+ * NCO, amp) + stage S (V/I sense path) + final header, in C.
+ *
+ * This is a register-level transliteration of the Python module and of the proxyclient drivers it
+ * uses (m1n1/hw/i2c.py, admac.py, mca.py, nco.py, dart.py + dart8020.py, pmgr.py): every MMIO read
+ * and write is issued in the same order with the same values, including the reads Python only does
+ * for its log lines and the read-modify-write of Register.set().  All hardware access goes through
+ * struct s264_audio_io, so the same file runs in the hypervisor (real MMIO) and on the build host
+ * (nwoas_scripts/standalone-s264/s264d_audio_test.py drives it with ctypes against the same register
+ * model the real Python module runs on, and compares the two traces).
+ * HARDWARE-UNVERIFIED.
+ */
+#ifndef NWOAS_S264_AUDIO_H
+#define NWOAS_S264_AUDIO_H
+
+#include "nwoas_s264_plan.h"
+
+struct s264_audio_io {
+    u32 (*rd32)(u64 addr);
+    void (*wr32)(u64 addr, u32 val);
+    void (*sleep_us)(u32 us);                       /* time.sleep */
+    int (*clocks_enable)(const char *adt_path);     /* p.pmgr_adt_clocks_enable */
+    void (*civac)(u64 pa, u64 size);                /* p.dc_civac (not "dc_civac": utils.h macro) */
+    void (*mem_write)(u64 pa, const void *src, u32 len); /* iface.writemem */
+    void (*mem_read)(u64 pa, void *dst, u32 len);   /* iface.readmem */
+    void (*log)(const char *msg);
+    /* Pacing, not in the Python trace (deliberate deviation): under the proxy every access was one
+     * USB round trip (~0.1 ms); in C they run back to back.  pace_us(S264_AUDIO_PACE_US) follows
+     * every MMIO write, pace_us(S264_AUDIO_POLL_US) every poll retry (I2C XEN / RX FIFO, DART
+     * BUSY), so the Python retry counts (10000) become >= 100 ms bounds as in m1n1 src/i2c.c
+     * (udelay(10) per retry), and pulse pairs (PMGR reset, SYNCGEN RST, ADMAC ring reset) get a
+     * gap like pmgr.c pmgr_reset_device (udelay(10)). */
+    void (*pace_us)(u32 us);
+};
+#define S264_AUDIO_PACE_US 20
+#define S264_AUDIO_POLL_US 10
+
+/* Everything stage B takes from the ADT (filled by s264_audio_ctx_from_adt, pure). */
+struct s264_audio_ctx {
+    u64 i2c1, admac, mca0, switch1, clk_base, clk_size, dart, gpio, pmgr0, nco;
+    u32 nco_fin, admac_nchans;
+    u64 buf, pt;          /* window buffer PA; 2 x 16 KiB page-table area (L1, L2) */
+    u32 prot_gain, prot_vol_floor;
+    u32 err;              /* 0, or the S264_AE_* reason the ADT/contract check failed */
+};
+
+#define S264_AE_RES    1 /* a contract resource (S256_RES) differs from the ADT */
+#define S264_AE_GPIO   2 /* /arm-io/gpio base does not give GPIO181 */
+#define S264_AE_NODE   3 /* a node the stage needs is missing */
+#define S264_AE_DART   4 /* dart-sio is not dart,t8020 */
+#define S264_AE_NCO    5 /* NCO input clock not found */
+#define S264_AE_ADMAC  6 /* fewer than 4 ADMAC channels */
+
+/* s264_audio_run() result bit: the header read back differently (Python raises: launch stops) */
+#define S264_AUDIO_HDR_BAD 0x80000000u
+
+int s264_audio_ctx_from_adt(const u8 *adt, u32 len, u64 buf, u64 pt, struct s264_audio_ctx *ctx);
+
+/* Stage B + S + final header.  Returns the header status (bit0 = ready, bit1 = sense). */
+u32 s264_audio_run(const struct s264_audio_io *io, const struct s264_audio_ctx *ctx);
+
+/* audio_module.py _s256_header(status) (0x4c bytes) */
+void s264_audio_header(u8 *h, u32 status, u32 prot_gain, u32 prot_vol_floor);
+
+#endif
