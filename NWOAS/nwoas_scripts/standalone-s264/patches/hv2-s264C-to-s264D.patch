+/* ---- W:390-492 _bring_up */
+static int bring_up(struct s264w *w)
+{
+    struct s264w_up *up = &w->up;
+    const struct s264w_facts *f = &w->f;
+    int r;
+    u32 b = g_begin(w);
+    u32 rp_id = cfg(w, 0, 0, 0, 0x00), rp_hdr = cfg(w, 0, 0, 0, 0x0c);
+    u32 exc = g_end(w, b);
+    if (exc || (rp_id & 0xffff) != APPLE_VENDOR || ((rp_hdr >> 16) & 0x7f) != 1)
+        FAIL(E_RP0_BAD);
+    u32 st = r32(w, f->port0 + PORT_STATUS), pe = r32(w, f->port0 + PORT_PERST);
+    u32 link0 = r32(w, f->port0 + PORT_LINKSTS);
+    if (!(st & STATUS_READY))
+        FAIL(E_PORT_NOT_READY);
+    if (!(pe & PERST_OFF))
+        FAIL(E_DART0_OFFLINE);
+    port1_snapshot(w, &up->p1before);
+    up->have_p1before = true;
+    if (link0 & LINKSTS_UP)
+        FAIL(E_LINK_ALREADY_UP);
+    /* smc-on */
+    if ((r = perst(w, true)))
+        return r;
+    up->smc_obj = true;
+    u32 kl = 0, kt = 0;
+    if (IO->smc_start() || IO->smc_key_info(SMC_KEY_GP0D, &kl, &kt))
+        FAIL(E_SMC_ERROR);
+    if (kl != 4 || !(kt == 0x32336975u || kt == 0x5f786568u))
+        FAIL(E_SMC_KEY);
+    up->smc_on_attempted = true;
+    if (IO->smc_write32(SMC_KEY_GP0D, SMC_GPIO_ON))
+        return X_RT; /* SMCError: an ordinary exception -> ERROR */
+    IO->sleep_us(100 * 1000); /* power_settle_ms 100 */
+    if ((r = bring_up_port0(w)))
+        return r;
+    u32 ls = 0;
+    bool ok = poll(w, f->port0 + PORT_LINKSTS, LINKSTS_UP, LINKSTS_UP, 1000, &ls);
+    w->linksts = ls;
+    if (!ok)
+        FAIL(E_LINK_DOWN);
+    bool pass = false;
+    if ((r = read_endpoint(w, &pass)))
+        return r;
+    if (!pass)
+        FAIL(E_NO_DEVICE);
+    w->ids = up->fn0_id;
+    if ((r = setup_bars(w)))
+        return r;
+    /* chip id (checked): _bp(CHIP_BASE + CC_CHIPID) */
+    b = g_begin(w);
+    u32 page = CHIP_BASE & ~(BAR0_WINDOW_SIZE - 1u);
+    r = w32(w, ecfg(w, BAR0_WINDOW_CFG), page);
+    if (!r && r32(w, ecfg(w, BAR0_WINDOW_CFG)) != page)
+        r = w32(w, ecfg(w, BAR0_WINDOW_CFG), page);
+    if (r) {
+        g_abort(w);
+        return r;
+    }
+    up->cur_page = page;
+    up->cur_page_valid = true;
+    u32 cid = r32(w, up->bar0_cpu + (CHIP_BASE & (BAR0_WINDOW_SIZE - 1u)));
+    if (g_end(w, b))
+        return X_RT;
+    w->chipid = cid;
+    if ((cid & 0xffff) != BRCM_CC_4378 || ((cid >> 28) & 0xf) != 1)
+        FAIL(E_CHIP_ID);
+    /* DevCtl */
+    u32 cap = up->fn0_cap;
+    if (!(0x40 <= cap && cap <= 0xf0))
+        FAIL(E_DEVCTL);
+    w->devctl_off = cap + 8;
+    u64 dc = ecfg(w, w->devctl_off);
+    if (up->n_late < 4)
+        up->late[up->n_late++] = dc;
+    b = g_begin(w);
+    u32 old = r32(w, dc) & 0xffff;
+    if ((r = w32(w, dc, old & ~DEVCTL_NS_RO))) {
+        g_abort(w);
+        return r;
+    }
+    u32 nw = r32(w, dc) & 0xffff;
+    if (g_end(w, b))
+        return X_RT;
+    w->devctl = nw;
+    if (nw & DEVCTL_NS_RO)
+        FAIL(E_DEVCTL);
+    /* INTx */
+    u32 msk = r32(w, f->port0 + INTMSK);
+    if ((msk & INTX_BITS) && (r = w32(w, f->port0 + INTMSKCLR, INTX_BITS)))
+        return r;
+    u32 msk2 = r32(w, f->port0 + INTMSK);
+    if (msk2 & INTX_BITS)
+        FAIL(E_INTX_MASK);
+    if ((r = dart_check(w)))
+        return r;
+    /* bus master */
+    up->bme_ok = true;
+    b = g_begin(w);
+    u32 rp_cmd = (up->saved_rp04 & 0xffff) | CMD_MEM | CMD_BME;
+    if ((r = w32(w, rcfg(w, 0x04), rp_cmd)) || (r = w32(w, ecfg(w, 0x04), EP_CMD_UP))) {
+        g_abort(w);
+        return r;
+    }
+    u32 rb0 = r32(w, rcfg(w, 0x04)) & 0xffff, rb1 = r32(w, ecfg(w, 0x04)) & 0xffff;
+    if (g_end(w, b))
+        return X_RT;
+    w->epcmd = rb1;
+    if ((rb0 & 0x6) != 0x6 || (rb1 & 0x406) != 0x6)
+        FAIL(E_BUS_MASTER);
+    if (IO->smc_stop())
+        return X_RT;
+    up->smc_obj = false;
+    struct s264w_snap after;
+    port1_snapshot(w, &after);
+    if (!snap_eq(&after, &up->p1before))
+        FAIL(E_PORT1_CHANGED);
+    return X_OK;
+}
+
+static void fail_cleanup(struct s264w *w)
+{
+    w->state = ST_FAILED;
+    WLOGF("FAIL error %u", w->error);
+    bool down;
+    power_off(w, "bring-up failed", true, &down);
+    w->have_up = false;
+}
+
+static void power_up(struct s264w *w)
+{
+    /* W:338-379 */
+    if (!w->enabled)
+        return;
+    if (w->state == ST_UP && w->have_up) {
+        u32 b = g_begin(w);
+        bool ok = link_up(w) && (r32(w, ecfg(w, 0x10)) & ~0xfu) == BAR0_BUS;
+        u32 exc = g_end(w, b);
+        if (ok && !exc) {
+            wlog(w, "power up: already up (no change)");
+            return;
+        }
+        wlog(w, "power up: link/BAR lost while UP -> full power cycle");
+        bool down;
+        power_off(w, "lost link", true, &down);
+        w->have_up = false;
+    }
+    new_up(w);
+    u64 t0 = IO->now_us();
+    int r = bring_up(w);
+    if (r == X_OK) {
+        w->have_up = true;
+        w->state = ST_UP;
+        w->error = 0;
+        if (!w->first_up_done)
+            w->avail = 1;
+    } else {
+        w->error = r == X_FAIL ? w_fail : r == X_REF_BAR ? E_BAR_SETUP : E_ERROR;
+        fail_cleanup(w);
+    }
+    w->first_up_done = true;
+    u64 dt = IO->now_us() - t0;
+    if (w->state == ST_UP)
+        WLOGF("READY ids=0x%x chip=0x%x bar0=0x6e0800000 bar2=0x6e0000000 devctl=0x%x epcmd=0x%x "
+              "dart_check=%u irq=695 t=%lu.%03lus",
+              w->ids, w->chipid, w->devctl, w->epcmd, w->dart_check, (unsigned long)(dt / 1000000),
+              (unsigned long)(dt / 1000 % 1000));
+    else
+        WLOGF("FAIL power up error=%u t=%lu.%03lus", w->error, (unsigned long)(dt / 1000000),
+              (unsigned long)(dt / 1000 % 1000));
+}
+
+static void power_down(struct s264w *w)
+{
+    /* W:538-550 */
+    if (w->state != ST_UP || !w->have_up) {
+        WLOGF("power down (CMD_POWER_DOWN): state %u, nothing powered", w->state);
+        return;
+    }
+    bool down;
+    bool ok = power_off(w, "CMD_POWER_DOWN", true, &down);
+    w->have_up = false;
+    if (ok) {
+        w->state = ST_OFF_REQ;
+        w->error = 0;
+        wlog(w, "OFF (CMD_POWER_DOWN) confirmed");
+    } else {
+        w->state = ST_FAILED;
+        w->error = E_POWER_OFF_UNCONFIRMED;
+        wlog(w, "FAIL power down unconfirmed");
+    }
+}
+
+/* ---- control page (W:553-632) */
+static u32 cfg_read(struct s264w *w, u32 off)
+{
+    w->cfg_reads++;
+    if (w->state != ST_UP || !w->have_up) {
+        w->cfg_err = CFG_NOT_UP;
+        return 0xffffffffu;
+    }
+    if ((off & 3) || off >= 0x1000) {
+        w->cfg_err = CFG_BAD_OFFSET;
+        return 0xffffffffu;
+    }
+    u32 b = g_begin(w);
+    u32 v = r32(w, ecfg(w, off));
+    u32 exc = g_end(w, b);
+    w->cfg_err = exc ? CFG_EXCEPTION : CFG_OK;
+    return exc ? 0xffffffffu : v;
+}
+
+/* W:83-95 */
+static bool cfg_policy(u32 off, u32 val, u32 cur, u32 devctl_off, u32 *out)
+{
+    if (off == BAR0_WINDOW_CFG) {
+        if (val & 0xfff)
+            return false;
+        *out = val & 0xfffff000u;
+        return true;
+    }
+    if (off == 0x04) {
+        *out = (val & (CMD_BME | CMD_INTX_DIS)) | CMD_MEM;
+        return true;
+    }
+    if (devctl_off && off == devctl_off) {
+        *out = val & 0xffff & ~DEVCTL_NS_RO;
+        return true;
+    }
+    if (off == EP_LINKCTL_CFG) {
+        *out = (cur & 0xffff & ~ASPM_MASK) | (val & ASPM_MASK);
+        return true;
+    }
+    return false;
+}
+
+/* returns false when Python would raise out of reg_write (hook_write -> STATE_FAILED / ERROR) */
+static bool cfg_write(struct s264w *w, u32 off, u32 val)
+{
+    w->cfg_writes++;
+    if (w->state != ST_UP || !w->have_up) {
+        w->cfg_err = CFG_NOT_UP;
+        return true;
+    }
+    if ((off & 3) || off >= 0x1000) {
+        w->cfg_err = CFG_BAD_OFFSET;
+        return true;
+    }
+    u32 cur = 0;
+    if (off == EP_LINKCTL_CFG) {
+        u32 b = g_begin(w);
+        cur = r32(w, ecfg(w, off));
+        g_end(w, b);
+    }
+    u32 v;
+    if (!cfg_policy(off, val, cur, w->devctl_off, &v)) {
+        w->cfg_refused++;
+        w->cfg_err = CFG_NOT_ALLOWED;
+        if (w->cfg_refused <= 16)
+            WLOGF("config write refused off=0x%x val=0x%x", off, val);
+        return true;
+    }
+    u32 b = g_begin(w);
+    if (w32(w, ecfg(w, off), v)) {
+        g_abort(w);
+        return false;
+    }
+    u32 exc = g_end(w, b);
+    if (off == 0x04)
+        w->epcmd = v & 0xffff;
+    if (off == w->devctl_off)
+        w->devctl = v & 0xffff;
+    w->cfg_err = exc ? CFG_EXCEPTION : CFG_OK;
+    if (w->cfg_writes <= 16 || off != BAR0_WINDOW_CFG)
+        WLOGF("config write off=0x%x val=0x%x -> 0x%x err=%u", off, val, v, w->cfg_err);
+    return true;
+}
+
+u32 s264w_reg_read(struct s264w *w, u32 off)
+{
+    struct s264_wifi_page *pg = w->pg;
+    if (off == R_CFG_DATA)
+        return cfg_read(w, w->cfg_off);
+    if (off == R_BAR0WIN)
+        return cfg_read(w, BAR0_WINDOW_CFG);
+    if (off == R_MAC_LO)
+        return pg->mac_lo;
+    if (off == R_MAC_HI)
+        return pg->mac_hi;
+    if (off == R_CAL_LEN)
+        return pg->cal_len;
+    if (off == R_ANTENNA)
+        return pg->antenna;
+    if (off >= R_BOARD && off < R_BOARD + 16 && !(off & 3))
+        return pg->board[(off - R_BOARD) / 4];
+    if (off >= CAL_OFF && off < CAL_OFF + ((pg->cal_len + 3) & ~3u) && !(off & 3))
+        return pg->cal[(off - CAL_OFF) / 4];
+    bool up = w->state == ST_UP;
+    switch (off) {
+        case R_MAGIC:
+            return MAGIC;
+        case R_VERSION:
+            return 1;
+        case R_STATE:
+            return w->state;
+        case R_ERROR:
+            return w->error;
+        case R_CMD:
+            return w->last_cmd;
+        case R_SEQ:
+            return w->seq;
+        case R_AVAIL:
+            return w->avail;
+        case R_IDS:
+            return w->ids;
+        case R_CFG_OFF:
+            return w->cfg_off;
+        case R_CFG_ERR:
+            return w->cfg_err;
+        case R_BAR0:
+            return up ? BAR0_BUS : 0;
+        case R_BAR2:
+            return up ? BAR2_BUS : 0;
+        case R_LINKSTS:
+            return w->linksts;
+        case R_DEVCTL:
+            return w->devctl;
+        case R_EPCMD:
+            return w->epcmd;
+        case R_DART_TTBR:
+            return w->dart_ttbr;
+        case R_DART_CHECK:
+            return w->dart_check;
+        case R_CHIPID:
+            return w->chipid;
+        case R_CMD_COUNT:
+            return w->cmd_count;
+        default:
+            return 0;
+    }
+}
+
+/* false = Python raised out of reg_write */
+static bool reg_write(struct s264w *w, u32 off, u32 val)
+{
+    if (off == R_CMD) {
+        w->last_cmd = val;
+        w->cmd_count++;
+        WLOGF("CMD 0x%x (state %u)", val, w->state);
+        if (val == CMD_POWER_UP)
+            power_up(w);
+        else if (val == CMD_POWER_DOWN)
+            power_down(w);
+        else
+            WLOGF("CMD 0x%x ignored (unknown)", val);
+        w->seq++;
+    } else if (off == R_CFG_OFF) {
+        w->cfg_off = val & 0xfff;
+        w->cfg_err = (val == w->cfg_off && !(val & 3)) ? CFG_OK : CFG_BAD_OFFSET;
+    } else if (off == R_CFG_DATA) {
+        return cfg_write(w, w->cfg_off, val);
+    } else if (off == R_BAR0WIN) {
+        return cfg_write(w, BAR0_WINDOW_CFG, val);
+    } else {
+        WLOGF("write 0x%x = 0x%x ignored (read-only)", off, val);
+    }
+    return true;
+}
+
+void s264w_reg_write(struct s264w *w, u32 off, u32 val)
+{
+    if (!reg_write(w, off, val)) {
+        w->state = ST_FAILED; /* W:660-662 hook_write except */
+        w->error = E_ERROR;
+    }
+}
+
+u64 s264w_hook_read(struct s264w *w, u32 off, int width)
+{
+    /* W:636-646 (Python width in bits = 8 << width) */
+    u32 base = off & ~3u;
+    if (width == 3)
+        return (u64)s264w_reg_read(w, base) | ((u64)s264w_reg_read(w, base + 4) << 32);
+    u64 v = s264w_reg_read(w, base) >> (8 * (off & 3));
+    return v & ((1ULL << (8 << width)) - 1);
+}
+
+void s264w_hook_write(struct s264w *w, u32 off, u64 val, int width)
+{
+    /* W:648-662 */
+    if (width == 2 && !(off & 3)) {
+        s264w_reg_write(w, off, (u32)val);
+    } else if (width == 3 && !(off & 7)) {
+        if (!reg_write(w, off, (u32)val)) {
+            w->state = ST_FAILED;
+            w->error = E_ERROR;
+            return; /* the exception skips the second half */
+        }
+        s264w_reg_write(w, off + 4, (u32)(val >> 32));
+    } else {
+        WLOGF("write 0x%x/%d ignored (32-bit aligned only)", off, 8 << width);
+    }
+}
+
+void s264w_init(struct s264w *w, const struct s264w_io *io, const struct s264w_facts *f,
+                struct s264_wifi_page *pg, bool enabled)
+{
+    memset(w, 0, sizeof(*w));
+    w->io = io;
+    w->f = *f;
+    w->pg = pg;
+    w->enabled = enabled;
+    w->state = ST_OFF;
+    if (!enabled) {
+        w->state = ST_FAILED;
+        w->error = E_DISABLED;
+    }
+}
+
+#ifdef S264_HOST
+unsigned long s264w_sizeof(void)
+{
+    return sizeof(struct s264w);
+}
+unsigned long s264w_page_sizeof(void)
+{
+    return sizeof(struct s264_wifi_page);
+}
+#endif
diff -ruN a/src/nwoas_s264_wifi.h b/src/nwoas_s264_wifi.h
--- a/src/nwoas_s264_wifi.h	1970-01-01 09:00:00
+++ b/src/nwoas_s264_wifi.h	2026-11-20 00:45:46
@@ -0,0 +1,122 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * NWOAS S264D: the hypervisor side of the S259 Wi-Fi (BCM4378 on apcie port 0) in C.
+ *
+ * Transliteration of what the MacBook did for NWOAS_WIFI=1 (all read only, not edited):
+ *   nwoas_scripts/wifi-s259/wifi_module.py       launcher checks + boot_force_off + control page
+ *   nwoas_scripts/wifi-s259/nwoas_wifi_s259.py   WifiS259 (power up/down inside the trapped write,
+ *                                                 config window, control page registers)
+ *   nwoas_scripts/wifi-s257/wifi_up.py           WifiUp/RangeMmio helpers used by WifiS259
+ *   nwoas_scripts/wifi-s240/wifi_probe.py        adt_facts/validate_facts/allowlist, port-0
+ *                                                 PERST#/REFCLK/LTSSM, config read, BAR sizing
+ *   nwoas_scripts/wifi-s257/wifi_scan.py         dart_info, Dart snapshot/invalidate
+ * Every MMIO read/write, exception-guard call, SMC call and sleep is issued in the Python order
+ * (host test nwoas_scripts/standalone-s264/s264d_wifi_test.py runs both on the S240/S257 fake
+ * hardware and compares).  Hardware access goes through struct s264w_io.  HARDWARE-UNVERIFIED.
+ */
+#ifndef NWOAS_S264_WIFI_H
+#define NWOAS_S264_WIFI_H
+
+#include "nwoas_s264_plan.h"
+
+/* ---- wifi_probe.adt_facts + wifi_scan.dart_info + dart-apcie1 (pure, plan time) */
+struct s264w_facts {
+    u64 ecam, rc, port0, port0_phy, port1, gpio, smc;
+    u32 gpio_phandle, perst_phandle, perst_pin, perst_polarity, port1_perst_phandle, port1_perst_pin;
+    u32 perst_to_config_ms, t_refclk_to_perst_us;
+    u32 j274, wlan_bcm4378;
+    u64 dart0_base, dart1_base;
+    u32 dart0_phandle, bridge0_dart_phandle, bridge0_dart_ok;
+};
+
+/* refusal reasons (plan error S264_E_WLAN, err_arg) */
+#define S264W_R_LOOKUP  21 /* adt_facts: a node/property is missing */
+#define S264W_R_TARGET  22 /* compatible has no j274 */
+#define S264W_R_EXPECT  23 /* an address/pin differs from the recorded J274 value (+ index << 8) */
+#define S264W_R_PHANDLE 24 /* function-perst does not point at /arm-io/gpio */
+#define S264W_R_WLAN    25 /* pci-bridge0/wlan is not bcm4378 */
+#define S264W_R_TIMING  26 /* ADT reset timing out of range */
+#define S264W_R_DART0   27 /* dart-apcie0 base / function-dart_self */
+#define S264W_R_DART1   28 /* dart-apcie1 base */
+
+int s264w_facts_from_adt(const u8 *adt, u32 len, struct s264w_facts *f);
+/* wifi_up.validate_facts (phandle number relaxed) -> wifi_probe.validate_facts, then the two DART
+ * checks of wifi_module._s259_checks.  0 = accepted, else S264W_R_* (| index << 8). */
+u32 s264w_validate(const struct s264w_facts *f);
+
+/* ---- hardware access */
+struct s264w_io {
+    u32 (*rd32)(u64 addr);
+    void (*wr32)(u64 addr, u32 val);
+    u32 (*exc_count)(void);             /* p.get_exc_count */
+    void (*set_guard)(u32 mode);        /* p.set_exc_guard */
+    void (*sleep_us)(u64 us);           /* time.sleep */
+    u64 (*now_us)(void);                /* time.monotonic */
+    void (*nop)(void);                  /* p.nop (WifiS259.resync) */
+    int (*smc_start)(void);             /* RealSmc(u, base) + start(); 0 = ok */
+    int (*smc_key_info)(u32 key, u32 *len, u32 *type4); /* type as the 4 shmem bytes, LE */
+    int (*smc_write32)(u32 key, u32 val);
+    int (*smc_stop)(void);
+    void (*log)(const char *msg);
+    /* not in the Python trace (deliberate): pause per retry of the count-bounded DART invalidate
+     * poll (wifi_scan.Dart.invalidate, 1000 reads = ~100 ms under the proxy) -> 1000 x 100 us */
+    void (*pace_us)(u32 us);
+};
+
+/* ---- WifiUp state for one bring-up (wu.WifiUp + RangeMmio) */
+struct s264w_snap {
+    u32 v[8]; /* port1 LINKSTS/APPCLK/STATUS/REFCLK/PERST, gpio port1 PERST#, rootport1 id/bus */
+    u32 exc;
+};
+struct s264w_bar {
+    u32 bar, type; /* type 1 io, 2 mem32, 3 mem64 */
+    u64 size;
+};
+struct s264w_up {
+    bool smc_obj, smc_on_attempted, port0_touched, bme_ok;
+    bool have_p1before;
+    struct s264w_snap p1before;
+    u64 late[4];
+    u32 n_late;
+    u64 r_base[2], r_size[2];
+    u32 n_ranges;
+    u32 saved_rp04;
+    u64 bar0_cpu;
+    u32 cur_page;
+    bool cur_page_valid;
+    u32 fn0_id, fn0_cap, fn1_id, n_bars, bars_ok;
+    struct s264w_bar bars[6];
+};
+
+/* ---- WifiS259 */
+struct s264w {
+    const struct s264w_io *io;
+    struct s264w_facts f;
+    struct s264_wifi_page *pg; /* wlan registers (MAC/cal/board) + counters, from the plan */
+    bool enabled, first_up_done, have_up;
+    u32 state, error, avail, seq, last_cmd, cmd_count;
+    u32 ids, chipid, linksts, devctl, epcmd, dart_ttbr, dart_check;
+    u32 cfg_off, cfg_err, cfg_reads, cfg_writes, cfg_refused;
+    u32 devctl_off;
+    u32 lines;
+    struct s264w_up up;
+    char msg[192];
+};
+
+void s264w_init(struct s264w *w, const struct s264w_io *io, const struct s264w_facts *f,
+                struct s264_wifi_page *pg, bool enabled);
+/* WifiS259.boot_force_off: 0 = confirmed; 1 = link still up, 2 = not confirmed (Python raises:
+ * the launcher stops before the guest starts). */
+int s264w_boot_force_off(struct s264w *w);
+u32 s264w_reg_read(struct s264w *w, u32 off);
+void s264w_reg_write(struct s264w *w, u32 off, u32 val);
+/* hook_read / hook_write with m1n1 C hook widths (0..3 = 8..64 bit) */
+u64 s264w_hook_read(struct s264w *w, u32 off, int width);
+void s264w_hook_write(struct s264w *w, u32 off, u64 val, int width);
+
+#ifdef S264_HOST
+unsigned long s264w_sizeof(void);
+unsigned long s264w_page_sizeof(void);
+#endif
+
+#endif
diff -ruN a/src/smc.c b/src/smc.c
--- a/src/smc.c	2026-11-20 00:45:46
+++ b/src/smc.c	2026-11-20 00:45:46
@@ -220,3 +220,16 @@
     memcpy(buf, &value, size);
     return 0;
 }
+
+/* NWOAS S264D: proxyclient m1n1/fw/smc.py get_key_info: GET_KEY_INFO (TYPE 7:0, KEY 63:32), then
+ * 6 bytes from the shared buffer = length (u8), type (4 chars), flags (u8). */
+int smc_get_key_info(smc_dev_t *smc, u32 key, u8 info[6])
+{
+    u64 msg = FIELD_PREP(SMC_MSG_TYPE, SMC_GET_KEY_INFO);
+    msg |= FIELD_PREP(SMC_WRITE_KEY_KEY, key);
+    int ret = smc_cmd(smc, msg);
+    if (ret)
+        return ret;
+    memcpy(info, smc->shmem, 6);
+    return 0;
+}
diff -ruN a/src/smc.h b/src/smc.h
--- a/src/smc.h	2026-11-20 00:45:46
+++ b/src/smc.h	2026-11-20 00:45:46
@@ -11,6 +11,7 @@
 
 int smc_write_u32(smc_dev_t *smc, u32 key, u32 value);
 int smc_read_key(smc_dev_t *smc, u32 key, void *buf, u32 size); /* NWOAS S260, size <= 4 */
+int smc_get_key_info(smc_dev_t *smc, u32 key, u8 info[6]); /* NWOAS S264D: len, type[4], flags */
 void smc_set_deadline_us(u32 usec);                               /* NWOAS S260, 0 = unbounded */
 
 smc_dev_t *smc_init(void);
