+/* ---- P:630-644 _pcie_cap: returns cap offset or 0 */
+static u32 pcie_cap(struct s264w *w, u32 bus, u32 dev, u32 fn)
+{
+    u32 ptr = cfg(w, bus, dev, fn, 0x34) & 0xfc;
+    for (int i = 0; i < 48; i++) {
+        if (ptr < 0x40)
+            return 0;
+        u32 v = cfg(w, bus, dev, fn, ptr);
+        if ((v & 0xff) == 0x10) {
+            cfg(w, bus, dev, fn, ptr + 8);
+            cfg(w, bus, dev, fn, ptr + 0x10);
+            return ptr;
+        }
+        ptr = (v >> 8) & 0xfc;
+    }
+    return 0;
+}
