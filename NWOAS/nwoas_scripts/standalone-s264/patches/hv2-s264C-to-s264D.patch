+/* ---- W:494-536 _dart_check */
+struct dsnap {
+    u32 config, enabled, error, err_hi, err_lo;
+    u32 tcr[16], ttbr[16][4];
+};
+static void dart_snapshot(struct s264w *w, u64 base, struct dsnap *s)
+{
+    s->config = r32(w, base + D_CONFIG);
+    s->enabled = r32(w, base + D_ENABLED);
+    s->error = r32(w, base + D_ERROR);
+    s->err_hi = r32(w, base + D_ERROR_ADDR_HI);
+    s->err_lo = r32(w, base + D_ERROR_ADDR_LO);
+    for (u32 i = 0; i < 16; i++)
+        s->tcr[i] = r32(w, base + D_TCR + 4 * i);
+    for (u32 i = 0; i < 16; i++)
+        for (u32 j = 0; j < 4; j++)
+            s->ttbr[i][j] = r32(w, base + D_TTBR + 16 * i + 4 * j);
+}
+static bool dsame(const struct dsnap *a, const struct dsnap *b)
+{
+    for (u32 s = 0; s < 16; s++)
+        if (a->ttbr[s][0] != b->ttbr[s][0] || a->tcr[s] != b->tcr[s])
+            return false;
+    return a->enabled == b->enabled;
+}
+static int dart_check(struct s264w *w)
+{
+    static struct dsnap s0, s1, s0b;
+    u32 b = g_begin(w);
+    dart_snapshot(w, DART0_BASE, &s0);
+    dart_snapshot(w, DART1_BASE, &s1);
+    if (g_end(w, b))
+        return X_RT;
+    u32 ttbr = s1.ttbr[0][0];
+    bool good1 = (ttbr & D_TTBR_VALID) && s1.enabled == 0xffff;
+    for (u32 s = 0; s < 16; s++)
+        good1 = good1 && s1.ttbr[s][0] == ttbr && (s1.tcr[s] & D_TCR_TRANSLATE) && !(s1.tcr[s] & D_TCR_BYPASS);
+    if (!good1)
+        FAIL(E_DART_MISMATCH);
+    if (s0.config & D_CONFIG_LOCK)
+        FAIL(E_DART_MISMATCH);
+    w->dart_ttbr = ttbr;
+    if (dsame(&s0, &s1)) {
+        w->dart_check = 1;
+        return X_OK;
+    }
+    b = g_begin(w);
+    int r = X_OK;
+    for (u32 s = 0; s < 16 && !r; s++)
+        r = w32(w, DART0_BASE + D_TCR + 4 * s, 0);
+    for (u32 s = 0; s < 16 && !r; s++)
+        for (u32 j = 0; j < 4 && !r; j++)
+            r = w32(w, DART0_BASE + D_TTBR + 16 * s + 4 * j, s1.ttbr[s][j]);
+    if (!r)
+        r = w32(w, DART0_BASE + D_ENABLED, s1.enabled);
+    for (u32 s = 0; s < 16 && !r; s++)
+        r = w32(w, DART0_BASE + D_TCR + 4 * s, s1.tcr[s]);
+    if (!r)
+        r = w32(w, DART0_BASE + D_STREAM_SELECT, 0xffff);
+    if (!r)
+        r = w32(w, DART0_BASE + D_STREAM_COMMAND, D_CMD_INVALIDATE);
+    if (!r) { /* S:476-481 invalidate */
+        bool idle = false;
+        for (u32 i = 0; i < INVALIDATE_POLLS && !idle; i++) {
+            idle = !(r32(w, DART0_BASE + D_STREAM_COMMAND) & D_CMD_BUSY);
+            if (!idle)
+                IO->pace_us(100);
+        }
+        if (!idle)
+            r = X_RT;
+    }
+    if (r) {
+        g_abort(w);
+        return r;
+    }
+    dart_snapshot(w, DART0_BASE, &s0b);
+    if (g_end(w, b))
+        return X_RT;
+    if (!dsame(&s0b, &s1))
+        FAIL(E_DART_MISMATCH);
+    w->dart_check = 2;
+    return X_OK;
+}
