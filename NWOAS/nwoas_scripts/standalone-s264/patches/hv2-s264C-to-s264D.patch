+
+/* a NUL-separated string list contains `needle` (case-insensitive when ci) as a substring of one entry */
+static bool w_strlist_has(const u8 *p, u32 l, const char *needle, bool ci)
+{
+    u32 nl = (u32)strlen(needle);
+    u32 i = 0;
+    while (i < l) {
+        u32 e = i;
+        while (e < l && p[e])
+            e++;
+        for (u32 s = i; s + nl <= e; s++) {
+            u32 k = 0;
+            for (; k < nl; k++) {
+                u8 c = p[s + k];
+                if (ci && c >= 'A' && c <= 'Z')
+                    c = (u8)(c + 32);
+                if (c != (u8)needle[k])
+                    break;
+            }
+            if (k == nl)
+                return true;
+        }
+        i = e + 1;
+    }
+    return false;
