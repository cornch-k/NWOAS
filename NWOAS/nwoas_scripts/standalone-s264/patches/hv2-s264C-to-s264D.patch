+/* ---- P:525-561 _read_endpoint: X_OK and *pass = PASS_IDS */
+static int read_endpoint(struct s264w *w, bool *pass)
+{
+    const struct s264w_facts *f = &w->f;
+    u64 port = f->port0;
+    int r;
+    *pass = false;
+    if ((r = rmw(w, port + PORT_REFCLK, REFCLK_CGDIS, 0)) || (r = rmw(w, port + PORT_APPCLK, APPCLK_CGDIS, 0)))
+        return r;
+    u64 bus_addr = ecam_addr(f->ecam, 0, 0, 0, 0x18);
+    u32 b = g_begin(w);
+    u32 orig = r32(w, bus_addr);
+    u32 want = (orig & 0xff000000u) | (1u << 16) | (1u << 8);
+    if (orig != want && (r = w32(w, bus_addr, want))) {
+        g_abort(w);
+        return r;
+    }
+    pcie_cap(w, 0, 0, 0);
+    if (g_end(w, b))
+        return X_RT;
+    u64 end = IO->now_us() + 1000 * 1000ULL; /* config_retry_ms 1000 */
+    for (;;) {
+        u32 gb = g_begin(w);
+        u32 id0 = cfg(w, 1, 0, 0, 0x00);
+        u32 exc = g_end(w, gb);
+        if (!exc && id0 != 0xffffffffu && id0 != 0 && (id0 & 0xffff) != 0x0001)
+            break;
+        if (IO->now_us() >= end)
+            return X_OK; /* NO_CONFIG_RESPONSE */
+        IO->sleep_us(10000);
+    }
+    u32 id1 = 0, cap1 = 0;
+    if ((r = read_function(w, 0, &w->up.fn0_id, &w->up.fn0_cap)) || (r = read_function(w, 1, &id1, &cap1)))
+        return r;
+    w->up.fn1_id = id1;
+    *pass = w->up.fn0_id == WIFI_ID && id1 == BT_ID;
+    return X_OK;
+}
