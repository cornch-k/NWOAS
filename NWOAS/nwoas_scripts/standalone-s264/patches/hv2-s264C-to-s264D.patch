+/* s264D: the IPA is identity-mapped by the last MAP op that covers it, and no HOOK covers it
+ * (= hv.mmio_maps.lookup(ipa) == {"HW"} in the Python launcher). */
+static bool ipa_is_plain_hw(const struct s264_plan *pl, u64 ipa)
+{
+    for (u32 k = 0; k < pl->n_ops; k++) {
+        const struct s264_op *o = &pl->ops[k];
+        if (o->kind == S264_OP_HOOK && o->a <= ipa && ipa < o->a + o->c)
+            return false;
+    }
+    for (u32 k = pl->n_ops; k-- > 0;) {
+        const struct s264_op *o = &pl->ops[k];
+        if (o->kind != S264_OP_MAP || !(o->a <= ipa && ipa < o->a + o->c))
+            continue;
+        if (!(o->b & PTE_VALID) || o->d != 1)
+            return false;
+        return (o->b & 0x0000fffffffff000ULL) + (ipa - o->a) == ipa;
+    }
+    return false;
+}
