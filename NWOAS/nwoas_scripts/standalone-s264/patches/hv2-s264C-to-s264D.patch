+/* ---- W:98-170 setup_bars_post_uefi */
+static int setup_bars(struct s264w *w)
+{
+    struct s264w_up *up = &w->up;
+    u64 s0 = 0, s2 = 0;
+    u32 t0 = 0, t2 = 0;
+    bool h0 = false, h2 = false;
+    for (u32 i = 0; i < up->n_bars; i++) {
+        if (up->bars[i].bar == 0)
+            s0 = up->bars[i].size, t0 = up->bars[i].type, h0 = true;
+        if (up->bars[i].bar == 2)
+            s2 = up->bars[i].size, t2 = up->bars[i].type, h2 = true;
+    }
+    if (!up->bars_ok || !h0 || !h2)
+        FAIL(E_BAR_SETUP);
+    if ((s0 & (s0 - 1)) || t0 != 3 || (s2 & (s2 - 1)) || t2 != 3)
+        FAIL(E_BAR_SETUP);
+    if (!s0 || !s2)
+        return X_RT; /* align_up(.., 0): ZeroDivisionError -> ERROR */
+    u64 bar2_bus = align_up(BAR_BASE, s2);
+    u64 bar0_bus = align_up(bar2_bus + s2, s0);
+    u64 win_lo = bar2_bus & ~0xfffffULL, win_hi = align_up(bar0_bus + s0, 0x100000) - 1;
+    if (bar0_bus != BAR0_BUS || bar2_bus != BAR2_BUS || s0 != BAR0_SIZE || s2 != BAR2_SIZE ||
+        win_lo != WIN_LO || win_hi != WIN_HI)
+        FAIL(E_BAR_LAYOUT);
+    up->bar0_cpu = bar0_bus + CPU_OFFSET;
+    /* config save (checked) */
+    static const u32 rpo[6] = {0x04, 0x18, 0x20, 0x24, 0x28, 0x2c};
+    static const u32 epo[6] = {0x04, 0x10, 0x14, 0x18, 0x1c, BAR0_WINDOW_CFG};
+    u32 rps[6], eps[6];
+    u32 b = g_begin(w);
+    for (u32 i = 0; i < 6; i++)
+        rps[i] = r32(w, rcfg(w, rpo[i]));
+    for (u32 i = 0; i < 6; i++)
+        eps[i] = r32(w, ecfg(w, epo[i]));
+    if (g_end(w, b))
+        return X_RT;
+    if ((eps[0] & 0x7) || (eps[1] & ~0xfu) || eps[2] || (eps[3] & ~0xfu) || eps[4])
+        FAIL(E_BAR_SETUP);
+    if ((rps[1] & 0xffff00) != 0x010100)
+        FAIL(E_BAR_SETUP);
+    up->saved_rp04 = rps[0];
+    u32 rp_cmd = ((rps[0] & 0xffff) & ~CMD_BME) | CMD_MEM;
+    u32 ep_cmd = CMD_MEM | CMD_INTX_DIS;
+    u32 mem_window = ((((u32)(win_hi >> 16)) & 0xfff0) << 16) | (((u32)(win_lo >> 16)) & 0xfff0);
+    b = g_begin(w);
+    int r;
+    if ((r = w32(w, rcfg(w, 0x20), mem_window)) || (r = w32(w, rcfg(w, 0x24), 0x0000fff0)) ||
+        (r = w32(w, rcfg(w, 0x28), 0)) || (r = w32(w, rcfg(w, 0x2c), 0)) || (r = w32(w, rcfg(w, 0x04), rp_cmd)) ||
+        (r = w32(w, ecfg(w, 0x10), (u32)bar0_bus)) || (r = w32(w, ecfg(w, 0x14), 0)) ||
+        (r = w32(w, ecfg(w, 0x18), (u32)bar2_bus)) || (r = w32(w, ecfg(w, 0x1c), 0)) ||
+        (r = w32(w, ecfg(w, 0x04), ep_cmd))) {
+        g_abort(w);
+        return r;
+    }
+    static const u32 rbo[5] = {0x04, 0x10, 0x14, 0x18, 0x1c};
+    static const u32 rpb[5] = {0x04, 0x20, 0x24, 0x28, 0x2c};
+    u32 rb[5], rp[5];
+    for (u32 i = 0; i < 5; i++)
+        rb[i] = r32(w, ecfg(w, rbo[i]));
+    for (u32 i = 0; i < 5; i++)
+        rp[i] = r32(w, rcfg(w, rpb[i]));
+    if (g_end(w, b))
+        return X_RT;
+    bool bad = (rb[0] & 0x0407) != ep_cmd || (rb[1] & ~0xfu) != bar0_bus || rb[2] ||
+               (rb[3] & ~0xfu) != bar2_bus || rb[4] || (rp[0] & 0xffff) != rp_cmd || rp[1] != mem_window ||
+               (rp[2] & 0xfff0fff0) != 0x0000fff0 || rp[3] || rp[4];
+    WLOGF("[s257] BARs assigned bar0_cpu=0x%lx bar2_cpu=0x%lx ok=%s", (unsigned long)(bar0_bus + CPU_OFFSET),
+          (unsigned long)(bar2_bus + CPU_OFFSET), bad ? "False" : "True");
+    if (bad)
+        FAIL(E_BAR_SETUP);
+    up->r_base[0] = bar0_bus + CPU_OFFSET;
+    up->r_size[0] = s0;
+    up->r_base[1] = bar2_bus + CPU_OFFSET;
+    up->r_size[1] = s2;
+    up->n_ranges = 2;
+    return X_OK;
+}
