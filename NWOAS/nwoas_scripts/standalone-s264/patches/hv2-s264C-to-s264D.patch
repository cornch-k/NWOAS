diff -ruN a/src/nwoas_s264_audio.c b/src/nwoas_s264_audio.c
--- a/src/nwoas_s264_audio.c	1970-01-01 09:00:00
+++ b/src/nwoas_s264_audio.c	2026-11-20 00:45:46
@@ -0,0 +1,744 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * NWOAS S264D: sound-s256/audio_module.py stage B + stage S + final header in C.
+ * Line references: A = nwoas_scripts/sound-s256/audio_module.py, I2C/ADMAC/MCA/NCO/DART/PMGR =
+ * m1n1_windows/proxyclient/m1n1/hw/{i2c,admac,mca,nco,dart,dart8020,pmgr}.py.
+ * Register.set(F=v) = one read + one write with only the named fields replaced; .val = x / .reg = x
+ * = one write; .val / .reg read = one read.  Reads that Python only performs for its log lines are
+ * issued too, so the MMIO trace is the same.  HARDWARE-UNVERIFIED.
+ */
+#include "nwoas_s264_audio.h"
+
+#ifdef S264_HOST
+#include <stdio.h>
+typedef int64_t s64;
+#define S264_SNPRINTF snprintf
+#else
+#include "string.h"
+#include "utils.h"
+#define S264_SNPRINTF snprintf
+#endif
+
+/* ---- contract constants (A:44-80) */
+#define S256_WIN_SIZE      0x40000u
+#define S256_HDR_SIZE      0x1000u
+#define S256_RING_OFF      0x1000u
+#define S256_RING_BYTES    0x20000u
+#define S256_IOVA_BASE     0x80000000ULL
+#define S256_MAGIC         0x5541574eu
+#define S256_VERSION       2u
+#define S256_RATE          48000u
+#define S256_FORMAT        1u
+#define S256_ADMAC_CH      0u
+#define S256_CLUSTER       0u
+#define S256_AMP           0x31u
+#define S256_VOL           0x50u
+#define S256_VOL_LIMIT     0x0cu
+#define S256_GAIN          0x00u
+#define S256_AMP_SHUTDOWN  0x0eu
+#define S256_GPIO181       0x23c1002d4ULL
+#define S256_SENSE_OFF     0x21000u
+#define S256_SENSE_BYTES   0x10000u
+#define S256_SENSE_CHAN    3u
+#define S256_SENSE_FORMAT  2u
+#define S256_STATUS_SENSE  0x2u
+#define S256_SWITCH1_B     0x205050u
+
+static const struct {
+    const char *path;
+    u32 idx;
+    u64 base, size;
+} s256_res[4] = {{"/arm-io/i2c1", 0, 0x235014000ULL, 0x4000},
+                 {"/arm-io/admac-sio", 0, 0x238200000ULL, 0x34000},
+                 {"/arm-io/mca-switch", 0, 0x238400000ULL, 0x18000},
+                 {"/arm-io/mca-switch", 1, 0x238300000ULL, 0x30000}};
+
+static u32 rd32le(const u8 *p)
+{
+    return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16) | ((u32)p[3] << 24);
+}
+static void wr32le(u8 *p, u32 v)
+{
+    p[0] = (u8)v;
+    p[1] = (u8)(v >> 8);
+    p[2] = (u8)(v >> 16);
+    p[3] = (u8)(v >> 24);
+}
+static void wr64le(u8 *p, u64 v)
+{
+    wr32le(p, (u32)v);
+    wr32le(p + 4, (u32)(v >> 32));
+}
+
+/* ------------------------------------------------------------------ context from the ADT */
+static bool reg_of(const u8 *adt, u32 len, const char *path, u32 idx, u64 *a, u64 *s)
+{
+    int n = s264_adt_path(adt, len, path);
+    return n >= 0 && s264_adt_reg(adt, len, n, idx, a, s);
+}
+
+int s264_audio_ctx_from_adt(const u8 *adt, u32 len, u64 buf, u64 pt, struct s264_audio_ctx *c)
+{
+    memset(c, 0, sizeof(*c));
+    c->buf = buf;
+    c->pt = pt;
+    c->prot_gain = 0x00; /* NWOAS_AUDIO_PROT=sense (A:21-27, default) */
+    c->prot_vol_floor = 0xc9;
+    u64 a, s;
+    /* B0 (A:215-226): contract resources = live ADT (the hypervisor maps every /arm-io range as
+     * plain passthrough and puts no hook there: checked by the planner) */
+    for (int i = 0; i < 4; i++) {
+        if (!reg_of(adt, len, s256_res[i].path, s256_res[i].idx, &a, &s))
+            return c->err = S264_AE_NODE;
+        if (a != s256_res[i].base || s != s256_res[i].size)
+            return c->err = S264_AE_RES;
+    }
+    if (!reg_of(adt, len, "/arm-io/gpio", 0, &a, &s))
+        return c->err = S264_AE_NODE;
+    c->gpio = a;
+    if (a + 4 * 181 != S256_GPIO181)
+        return c->err = S264_AE_GPIO;
+    reg_of(adt, len, "/arm-io/i2c1", 0, &c->i2c1, NULL);
+    reg_of(adt, len, "/arm-io/admac-sio", 0, &c->admac, NULL);
+    reg_of(adt, len, "/arm-io/mca-switch", 0, &c->mca0, NULL);
+    c->mca0 += 0x4000 * S256_CLUSTER;
+    reg_of(adt, len, "/arm-io/mca-switch", 1, &c->switch1, NULL);
+    if (!reg_of(adt, len, "/arm-io/mca-switch", 2, &c->clk_base, &c->clk_size))
+        return c->err = S264_AE_NODE;
+    if (!reg_of(adt, len, "/arm-io/pmgr", 0, &c->pmgr0, NULL))
+        return c->err = S264_AE_NODE;
+    int d = s264_adt_path(adt, len, "/arm-io/dart-sio");
+    u32 cl = 0;
+    const u8 *cp = d >= 0 ? s264_adt_prop(adt, len, d, "compatible", &cl) : NULL;
+    if (!cp || !reg_of(adt, len, "/arm-io/dart-sio", 0, &c->dart, NULL))
+        return c->err = S264_AE_NODE;
+    if (cl < 11 || memcmp(cp, "dart,t8020", 11)) /* dart.py:31-35: first compatible string */
+        return c->err = S264_AE_DART;
+    int ad = s264_adt_path(adt, len, "/arm-io/admac-sio");
+    u32 nl = 0;
+    const u8 *nch = s264_adt_prop(adt, len, ad, "#dma-channels", &nl);
+    if (!nch || nl < 4)
+        return c->err = S264_AE_NODE;
+    c->admac_nchans = rd32le(nch) * 2; /* admac.py:376 */
+    if (c->admac_nchans <= S256_SENSE_CHAN)
+        return c->err = S264_AE_ADMAC;
+    /* nco.py:73-77: fin = /arm-io clock-frequencies[clock-ids[0] - 256] */
+    int nn = s264_adt_path(adt, len, "/arm-io/nco");
+    int io = s264_adt_path(adt, len, "/arm-io");
+    u32 il = 0, fl = 0;
+    const u8 *ids = nn >= 0 ? s264_adt_prop(adt, len, nn, "clock-ids", &il) : NULL;
+    const u8 *fq = io >= 0 ? s264_adt_prop(adt, len, io, "clock-frequencies", &fl) : NULL;
+    if (!ids || il < 4 || !fq || !reg_of(adt, len, "/arm-io/nco", 0, &c->nco, NULL))
+        return c->err = S264_AE_NCO;
+    u32 ci = rd32le(ids);
+    if (ci < 256 || (ci - 256 + 1) * 4 > fl)
+        return c->err = S264_AE_NCO;
+    c->nco_fin = rd32le(fq + 4 * (ci - 256));
+    return 0;
+}
+
+void s264_audio_header(u8 *h, u32 status, u32 prot_gain, u32 prot_vol_floor)
+{
+    /* A:124-130, struct "<IIQIIIIIIIIQIIIII" */
+    memset(h, 0, 0x4c);
+    wr32le(h + 0x00, S256_MAGIC);
+    wr32le(h + 0x04, S256_VERSION);
+    wr64le(h + 0x08, S256_IOVA_BASE + S256_RING_OFF);
+    wr32le(h + 0x10, S256_RING_BYTES);
+    wr32le(h + 0x14, S256_RATE);
+    wr32le(h + 0x18, S256_FORMAT);
+    wr32le(h + 0x1c, S256_ADMAC_CH);
+    wr32le(h + 0x20, S256_CLUSTER);
+    wr32le(h + 0x24, S256_AMP);
+    wr32le(h + 0x28, S256_VOL_LIMIT);
+    wr32le(h + 0x2c, status);
+    wr64le(h + 0x30, S256_IOVA_BASE + S256_SENSE_OFF);
+    wr32le(h + 0x38, S256_SENSE_BYTES);
+    wr32le(h + 0x3c, S256_SENSE_CHAN);
+    wr32le(h + 0x40, S256_SENSE_FORMAT);
+    wr32le(h + 0x44, prot_gain);
+    wr32le(h + 0x48, prot_vol_floor);
+}
+
+/* ------------------------------------------------------------------ helpers */
+struct s264_aud {
+    const struct s264_audio_io *io;
+    const struct s264_audio_ctx *c;
+    bool b0_ok, have_i2c, have_tx, have_serdes, have_rx, have_rxb;
+    char msg[256];
+};
+
+#define RD(a)    (A->io->rd32(a))
+#define WR(a, v) (A->io->wr32((a), (u32)(v)), A->io->pace_us(S264_AUDIO_PACE_US))
+#define POLL_PAUSE() (A->io->pace_us(S264_AUDIO_POLL_US))
+/* Register.set(): read, replace the fields in mask by val, write */
+static void set_f(struct s264_aud *A, u64 a, u32 mask, u32 val)
+{
+    u32 v = RD(a);
+    WR(a, (v & ~mask) | val);
+}
+static void alog(struct s264_aud *A, const char *m)
+{
+    if (A->io->log)
+        A->io->log(m);
+}
+
+/* ---- I2C (i2c.py:169-219) */
+#define I2C_MTXFIFO 0x00
+#define I2C_MRXFIFO 0x04
+#define I2C_SMSTA   0x14
+#define I2C_CTL     0x1c
+#define MTX_START   (1u << 8)
+#define MTX_STOP    (1u << 9)
+#define MTX_READ    (1u << 10)
+#define SMSTA_XEN   (1u << 27)
+#define CTL_MTR     (1u << 9)
+#define CTL_MRR     (1u << 10)
+#define CTL_ENABLE  (1u << 11)
+
+static void i2c_begin(struct s264_aud *A, u32 addr)
+{
+    u64 b = A->c->i2c1;
+    set_f(A, b + I2C_CTL, CTL_MTR | CTL_MRR, CTL_MTR | CTL_MRR); /* clear_fifos */
+    WR(b + I2C_SMSTA, 0xffffffffu);                              /* clear_status */
+    set_f(A, b + I2C_CTL, CTL_ENABLE | 0xff, CTL_ENABLE | 0x4);
+    set_f(A, b + I2C_MTXFIFO, 0xff | MTX_START, ((addr << 1) & 0xff) | MTX_START);
+}
+
+static int i2c_fifo_write(struct s264_aud *A, const u8 *buf, u32 n, bool stop)
+{
+    u64 b = A->c->i2c1;
+    for (u32 i = 0; i < n; i++) {
+        bool s = stop && i == n - 1;
+        set_f(A, b + I2C_MTXFIFO, 0xff | MTX_STOP, buf[i] | (s ? MTX_STOP : 0));
+    }
+    if (!stop)
+        return 0;
+    int timeout = 10000;
+    while (!(RD(b + I2C_SMSTA) & SMSTA_XEN) && timeout > 0) {
+        timeout--;
+        POLL_PAUSE();
+    }
+    return timeout == 0 ? -1 : 0;
+}
+
+static int i2c_write_reg(struct s264_aud *A, u32 addr, u32 reg, const u8 *data, u32 n)
+{
+    u8 tmp[8];
+    if (n + 1 > sizeof(tmp))
+        return -1;
+    i2c_begin(A, addr);
+    tmp[0] = (u8)reg;
+    memcpy(tmp + 1, data, n);
+    int r = i2c_fifo_write(A, tmp, n + 1, true);
+    if (r)
+        return r; /* Python raises before the final CTL write */
+    set_f(A, A->c->i2c1 + I2C_CTL, CTL_ENABLE | 0xff, 0x4);
+    return 0;
+}
+
+static int i2c_read_reg(struct s264_aud *A, u32 addr, u32 reg, u8 *out, u32 n)
+{
+    u64 b = A->c->i2c1;
+    u8 r8 = (u8)reg;
+    i2c_begin(A, addr);
+    i2c_fifo_write(A, &r8, 1, false);
+    set_f(A, b + I2C_MTXFIFO, 0xff | MTX_START, (((addr << 1) | 1) & 0xff) | MTX_START);
+    set_f(A, b + I2C_MTXFIFO, 0xff | MTX_STOP | MTX_READ, (n & 0xff) | MTX_STOP | MTX_READ);
+    for (u32 i = 0; i < n; i++) {
+        u32 v = RD(b + I2C_MRXFIFO);
+        int timeout = 10000;
+        while ((v & (1u << 8)) && timeout > 0) {
+            POLL_PAUSE();
+            v = RD(b + I2C_MRXFIFO);
+            timeout--;
+        }
+        if (timeout == 0)
+            return -1;
+        out[i] = (u8)v;
+    }
+    set_f(A, b + I2C_CTL, CTL_ENABLE | 0xff, 0x4);
+    return 0;
+}
+
+static int amp_read(struct s264_aud *A, u32 reg, u32 *v)
+{
+    u8 b;
+    if (i2c_read_reg(A, S256_AMP, reg, &b, 1))
+        return -1;
+    *v = b;
+    return 0;
+}
+static int amp_write1(struct s264_aud *A, u32 reg, u32 v)
+{
+    u8 b = (u8)v;
+    return i2c_write_reg(A, S256_AMP, reg, &b, 1);
+}
+
+/* ---- ADMAC (admac.py) */
+#define ADMAC_TX_EN     0x0
+#define ADMAC_TX_EN_CLR 0x4
+#define ADMAC_RX_EN     0x8
+#define ADMAC_RX_EN_CLR 0xc
+#define CH(n, off)      (A->c->admac + 0x8000 + 0x200 * (u64)(n) + (off))
+#define CH_CTL          0x00
+#define CH_BUSWIDTH     0x40
+#define CH_SRAM         0x50
+#define CH_BURST        0x54
+#define CH_DESC_RING    0x70
+#define CH_REPORT_RING  0x74
+
+static void admac_disable(struct s264_aud *A, u32 ch)
+{
+    WR(A->c->admac + ((ch % 2) == 0 ? ADMAC_TX_EN_CLR : ADMAC_RX_EN_CLR), 1u << (ch / 2));
+}
+static void admac_reset(struct s264_aud *A, u32 ch)
+{
+    set_f(A, CH(ch, CH_CTL), 3, 3); /* RESET_RINGS=1, CLEAR_OF_UF_COUNTERS=1 */
+    set_f(A, CH(ch, CH_CTL), 3, 0);
+    WR(CH(ch, CH_BURST), 0xc00060);            /* burstsize */
+    set_f(A, CH(ch, CH_BUSWIDTH), 0x7, 2);     /* buswidth W_32BIT */
+    set_f(A, CH(ch, CH_BUSWIDTH), 0x70, 0);    /* framesize F_1_WORD */
+}
+static int admac_read_reports(struct s264_aud *A, u32 ch)
+{
+    /* admac.py:297-325: drain 4 words per report until EMPTY (bounded here) */
+    u64 rr = A->c->admac + ((ch % 2) == 0 ? 0x10100 : 0x14100) + 4 * (u64)(ch / 2);
+    for (int n = 0; n < 64; n++) {
+        if (RD(CH(ch, CH_REPORT_RING)) & (1u << 8))
+            return 0;
+        for (int k = 0; k < 4; k++)
+            RD(rr);
+    }
+    return -1;
+}
+
+/* ---- DART t8020 (dart8020.py) */
+#define D_STREAM_COMMAND 0x20
+#define D_STREAM_SELECT  0x34
+#define D_ERROR          0x40
+#define D_CONFIG         0x60
+#define D_UNK1           0xf8
+#define D_ENABLED        0xfc
+#define D_TCR(s)         (0x100 + 4 * (u64)(s))
+#define D_TTBR(s, j)     (0x200 + 16 * (u64)(s) + 4 * (u64)(j))
+#define DPAGE            0x4000ULL
+
+static void dart_invalidate(struct s264_aud *A, u32 streams)
+{
+    u64 d = A->c->dart;
+    WR(d + D_STREAM_SELECT, streams);
+    WR(d + D_STREAM_COMMAND, 1u << 20);
+    for (int n = 0; n < 100000 && (RD(d + D_STREAM_COMMAND) & (1u << 2)); n++)
+        POLL_PAUSE();
+}
+
+/* ---- the stages */
+static int stage_b(struct s264_aud *A)
+{
+    const struct s264_audio_ctx *c = A->c;
+    char *m = A->msg;
+    if (c->err) {
+        S264_SNPRINTF(m, sizeof(A->msg), "B0 ADT/contract check failed: reason %u", c->err);
+        alog(A, m);
+        return -1;
+    }
+    A->b0_ok = true;
+    alog(A, "B0 ADT reg check: i2c1 / admac-sio / mca-switch reg0 / reg1 match the SSDT; GPIO181 ok");
+
+    /* B1 clocks (A:229-236): errors ignored */
+    static const char *const nodes[6] = {"/arm-io/i2c1",       "/arm-io/admac-sio", "/arm-io/dart-sio",
+                                         "/arm-io/mca-switch", "/arm-io/mca0",      "/arm-io/mca1"};
+    for (int i = 0; i < 6; i++)
+        A->io->clocks_enable(nodes[i]);
+
+    /* B2 MCA clock muxes (A:239-246) */
+    for (u64 i = 0; i < c->clk_size / 4; i++) {
+        u64 a = c->clk_base + 4 * i;
+        u32 v = RD(a);
+        u32 nv = (v & ~(0xfu << 24)) | ((5u + (u32)(i < 4 ? i : 4)) << 24);
+        if (nv != v)
+            WR(a, nv);
+    }
+    for (u64 i = 0; i < c->clk_size / 4; i++)
+        RD(c->clk_base + 4 * i);
+
+    /* B3 AUDIO_P reset (A:249-259): PMGR PS4[5] */
+    u64 ps = c->pmgr0 + 0x200 + 8 * 5;
+    RD(0x23b700228ULL);
+    set_f(A, ps, 1u << 10, 1u << 10); /* DEV_DISABLE=1 */
+    set_f(A, ps, 1u << 31, 1u << 31); /* RESET=1 */
+    set_f(A, ps, 1u << 31, 0);        /* RESET=0 */
+    set_f(A, ps, 1u << 10, 0);        /* DEV_DISABLE=0 */
+    RD(0x23b7001d0ULL);
+    RD(0x23b7001f8ULL);
+    RD(0x23b700228ULL);
+    RD(0x23b700230ULL);
+    RD(0x23b7002b8ULL);
+    A->have_i2c = true; /* A:261 hw.i2c = I2C(...) */
+
+    /* B4 DART-sio stream 2 only (A:264-299) */
+    u64 d = c->dart;
+    RD(d + D_ENABLED); /* DART8020.__init__ enabled_streams */
+    RD(d + D_CONFIG);
+    RD(d + D_ENABLED);
+    RD(d + D_ERROR);
+    RD(d + D_UNK1);
+    for (int i = 0; i < 4; i++)
+        RD(d + D_TCR(i));
+    for (int j = 0; j < 4; j++)
+        RD(d + D_TTBR(2, j));
+    RD(d + D_TTBR(0, 0));
+    u32 keep[4];
+    for (int i = 0; i < 2; i++) {
+        keep[2 * i] = RD(d + D_TCR(i));
+        keep[2 * i + 1] = RD(d + D_TTBR(i, 0));
+    }
+    WR(d + D_TCR(2), 1u << 7); /* TRANSLATE_ENABLE */
+    for (int j = 0; j < 4; j++)
+        WR(d + D_TTBR(2, j), 0);
+    if (RD(d + D_ERROR) & (1u << 31))
+        WR(d + D_ERROR, 0xffffffffu);
+    u32 enabled = RD(d + D_ENABLED);
+    dart_invalidate(A, 1u << 2);
+    if (RD(d + D_TCR(2)) != (1u << 7)) {
+        RD(d + D_TCR(2)); /* read again for the message (A:278) */
+        alog(A, "FAIL DART-sio TCR2 write did not stick");
+        return -1;
+    }
+    /* iomap_at(2, IOVA, buf, 0x40000) (dart8020.py:113-176); L1 = pt, L2 = pt + 16 KiB */
+    if (!(enabled & (1u << 2))) {
+        enabled |= 1u << 2;
+        u32 cur = RD(d + D_ENABLED);
+        WR(d + D_ENABLED, cur | enabled);
+    }
+    u32 tcr = RD(d + D_TCR(2));
+    if (!(tcr & (1u << 7)) || (tcr & (1u << 8))) {
+        alog(A, "FAIL DART-sio stream 2 mode");
+        return -1;
+    }
+    static u64 l1[2048], l2[2048];
+    u64 l1pa = c->pt, l2pa = c->pt + DPAGE;
+    memset(l1, 0, sizeof(l1));
+    memset(l2, 0, sizeof(l2));
+    bool have_l1 = false, have_l2 = false;
+    for (u64 page = S256_IOVA_BASE; page < S256_IOVA_BASE + S256_WIN_SIZE; page += DPAGE) {
+        u64 paddr = c->buf + page - S256_IOVA_BASE;
+        u32 ttbr = RD(d + D_TTBR(2, page >> 36));
+        if (!(ttbr & (1u << 31))) {
+            have_l1 = true;
+            ttbr = (ttbr & ~0x7fffffffu) | (u32)((l1pa >> 12) & 0x7fffffff) | (1u << 31);
+            WR(d + D_TTBR(2, page >> 36), ttbr);
+        }
+        u32 l1i = (u32)((page >> 25) & 0x7ff);
+        if (!(l1[l1i] & 1)) {
+            have_l2 = true;
+            l1[l1i] = ((l2pa >> 14) << 14) | 2 | 1; /* OFFSET, SP_PROT_DIS, VALID */
+        }
+        u32 l2i = (u32)((page >> 14) & 0x7ff);
+        l2[l2i] = (0ULL << 52) | (0xfffULL << 40) | (((paddr >> 14) & 0x3ffffffULL) << 14) | 2 | 1;
+    }
+    if (have_l1)
+        A->io->mem_write(l1pa, l1, sizeof(l1));
+    if (have_l2)
+        A->io->mem_write(l2pa, l2, sizeof(l2));
+    A->io->civac(l1pa, DPAGE); /* A:285-286, pt_cache order: L1 then L2 */
+    A->io->civac(l2pa, DPAGE);
+    dart_invalidate(A, 1u << 2);
+    /* iotranslate(2, IOVA, size) (dart8020.py:178-245) */
+    tcr = RD(d + D_TCR(2));
+    static u64 t1[2048], t2[2048];
+    bool t1_ok = false, t2_ok = false, tr_ok = true;
+    for (u64 page = S256_IOVA_BASE; page < S256_IOVA_BASE + S256_WIN_SIZE; page += DPAGE) {
+        u32 ttbr = RD(d + D_TTBR(2, page >> 36));
+        if (!(ttbr & (1u << 31))) {
+            tr_ok = false;
+            continue;
+        }
+        if (!t1_ok) {
+            A->io->mem_read((u64)(ttbr & 0x7fffffff) << 12, t1, sizeof(t1));
+            t1_ok = true;
+        }
+        u64 e1 = t1[(page >> 25) & 0x7ff];
+        if (!(e1 & 1)) {
+            tr_ok = false;
+            continue;
+        }
+        if (!t2_ok) {
+            A->io->mem_read(((e1 >> 14) & 0x3ffffffULL) << 14, t2, sizeof(t2));
+            t2_ok = true;
+        }
+        u64 e2 = t2[(page >> 14) & 0x7ff];
+        if (!(e2 & 1) || (((e2 >> 14) & 0x3ffffffULL) << 14) != c->buf + page - S256_IOVA_BASE)
+            tr_ok = false;
+    }
+    if (!tr_ok) {
+        alog(A, "FAIL DART-sio stream 2 translate does not give the window buffer");
+        return -1;
+    }
+    u32 now[4];
+    for (int i = 0; i < 2; i++) { /* A:290: the list is built (4 reads) before the compare */
+        now[2 * i] = RD(d + D_TCR(i));
+        now[2 * i + 1] = RD(d + D_TTBR(i, 0));
+    }
+    if (memcmp(now, keep, sizeof(now))) {
+        alog(A, "FAIL DART-sio streams 0/1 changed unexpectedly");
+        return -1;
+    }
+    RD(d + D_TCR(2));
+    RD(d + D_TTBR(2, 0));
+    RD(d + D_ENABLED);
+
+    /* B5 ADMAC TX channel 0 (A:302-316) */
+    A->have_tx = true;
+    admac_disable(A, S256_ADMAC_CH);
+    admac_reset(A, S256_ADMAC_CH);
+    if (admac_read_reports(A, S256_ADMAC_CH))
+        return -1;
+    set_f(A, CH(0, CH_BUSWIDTH), 0x7, 2);
+    set_f(A, CH(0, CH_BUSWIDTH), 0x70, 0);
+    RD(CH(0, CH_BUSWIDTH));
+    RD(CH(0, CH_BURST));
+    RD(CH(0, CH_SRAM));
+    RD(CH(0, CH_DESC_RING));
+    RD(CH(0, CH_REPORT_RING));
+    RD(c->admac + ADMAC_TX_EN);
+
+    /* B6 NCO 0 = 48000 * 256 (nco.py:37-42, 64-71) */
+    {
+        u64 n = c->nco;
+        u64 fin = c->nco_fin, fout = (u64)S256_RATE * 256;
+        u64 div = 2 * fin / fout;
+        s64 inc1 = (s64)(2 * fin - div * fout);
+        s64 inc2 = inc1 - (s64)fout;
+        u64 idx = div >> 2;
+        if (idx < 2 || idx > 2049) {
+            alog(A, "FAIL NCO target rate out of range");
+            return -1;
+        }
+        /* TBL[k] (nco.py:13-20): k = 2 -> 0, k >= 3 -> galois_lfsr(0x7ff, 0xa01) state number 2050 - k */
+        u32 st = 0;
+        if (idx >= 3) {
+            st = 0x7ff;
+            for (u64 i = 0; i < 2050 - idx; i++)
+                st = (st & 1) ? ((st >> 1) ^ (0xa01 >> 1)) : (st >> 1);
+        }
+        u32 vals[4] = {0, (st << 2) | (u32)(div & 3), (u32)inc1, (u32)((s64)inc2 + 0x100000000LL)};
+        bool was = RD(n) & (1u << 31);
+        for (int i = 0; i < 4; i++)
+            WR(n + 4 * (u64)i, vals[i]);
+        if (was)
+            set_f(A, n, 1u << 31, 1u << 31);
+        set_f(A, n, 1u << 31, 1u << 31); /* enable(): p.set32 */
+        RD(n);
+    }
+
+    /* B7 MCA cluster 0 (A:319-347) */
+    u64 cb = c->mca0, tx = cb + 0x300;
+    A->have_serdes = true;
+    set_f(A, cb + 0x100, 3, 2); /* SYNCGEN_STATUS RST=1 EN=0 */
+    set_f(A, cb + 0x100, 2, 0); /* RST=0 */
+    WR(cb + 0x104, 1 + S256_CLUSTER);
+    WR(cb + 0x108, 0);
+    WR(cb + 0x10c, 0xfe);
+    set_f(A, tx + 0x0, 1, 0); /* TXA STATUS EN=0 */
+    set_f(A, tx + 0x4, 0xf | (0x1fu << 4) | (1u << 10) | (1u << 12) | (1u << 13) | (1u << 14) | (7u << 16),
+          (0x10u << 4) | (1u << 10) | (1u << 12) | (1u << 13) | (1u << 14) | ((1u + S256_CLUSTER) << 16));
+    WR(tx + 0x8, 0);
+    WR(tx + 0xc, 0xfffffffeu);
+    WR(tx + 0x10, 0xfffffffeu);
+    set_f(A, cb + 0x600, 0xe, 0xe);                                  /* PORT_ENABLES */
+    set_f(A, cb + 0x604, 0xf00, (S256_CLUSTER + 1) << 8);            /* PORT_CLK_SEL */
+    WR(cb + 0x608, S256_CLUSTER + 1);                                /* PORT_DATA_SEL */
+    set_f(A, cb + 0x0, 1, 1);                                        /* MCLK_STATUS EN=1 */
+    set_f(A, cb + 0x100, 1, 1);                                      /* SYNCGEN EN=1 */
+    WR(c->switch1 + 0x8000 * S256_CLUSTER, 0x102040);
+    if (RD(tx + 0x0) & 1) {
+        alog(A, "FAIL SERDES TXA enabled after configuration");
+        return -1;
+    }
+    RD(cb + 0x0);
+    RD(cb + 0x100);
+    RD(tx + 0x0);
+    RD(tx + 0x4);
+    RD(cb + 0x600);
+    RD(c->switch1 + 0x8000 * S256_CLUSTER);
+
+    /* B8 amp reset GPIO 181 (A:350-355) */
+    RD(S256_GPIO181);
+    WR(S256_GPIO181, 0x76a02);
+    A->io->sleep_us(10000);
+    WR(S256_GPIO181, 0x76a03);
+    A->io->sleep_us(10000);
+    RD(S256_GPIO181);
+
+    /* B9 amp (A:358-376) */
+    u32 st0, vol;
+    if (amp_read(A, 0x02, &st0) || amp_write1(A, 0x05, S256_VOL) || amp_read(A, 0x05, &vol))
+        return -1;
+    S264_SNPRINTF(m, sizeof(A->msg), "B9 amp 0x02=0x%x volume 0x05=0x%x", st0, vol);
+    alog(A, m);
+    if (vol != S256_VOL)
+        return -1;
+    static const u8 cfg_a[] = {0x06, 0x00, 0x1a}, cfg_b[] = {0x01, 0x82, 0x06}, cfg_c[] = {0x50, 0x04};
+    if (amp_write1(A, 0x02, S256_AMP_SHUTDOWN) || amp_write1(A, 0x08, 0x40) ||
+        i2c_write_reg(A, S256_AMP, 0x0a, cfg_a, 3) || i2c_write_reg(A, S256_AMP, 0x1b, cfg_b, 3) ||
+        i2c_write_reg(A, S256_AMP, 0x16, cfg_c, 2) || amp_write1(A, 0x0d, 0x00) ||
+        amp_write1(A, 0x03, S256_GAIN) || amp_write1(A, 0x05, S256_VOL) ||
+        amp_write1(A, 0x02, S256_AMP_SHUTDOWN))
+        return -1;
+    static const u8 regs[7] = {0x02, 0x03, 0x05, 0x0a, 0x0b, 0x0c, 0x0d};
+    u32 got[7];
+    for (int i = 0; i < 7; i++)
+        if (amp_read(A, regs[i], &got[i]))
+            return -1;
+    if (got[0] != S256_AMP_SHUTDOWN || got[1] != S256_GAIN || got[2] != S256_VOL) {
+        alog(A, "FAIL amp state/gain/volume read-back mismatch");
+        return -1;
+    }
+    /* B10 (A:379-384) */
+    if (RD(tx + 0x0) & 1)
+        return -1;
+    RD(d + D_ERROR);
+    alog(A, "B10 final: amp in shutdown, SERDES TXA EN=0, ADMAC ch0 disabled");
+    return 0;
+}
+
+static int stage_sense(struct s264_aud *A)
+{
+    const struct s264_audio_ctx *c = A->c;
+    u32 ch = S256_SENSE_CHAN;
+    /* S1 (A:389-405) */
+    A->have_rx = true;
+    admac_disable(A, ch);
+    admac_reset(A, ch);
+    if (admac_read_reports(A, ch))
+        return -1;
+    WR(CH(ch, CH_BURST), 0x00600030);
+    set_f(A, CH(ch, CH_BUSWIDTH), 0x7, 1);    /* W_16BIT */
+    set_f(A, CH(ch, CH_BUSWIDTH), 0x70, 0x10); /* F_2_WORDS */
+    RD(CH(ch, CH_BUSWIDTH));
+    RD(CH(ch, CH_BURST));
+    RD(CH(ch, CH_SRAM));
+    RD(CH(ch, CH_DESC_RING));
+    RD(CH(ch, CH_REPORT_RING));
+    RD(c->admac + ADMAC_RX_EN);
+    RD(CH(S256_ADMAC_CH, CH_SRAM));
+    if ((RD(CH(ch, CH_BUSWIDTH)) & 0x77) != 0x11) {
+        RD(CH(ch, CH_BUSWIDTH)); /* read again for the message (A:405) */
+        return -1;
+    }
+    /* S2 (A:408-423) */
+    u64 rxb = c->mca0 + 0x400;
+    A->have_rxb = true;
+    set_f(A, rxb + 0x0, 1, 0);
+    WR(rxb + 0x8, 15 | (0x4u << 4) | (1u << 10) | (1u << 12) | (1u << 13) | (1u << 15) |
+                      ((1u + S256_CLUSTER) << 16));
+    WR(rxb + 0xc, 0);
+    WR(rxb + 0x10, 0xffffffffu);
+    WR(rxb + 0x14, 0xfffffffcu);
+    WR(rxb + 0x4, 1u << S256_CLUSTER);
+    u64 adb = c->switch1 + 0x8000 * S256_CLUSTER + 0x4000;
+    WR(adb, S256_SWITCH1_B);
+    if (RD(rxb + 0x0) & 1)
+        return -1;
+    RD(rxb + 0x0);
+    RD(rxb + 0x8);
+    RD(rxb + 0xc);
+    RD(rxb + 0x10);
+    RD(rxb + 0x14);
+    RD(rxb + 0x4);
+    RD(adb);
+    /* S3 (A:426-438) */
+    u32 v, before[4], after[3];
+    static const u8 tdm[3] = {0x21, 0x42, 0x40};
+    static const u8 br[4] = {0x0e, 0x0f, 0x10, 0x31};
+    if (amp_read(A, 0x02, &v))
+        return -1;
+    if (v != S256_AMP_SHUTDOWN)
+        return -1;
+    for (int i = 0; i < 4; i++)
+        if (amp_read(A, br[i], &before[i]))
+            return -1;
+    if (i2c_write_reg(A, S256_AMP, 0x0e, tdm, 3))
+        return -1;
+    for (int i = 0; i < 3; i++)
+        if (amp_read(A, 0x0e + i, &after[i]))
+            return -1;
+    if (amp_read(A, 0x02, &v)) /* read for the S3 log line */
+        return -1;
+    if (after[0] != tdm[0] || after[1] != tdm[1] || after[2] != tdm[2])
+        return -1;
+    if (amp_read(A, 0x02, &v) || v != S256_AMP_SHUTDOWN)
+        return -1;
+    (void)before;
+    return 0;
+}
+
+static void sense_off(struct s264_aud *A)
+{
+    if (A->have_rx)
+        admac_disable(A, S256_SENSE_CHAN);
+    if (A->have_rxb)
+        set_f(A, A->c->mca0 + 0x400, 1, 0);
+}
+
+static void safe_off(struct s264_aud *A)
+{
+    /* A:458-484 */
+    if (A->have_i2c) {
+        amp_write1(A, 0x02, 0x0d);
+        amp_write1(A, 0x02, 0x0e);
+    }
+    if (A->b0_ok) {
+        WR(S256_GPIO181, 0x76a02);
+        RD(S256_GPIO181);
+    }
+    if (A->have_tx)
+        admac_disable(A, S256_ADMAC_CH);
+    if (A->have_serdes)
+        set_f(A, A->c->mca0 + 0x300, 1, 0);
+    sense_off(A);
+}
+
+u32 s264_audio_run(const struct s264_audio_io *io, const struct s264_audio_ctx *ctx)
+{
+    static struct s264_aud st;
+    struct s264_aud *A = &st;
+    memset(A, 0, sizeof(*A));
+    A->io = io;
+    A->c = ctx;
+    bool ok = stage_b(A) == 0;
+    if (!ok) {
+        alog(A, "FAIL -> fail closed (header status 0, amp off)");
+        safe_off(A);
+    }
+    bool sense_ok = false;
+    if (ok) {
+        sense_ok = stage_sense(A) == 0;
+        if (!sense_ok) {
+            alog(A, "SENSE FAIL -> status bit1 = 0 (driver stays static)");
+            sense_off(A);
+            u32 v;
+            if (!amp_read(A, 0x02, &v) && v != S256_AMP_SHUTDOWN) {
+                amp_write1(A, 0x02, 0x0d);
+                amp_write1(A, 0x02, S256_AMP_SHUTDOWN);
+            }
+        }
+    }
+    u32 status = (ok ? 1u : 0u) | (sense_ok ? S256_STATUS_SENSE : 0u);
+    u8 h[0x4c];
+    s264_audio_header(h, status, ctx->prot_gain, ctx->prot_vol_floor);
+    io->mem_write(ctx->buf, h, sizeof(h));
+    io->civac(ctx->buf, S256_HDR_SIZE);
+    u8 back[0x4c];
+    io->mem_read(ctx->buf, back, sizeof(back)); /* A:509-510 _s256_require read-back */
+    if (memcmp(back, h, sizeof(h))) {
+        alog(A, "FAIL final header read-back mismatch");
+        return status | S264_AUDIO_HDR_BAD;
+    }
+    S264_SNPRINTF(A->msg, sizeof(A->msg), "%s (header status 0x%x)",
+                  ok ? "READY: hardware prepared, nothing playing" : "NOT READY: status bit0 = 0", status);
+    alog(A, A->msg);
+    return status;
+}
