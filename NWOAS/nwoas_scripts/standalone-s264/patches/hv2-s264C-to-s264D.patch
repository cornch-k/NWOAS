+/* ---- P:563-595 _read_function: returns X_* ; *id */
+static int read_function(struct s264w *w, u32 fn, u32 *id_out, u32 *cap_out)
+{
+    u32 b = g_begin(w);
+    u32 fid = cfg(w, 1, 0, fn, 0x00);
+    u32 cmdsts = cfg(w, 1, 0, fn, 0x04);
+    cfg(w, 1, 0, fn, 0x08);
+    u32 hdr = cfg(w, 1, 0, fn, 0x0c);
+    cfg(w, 1, 0, fn, 0x2c);
+    *id_out = fid;
+    *cap_out = 0;
+    if (fid == 0xffffffffu) {
+        g_end(w, b);
+        return X_OK; /* present False, no bars */
+    }
+    *cap_out = pcie_cap(w, 1, 0, fn);
+    u32 exc = g_end(w, b);
+    if (exc || (cmdsts & 0x3) || ((hdr >> 16) & 0x7f) != 0)
+        return X_OK; /* bars skipped */
+    u32 b2 = g_begin(w);
+    int r = size_bars(w, fn);
+    if (r) {
+        g_abort(w);
+        return r;
+    }
+    g_end(w, b2);
+    return X_OK;
+}
