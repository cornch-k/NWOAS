+/// NWOAS S264G: read `spec` ("<partition uuid>;<path>") into a caller-owned buffer (the Python heap
+/// range of the C launcher), without a heap copy.  Returns the file size in Ok; Err(TooBig) leaves
+/// the buffer untouched.
+pub enum LoadInto {
+    Done(usize),
+    TooBig(usize),
+}
+
+fn load_into(spec: &str, dst: &mut [u8]) -> Result<LoadInto, Error> {
+    println!("ESP read {}", spec);
+    let mut args = spec.split(';');
+    let uuid = Uuid::parse_str(args.next().ok_or(Error::BadArgs)?).or(Err(Error::BadArgs))?;
+    let path = args.next().ok_or(Error::BadArgs)?;
+    let part = {
+        let storage = nvme::NVMEStorage::new(1, 0);
+        let mut pt = gpt::GPT::new(storage)?;
+        pt.find_by_partuuid(uuid)?.ok_or(Error::PartitionNotFound)?
+    };
+    let storage = nvme::NVMEStorage::new(1, part.get_starting_lba());
+    let opts = FsOptions::new().update_accessed_date(false);
+    let fs = FileSystem::new(storage, opts)?;
+    let mut file = fs.root_dir().open_file(path)?;
+    let size = file.seek(SeekFrom::End(0))? as usize;
+    file.seek(SeekFrom::Start(0))?;
+    if size > dst.len() {
+        println!("ESP read: {} bytes do not fit in {}", size, dst.len());
+        return Ok(LoadInto::TooBig(size));
+    }
+    let mut slice = &mut dst[..size];
+    while !slice.is_empty() {
+        let read = file.read(slice)?;
+        if read == 0 {
+            return Err(Error::Unknown);
+        }
+        slice = &mut slice[read..];
+    }
+    println!("ESP read: {} bytes", size);
+    Ok(LoadInto::Done(size))
+}
+
+/// 0 = read (*size = bytes), 1 = larger than `cap` (*size = file size, nothing written),
+/// -1 = not found / not readable.  `cap` 0 = only ask whether the file exists.
+#[no_mangle]
+pub unsafe extern "C" fn rust_load_file_into(
+    raw_spec: *const c_char,
+    dst: *mut c_void,
+    cap: c_size_t,
+    size: *mut c_size_t,
+) -> c_int {
+    let spec = match unsafe { CStr::from_ptr(raw_spec) }.to_str() {
+        Ok(s) => s,
+        Err(_) => return -1,
+    };
+    let buf: &mut [u8] = if cap == 0 || dst.is_null() {
+        &mut []
+    } else {
+        unsafe { core::slice::from_raw_parts_mut(dst as *mut u8, cap) }
+    };
+    match load_into(spec, buf) {
+        Ok(LoadInto::Done(n)) => {
+            unsafe { *size = n };
+            0
+        }
+        Ok(LoadInto::TooBig(n)) => {
+            unsafe { *size = n };
+            1
+        }
+        Err(err) => {
+            println!("ESP read failed: {:?}", err);
+            -1
+        }
+    }
+}
+
