--- a/src/nwoas_s264_auto.c	1970-01-01 09:00:00
+++ b/src/nwoas_s264_auto.c	2026-11-20 04:07:26
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: MIT */
+/* NWOAS S264G: auto-start decision (pure; see nwoas_s264_auto.h).  HARDWARE-UNVERIFIED. */
+#include "nwoas_s264_auto.h"
+
+#ifndef S264_HOST
+#include "string.h"
+#endif
+
+bool s264_auto_should_fire(u32 autostart_s, u64 elapsed_us, bool host_seen)
+{
+    if (!autostart_s || host_seen)
+        return false;
+    if (autostart_s > S264_AUTO_MAX_S)
+        autostart_s = S264_AUTO_MAX_S;
+    return elapsed_us >= (u64)autostart_s * 1000000ULL;
+}
+
+u64 s264_auto_payload_cap(const struct s264_config *cfg)
+{
+    /* layout (nwoas_s264_plan.c): adt_scratch = phys_base - 8 MiB, nvme_buf = phys_base - 2 MiB,
+     * audio_buf = phys_base - 1 MiB; py heap = [phys_base - py_heap_size, phys_base) */
+    if (cfg->py_heap_size <= 0x800000)
+        return 0;
+    return cfg->py_heap_size - 0x800000;
+}
+
+int s264_auto_compose(const struct s264_auto_files *f, struct s264_config *out)
+{
+    if (f->nowin_rc >= 0)
+        return S264_AUTO_NOWIN_WAIT;
+    if (f->cfg_rc >= 0) {
+        if (f->cfg_rc != 0 || f->cfg_size != sizeof(*out) || !f->cfg_bytes)
+            return S264_AUTO_BAD_CFG;
+        memcpy(out, f->cfg_bytes, sizeof(*out));
+        if (out->magic != S264_MAGIC || out->version != S264_VERSION || out->size != sizeof(*out))
+            return S264_AUTO_BAD_CFG;
+    } else {
+        s264_default_config(out);
+    }
+    if (f->payload_rc == 1)
+        return S264_AUTO_TOO_BIG;
+    if (f->payload_rc != 0)
+        return S264_AUTO_NO_PAYLOAD;
+    if (!f->payload_size)
+        return S264_AUTO_EMPTY;
+    out->payload_ptr = f->payload_ptr;
+    out->payload_size = f->payload_size;
+    out->flags |= S264_CFG_F_EXC_FATAL;
+    return S264_AUTO_LAUNCH;
+}
diff -ruN a/src/nwoas_s264_auto.h b/src/nwoas_s264_auto.h
--- a/src/nwoas_s264_auto.h	1970-01-01 09:00:00
+++ b/src/nwoas_s264_auto.h	2026-11-20 04:07:26
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * NWOAS S264G (roadmap 4-2): start the C launcher from the ESP when no MacBook proxy client attaches.
+ *   - Only armed by the m1n1 variable "nwoas_autostart=<seconds>" appended to the image (the ESP
+ *     \m1n1\boot.bin of PLAN-4-1); an image chainloaded by the MacBook (chainload.py -r) has no such
+ *     variable and behaves exactly as before.
+ *   - If any byte arrives on a proxy iodev before the deadline: today's behaviour (proxy).
+ *   - Deadline passed: ESP m1n1/nowin present -> keep waiting for the MacBook (proxy, forever);
+ *     else read m1n1/nwoas-s264.cfg (optional, exactly sizeof(struct s264_config)) and
+ *     m1n1/nwoas-payload.bin into the Python heap range, and LAUNCH.
+ * The composition below is pure (host-tested: nwoas_scripts/standalone-s264/s264g_auto_test.py).
+ * HARDWARE-UNVERIFIED.
+ */
+#ifndef NWOAS_S264_AUTO_H
+#define NWOAS_S264_AUTO_H
+
+#include "nwoas_s264_plan.h"
+
+#define S264_AUTO_ESP_UUID "a3e73003-c14a-487b-9f2e-8854fe119192" /* GPT slot 4 = Windows ESP */
+#define S264_AUTO_NOWIN    "m1n1/nowin"
+#define S264_AUTO_CFG      "m1n1/nwoas-s264.cfg"
+#define S264_AUTO_PAYLOAD  "m1n1/nwoas-payload.bin"
+#define S264_AUTO_MAX_S    600
+
+/* results of s264_auto_compose */
+#define S264_AUTO_LAUNCH     0
+#define S264_AUTO_NOWIN_WAIT 1 /* m1n1/nowin present: stay in the proxy */
+#define S264_AUTO_NO_PAYLOAD 2
+#define S264_AUTO_TOO_BIG    3 /* payload larger than the room below the launcher scratch */
+#define S264_AUTO_BAD_CFG    4 /* cfg file present but wrong size / magic / version: do not guess */
+#define S264_AUTO_EMPTY      5 /* payload of 0 bytes */
+
+/* rc values as returned by rust_load_file_into: 0 read, 1 too big, -1 missing/unreadable */
+struct s264_auto_files {
+    int nowin_rc;
+    int cfg_rc;
+    u64 cfg_size;
+    const u8 *cfg_bytes; /* cfg_size bytes when cfg_rc == 0 */
+    int payload_rc;
+    u64 payload_size;
+    u64 payload_ptr;
+};
+
+/* Deadline helper: true when the launcher should be started now. */
+bool s264_auto_should_fire(u32 autostart_s, u64 elapsed_us, bool host_seen);
+/* Room for the payload at py_heap_base: everything below the launcher scratch (top 8 MiB) and the
+ * audio / NVMe buffers (phys_base - 2 MiB) of the default config. */
+u64 s264_auto_payload_cap(const struct s264_config *cfg);
+/* Builds the launch config: default (or the file) + payload pointer/size + exception policy FATAL
+ * (nothing may wait for a MacBook that is not there). */
+int s264_auto_compose(const struct s264_auto_files *f, struct s264_config *out);
+
+#endif
