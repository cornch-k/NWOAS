+}
+
+/* ------------------------------------------------------------------ s264G auto-start (4-2) */
+u32 nwoas_autostart_s;
+extern int rust_load_file_into(const char *spec, void *dst, size_t cap, size_t *size);
+
+static int s264_esp_read(const char *path, void *dst, size_t cap, size_t *size)
+{
+    char spec[128];
+    snprintf(spec, sizeof(spec), "%s;%s", S264_AUTO_ESP_UUID, path);
+    *size = 0;
+    return rust_load_file_into(spec, dst, cap, size);
+}
+
+void nwoas_s264_autostart(void)
+{
+    static const char *const why[] = {"launch", "m1n1/nowin present: waiting for the MacBook",
+                                      "no m1n1/nwoas-payload.bin", "payload too large",
+                                      "m1n1/nwoas-s264.cfg has a wrong size/magic/version",
+                                      "payload is empty"};
+    static struct s264_config cfg, tmp;
+    static u8 cfgbuf[sizeof(struct s264_config)];
+    printf("HVLOG: S264G no MacBook proxy client within %u s: auto-start from the ESP\n",
+           nwoas_autostart_s);
+    if (s264_launched)
+        return;
+    if (!nvme_init()) {
+        printf("HVLOG: S264G nvme_init failed: staying in the proxy\n");
+        return;
+    }
+    struct s264_auto_files f;
+    memset(&f, 0, sizeof(f));
+    size_t sz = 0;
+    f.nowin_rc = s264_esp_read(S264_AUTO_NOWIN, NULL, 0, &sz);
+    f.cfg_rc = -1;
+    f.payload_rc = -1;
+    if (f.nowin_rc < 0) {
+        f.cfg_rc = s264_esp_read(S264_AUTO_CFG, cfgbuf, sizeof(cfgbuf), &sz);
+        f.cfg_size = sz;
+        f.cfg_bytes = cfgbuf;
+        /* payload goes where run_guest.py's ProxyUtils heap starts (above the m1n1 heap reserve) */
+        if (f.cfg_rc == 0 && sz == sizeof(tmp))
+            memcpy(&tmp, cfgbuf, sizeof(tmp));
+        else
+            s264_default_config(&tmp);
+        u64 dst = ((u64)heapblock_alloc(0) + tmp.m1n1_heap_reserve + 0x3fff) & ~0x3fffULL;
+        f.payload_ptr = dst;
+        f.payload_rc =
+            s264_esp_read(S264_AUTO_PAYLOAD, (void *)dst, (size_t)s264_auto_payload_cap(&tmp), &sz);
+        f.payload_size = sz;
+    }
+    nvme_shutdown();
+    int rc = s264_auto_compose(&f, &cfg);
+    printf("HVLOG: S264G auto-start: nowin %d cfg %d (%lu B) payload %d (%lu B at 0x%lx) -> %s\n",
+           f.nowin_rc, f.cfg_rc, (unsigned long)f.cfg_size, f.payload_rc, (unsigned long)f.payload_size,
+           (unsigned long)f.payload_ptr, rc >= 0 && rc <= 5 ? why[rc] : "?");
+    if (rc != S264_AUTO_LAUNCH)
+        return;
+    uartproxy_iodev = IODEV_USB0; /* the port the MacBook would use (s264 tests: iodev 3) */
+    int r = s264_prepare((u64)&cfg, sizeof(cfg));
+    if (r < 0) {
+        printf("HVLOG: S264G plan error %d (err %u arg 0x%x): staying in the proxy\n", r, s264_pl.err,
+               s264_pl.err_arg);
+        return;
+    }
+    printf("HVLOG: S264G C launcher: %u ops, phys_base=0x%lx entry=0x%lx flags=0x%x\n", s264_pl.n_ops,
+           s264_pl.L.phys_base, s264_pl.L.entry, cfg.flags);
+    r = s264_execute();
+    printf("HVLOG: S264G launcher returned %d: staying in the proxy\n", r);
 }
 
