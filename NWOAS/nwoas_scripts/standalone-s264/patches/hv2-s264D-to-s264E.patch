+/* s264E: bt-s261 control page (nwoas_bt_s261.py bt_hook_read / bt_hook_write) */
+static bool s264_hook_bt(struct exc_info *ctx, u64 addr, u64 *val, bool write, int width)
+{
+    UNUSED(ctx);
+    u32 off = (u32)(addr - 0x348004000ULL);
+    if (write) {
+        nwoas_s264_cnt.wifi_writes++;
+        /* CMD (ensure may power the whole chip) and RESET (FLR, 110 ms): as under the proxy, the
+         * other CPUs are rendezvoused and the time is hidden (see s264_hook_wifi) */
+        bool longw = off == 0x10 || off == 0x40;
+        u64 t0 = 0;
+        if (longw) {
+            hv_rendezvous();
+            t0 = mrs(CNTPCT_EL0);
+        }
+        hv_wdt_suspend();
+        s264w_bt_hook_write(&s264w_drv, off, val[0], width);
+        hv_wdt_resume();
+        if (longw)
+            hv_add_time(-(s64)(mrs(CNTPCT_EL0) - t0));
+    } else {
+        nwoas_s264_cnt.wifi_reads++;
+        val[0] = s264w_bt_hook_read(&s264w_drv, off, width);
+    }
+    return true;
+}
+
+/* s264E: bt-s261-bar-fence (all-ones / dropped while the chip may not decode the fn1 BARs) */
+static bool s264_hook_bt_fence(struct exc_info *ctx, u64 addr, u64 *val, bool write, int width)
+{
+    UNUSED(ctx);
+    if (write) {
+        s264w_fence_write(&s264w_drv, addr, width);
+    } else {
+        u64 v = s264w_fence_read(&s264w_drv, addr, width);
+        int n = width > 3 ? (1 << width) / 8 : 1;
+        for (int k = 0; k < n; k++)
+            val[k] = v;
+    }
+    return true;
+}
