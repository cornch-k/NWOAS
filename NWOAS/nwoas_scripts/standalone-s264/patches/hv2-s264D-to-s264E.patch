+int s264_bt_page_init(const u8 *adt, u32 len, const struct s264_wifi_page *wlan, struct s264_bt_page *b,
+                      bool bt_on)
+{
+    /* nwoas_bt_s261.py:140-148 bt_info, 180-196 _bt_regs; bt_module.py:103-107 checks */
+    memset(b, 0, sizeof(*b));
+    memcpy(b->board, wlan->board, sizeof(b->board));
+    int n = s264_adt_path(adt, len, "/arm-io/bluetooth");
+    if (n < 0)
+        return 40; /* adt['/arm-io/bluetooth'] raises (also with NWOAS_BT=0) */
+    u32 al = 0, cl = 0, fl = 0;
+    const u8 *a = s264_adt_prop(adt, len, n, "local-mac-address", &al);
+    const u8 *c = s264_adt_prop(adt, len, n, "bluetooth-taurus-calibration", &cl);
+    const u8 *f = s264_adt_prop(adt, len, n, "bluetooth-taurus-calibration-bf", &fl);
+    if (!c)
+        cl = 0;
+    if (!f)
+        fl = 0;
+    b->bd_ok = a && al == 6;
+    if (b->bd_ok) {
+        b->bdaddr_lo = rd32(a);
+        b->bdaddr_hi = (u32)a[4] | ((u32)a[5] << 8);
+    }
+    b->raw_cal_len = cl;
+    b->raw_calbf_len = fl;
+    if (cl <= 0x1800) {
+        b->cal_len = cl;
+        memcpy(b->cal, c, cl);
+    }
+    if (fl <= 0x1800) {
+        b->calbf_len = fl;
+        memcpy(b->calbf, f, fl);
+    }
+    if (!bt_on)
+        return 0;
+    if (!b->bd_ok)
+        return 41;
+    if (!(0 < fl && fl <= 0x1800))
+        return 43;
+    if (!(0 < cl && cl <= 0x1800))
+        return 42;
+    return 0;
+}
