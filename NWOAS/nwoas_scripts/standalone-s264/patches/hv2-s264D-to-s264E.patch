+    bool ok = rb[0] == FN1_BAR0_BUS && rb[1] == FN1_BAR2_BUS && rb[2] == FN1_CMD_QUIET &&
+              !(rb[3] & (DEVCTL_NS_RO | DEVCTL_FLR));
+    w->bt_reset_result = ok ? RESET_OK : RESET_MISMATCH;
+    WLOGF("reset: FLR done ok=%d bar0=0x%x bar2=0x%x cmd=0x%x devctl=0x%x", ok, rb[0], rb[1], rb[2], rb[3]);
+    return;
+ex:
+    g_abort(w);
+    w->bt_reset_result = RESET_EXCEPTION;
+    wlog(w, "reset: FLR exception");
+}
+
+/* B:243-273 */
+static void bt_arm(struct s264w *w, u32 val)
+{
+    if (w->bt_state != BT_UP || !w->have_up) {
+        w->bt_arm_result = ARM_NOT_UP;
+    } else if (val != w->bt_gen) {
+        w->bt_arm_result = ARM_STALE;
+    } else {
+        bool ok = false;
+        u32 b = g_begin(w);
+        u32 a0 = r32(w, ecfg1(w, 0x10)) & ~0xfu, a2 = r32(w, ecfg1(w, 0x18)) & ~0xfu,
+            ac = r32(w, ecfg1(w, 0x04)) & 0x2;
+        int r = X_OK;
+        if (!(a0 == FN1_BAR0_BUS && a2 == FN1_BAR2_BUS && ac == 0x2)) {
+            if ((r = w32(w, ecfg1(w, 0x10), FN1_BAR0_BUS)) || (r = w32(w, ecfg1(w, 0x14), 0)) ||
+                (r = w32(w, ecfg1(w, 0x18), FN1_BAR2_BUS)) || (r = w32(w, ecfg1(w, 0x1c), 0)) ||
+                (r = w32(w, ecfg1(w, 0x04), FN1_CMD_QUIET))) {
+            } else {
+                w->bt_epcmd = FN1_CMD_QUIET;
+            }
+        }
+        if (r) {
+            g_abort(w);
+            wlog(w, "arm raised");
+        } else {
+            u32 c0 = r32(w, ecfg1(w, 0x10)) & ~0xfu, c2 = r32(w, ecfg1(w, 0x18)) & ~0xfu,
+                cc = r32(w, ecfg1(w, 0x04)) & 0x2;
+            u32 exc = g_end(w, b);
+            ok = c0 == FN1_BAR0_BUS && c2 == FN1_BAR2_BUS && cc == 0x2 && !exc;
+            WLOGF("arm gen=%u ok=%d", val, ok);
+        }
+        if (ok) {
+            fence(w, false, "arm", true);
+            w->bt_arm_result = ARM_OK;
+        } else {
+            w->bt_arm_result = ARM_BARS;
+        }
+    }
+    WLOGF("ARM %u -> %u (fn1 state %u, gen %u)", val, w->bt_arm_result, w->bt_state, w->bt_gen);
+}
+
+/* B:113-137 bt_cfg_write_policy */
+static bool bt_policy(struct s264w *w, u32 off, u32 val, u32 cur, u32 *out)
+{
+    u32 pcie = w->cap_pcie, msi = w->cap_msi;
+    for (u32 i = 0; i < 5; i++)
+        if (off == fn1_window_regs[i]) {
+            if ((val & 0xfff) == 0 && 0x18000000u <= val && val <= 0x1ffff000u) {
+                *out = val;
+                return true;
+            }
+            return false;
+        }
+    if (off == FN1_SUBSYS_CTRL) {
+        *out = (cur & ~SUBSYS_BITS) | (val & SUBSYS_BITS);
+        return true;
+    }
+    if (off == 0x04) {
+        *out = (val & (CMD_BME | CMD_INTX_DIS)) | CMD_MEM;
+        return true;
+    }
+    if (pcie && off == pcie + 8) {
+        *out = val & 0xffff & ~DEVCTL_NS_RO & ~DEVCTL_FLR;
+        return true;
+    }
+    if (pcie && off == pcie + 0x10) {
+        *out = (cur & 0xffff & ~ASPM_MASK) | (val & ASPM_MASK);
+        return true;
+    }
+    if (msi) {
+        u32 data_off = msi + (w->cap_msi64 ? 0xc : 0x8);
+        if (off == msi) {
+            *out = (cur & ~(MSI_ENABLE | MSI_MME)) | (val & MSI_ENABLE);
+            return true;
+        }
+        if (off == msi + 4) {
+            if ((val & 3) == 0 && MSI_ADDR_MIN <= val && val < MSI_ADDR_MAX) {
+                *out = val;
+                return true;
+            }
+            return false;
+        }
+        if (w->cap_msi64 && off == msi + 8) {
+            if (val == 0) {
+                *out = 0;
+                return true;
+            }
+            return false;
+        }
+        if (off == data_off) {
+            *out = val & 0xffff;
+            return true;
+        }
+    }
+    return false;
+}
+
+static u32 bt_cfg_read(struct s264w *w, u32 off)
+{
+    w->bt_cfg_reads++;
+    if ((w->bt_state != BT_UP && w->bt_state != BT_QUIET) || !w->have_up) {
+        w->bt_cfg_err = CFG_NOT_UP;
+        return 0xffffffffu;
+    }
+    if ((off & 3) || off >= 0x1000) {
+        w->bt_cfg_err = CFG_BAD_OFFSET;
+        return 0xffffffffu;
+    }
+    u32 b = g_begin(w);
+    u32 v = r32(w, ecfg1(w, off));
+    u32 exc = g_end(w, b);
+    w->bt_cfg_err = exc ? CFG_EXCEPTION : CFG_OK;
+    return exc ? 0xffffffffu : v;
+}
+
+/* false = Python raised out of bt_reg_write */
+static bool bt_cfg_write(struct s264w *w, u32 off, u32 val)
+{
+    w->bt_cfg_writes++;
+    if (w->bt_state != BT_UP || !w->have_up) {
+        w->bt_cfg_err = CFG_NOT_UP;
+        return true;
+    }
+    if ((off & 3) || off >= 0x1000) {
+        w->bt_cfg_err = CFG_BAD_OFFSET;
+        return true;
+    }
+    u32 cur = 0;
+    bool rd = off == FN1_SUBSYS_CTRL || (w->have_caps && w->cap_pcie && off == w->cap_pcie + 0x10) ||
+              (!w->cap_pcie && off == 0xf) || (w->cap_msi && off == w->cap_msi);
+    if (rd) {
+        u32 b = g_begin(w);
+        cur = r32(w, ecfg1(w, off));
+        g_end(w, b);
+    }
+    u32 v = 0;
+    bool okp = bt_policy(w, off, val, cur, &v);
+    if (okp && w->cap_msi && off == w->cap_msi && (v & MSI_ENABLE)) {
+        u32 b = g_begin(w);
+        u32 lo = r32(w, ecfg1(w, w->cap_msi + 4));
+        u32 hi = w->cap_msi64 ? r32(w, ecfg1(w, w->cap_msi + 8)) : 0;
+        g_end(w, b);
+        if (hi || (lo & 3) || !(MSI_ADDR_MIN <= lo && lo < MSI_ADDR_MAX))
+            okp = false;
+    }
+    if (!okp) {
+        w->bt_cfg_refused++;
+        w->bt_cfg_err = CFG_NOT_ALLOWED;
+        if (w->bt_cfg_refused <= 16)
+            WLOGF("fn1 config write refused off=0x%x val=0x%x", off, val);
+        return true;
+    }
+    u32 b = g_begin(w);
+    if (w32(w, ecfg1(w, off), v)) {
+        g_abort(w);
+        return false;
+    }
+    u32 exc = g_end(w, b);
+    if (off == 0x04)
+        w->bt_epcmd = v & 0xffff;
+    if (w->cap_pcie && off == w->cap_pcie + 8)
+        w->bt_devctl = v & 0xffff;
+    w->bt_cfg_err = exc ? CFG_EXCEPTION : CFG_OK;
+    if (w->bt_cfg_writes <= 64)
+        WLOGF("fn1 config write off=0x%x val=0x%x -> 0x%x err=%u", off, val, v, w->bt_cfg_err);
+    return true;
+}
+
+u32 s264w_bt_reg_read(struct s264w *w, u32 off)
+{
+    const struct s264_bt_page *bp = w->bp;
+    if (off == R_CFG_DATA)
+        return bt_cfg_read(w, w->bt_cfg_off);
+    if (off == B_R_BDADDR_LO)
+        return bp->bdaddr_lo;
+    if (off == B_R_BDADDR_HI)
+        return bp->bdaddr_hi;
+    if (off >= B_R_BOARD && off < B_R_BOARD + 16 && !(off & 3))
+        return bp->board[(off - B_R_BOARD) / 4];
+    if (off == B_R_CAL_LEN)
+        return bp->cal_len;
+    if (off == B_R_CALBF_LEN)
+        return bp->calbf_len;
+    if (off >= B_CAL_OFF && off < B_CAL_OFF + ((bp->cal_len + 3) & ~3u) && !(off & 3))
+        return bp->cal[(off - B_CAL_OFF) / 4];
+    if (off >= B_CALBF_OFF && off < B_CALBF_OFF + ((bp->calbf_len + 3) & ~3u) && !(off & 3))
+        return bp->calbf[(off - B_CALBF_OFF) / 4];
+    bool up = w->bt_state == BT_UP || w->bt_state == BT_QUIET;
+    switch (off) {
+        case R_MAGIC:
+            return BT_MAGIC;
+        case R_VERSION:
+            return 1;
+        case R_STATE:
+            return w->bt_state;
+        case R_ERROR:
+            return w->bt_error;
+        case R_CMD:
+            return w->bt_last_cmd;
+        case R_SEQ:
+            return w->bt_seq;
+        case R_AVAIL:
+            return w->bt_avail;
+        case R_IDS:
+            return w->bt_ids;
+        case R_CFG_OFF:
+            return w->bt_cfg_off;
+        case R_CFG_ERR:
+            return w->bt_cfg_err;
+        case B_R_BAR0:
+            return up ? FN1_BAR0_BUS : 0;
+        case B_R_BAR2:
+            return up ? FN1_BAR2_BUS : 0;
+        case B_R_CHIP_STATE:
+            return w->state;
+        case B_R_DEVCTL:
+            return w->bt_devctl;
+        case B_R_EPCMD:
+            return w->bt_epcmd;
+        case B_R_RESET:
+            return w->bt_reset_result;
+        case B_R_RESET_COUNT:
+            return w->bt_reset_count;
+        case B_R_EPOCH:
+            return w->epoch;
+        case B_R_RID2SID:
+            return w->bt_rid2sid;
+        case B_R_CMD_COUNT:
+            return w->bt_cmd_count;
+        case B_R_WINDOW:
+            return w->bt_window;
+        case B_R_DEVCAP:
+            return w->bt_devcap;
+        case B_R_MSICAP:
+            return w->cap_msi;
+        case B_R_GEN:
+            return w->bt_gen;
+        case B_R_ARM:
+            return w->bt_arm_result;
+        default:
+            return 0;
+    }
+}
+
+static bool bt_reg_write(struct s264w *w, u32 off, u32 val)
+{
+    if (off == R_CMD) {
+        w->bt_last_cmd = val;
+        w->bt_cmd_count++;
+        WLOGF("CMD 0x%x (fn1 state %u, chip state %u)", val, w->bt_state, w->state);
+        if (val == BT_CMD_ENSURE)
+            bt_ensure(w);
+        else if (val == BT_CMD_QUIET)
+            bt_quiet(w);
+        else
+            WLOGF("CMD 0x%x ignored (unknown)", val);
+        w->bt_seq++;
+    } else if (off == R_CFG_OFF) {
+        w->bt_cfg_off = val & 0xfff;
+        w->bt_cfg_err = (val == w->bt_cfg_off && !(val & 3)) ? CFG_OK : CFG_BAD_OFFSET;
+    } else if (off == R_CFG_DATA) {
+        return bt_cfg_write(w, w->bt_cfg_off, val);
+    } else if (off == B_R_RESET) {
+        if (val == 1)
+            bt_reset(w);
+    } else if (off == B_R_ARM) {
+        bt_arm(w, val);
+    } else {
+        WLOGF("write 0x%x = 0x%x ignored (read-only)", off, val);
+    }
+    return true;
+}
+
+void s264w_bt_reg_write(struct s264w *w, u32 off, u32 val)
+{
+    if (!bt_reg_write(w, off, val)) {
+        w->bt_state = BT_FAILED; /* B:627-629 */
+        w->bt_error = BE_ERROR;
+    }
+}
+
+u64 s264w_bt_hook_read(struct s264w *w, u32 off, int width)
+{
+    u32 base = off & ~3u;
+    if (width == 3)
+        return (u64)s264w_bt_reg_read(w, base) | ((u64)s264w_bt_reg_read(w, base + 4) << 32);
+    u64 v = s264w_bt_reg_read(w, base) >> (8 * (off & 3));
+    return v & ((1ULL << (8 << width)) - 1);
+}
+
+void s264w_bt_hook_write(struct s264w *w, u32 off, u64 val, int width)
+{
+    if (width == 2 && !(off & 3))
+        s264w_bt_reg_write(w, off, (u32)val);
+    else
+        WLOGF("write 0x%x/%d ignored (32-bit aligned only)", off, 8 << width);
+}
+
+void s264w_bt_init(struct s264w *w, struct s264_bt_page *bp, bool bt_enabled)
+{
+    /* B:152-178 */
+    w->bp = bp;
+    w->bt_enabled = bt_enabled && w->enabled;
+    w->bt_state = BT_OFF;
+    w->bt_gen = 1;
+    w->bt_arm_result = ARM_NONE;
+    w->fence_on_wifi_reset = true;
+    if (!w->enabled) {
+        w->bt_state = BT_FAILED;
+        w->bt_error = BE_WIFI_DISABLED;
+    } else if (!bt_enabled) {
+        w->bt_state = BT_FAILED;
+        w->bt_error = BE_DISABLED;
+    }
+}
+
