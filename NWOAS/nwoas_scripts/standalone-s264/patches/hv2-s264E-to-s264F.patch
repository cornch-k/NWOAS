diff -ruN a/src/nwoas_s264_pwr.c b/src/nwoas_s264_pwr.c
--- a/src/nwoas_s264_pwr.c	1970-01-01 09:00:00
+++ b/src/nwoas_s264_pwr.c	2026-11-20 03:47:24
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: MIT */
+/* NWOAS S264F: power-s260/power_module.py in C (see nwoas_s264_pwr.h).  P = power_module.py. */
+#include "nwoas_s264_pwr.h"
+
+#ifdef S264_HOST
+#include <stdio.h>
+typedef int64_t s64;
+#else
+#include "string.h"
+#include "utils.h"
+#endif
+
+#define OP_QUERY 0
+#define OP_CONFIG 1
+#define OP_SNAPSHOT 2
+#define OP_SMC_READ 3
+#define OP_SLC 4
+#define OP_MCC_STAT 5
+#define F_SMC_SENSE (1u << 5)
+#define PWR_MAGIC 0x5057524eULL
+
+/* P:68-76 _pwr_mcc */
+static void mcc(const struct s264_pwr_io *io, u64 buf, char *out, unsigned long n)
+{
+    u64 r = io->pwr(OP_MCC_STAT, buf, 16, 0, 0);
+    if (r >> 63 || r == 0) {
+        snprintf(out, n, "None");
+        return;
+    }
+    u32 w[16];
+    if (r > 16)
+        r = 16;
+    io->mem_read(buf, w, (u32)(4 * r));
+    unsigned long k = 0;
+    out[0] = 0;
+    for (u64 i = 0; i + 1 < r && k + 40 < n; i += 2)
+        k += (unsigned long)snprintf(out + k, n - k, "%s{enable 0x%x status 0x%x}", i ? "," : "", w[i], w[i + 1]);
+}
+
+int s264_pwr_run(const struct s264_pwr_io *io, u64 buf, u32 flags, u32 sec_hz, u32 gap_us, u32 print_s,
+                 bool slc)
+{
+    char m[256], a[128], b2[128];
+    /* P:50-51 */
+    if (io->pwr(OP_QUERY, 0, 0, 0, 0) != ((PWR_MAGIC << 32) | 1)) {
+        io->log("NWOAS-PWR STOP: HV has no S260 power interface (S264F C)");
+        return 1;
+    }
+    /* P:54-57 _pwr_config */
+    if (io->pwr(OP_CONFIG, flags, sec_hz, gap_us, print_s) != ((1ULL << 32) | flags)) {
+        io->log("NWOAS-PWR STOP: HV refused the S260 config (S264F C)");
+        return 2;
+    }
+    /* P:121-129 */
+    mcc(io, buf, a, sizeof(a));
+    if (slc) {
+        u64 rc = io->pwr(OP_SLC, 1, 0, 0, 0);
+        mcc(io, buf, b2, sizeof(b2));
+        snprintf(m, sizeof(m), "NWOAS-PWR SLC enable rc=%ld before=%s after=%s (S264F C)", (long)(s64)rc, a, b2);
+    } else {
+        snprintf(m, sizeof(m), "NWOAS-PWR SLC (not enabled by S260) status=%s (S264F C)", a);
+    }
+    io->log(m);
+    snprintf(m, sizeof(m), "NWOAS-PWR S260 config flags=0x%x sectick_hz=%u tgap_us=%u print_s=%u (S264F C)",
+             flags, sec_hz, gap_us, print_s);
+    io->log(m);
+    /* P:130 _pwr_mark('boot', 0): snapshot (+ SMC read) */
+    if (io->pwr(OP_SNAPSHOT, buf, S264_PWR_SNAP_SIZE, 0, 0) != S264_PWR_SNAP_SIZE) {
+        io->log("NWOAS-PWR STOP: snapshot size (S264F C)");
+        return 3;
+    }
+    if (flags & F_SMC_SENSE) {
+        /* nwoas_pwr_layout.py DEFAULT_SMC_KEYS PSTR,PDTR,PMVR,TH0x,TW0P,F0Ac, smc_key = big-endian */
+        static const char keys[6][4] = {{'P', 'S', 'T', 'R'}, {'P', 'D', 'T', 'R'}, {'P', 'M', 'V', 'R'},
+                                        {'T', 'H', '0', 'x'}, {'T', 'W', '0', 'P'}, {'F', '0', 'A', 'c'}};
+        u8 kb[24];
+        for (int i = 0; i < 6; i++)
+            for (int j = 0; j < 4; j++)
+                kb[4 * i + j] = (u8)keys[i][3 - j]; /* to_bytes(4, 'little') of the big-endian key */
+        io->mem_write(buf, kb, sizeof(kb));
+        u64 ok = io->pwr(OP_SMC_READ, buf, 6, buf + 64, 0);
+        u64 vals[6];
+        io->mem_read(buf + 64, vals, sizeof(vals));
+        snprintf(m, sizeof(m), "NWOAS-PWR mark boot flags=0x%x smc ok=%lu (S264F C)", flags, (unsigned long)ok);
+    } else {
+        snprintf(m, sizeof(m), "NWOAS-PWR mark boot flags=0x%x (S264F C)", flags);
+    }
+    io->log(m);
+    return 0;
+}
diff -ruN a/src/nwoas_s264_pwr.h b/src/nwoas_s264_pwr.h
--- a/src/nwoas_s264_pwr.h	1970-01-01 09:00:00
+++ b/src/nwoas_s264_pwr.h	2026-11-20 03:47:24
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * NWOAS S264F: power-s260/power_module.py (S260 power interface, as the S268 launcher runs it with the
+ * S262 default) in C.  The module's work before the guest starts is a fixed sequence of
+ * P_HV_NWOAS_PWR requests (QUERY, CONFIG, MCC_STAT, [SLC + MCC_STAT], boot mark = SNAPSHOT
+ * [+ SMC_READ]); here they are the same calls into nwoas_pwr_proxy(), through struct s264_pwr_io so
+ * the host test (nwoas_scripts/standalone-s264/s264f_pwr_test.py) can compare them with the real
+ * Python module.  Not ported: the NWSTAT-MARK / NWSTAT-SET job-output hook (needs the MacBook link
+ * transport; the C launcher has no NS2 job channel) and the hvstats.jsonl file on the MacBook.
+ * HARDWARE-UNVERIFIED.
+ */
+#ifndef NWOAS_S264_PWR_H
+#define NWOAS_S264_PWR_H
+
+#include "nwoas_s264_plan.h"
+
+struct s264_pwr_io {
+    u64 (*pwr)(u64 op, u64 a0, u64 a1, u64 a2, u64 a3); /* p.request(P_HV_NWOAS_PWR, ...) */
+    void (*mem_write)(u64 pa, const void *src, u32 len);  /* iface.writemem */
+    void (*mem_read)(u64 pa, void *dst, u32 len);         /* iface.readmem */
+    void (*log)(const char *msg);                         /* hv.log */
+};
+
+#define S264_PWR_SNAP_SIZE 2368 /* nwoas_pwr_layout.py SIZE = sizeof(struct nwoas_pwr_snapshot) */
+
+/* 0 = done; 1 = QUERY answer wrong, 2 = CONFIG refused (Python asserts: the launch stops),
+ * 3 = SNAPSHOT size wrong (assert). buf = scratch >= S264_PWR_SNAP_SIZE + 256 bytes. */
+int s264_pwr_run(const struct s264_pwr_io *io, u64 buf, u32 flags, u32 sec_hz, u32 gap_us, u32 print_s,
+                 bool slc);
+
+#endif
