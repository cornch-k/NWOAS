+/* ------------------------------------------------------- s264C exception policy */
+/* Shadow sysregs of proxyclient handle_msr (hv/__init__.py:754-797): MDSCR_EL1, VMSA_LOCK_EL1,
+ * DBGBVR/BCR n < 5, DBGWVR/WCR n < 4 (len(self._bps) = 5, len(self._wps) = 4, :144-146). */
+#define S264_SHADOW_N 20
+static u64 s264_shadow[MAX_CPUS][S264_SHADOW_N];
+
+static int s264_shadow_slot(u32 op0, u32 op1, u32 crn, u32 crm, u32 op2)
+{
+    if (op0 == 2 && op1 == 0 && crn == 0 && crm == 2 && op2 == 2)
+        return 0; /* MDSCR_EL1 */
+    if (op0 == 3 && op1 == 4 && crn == 15 && crm == 1 && op2 == 2)
+        return 1; /* VMSA_LOCK_EL1 (tools/apple_regs.json) */
+    if (op0 == 2 && op1 == 0 && crn == 0) {
+        if (op2 == 4 && crm < 5)
+            return 2 + crm; /* DBGBVRn_EL1 */
+        if (op2 == 5 && crm < 5)
+            return 7 + crm; /* DBGBCRn_EL1 */
+        if (op2 == 6 && crm < 4)
+            return 12 + crm; /* DBGWVRn_EL1 */
+        if (op2 == 7 && crm < 4)
+            return 16 + crm; /* DBGWCRn_EL1 */
+    }
+    return -1;
+}
+
+bool nwoas_s264_msr_policy(struct exc_info *ctx, u64 reg, u64 rt, bool is_read)
+{
+    if (!(nwoas_s264_policy & S264_POL_LOCAL))
+        return false;
+    u32 op0 = (u32)((reg & ESR_ISS_MSR_OP0) >> ESR_ISS_MSR_OP0_SHIFT);
+    u32 op1 = (u32)((reg & ESR_ISS_MSR_OP1) >> ESR_ISS_MSR_OP1_SHIFT);
+    u32 crn = (u32)((reg & ESR_ISS_MSR_CRn) >> ESR_ISS_MSR_CRn_SHIFT);
+    u32 crm = (u32)((reg & ESR_ISS_MSR_CRm) >> ESR_ISS_MSR_CRm_SHIFT);
+    u32 op2 = (u32)((reg & ESR_ISS_MSR_OP2) >> ESR_ISS_MSR_OP2_SHIFT);
+    u64 *regs = ctx->regs;
+    u32 cpu = (u32)mrs(TPIDR_EL2);
+    int slot = s264_shadow_slot(op0, op1, crn, crm, op2);
+    if (slot >= 0 && cpu < MAX_CPUS) {
+        if (is_read)
+            regs[rt] = s264_shadow[cpu][slot];
+        else
+            s264_shadow[cpu][slot] = regs[rt];
+        nwoas_s264_cnt.msr_shadow++;
+        return true;
+    }
+    if (op0 == 3 && op1 == 5 && crn == 15 && crm == 6 && op2 == 0) { /* ACC_OVRD_EL1 */
+        if (is_read)
+            regs[rt] = mrs(SYS_IMP_APL_ACC_OVRD); /* Python "Pass" read */
+        nwoas_s264_cnt.msr_skip += is_read ? 0 : 1; /* "Skip" write (ro set) */
+        nwoas_s264_cnt.msr_pass += is_read ? 1 : 0;
+        return true;
+    }
+    if (op0 == 3 && op1 == 5 && crn == 15 && crm == 5 && op2 == 0 && !is_read) { /* CYC_OVRD */
+        if (regs[rt] & 1)
+            return false; /* Python: "Guest is shutting down CPU" -> hv_exit_cpu: not ported */
+        nwoas_s264_cnt.msr_skip++;
