+bool s264_lower_calc(u64 spsr, u64 vbar_el12, u32 exc_code, u64 *new_spsr, u64 *new_elr)
+{
+    u64 off = 0x80ULL * exc_code;
+    u32 m = (u32)(spsr & 0xf);         /* SPSR.M[3:0] (AArch64) */
+    if (spsr & 0x10)                   /* M[4] = AArch32: not a mode _lower handles */
+        return false;
+    if (m == 0x0)                      /* EL0t */
+        off += 0x400;
+    else if (m == 0x4)                 /* EL1t */
+        ;
+    else if (m == 0x5)                 /* EL1h */
+        off += 0x200;
+    else
+        return false;                  /* "Unknown exception level" */
+    u64 s = (spsr & ~0xfULL) | 0x5;    /* M = EL1h */
+    s |= (1ULL << 9) | (1ULL << 8) | (1ULL << 7) | (1ULL << 6); /* D A I F */
+    *new_spsr = s;
+    *new_elr = vbar_el12 + off;
+    return true;
+}
