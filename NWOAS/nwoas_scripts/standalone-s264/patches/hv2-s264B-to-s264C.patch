diff -ruN --exclude build s264B-base/src/nwoas_ans_irq.h b/src/nwoas_ans_irq.h
--- s264B-base/src/nwoas_ans_irq.h	1970-01-01 09:00:00
+++ b/src/nwoas_ans_irq.h	2026-11-19 23:34:48
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: MIT */
+/* NWOAS S262 (g262R): pick the ANS2 NVMe completion interrupt out of the ADT /arm-io/ans node.
+ *
+ * Header-only and free of m1n1 state so the host test (tools-hv2/hosttest/test_ansirq_g262R.c)
+ * runs this exact code against the real J274 ADT dump.
+ *
+ * Observed (J274, iBoot-8422.141.2 / macOS 13.5 ADT dump 2026-11-16, adt.bin sha256 32e63706...):
+ *   /arm-io/ans  interrupt-parent = 0x5f (= /arm-io/aic AAPL,phandle)
+ *                interrupts       = 48 02 00 00 47 02 00 00 4a 02 00 00 49 02 00 00 4e 02 00 00
+ *                                 = 584, 583, 586, 585, 590   (20 bytes, 5 cells)
+ * Linux arch/arm64/boot/dts/apple/t8103.dtsi gives the four ASC mailbox lines 583..586 to
+ * ans_mbox (send-empty, send-not-empty, recv-empty, recv-not-empty) and AIC_IRQ 590 to
+ * nvme@27bcc0000 (the apple,nvme-ans2 completion interrupt).  g262Q accepted only a 4-byte
+ * property, so it found no line on this machine and fell back to polling.
+ *
+ * Rule: 1 cell -> that cell; 5 cells -> the 5th (the line that is not one of the four
+ * mailbox lines); anything else is refused (no guessing).  The parent must be the AIC. */
+#ifndef NWOAS_ANS_IRQ_H
+#define NWOAS_ANS_IRQ_H
+
+enum {
+    NWOAS_ANS_IRQ_OK = 0,
+    NWOAS_ANS_IRQ_NO_NODE = 2,     /* no /arm-io/ans */
+    NWOAS_ANS_IRQ_NO_PROP = 3,     /* no interrupts property */
+    NWOAS_ANS_IRQ_CELLS = 4,       /* cell count is not 1 or 5 (or length not a multiple of 4) */
+    NWOAS_ANS_IRQ_PARENT = 5,      /* interrupt-parent missing or not the AIC phandle */
+    NWOAS_ANS_IRQ_RANGE = 6,       /* line 0 or >= the AIC line count */
+    NWOAS_ANS_IRQ_MAILBOX = 7,     /* 5 cells but the 5th repeats one of the first four */
+};
+
+/* cells/len: the interrupts property; parent: interrupt-parent (0 = missing); aic_phandle:
+ * /arm-io/aic AAPL,phandle (0 = unknown); nr_irq: AIC line count (0 = unknown, then < 0x1000).
+ * Returns 0 and sets *irq / *index, or one of the reasons above. */
+static inline int nwoas_ans_irq_pick(const unsigned int *cells, unsigned int len, unsigned int parent,
+                                     unsigned int aic_phandle, unsigned int nr_irq,
+                                     unsigned int *irq, unsigned int *index)
+{
+    *irq = 0;
+    *index = 0;
+    if (!cells)
+        return NWOAS_ANS_IRQ_NO_PROP;
+    if (!parent || !aic_phandle || parent != aic_phandle)
+        return NWOAS_ANS_IRQ_PARENT;
+    if (len % 4)
+        return NWOAS_ANS_IRQ_CELLS;
+    unsigned int n = len / 4, i;
+    if (n == 1)
+        i = 0;
+    else if (n == 5)
+        i = 4;
+    else
+        return NWOAS_ANS_IRQ_CELLS;
+    for (unsigned int k = 0; k < i; k++)
+        if (cells[k] == cells[i])
+            return NWOAS_ANS_IRQ_MAILBOX;
+    unsigned int limit = nr_irq ? nr_irq : 0x1000;
+    if (!cells[i] || cells[i] >= limit)
+        return NWOAS_ANS_IRQ_RANGE;
+    *irq = cells[i];
+    *index = i;
+    return NWOAS_ANS_IRQ_OK;
+}
+
+#endif
