+ * uartproxy_run return with next_stage set, and the normal tail hands over.  Never returns. */
+void nwoas_stage1_fallback(void)
+{
+    exc_recover_pc = 0; /* a fault inside the fallback itself reboots (nothing left to fall back to) */
+    printf("NWOAS-STAGE1: USB proxy fallback (waiting for the MacBook)\n");
+    usb_init();
