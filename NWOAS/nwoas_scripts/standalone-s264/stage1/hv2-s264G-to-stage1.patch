+/* The upstream m1n1_main tail (NWOAS 4-1: a function, so the stage-1 fallback proxy can hand over too). */
+static void __attribute__((noreturn)) nwoas_handover(void)
+{
+    if (!next_stage.entry) {
+        panic("Nothing to do!\n");
+    }
+
+    printf("Preparing to run next stage at %p...\n", next_stage.entry);
+
+    nvme_shutdown();
+    exc_recover_pc = 0; /* NWOAS 4-1: the next image owns the exception vectors from here */
