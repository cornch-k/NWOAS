--- a/MdeModulePkg/Library/UefiBootManagerLib/BmBoot.c
+++ b/MdeModulePkg/Library/UefiBootManagerLib/BmBoot.c
@@ -1086,6 +1086,80 @@ BmExpandPartitionDevicePath (
   return FullPath;
 }
 
+/**
+  Check whether a controller handle already has connected child controllers.
+
+  When a removable-device boot option points at the whole device,
+  BmExpandMediaDevicePath() calls gBS->ConnectController (Handle, NULL, NULL, TRUE)
+  to make sure the child partition/media handles are created and connected.
+
+  On some platforms re-issuing that recursive ConnectController against a
+  controller that is ALREADY connected (i.e. its children already exist) is not
+  a harmless no-op: it can re-bind the underlying host controller driver and
+  reset it in the middle of the in-flight boot-device read, making the read
+  fail.  (Observed on Apple Silicon with an FL1100 xHCI behind a tethered m1n1
+  hypervisor: the recursive reconnect re-runs XhcResetHC + XhcInitSched and
+  thrashes the xHCI Event Ring, leaving Windows Boot Manager in an endless
+  0xc0000272 retry loop.)
+
+  This routine lets the caller detect the "already connected" case so it can
+  skip the redundant reconnect while still performing the legitimate first
+  connect.  It mirrors the canonical HasChildren() test used by PartitionDxe:
+  partition/media child controllers open the parent controller's DiskIo
+  protocol with EFI_OPEN_PROTOCOL_BY_CHILD_CONTROLLER, so the presence of such
+  an open-information entry means the child handles already exist.  If DiskIo is
+  not present on the handle at all, no partition child can exist yet, so the
+  controller still needs its first connect.
+
+  @param[in] ControllerHandle  Handle of the controller to test (the whole
+                               removable device's BlockIo handle).
+
+  @retval TRUE   The controller already has connected child controllers; the
+                 recursive ConnectController would be redundant.
+  @retval FALSE  The controller has no child controllers (or cannot be queried);
+                 it still needs the legitimate first connect.
+**/
+BOOLEAN
+BmHandleHasConnectedChildren (
+  IN EFI_HANDLE  ControllerHandle
+  )
+{
+  EFI_STATUS                           Status;
+  EFI_OPEN_PROTOCOL_INFORMATION_ENTRY  *OpenInfoBuffer;
+  UINTN                                EntryCount;
+  UINTN                                Index;
+  BOOLEAN                              HasChildren;
+
+  OpenInfoBuffer = NULL;
+  EntryCount     = 0;
+
+  Status = gBS->OpenProtocolInformation (
+                  ControllerHandle,
+                  &gEfiDiskIoProtocolGuid,
+                  &OpenInfoBuffer,
+                  &EntryCount
+                  );
+  if (EFI_ERROR (Status) || (OpenInfoBuffer == NULL)) {
+    //
+    // DiskIo absent (or query failed) => no partition child can exist yet.
+    // Treat as "not connected" so the legitimate first connect still happens.
+    //
+    return FALSE;
+  }
+
+  HasChildren = FALSE;
+  for (Index = 0; Index < EntryCount; Index++) {
+    if ((OpenInfoBuffer[Index].Attributes & EFI_OPEN_PROTOCOL_BY_CHILD_CONTROLLER) != 0) {
+      HasChildren = TRUE;
+      break;
+    }
+  }
+
+  FreePool (OpenInfoBuffer);
+
+  return HasChildren;
+}
