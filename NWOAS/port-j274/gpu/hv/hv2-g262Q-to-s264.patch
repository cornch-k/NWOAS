+/* SPDX-License-Identifier: MIT */
+/* NWOAS S264: pure planning half of the C guest launcher.  See nwoas_s264_plan.h.
+ * HARDWARE-UNVERIFIED. */
+#include "nwoas_s264_plan.h"
+
+#ifndef S264_HOST
+#include "string.h"
+#endif
+
+/* ------------------------------------------------------------------ small helpers */
+static u32 rd32(const u8 *p)
+{
+    return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16) | ((u32)p[3] << 24);
+}
+static u64 rd64(const u8 *p)
+{
+    return (u64)rd32(p) | ((u64)rd32(p + 4) << 32);
+}
+static void wr32(u8 *p, u32 v)
+{
+    p[0] = (u8)v;
+    p[1] = (u8)(v >> 8);
+    p[2] = (u8)(v >> 16);
+    p[3] = (u8)(v >> 24);
+}
+static void wr64(u8 *p, u64 v)
+{
+    wr32(p, (u32)v);
+    wr32(p + 4, (u32)(v >> 32));
+}
+static u32 s264_strnlen(const u8 *s, u32 max)
+{
+    u32 n = 0;
+    while (n < max && s[n])
+        n++;
+    return n;
+}
+static bool streq_n(const u8 *a, u32 alen, const char *b)
+{
+    u32 bl = (u32)strlen(b);
+    return alen == bl && !memcmp(a, b, bl);
+}
+
+/* ------------------------------------------------------------------ raw ADT reader */
+#define PROP_HDR 36u
+
+static int prop_next(const u8 *adt, u32 len, u32 off)
+{
+    if (off + PROP_HDR > len)
+        return -1;
+    u32 sz = rd32(adt + off + 32) & 0x7fffffffu;
+    u64 end = (u64)off + PROP_HDR + ((sz + 3u) & ~3u);
+    if (end > len)
+        return -1;
+    return (int)end;
+}
+
+/* offset of the first child (after the properties) */
+static int node_children(const u8 *adt, u32 len, int node)
+{
+    if (node < 0 || (u32)node + 8 > len)
+        return -1;
+    u32 pc = rd32(adt + node);
+    int off = node + 8;
+    for (u32 i = 0; i < pc; i++) {
+        off = prop_next(adt, len, (u32)off);
+        if (off < 0)
+            return -1;
+    }
+    return off;
+}
+
+static int node_end_depth(const u8 *adt, u32 len, int node, int depth)
+{
+    if (depth > 32)
+        return -1;
+    int off = node_children(adt, len, node);
+    if (off < 0)
+        return -1;
+    u32 cc = rd32(adt + node + 4);
+    for (u32 i = 0; i < cc; i++) {
+        off = node_end_depth(adt, len, off, depth + 1);
+        if (off < 0)
+            return -1;
+    }
+    return off;
+}
+static int node_end(const u8 *adt, u32 len, int node)
+{
+    return node_end_depth(adt, len, node, 0);
+}
+
+const u8 *s264_adt_prop(const u8 *adt, u32 len, int node, const char *name, u32 *plen)
+{
+    if (node < 0 || (u32)node + 8 > len)
+        return NULL;
+    u32 pc = rd32(adt + node);
+    int off = node + 8;
+    u32 nl = (u32)strlen(name);
+    for (u32 i = 0; i < pc; i++) {
+        if ((u32)off + PROP_HDR > len)
+            return NULL;
+        const u8 *pn = adt + off;
+        if (nl < 32 && !memcmp(pn, name, nl) && pn[nl] == 0) {
+            if (plen)
+                *plen = rd32(adt + off + 32) & 0x7fffffffu;
+            return adt + off + PROP_HDR;
+        }
+        off = prop_next(adt, len, (u32)off);
+        if (off < 0)
+            return NULL;
+    }
+    return NULL;
+}
+
+const char *s264_adt_name(const u8 *adt, u32 len, int node)
+{
+    u32 n = 0;
+    const u8 *v = s264_adt_prop(adt, len, node, "name", &n);
+    if (!v || !n || v[n - 1] != 0)
+        return NULL;
+    return (const char *)v;
+}
+
+static bool node_name_is(const u8 *adt, u32 len, int node, const u8 *comp, u32 clen)
+{
+    u32 n = 0;
+    const u8 *v = s264_adt_prop(adt, len, node, "name", &n);
+    if (!v)
+        return false;
+    return s264_strnlen(v, n) == clen && !memcmp(v, comp, clen);
+}
+
+/* Deleted-node set (offsets) used while resolving paths for deletions. */
+struct s264_marks {
+    int off[32];
+    u32 n;
+};
+static bool marked(const struct s264_marks *m, int off)
+{
+    if (!m)
+        return false;
+    for (u32 i = 0; i < m->n; i++)
+        if (m->off[i] == off)
+            return true;
+    return false;
+}
+
+static int child_by_name(const u8 *adt, u32 len, int node, const u8 *comp, u32 clen,
+                         const struct s264_marks *m)
+{
+    int off = node_children(adt, len, node);
+    if (off < 0)
+        return -1;
+    u32 cc = rd32(adt + node + 4);
+    for (u32 i = 0; i < cc; i++) {
+        if (!marked(m, off) && node_name_is(adt, len, off, comp, clen))
+            return off;
+        off = node_end(adt, len, off);
+        if (off < 0)
+            return -1;
+    }
+    return -1;
+}
+
+static int path_lookup(const u8 *adt, u32 len, const char *path, const struct s264_marks *m)
+{
+    int node = 0;
+    const char *p = path;
+    while (*p == '/')
+        p++;
+    while (*p) {
+        const char *e = p;
+        while (*e && *e != '/')
+            e++;
+        node = child_by_name(adt, len, node, (const u8 *)p, (u32)(e - p), m);
+        if (node < 0)
+            return -1;
+        p = e;
+        while (*p == '/')
+            p++;
+    }
+    return node;
+}
+
+int s264_adt_path(const u8 *adt, u32 len, const char *path)
+{
+    return path_lookup(adt, len, path, NULL);
+}
+
+bool s264_adt_reg(const u8 *adt, u32 len, int node, u32 idx, u64 *addr, u64 *size)
+{
+    /* Only /arm-io children (#address-cells = #size-cells = 2), as Python get_reg +
+     * translate: one level of /arm-io "ranges", root has no ranges. */
+    u32 rl = 0;
+    const u8 *reg = s264_adt_prop(adt, len, node, "reg", &rl);
+    if (!reg || rl < (idx + 1) * 16)
+        return false;
+    u64 a = rd64(reg + idx * 16), s = rd64(reg + idx * 16 + 8);
+    int io = s264_adt_path(adt, len, "/arm-io");
+    u32 nl = 0;
+    const u8 *r = s264_adt_prop(adt, len, io, "ranges", &nl);
+    if (r) {
+        for (u32 o = 0; o + 24 <= nl; o += 24) {
+            u64 ba = rd64(r + o), pa = rd64(r + o + 8), sz = rd64(r + o + 16);
+            if (ba <= a && a < ba + sz) {
+                a = a - ba + pa;
+                break;
+            }
+        }
+    }
+    if (addr)
+        *addr = a;
+    if (size)
+        *size = s;
+    return true;
+}
+
+/* ------------------------------------------------------------------ ADT rewrite */
+#define S264_MAX_SET 12
+struct s264_set {
+    int node;
+    const char *name;
+    const u8 *val;
+    u32 len;
+};
+
+struct s264_rw {
+    const u8 *src;
+    u32 srclen;
+    u8 *dst;
+    u32 cap, pos;
+    struct s264_marks del;
+    struct s264_set set[S264_MAX_SET];
+    u32 n_set;
+    int root_extra_val; /* -1 = none, else pmgr-u8id value */
+    int arm_io;
+    bool overflow;
+    /* scratch for __OS_LOG edits */
+    u8 seg_names[512];
+    u8 seg_ranges[1024];
+};
+
+static void out_bytes(struct s264_rw *w, const void *p, u32 n)
+{
+    if (w->overflow || w->pos + n > w->cap) {
+        w->overflow = true;
+        return;
+    }
+    if (p)
+        memcpy(w->dst + w->pos, p, n);
+    else
+        memset(w->dst + w->pos, 0, n);
+    w->pos += n;
+}
+
+static void out_prop(struct s264_rw *w, const u8 *name32, u32 sizefield_flags, const u8 *val,
+                     u32 vlen)
+{
+    u8 hdr[PROP_HDR];
+    memcpy(hdr, name32, 32);
+    wr32(hdr + 32, vlen | sizefield_flags);
+    out_bytes(w, hdr, PROP_HDR);
+    out_bytes(w, val, vlen);
+    u32 pad = ((vlen + 3u) & ~3u) - vlen;
+    if (pad)
+        out_bytes(w, NULL, pad);
+}
+
+static void out_prop_named(struct s264_rw *w, const char *name, const u8 *val, u32 vlen)
+{
+    u8 n32[32];
+    memset(n32, 0, sizeof(n32));
+    memcpy(n32, name, strlen(name));
+    out_prop(w, n32, 0, val, vlen);
+}
+
+/* segment-names "a;b;__OS_LOG;c" -> drop the first exact __OS_LOG element and the matching
+ * 32 bytes of segment-ranges (hv/__init__.py:2252-2261).  Returns false if not applicable. */
+static bool oslog_edit(struct s264_rw *w, int node, u32 *nlen, u32 *rlen)
+{
+    u32 sl = 0, rl = 0;
+    const u8 *s = s264_adt_prop(w->src, w->srclen, node, "segment-names", &sl);
+    const u8 *r = s264_adt_prop(w->src, w->srclen, node, "segment-ranges", &rl);
+    if (!s || !r)
+        return false;
+    u32 n = s264_strnlen(s, sl);
+    if (n + 1 > sizeof(w->seg_names) || rl > sizeof(w->seg_ranges))
+        return false;
+    /* names = s.split(";"); idx = names.index("__OS_LOG") */
+    u32 idx = 0, start = 0, found = 0xffffffffu;
+    for (u32 i = 0; i <= n; i++) {
+        if (i == n || s[i] == ';') {
+            if (found == 0xffffffffu && streq_n(s + start, i - start, "__OS_LOG"))
+                found = idx;
+            idx++;
+            start = i + 1;
+        }
+    }
+    if (found == 0xffffffffu)
+        return false;
+    /* ";".join(names[:idx] + names[idx+1:]) */
+    u32 o = 0, k = 0;
+    bool first = true;
+    start = 0;
+    for (u32 i = 0; i <= n; i++) {
+        if (i == n || s[i] == ';') {
+            if (k != found) {
+                if (!first)
+                    w->seg_names[o++] = ';';
+                memcpy(w->seg_names + o, s + start, i - start);
+                o += i - start;
+                first = false;
+            }
+            k++;
+            start = i + 1;
+        }
+    }
+    w->seg_names[o++] = 0;
+    *nlen = o;
+    /* Python: segment_ranges[:idx*32] + segment_ranges[32+idx*32:] (bytes) */
+    u32 cut = found * 32;
+    u32 ro = 0;
+    u32 keep1 = cut < rl ? cut : rl;
+    memcpy(w->seg_ranges, r, keep1);
+    ro = keep1;
+    if (cut + 32 < rl) {
+        memcpy(w->seg_ranges + ro, r + cut + 32, rl - cut - 32);
+        ro += rl - cut - 32;
+    }
+    *rlen = ro;
+    return true;
+}
+
+static int emit_node(struct s264_rw *w, int node, int depth, int parent, int grandparent)
+{
+    const u8 *src = w->src;
+    u32 len = w->srclen;
+    if (depth > 32 || node < 0 || (u32)node + 8 > len)
+        return -1;
+    u32 pc = rd32(src + node), cc = rd32(src + node + 4);
+
+    bool oslog = false;
+    u32 seg_nlen = 0, seg_rlen = 0;
+    if ((depth == 2 && parent == w->arm_io) || (depth == 3 && grandparent == w->arm_io))
+        oslog = oslog_edit(w, node, &seg_nlen, &seg_rlen);
+
+    /* child count after deletions */
+    u32 cc_out = 0;
+    {
+        int off = node_children(src, len, node);
+        if (off < 0)
+            return -1;
+        for (u32 i = 0; i < cc; i++) {
+            if (!marked(&w->del, off))
+                cc_out++;
+            off = node_end(src, len, off);
+            if (off < 0)
+                return -1;
+        }
+    }
+    u8 hdr[8];
+    wr32(hdr, pc + (depth == 0 && w->root_extra_val >= 0 ? 1 : 0));
+    wr32(hdr + 4, cc_out);
+    out_bytes(w, hdr, 8);
+
+    int off = node + 8;
+    for (u32 i = 0; i < pc; i++) {
+        int next = prop_next(src, len, (u32)off);
+        if (next < 0)
+            return -1;
+        const u8 *name = src + off;
+        u32 raw = rd32(src + off + 32);
+        u32 flags = raw & 0x80000000u, sz = raw & 0x7fffffffu;
+        const u8 *val = src + off + PROP_HDR;
+        bool done = false;
+        for (u32 k = 0; k < w->n_set && !done; k++) {
+            u32 kl = (u32)strlen(w->set[k].name);
+            if (w->set[k].node == node && kl < 32 && !memcmp(name, w->set[k].name, kl) &&
+                name[kl] == 0) {
+                out_prop(w, name, flags, w->set[k].val, w->set[k].len);
+                done = true;
+            }
+        }
+        if (!done && oslog && !memcmp(name, "segment-names", 14)) {
+            out_prop(w, name, flags, w->seg_names, seg_nlen);
+            done = true;
+        }
+        if (!done && oslog && !memcmp(name, "segment-ranges", 15)) {
+            out_prop(w, name, flags, w->seg_ranges, seg_rlen);
+            done = true;
+        }
+        if (!done)
+            out_prop(w, name, flags, val, sz);
+        off = next;
+    }
+    if (depth == 0 && w->root_extra_val >= 0) {
+        u8 v[4];
+        wr32(v, (u32)w->root_extra_val);
+        out_prop_named(w, "pmgr-u8id", v, 4);
+    }
+    for (u32 i = 0; i < cc; i++) {
+        int end = node_end(src, len, off);
+        if (end < 0)
+            return -1;
+        if (!marked(&w->del, off) && emit_node(w, off, depth + 1, node, parent) < 0)
+            return -1;
+        off = end;
+    }
+    return off;
+}
+
+/* ------------------------------------------------------------------ PMGR hook list */
+#define PMGR_DEV_SIZE 48u
+struct s264_pmgr {
+    const u8 *adt;
+    u32 len;
+    const u8 *devs;
+    u32 ndev;
+    const u8 *ps;
+    u32 nps;
+    int pmgr;
+    bool u8id;
+    u64 *out;
+    u32 n, cap;
+    bool err;
+};
+
+static u32 pm_id(const struct s264_pmgr *p, const u8 *d)
+{
+    return p->u8id ? d[3] : (u32)d[26] | ((u32)d[27] << 8);
+}
+static const u8 *pm_by_id(const struct s264_pmgr *p, u32 id)
+{
+    const u8 *hit = NULL; /* Python dict comprehension: the LAST device with this id wins */
+    for (u32 i = 0; i < p->ndev; i++)
+        if (pm_id(p, p->devs + i * PMGR_DEV_SIZE) == id)
+            hit = p->devs + i * PMGR_DEV_SIZE;
+    return hit;
+}
+static const u8 *pm_by_name(const struct s264_pmgr *p, const char *name)
+{
+    const u8 *hit = NULL;
+    u32 nl = (u32)strlen(name);
+    for (u32 i = 0; i < p->ndev; i++) {
+        const u8 *d = p->devs + i * PMGR_DEV_SIZE;
+        if (s264_strnlen(d + 32, 16) == nl && !memcmp(d + 32, name, nl))
+            hit = d;
+    }
+    return hit;
+}
+static void pm_hook(struct s264_pmgr *p, const u8 *d, int depth)
+{
+    if (depth > 16 || p->err)
+        return;
+    u32 psidx = d[10], psreg = d[11];
+    if (psreg >= p->nps) { /* Python: pmgr.ps_regs[dev.psreg] raises IndexError */
+        p->err = true;
+        return;
+    }
+    if (!(psidx || psreg))
+        return;
+    u32 reg = rd32(p->ps + psreg * 12), off = rd32(p->ps + psreg * 12 + 4);
+    u64 base;
+    if (!s264_adt_reg(p->adt, p->len, p->pmgr, reg, &base, NULL)) {
+        p->err = true;
+        return;
+    }
+    u64 addr = base + off + (u64)psidx * 8;
+    bool dup = false;
+    for (u32 i = 0; i < p->n; i++)
+        dup |= p->out[i] == addr;
+    if (!dup) {
+        if (p->n >= p->cap) {
+            p->err = true;
+            return;
+        }
+        p->out[p->n++] = addr;
+    }
+    u32 par[2];
+    if (p->u8id) {
+        par[0] = d[4];
+        par[1] = d[5];
+    } else {
+        par[0] = (u32)d[4] | ((u32)d[5] << 8);
+        par[1] = (u32)d[6] | ((u32)d[7] << 8);
+    }
+    for (int j = 0; j < 2; j++) {
+        const u8 *pd = pm_by_id(p, par[j]);
+        if (pd)
+            pm_hook(p, pd, depth + 1);
+    }
+}
+
+/* ------------------------------------------------------------------ ops */
+static void op(struct s264_plan *pl, u32 kind, u32 id, u64 a, u64 b, u64 c, u64 d)
+{
+    if (pl->n_ops >= pl->cap_ops) {
+        if (!pl->err)
+            pl->err = S264_E_OPS_FULL;
+        return;
+    }
+    struct s264_op *o = &pl->ops[pl->n_ops++];
+    o->kind = kind;
+    o->id = id;
+    o->a = a;
+    o->b = b;
+    o->c = c;
+    o->d = d;
+}
+
+/* hv/__init__.py map_hw/map_sw/unmap reduce to these raw hv_map arguments */
+#define PTE_VALID      1ULL
+#define PTE_ATTRIBUTES ((1ULL << 10) | (3ULL << 8) | (3ULL << 6) | (0xfULL << 2))
+static void op_map_hw(struct s264_plan *pl, u64 ipa, u64 pa, u64 size)
+{
+    op(pl, S264_OP_MAP, 0, ipa, pa | PTE_ATTRIBUTES | PTE_VALID, size, 1);
+}
+static void op_map_sw(struct s264_plan *pl, u64 ipa, u64 pa, u64 size)
+{
+    op(pl, S264_OP_MAP, 0, ipa, pa, size, 1); /* SPTE_MAP = type 0, no trace bits */
+}
+static void op_unmap(struct s264_plan *pl, u64 ipa, u64 size)
+{
+    op(pl, S264_OP_MAP, 0, ipa, 0, size, 0);
+}
+static void op_step(struct s264_plan *pl, u32 id, u64 a, u64 b, u64 c, u64 d)
+{
+    op(pl, S264_OP_STEP, id, a, b, c, d);
+}
+
+/* ------------------------------------------------------------------ config */
+void s264_default_config(struct s264_config *c)
+{
+    memset(c, 0, sizeof(*c));
+    c->magic = S264_MAGIC;
+    c->version = S264_VERSION;
+    c->size = sizeof(*c);
+    c->flags = S264_CFG_F_DEFAULT;
+    c->payload_size = 33669120; /* fw-wifi-s259 payload, agxdcp-s259-guest-test.sh:116 */
+    c->entry_offset = 0x800;
+    c->py_heap_size = 768ULL << 20;
+    c->m1n1_heap_reserve = 128ULL << 20;
+    c->win_base = 0;
+    c->win_size = 0x100000000ULL;
+    c->win_skew = 0x34000;
+    c->exclude_window = 1;
+    c->max_transfer = 1048576;
+    c->agx_mode = 2;                /* NWOAS_AGX_MODE=mediate */
+    c->agx_local_ipa = 0xa00000000ULL;
+    c->agx_pool_ipa = 0;
+    c->agx_scanout_intid = 889;
+    c->agx_base_pstate = 3;
+    c->agx_cfg_flags = 0x2;         /* NWOAS_AGX_DCP_SERVICE=1 */
+    c->agx_dcp_latch_us = 0;
+    c->link_lbas = 0;               /* NS1 only */
+}
+
+/* ------------------------------------------------------------------ IRQ 900 check */
+static bool irq900_walk(const u8 *adt, u32 len, int node, int depth)
+{
+    if (depth > 32)
+        return false;
+    u32 il = 0;
+    const u8 *irq = s264_adt_prop(adt, len, node, "interrupts", &il);
+    if (irq)
+        for (u32 o = 0; o + 4 <= il; o += 4)
+            if (rd32(irq + o) == 900)
+                return false;
+    int off = node_children(adt, len, node);
+    if (off < 0)
+        return false;
+    u32 cc = rd32(adt + node + 4);
+    for (u32 i = 0; i < cc; i++) {
+        if (!irq900_walk(adt, len, off, depth + 1))
+            return false;
+        off = node_end(adt, len, off);
+        if (off < 0)
+            return false;
+    }
+    return true;
+}
+
+static bool overlap(u64 a, u64 n, u64 b, u64 m)
+{
+    return a < b + m && b < a + n;
+}
