+/* ------------------------------------------------------------------ Wi-Fi page */
+#define W_R_MAGIC     0x00
+#define W_R_VERSION   0x04
+#define W_R_STATE     0x08
+#define W_R_ERROR     0x0c
+#define W_R_CMD       0x10
+#define W_R_SEQ       0x14
+#define W_R_AVAIL     0x18
+#define W_R_IDS       0x1c
+#define W_R_CFG_OFF   0x20
+#define W_R_CFG_DATA  0x24
+#define W_R_CFG_ERR   0x28
+#define W_R_BAR0WIN   0x4c
+#define W_R_CMD_COUNT 0x50
+#define W_R_MAC_LO    0x60
+#define W_R_MAC_HI    0x64
+#define W_R_CAL_LEN   0x68
+#define W_R_ANTENNA   0x6c
+#define W_R_BOARD     0x70
+#define W_CAL_OFF     0x1000
+#define W_CAL_MAX     0x1000
+
+int s264_wifi_page_init(const u8 *adt, u32 len, struct s264_wifi_page *w)
+{
+    memset(w, 0, sizeof(*w));
+    w->state = 3; /* STATE_FAILED */
+    w->error = 1; /* ERR DISABLED */
+    int n = s264_adt_path(adt, len, "/arm-io/wlan");
+    if (n < 0)
+        return -1;
+    u32 bl = 0, al = 0, ml = 0, cl = 0;
+    const u8 *board = s264_adt_prop(adt, len, n, "module-instance", &bl);
+    const u8 *ant = s264_adt_prop(adt, len, n, "wifi-antenna-sku-info", &al);
+    const u8 *mac = s264_adt_prop(adt, len, n, "local-mac-address", &ml);
+    const u8 *cal = s264_adt_prop(adt, len, n, "wifi-calibration-msf", &cl);
+    /* wifi_up.py wlan_info: board = str(prop).strip('\0').strip(); antenna = raw[8:16]
+     * up to NUL; mac must be 6 bytes; wifi_module.py:84-87 refuses otherwise */
+    u8 b16[16], a4[4];
+    memset(b16, 0, sizeof(b16));
+    memset(a4, 0, sizeof(a4));
+    u32 blen = board ? s264_strnlen(board, bl) : 0;
+    if (!board || blen != 9 || memcmp(board, "atlantisb", 9))
+        return -2;
+    memcpy(b16, board, blen);
+    if (!ant || al < 10)
+        return -3;
+    u32 alen = s264_strnlen(ant + 8, al - 8 < 8 ? al - 8 : 8);
+    if (alen != 2 || memcmp(ant + 8, "X3", 2))
+        return -3;
+    memcpy(a4, ant + 8, alen);
+    if (!mac || ml != 6)
+        return -4;
+    if (!cal || !cl || cl > W_CAL_MAX)
+        return -5;
+    w->mac_lo = rd32(mac);
+    w->mac_hi = (u32)mac[4] | ((u32)mac[5] << 8);
+    w->cal_len = cl;
+    w->antenna = rd32(a4);
+    for (u32 i = 0; i < 4; i++)
+        w->board[i] = rd32(b16 + 4 * i);
+    u8 *cp = (u8 *)w->cal;
+    memcpy(cp, cal, cl);
+    return 0;
+}
+
+u32 s264_wifi_reg_read(struct s264_wifi_page *w, u32 off)
+{
+    if (off == W_R_CFG_DATA || off == W_R_BAR0WIN) {
+        w->cfg_reads++;
+        w->cfg_err = 1; /* CFG_NOT_UP */
+        return 0xffffffffu;
+    }
+    if (off == W_R_MAC_LO)
+        return w->mac_lo;
+    if (off == W_R_MAC_HI)
+        return w->mac_hi;
+    if (off == W_R_CAL_LEN)
+        return w->cal_len;
+    if (off == W_R_ANTENNA)
+        return w->antenna;
+    if (off >= W_R_BOARD && off < W_R_BOARD + 16)
+        return w->board[(off - W_R_BOARD) / 4];
+    if (off >= W_CAL_OFF && off < W_CAL_OFF + ((w->cal_len + 3) & ~3u))
+        return w->cal[(off - W_CAL_OFF) / 4];
+    switch (off) {
+        case W_R_MAGIC:
+            return 0x4657574eu;
+        case W_R_VERSION:
+            return 1;
+        case W_R_STATE:
+            return w->state;
+        case W_R_ERROR:
+            return w->error;
+        case W_R_CMD:
+            return w->last_cmd;
+        case W_R_SEQ:
+            return w->seq;
+        case W_R_CFG_OFF:
+            return w->cfg_off;
+        case W_R_CFG_ERR:
+            return w->cfg_err;
+        case W_R_CMD_COUNT:
+            return w->cmd_count;
+        default:
+            return 0; /* AVAIL, IDS, BAR0/2, LINKSTS, DEVCTL, EPCMD, DART, CHIPID: 0 when not UP */
+    }
+}
+
+void s264_wifi_reg_write(struct s264_wifi_page *w, u32 off, u32 val)
+{
+    if (off == W_R_CMD) {
+        w->last_cmd = val;
+        w->cmd_count++;
+        /* power_up(): returns at once when not enabled; power_down(): nothing powered */
+        w->seq++;
+    } else if (off == W_R_CFG_OFF) {
+        w->cfg_off = val & 0xfff;
+        w->cfg_err = (val == w->cfg_off && !(val & 3)) ? 0 : 3;
+    } else if (off == W_R_CFG_DATA || off == W_R_BAR0WIN) {
+        w->cfg_writes++;
+        w->cfg_err = 1; /* CFG_NOT_UP */
+    }
+    /* everything else: "ignored (read-only)" */
+}
+
+/* ------------------------------------------------------------------ the plan */
+u64 s264_phys_base(const struct s264_inputs *in, const struct s264_config *cfg)
+{
+    return in->heapblock_top + cfg->m1n1_heap_reserve + cfg->py_heap_size;
+}
+u64 s264_adt_scratch(const struct s264_inputs *in, const struct s264_config *cfg)
+{
+    return (s264_phys_base(in, cfg) - 0x800000) & ~(S264_SZ_16K - 1);
+}
+static const char *const usb_nodes[] = {
+    /* hv/__init__.py:2115-2133, %d = iodev - USB0 */
+    "/arm-io/dart-usb%",       "/arm-io/atc-phy%",      "/arm-io/usb-drd%",
+    "/arm-io/acio%",           "/arm-io/acio-cpu%",     "/arm-io/dart-acio%",
+    "/arm-io/apciec%",         "/arm-io/dart-apciec%",  "/arm-io/apciec%-piodma",
+    "/arm-io/i2c0/hpmBusManager/hpm%", "/arm-io/i2c0/hpmBusManager1/hpm%",
+    "/arm-io/i2c3/hpmBusManager0/hpm%", "/arm-io/nub-spmi-a0/hpm%",
+    "/arm-io/atc%-dpxbar",     "/arm-io/atc%-dpphy",    "/arm-io/atc%-dpin0",
+    "/arm-io/atc%-dpin1",      "/arm-io/atc-phy%",
+};
+
+static void fmt_path(char *out, u32 cap, const char *tmpl, u32 idx)
+{
+    u32 o = 0;
+    for (const char *p = tmpl; *p && o + 4 < cap; p++) {
+        if (*p == '%') {
+            if (idx >= 10)
+                out[o++] = (char)('0' + idx / 10);
+            out[o++] = (char)('0' + idx % 10);
+        } else {
+            out[o++] = *p;
+        }
+    }
+    out[o] = 0;
+}
+
+static bool memmap_get(const u8 *adt, u32 len, int mm, const char *name, u64 *base, u64 *size)
+{
+    u32 l = 0;
+    const u8 *v = s264_adt_prop(adt, len, mm, name, &l);
+    if (!v || l != 16)
+        return false;
+    *base = rd64(v);
+    *size = rd64(v + 8);
+    return true;
+}
+
+int s264_plan_build(const struct s264_inputs *in, const struct s264_config *cfg,
+                    struct s264_plan *pl)
+{
+    struct s264_layout *L = &pl->L;
+    const u8 *adt = in->adt;
+    u32 alen = in->adt_size;
+    pl->n_ops = 0;
+    pl->err = 0;
+    pl->err_arg = 0;
+    memset(L, 0, sizeof(*L));
+
+    if (!cfg || cfg->magic != S264_MAGIC || cfg->version != S264_VERSION ||
+        cfg->size != sizeof(*cfg) || cfg->link_lbas != 0 ||
+        (cfg->max_transfer != 65536 && cfg->max_transfer != 1048576))
+        return pl->err = S264_E_CFG;
+    if (!adt || alen < 8 || node_end(adt, alen, 0) < 0)
+        return pl->err = S264_E_ADT;
+
+    /* ---- boot args (proxyutils.py:85-92 readstruct + tgtypes.py layout) */
+    u32 cmdlen = in->ba_rev <= 1 ? 256 : in->ba_rev == 2 ? 608 : in->ba_rev == 3 ? 1024 : 0;
+    if (!cmdlen || !in->ba_raw)
+        return pl->err = S264_E_BA;
+    u32 ba_len = 108 + cmdlen + 4 + 16;
+    const u8 *ba = in->ba_raw;
+    L->ba_len = ba_len;
+    L->ba_virt_base = rd64(ba + 8);
+    L->ba_phys_base = rd64(ba + 16);
+    L->ba_mem_size = rd64(ba + 24);
+    L->video_base = rd64(ba + 40);
+    L->video_stride = rd64(ba + 56);
+    L->video_height = rd64(ba + 72);
+    L->ba_mem_size_actual = rd64(ba + 108 + cmdlen + 4 + 8);
+    L->iodev = in->iodev;
+
+    /* ---- chosen / memory-map of THIS HV's ADT (u.adt) */
+    int chosen = s264_adt_path(adt, alen, "/chosen");
+    int mm = s264_adt_path(adt, alen, "/chosen/memory-map");
+    u32 cl = 0;
+    const u8 *chip = s264_adt_prop(adt, alen, chosen, "chip-id", &cl);
+    if (mm < 0 || !chip || cl < 4)
+        return pl->err = S264_E_MEMMAP;
+    L->chip_id = rd32(chip);
+    u64 tmp;
+    if (!memmap_get(adt, alen, mm, "SEPFW", &L->sepfw_src, &L->sepfw_size) ||
+        !memmap_get(adt, alen, mm, "TrustCache", &L->tc_src, &L->tc_size) ||
+        !memmap_get(adt, alen, mm, "DeviceTree", &tmp, &tmp) ||
+        !memmap_get(adt, alen, mm, "BootArgs", &tmp, &tmp))
+        return pl->err = S264_E_MEMMAP;
+    bool have_preoslog = memmap_get(adt, alen, mm, "preoslog", &L->preoslog_src, &L->preoslog_size);
+    if (!have_preoslog)
+        L->preoslog_size = 0;
+    bool have_kmh = s264_adt_prop(adt, alen, mm, "Kernel-mach_header", NULL) != NULL;
+
+    /* ---- layout: hv/__init__.py:2186-2249 */
+    L->payload_size = cfg->payload_size;
+    u64 image_size = S264_ALIGN(cfg->payload_size);
+    u64 sepfw_off = image_size;
+    image_size += S264_ALIGN(L->sepfw_size);
+    u64 preoslog_off = image_size;
+    image_size += L->preoslog_size;
+    u64 bootargs_off = image_size;
+    L->bootargs_size = 0x4000;
+    image_size += L->bootargs_size;
+    L->image_size = image_size;
+
+    L->py_heap_base = in->heapblock_top + cfg->m1n1_heap_reserve; /* proxyutils.py:102,111 */
+    L->py_heap_top = L->py_heap_base + cfg->py_heap_size;
+    L->phys_base = L->py_heap_top;
+    L->ram_base = L->phys_base & ~0xffffffffULL;
+    u64 g = L->phys_base + (16ULL << 20);
+    L->adt_base = g;
+    L->adt_region = S264_ALIGN((u64)alen);
+    g += L->adt_region;
+    L->tc_base = g;
+    g += S264_ALIGN(L->tc_size);
+    L->guest_base = g;
+    L->mem_top = L->ba_phys_base + L->ba_mem_size;
+    if (L->mem_top <= L->phys_base + image_size + (1ULL << 32))
+        return pl->err = S264_E_LAYOUT;
+    L->mem_size = L->mem_top - L->phys_base;
+    L->entry = g + cfg->entry_offset;
+    L->sepfw_base = g + sepfw_off;
+    L->preoslog_base = g + preoslog_off;
+    L->bootargs_base = g + bootargs_off;
+    L->virt_base = 0xfffffe0010000000ULL + (L->phys_base & ((32ULL << 20) - 1));
+    L->devtree_va = L->adt_base - L->phys_base + L->virt_base;
+    L->top_of_kernel_data = g + image_size;
+
+    /* ---- guest_map.py:11-15 low window, guest_module.py:44-55 exclusion */
+    L->win_backing = L->ba_phys_base + L->ba_mem_size - cfg->win_size - cfg->win_skew;
+    L->low_backing = L->ba_phys_base + L->ba_mem_size - 0x100000000ULL - 0x34000;
+    L->mem_size_patched = L->mem_size;
+    if (cfg->exclude_window) {
+        u64 nw = L->low_backing - L->phys_base + 0x34000;
+        if (!(0x100000000ULL < nw && nw < L->mem_size))
+            return pl->err = S264_E_LAYOUT;
+        L->mem_size_patched = nw;
+    }
+    /* launcher scratch: inside the Python heap range, just below guest RAM */
+    L->audio_buf = (L->phys_base - 0x100000) & ~(S264_SZ_16K - 1);
+    L->nvme_buf = (L->phys_base - 0x200000) & ~(S264_SZ_16K - 1);
+    L->adt_scratch = s264_adt_scratch(in, cfg);
+
+    /* ---- guest ADT: setup_adt (2107-2156) + load_raw memory-map/__OS_LOG (2238-2266) */
+    static struct s264_rw w; /* large scratch; plan is single-shot under the proxy lock */
+    memset(&w, 0, sizeof(w));
+    w.src = adt;
+    w.srclen = alen;
+    w.dst = pl->adt;
+    w.cap = pl->adt_cap;
+    w.arm_io = s264_adt_path(adt, alen, "/arm-io");
+    if (w.arm_io < 0)
+        return pl->err = S264_E_ADT;
+    if (in->iodev != S264_IODEV_NONE && in->iodev >= S264_IODEV_USB0) {
+        u32 idx = in->iodev - S264_IODEV_USB0;
+        for (u32 i = 0; i < sizeof(usb_nodes) / sizeof(usb_nodes[0]); i++) {
+            char path[96];
+            fmt_path(path, sizeof(path), usb_nodes[i], idx);
+            /* del self.adt[path]: parent by first-match, delete its FIRST child of that name */
+            const char *slash = path + strlen(path);
+            while (slash > path && *slash != '/')
+                slash--;
+            char parent[96];
+            u32 pl_len = (u32)(slash - path);
+            memcpy(parent, path, pl_len);
+            parent[pl_len] = 0;
+            int pn = pl_len ? path_lookup(adt, alen, parent, &w.del) : 0;
+            if (pn < 0)
+                continue;
+            int c = child_by_name(adt, alen, pn, (const u8 *)slash + 1, (u32)strlen(slash + 1),
+                                  &w.del);
+            if (c < 0 || w.del.n >= 32)
+                continue;
+            w.del.off[w.del.n++] = c;
+        }
+    }
+    int product = s264_adt_path(adt, alen, "/product");
+    if (product < 0)
+        return pl->err = S264_E_ADT;
+    static u8 pname[160], pdesc[160], psoc[160];
+    const char *suffix = " on m1n1 hypervisor";
+    u32 sl = (u32)strlen(suffix);
+    struct {
+        const char *prop;
+        u8 *buf;
+        const char *prefix;
+    } prod[3] = {{"product-name", pname, ""},
+                 {"product-description", pdesc, ""},
+                 {"product-soc-name", psoc, "Virtual "}};
+    for (int i = 0; i < 3; i++) {
+        u32 vl = 0;
+        const u8 *v = s264_adt_prop(adt, alen, product, prod[i].prop, &vl);
+        if (!v)
+            return pl->err = S264_E_ADT;
+        u32 n = s264_strnlen(v, vl), pre = (u32)strlen(prod[i].prefix);
+        if (pre + n + sl + 1 > 160)
+            return pl->err = S264_E_ADT;
+        memcpy(prod[i].buf, prod[i].prefix, pre);
+        memcpy(prod[i].buf + pre, v, n);
+        memcpy(prod[i].buf + pre + n, suffix, sl);
+        prod[i].buf[pre + n + sl] = 0;
+        w.set[w.n_set].node = product;
+        w.set[w.n_set].name = prod[i].prop;
+        w.set[w.n_set].val = prod[i].buf;
+        w.set[w.n_set].len = pre + n + sl + 1;
+        w.n_set++;
+    }
+    static u8 mmv[6][16];
+    struct {
+        const char *name;
+        u64 base, size;
+        bool on;
+    } mme[6] = {
+        {"SEPFW", L->sepfw_base, L->sepfw_size, true},
+        {"TrustCache", L->tc_base, L->tc_size, true},
+        {"DeviceTree", L->adt_base, L->adt_region, true},
+        {"BootArgs", L->bootargs_base, L->bootargs_size, true},
+        {"preoslog", L->preoslog_base, L->preoslog_size, have_preoslog},
+        {"Kernel-mach_header", L->guest_base, 0, have_kmh},
+    };
+    for (int i = 0; i < 6; i++) {
+        if (!mme[i].on)
+            continue;
+        wr64(mmv[i], mme[i].base);
+        wr64(mmv[i] + 8, mme[i].size);
+        w.set[w.n_set].node = mm;
+        w.set[w.n_set].name = mme[i].name;
+        w.set[w.n_set].val = mmv[i];
+        w.set[w.n_set].len = 16;
+        w.n_set++;
+    }
+    /* pmgr-u8id: adt.py pmgr_init (load_adt) adds this root property; build() keeps it */
+    int pmgr = s264_adt_path(adt, alen, "/arm-io/pmgr");
+    u32 dl = 0, psl = 0;
+    const u8 *devs = s264_adt_prop(adt, alen, pmgr, "devices", &dl);
+    const u8 *ps = s264_adt_prop(adt, alen, pmgr, "ps-regs", &psl);
+    if (!devs || dl < 2 * PMGR_DEV_SIZE || !ps)
+        return pl->err = S264_E_PMGR;
+    bool u8id = devs[3] != devs[PMGR_DEV_SIZE + 3];
+    L->pmgr_u8id = u8id;
+    w.root_extra_val = u8id ? 1 : 0;
+
+    if (emit_node(&w, 0, 0, -1, -1) < 0)
+        return pl->err = S264_E_ADT;
+    if (w.overflow)
+        return pl->err = S264_E_ADT_FULL;
+    pl->adt_len = w.pos;
+
+    /* ---- boot args blob: load_raw 2270-2283 (Python rebuilds the struct: padding = 0) */
+    memcpy(pl->ba, ba, ba_len);
+    memset(pl->ba + 4, 0, 4);
+    memset(pl->ba + 92, 0, 4);
+    memset(pl->ba + 108 + cmdlen, 0, 4);
+    wr64(pl->ba + 8, L->virt_base);
+    wr64(pl->ba + 16, L->phys_base);
+    wr64(pl->ba + 24, L->mem_size);
+    wr64(pl->ba + 32, L->top_of_kernel_data);
+    wr64(pl->ba + 96, L->devtree_va);
+    pl->ba_len = ba_len;
+
+    /* ---- PMGR hooks (map_essential 1981-2017) */
+    struct s264_pmgr pm = {adt, alen, devs, dl / PMGR_DEV_SIZE, ps, psl / 12, pmgr, u8id,
+                           pl->pmgr_addr, 0, 32, false};
+    {
+        const u8 *d = pm_by_name(&pm, "UART0");
+        if (d)
+            pm_hook(&pm, d, 0);
+        if (in->iodev != S264_IODEV_NONE && in->iodev >= S264_IODEV_USB0) {
+            char n1[24] = "ATCx_USB", n2[24] = "ATCx_USB_AON";
+            n1[3] = n2[3] = (char)('0' + (in->iodev - S264_IODEV_USB0));
+            d = pm_by_name(&pm, n1);
+            if (d)
+                pm_hook(&pm, d, 0);
+            d = pm_by_name(&pm, n2);
+            if (d)
+                pm_hook(&pm, d, 0);
+        }
+    }
+    if (pm.err)
+        return pl->err = S264_E_PMGR;
+    pl->n_pmgr = pm.n;
+    u64 pmgr0;
+    if (!s264_adt_reg(adt, alen, pmgr, 0, &pmgr0, NULL))
+        return pl->err = S264_E_PMGR;
+
+    /* ---- NVMe checks that only read the ADT / carveouts (guest_module.py:21-35) */
+    if (!irq900_walk(adt, alen, 0, 0))
+        return pl->err = S264_E_IRQ900;
+    if (!(0x700100000ULL + 0x4000 < L->ram_base))
+        return pl->err = S264_E_LAYOUT;
+
+    /* ---- fixed guest windows must not overlap (audio_module.py:120-170, wifi_module.py:35-77) */
+    {
+        const u64 win[3][2] = {{0x340000000ULL, 0x40000}, {0x348000000ULL, 0x4000},
+                               {0x6e0000000ULL, 0x900000}};
+        u32 rl = 0;
+        const u8 *r = s264_adt_prop(adt, alen, w.arm_io, "ranges", &rl);
+        for (int i = 0; i < 2; i++) {
+            if (overlap(win[i][0], win[i][1], 0, 0x100000000ULL) ||
+                overlap(win[i][0], win[i][1], L->ram_base, L->ba_mem_size_actual) ||
+                overlap(win[i][0], win[i][1], 0x300000000ULL, 0x1000) ||
+                overlap(win[i][0], win[i][1], 0xF00000000ULL, 0x10000) ||
+                overlap(win[i][0], win[i][1], 0xF10000000ULL, 0x20000 * 8) ||
+                overlap(win[i][0], win[i][1], 0xF20000000ULL, 0x10000) ||
+                (cfg->agx_local_ipa && overlap(win[i][0], win[i][1], cfg->agx_local_ipa, 0x40000000)) ||
+                (cfg->agx_pool_ipa && overlap(win[i][0], win[i][1], cfg->agx_pool_ipa, 0x100000000ULL)))
+                return pl->err = S264_E_OVERLAP, pl->err_arg = i, pl->err;
+            for (u32 o = 0; r && o + 24 <= rl; o += 24)
+                if (overlap(win[i][0], win[i][1], rd64(r + o + 8), rd64(r + o + 16)))
+                    return pl->err = S264_E_OVERLAP, pl->err_arg = 10 + i, pl->err;
+        }
+        if (overlap(win[0][0], win[0][1], win[1][0], win[1][1]))
+            return pl->err = S264_E_OVERLAP;
+        bool bar_ok = false; /* wifi_module.py:70-74 */
+        for (u32 o = 0; r && o + 24 <= rl; o += 24)
+            bar_ok |= rd64(r + o + 8) <= win[2][0] &&
+                      win[2][0] + win[2][1] <= rd64(r + o + 8) + rd64(r + o + 16);
+        if (!bar_ok)
+            return pl->err = S264_E_OVERLAP, pl->err_arg = 20, pl->err;
+        for (u32 i = 0; i < in->n_carveouts; i++)
+            if (overlap(L->audio_buf, 0x40000, in->carveouts[2 * i], in->carveouts[2 * i + 1]) ||
+                overlap(L->nvme_buf, 0x4000, in->carveouts[2 * i], in->carveouts[2 * i + 1]))
+                return pl->err = S264_E_OVERLAP, pl->err_arg = 30, pl->err;
+        if (!(L->py_heap_base <= L->nvme_buf && L->audio_buf + 0x40000 <= L->py_heap_top))
+            return pl->err = S264_E_OVERLAP, pl->err_arg = 31, pl->err;
+    }
+    if (cfg->flags & S264_CFG_F_WIFI0) {
+        static struct s264_wifi_page wp;
+        int r = s264_wifi_page_init(adt, alen, &wp);
+        if (r)
+            return pl->err = S264_E_WLAN, pl->err_arg = (u32)-r, pl->err;
+        int d1 = s264_adt_path(adt, alen, "/arm-io/dart-apcie1");
+        u64 d1b = 0;
+        if (d1 < 0 || !s264_adt_reg(adt, alen, d1, 0, &d1b, NULL) || d1b != 0x682008000ULL)
+            return pl->err = S264_E_WLAN, pl->err_arg = 10, pl->err;
+    }
+
+    /* ---- PMU (proxyclient m1n1/hw/pmu.py find_primary_pmu + reset_panic_counter) */
+    u64 spmi_base = 0, pmu_slave = 0, pmu_reg = 0;
+    if (cfg->flags & S264_CFG_F_PMU) {
+        bool found = false;
+        int off = node_children(adt, alen, w.arm_io);
+        u32 cc = rd32(adt + w.arm_io + 4);
+        for (u32 i = 0; i < cc && !found && off >= 0; i++) {
+            const char *nm = s264_adt_name(adt, alen, off);
+            if (nm && (!strncmp(nm, "nub-spmi", 8) || !strncmp(nm, "spmi", 4))) {
+                int c = node_children(adt, alen, off);
+                u32 ccc = rd32(adt + off + 4);
+                for (u32 j = 0; j < ccc && c >= 0; j++) {
+                    u32 l1 = 0, l2 = 0, l3 = 0, l4 = 0;
+                    const u8 *compat = s264_adt_prop(adt, alen, c, "compatible", &l1);
+                    const u8 *prim = s264_adt_prop(adt, alen, c, "is-primary", &l2);
+                    bool cm = compat && (streq_n(compat, s264_strnlen(compat, l1), "pmu,spmi") ||
+                                         streq_n(compat, s264_strnlen(compat, l1), "pmu,d2422") ||
+                                         streq_n(compat, s264_strnlen(compat, l1), "pmu,d2449"));
+                    if (cm && prim && l2 >= 4 && rd32(prim) == 1) {
+                        const u8 *reg = s264_adt_prop(adt, alen, c, "reg", &l3);
+                        const u8 *scr = s264_adt_prop(adt, alen, c, "info-leg_scrpad", &l4);
+                        if (!reg || !l3 || !scr || l4 < 4 || !s264_adt_reg(adt, alen, off, 0, &spmi_base, NULL))
+                            return pl->err = S264_E_PMU;
+                        pmu_slave = reg[0];
+                        pmu_reg = rd32(scr) + 2;
+                        found = true;
+                        break;
+                    }
+                    c = node_end(adt, alen, c);
+                }
+            }
+            off = node_end(adt, alen, off);
+        }
+        if (!found)
+            return pl->err = S264_E_PMU;
+    }
+
+    /* =================================================================== ops, in the
+     * executor's order.  The final stage-2 state equals Python's: HW over /arm-io first,
+     * then every overlay (Python reaches the same state with pt_update + RESERVED zones). */
+    u32 me = in->iodev;
+    bool usb = me != S264_IODEV_NONE && me >= S264_IODEV_USB0;
+    /* HV.init 1849-1865 */
+    if (usb) {
+        for (u32 i = S264_IODEV_USB0; i < S264_IODEV_COUNT; i++)
+            if (i != me)
+                op(pl, S264_OP_IODEV, 0, i, 0, 0, 0);
+        if (cfg->flags & S264_CFG_F_SPLIT)
+            op(pl, S264_OP_IODEV, 0, me, S264_USAGE_UARTPROXY, 0, 0);
+    }
+    op_step(pl, S264_STEP_HV_INIT, 0, 0, 0, 0);
+    /* HV.init 1910-1955 */
+    op(pl, S264_OP_MSR, S264_MSR_HACR_EL2, S264_SYSREG_ENC(3, 4, 1, 1, 7), 0x317000000014000ULL, 0, 0);
+    op(pl, S264_OP_MSR, S264_MSR_MDCR_EL2, S264_SYSREG_ENC(3, 4, 1, 1, 1), 0xf00, 0, 0);
+    op(pl, S264_OP_MSR, S264_MSR_MDSCR_EL1, S264_SYSREG_ENC(2, 0, 0, 2, 2), 0x8000, 0, 0);
+    op(pl, S264_OP_MSR, S264_MSR_AMX_CONFIG_EL1, S264_SYSREG_ENC(3, 4, 15, 1, 4),
+       in->amx_config_cur | (1ULL << 62), 0, 0);
+    op(pl, S264_OP_MSR, S264_MSR_VMKEYLO_EL2, S264_SYSREG_ENC(3, 6, 15, 14, 4), 0x4E7672476F6E6147ULL, 0, 0);
+    op(pl, S264_OP_MSR, S264_MSR_VMKEYHI_EL2, S264_SYSREG_ENC(3, 6, 15, 14, 5), 0x697665596F755570ULL, 0, 0);
+    op(pl, S264_OP_MSR, S264_MSR_APSTS_EL12, S264_SYSREG_ENC(3, 6, 15, 14, 7), 1, 0, 0);
+    /* /arm-io ranges as HW (1887-1889; mapped by pt_update in Python) */
+    {
+        u32 rl = 0;
+        const u8 *r = s264_adt_prop(adt, alen, w.arm_io, "ranges", &rl);
+        for (u32 o = 0; r && o + 24 <= rl; o += 24)
+            op_map_hw(pl, rd64(r + o + 8), rd64(r + o + 8), rd64(r + o + 16));
+    }
+    /* map_vuart 1957-1964 */
+    {
+        int u0 = s264_adt_path(adt, alen, "/arm-io/uart0");
+        u64 ub;
+        u32 il = 0;
+        const u8 *irq = s264_adt_prop(adt, alen, u0, "interrupts", &il);
+        if (u0 < 0 || !irq || il < 4 || !s264_adt_reg(adt, alen, u0, 0, &ub, NULL))
+            return pl->err = S264_E_ADT;
+        op(pl, S264_OP_VUART, 0, ub, rd32(irq), me == S264_IODEV_NONE ? S264_IODEV_UART : me, 0);
+    }
+    {
+        u32 part = (u32)((in->midr >> 4) & 0xfff);
+        if (part >= 0x30)
+            op(pl, S264_OP_MSR, S264_MSR_ACTLR_EL12, S264_SYSREG_ENC(3, 5, 1, 0, 1),
+               in->actlr_cur | 0x1000, 0, 0);
+        else
+            op(pl, S264_OP_MSR, S264_MSR_ACTLR_EL12_PRE, S264_SYSREG_ENC(3, 6, 15, 14, 6),
+               in->actlr_cur | 0x1000, 0, 0);
+    }
+    /* load_raw RAM-LOW / RAM-HIGH / unmap_carveouts 2223-2226, 2166-2177 */
+    u64 lo_a = L->ram_base, lo_n = L->ba_phys_base - L->ram_base;
+    u64 hi_a = L->phys_base, hi_n = L->ba_mem_size_actual - L->phys_base + L->ram_base;
+    op_map_hw(pl, lo_a, lo_a, lo_n);
+    op_map_hw(pl, hi_a, hi_a, hi_n);
+    for (u32 i = 0; i < in->n_carveouts; i++) {
+        u64 b = in->carveouts[2 * i], n = in->carveouts[2 * i + 1];
+        for (int z = 0; z < 2; z++) {
+            u64 za = z ? hi_a : lo_a, zn = z ? hi_n : lo_n;
+            u64 s = b > za ? b : za, e = (b + n) < (za + zn) ? (b + n) : (za + zn);
+            if (s < e)
+                op_unmap(pl, s, e - s);
+        }
+    }
+    op(pl, S264_OP_COPY, 0, L->guest_base, 0, cfg->payload_size, 0);
+    op(pl, S264_OP_COPY, 1, L->sepfw_base, L->sepfw_src, L->sepfw_size, 0);
+    op(pl, S264_OP_COPY, 2, L->tc_base, L->tc_src, L->tc_size, 0);
+    if (have_preoslog)
+        op(pl, S264_OP_COPY, 3, L->preoslog_base, L->preoslog_src, L->preoslog_size, 0);
+    op_step(pl, S264_STEP_WRITE_BOOTARGS, L->bootargs_base, 0, ba_len, 0);
+    /* secondary RVBARs 2285-2292 */
+    {
+        int cpus = s264_adt_path(adt, alen, "/cpus");
+        int c = node_children(adt, alen, cpus);
+        u32 cc = cpus >= 0 ? rd32(adt + cpus + 4) : 0;
+        for (u32 i = 0; i < cc && c >= 0; i++) {
+            u32 sl2 = 0, rl = 0;
+            const u8 *st = s264_adt_prop(adt, alen, c, "state", &sl2);
+            const u8 *ir = s264_adt_prop(adt, alen, c, "cpu-impl-reg", &rl);
+            bool running = st && streq_n(st, s264_strnlen(st, sl2), "running");
+            if (!running && ir && rl >= 8)
+                op(pl, S264_OP_W64, 0, rd64(ir), L->entry & ~0xfffULL, 0, 0);
+            c = node_end(adt, alen, c);
+        }
+    }
+    if (cfg->flags & S264_CFG_F_PMU)
+        op_step(pl, S264_STEP_PMU_RESET, spmi_base, pmu_slave, pmu_reg, 0);
+    /* usb-s174/guest_map.py */
+    op_step(pl, S264_STEP_PCIE_INIT, 0, 0, 0, 0);
+    op_map_sw(pl, 0x6c0000000ULL, 0x6c0000000ULL, 0x100000);
+    op_map_sw(pl, 0x681000000ULL, 0x681000000ULL, 0x3000000);
+    op_map_hw(pl, cfg->win_base, L->win_backing, cfg->win_size);
+    op_map_sw(pl, 0x502280000ULL, 0x502280000ULL, 0x10000);
+    /* layout-s231/guest_module.py + module.py */
+    if (cfg->flags & S264_CFG_F_NVME) {
+        op_step(pl, S264_STEP_NVME_CHECKS, 0, 0, 0, 0);
+        if (cfg->exclude_window)
+            op(pl, S264_OP_W64, 1, L->bootargs_base + 24, L->mem_size_patched, 0, 0);
+        op_step(pl, S264_STEP_NVME_INIT, L->low_backing, L->phys_base,
+                cfg->exclude_window ? L->low_backing : L->ba_phys_base + L->ba_mem_size, 0);
+        op_step(pl, S264_STEP_GPT_CHECK, L->nvme_buf, 0, 0, 0);
+        op(pl, S264_OP_HOOK, S264_HOOK_NVME, 0x700000000ULL, 0, 0x100000, S264_HOOK_RW);
+        op(pl, S264_OP_HOOK, S264_HOOK_NVME, 0x700100000ULL, 0, 0x4000, S264_HOOK_RW);
+        u32 mdts = 0;
+        for (u32 v = cfg->max_transfer; v > 1; v >>= 1)
+            mdts++;
+        op_step(pl, S264_STEP_NVME_TAKEOVER, cfg->link_lbas, mdts - 12, 0, 0);
+    }
+    if (cfg->flags & S264_CFG_F_AGX) {
+        /* agx_hv2_module.py:42-66 */
+        u8 *b = pl->agx;
+        memset(b, 0, 512);
+        u64 ram_end = L->ba_phys_base + L->ba_mem_size;
+        u64 lowb = ram_end - 0x100000000ULL - 0x34000;
+        wr32(b + 0, 0x4741574e);
+        wr32(b + 4, 1);
+        wr32(b + 8, 512);
+        wr32(b + 12, cfg->agx_mode);
+        wr64(b + 16, L->py_heap_base);
+        wr64(b + 24, cfg->agx_local_ipa);
+        wr64(b + 32, cfg->agx_pool_ipa);
+        wr32(b + 40, cfg->agx_base_pstate);
+        wr32(b + 44, cfg->agx_cfg_flags);
+        wr64(b + 48, L->entry);
+        wr32(b + 56, cfg->agx_scanout_intid);
+        wr32(b + 60, cfg->agx_dcp_latch_us);
+        wr64(b + 64, L->phys_base);
+        wr64(b + 72, ram_end - L->phys_base);
+        wr64(b + 80, L->entry);
+        u32 nreg = 0;
+        u8 *rp = b + 64 + 56 + 8;
+        const u64 regs[5][3] = {
+            {0, L->phys_base, ram_end - L->phys_base},
+            {6, lowb, ram_end - lowb},
+            {3, L->adt_base, 0x100000},
+            {4, L->bootargs_base, 0x4000},
+            {5, L->video_base, (L->video_stride * L->video_height + 0x3fff) & ~0x3fffULL},
+        };
+        u32 want = (L->video_base && L->video_stride && L->video_height) ? 5 : 4;
+        for (u32 i = 0; i < want; i++, nreg++) {
+            wr32(rp + 24 * i, (u32)regs[i][0]);
+            wr64(rp + 24 * i + 8, regs[i][1]);
+            wr64(rp + 24 * i + 16, regs[i][2]);
+        }
+        wr32(b + 64 + 56, nreg);
+        op_step(pl, S264_STEP_AGX_CONFIG, 0, 0, 512, 0);
+    }
+    if (cfg->flags & S264_CFG_F_AUDIO_A) {
+        /* audio_module.py:100-113 header v2, status 0; stage B (hardware) is NOT ported */
+        u8 *h = pl->audio_hdr;
+        memset(h, 0, sizeof(pl->audio_hdr));
+        wr32(h + 0x00, 0x5541574e);
+        wr32(h + 0x04, 2);
+        wr64(h + 0x08, 0x80000000ULL + 0x1000);
+        wr32(h + 0x10, 0x20000);
+        wr32(h + 0x14, 48000);
+        wr32(h + 0x18, 1);
+        wr32(h + 0x1c, 0);
+        wr32(h + 0x20, 0);
+        wr32(h + 0x24, 0x31);
+        wr32(h + 0x28, 0x0c);
+        wr32(h + 0x2c, 0);
+        wr64(h + 0x30, 0x80000000ULL + 0x21000);
+        wr32(h + 0x38, 0x10000);
+        wr32(h + 0x3c, 3);
+        wr32(h + 0x40, 2);
+        wr32(h + 0x44, 0x00);
+        wr32(h + 0x48, 0xc9);
+        op_step(pl, S264_STEP_AUDIO_A, 0x340000000ULL, L->audio_buf, 0x40000, 0);
+        op_map_hw(pl, 0x340000000ULL, L->audio_buf, 0x40000);
+    }
+    if (cfg->flags & S264_CFG_F_WIFI0) {
+        op_step(pl, S264_STEP_WIFI, 0x348000000ULL, 0, 0x4000, 0);
+        op(pl, S264_OP_HOOK, S264_HOOK_WIFI_CTL, 0x348000000ULL, 0, 0x4000, S264_HOOK_RW);
+        op_map_sw(pl, 0x6e0000000ULL, 0x6e0000000ULL, 0x900000);
+    }
+    /* HV.start 2403-2414 */
+    if (usb) {
+        for (u32 i = 0; i < S264_IODEV_COUNT; i++)
+            if (i != me)
+                op(pl, S264_OP_IODEV, 0, i, 0, 0, 0);
+        if (cfg->flags & S264_CFG_F_SPLIT) {
+            op(pl, S264_OP_IODEV, 0, me, S264_USAGE_UARTPROXY, 0, 0);
+            op(pl, S264_OP_IODEV, 0, S264_IODEV_USB_VUART, S264_USAGE_CONSOLE, 0, 0);
+        }
+    }
+    /* map_essential: PMGR, pg overrides, CPU_START */
+    for (u32 i = 0; i < pl->n_pmgr; i++)
+        op(pl, S264_OP_HOOK, S264_HOOK_PMGR, pl->pmgr_addr[i], 0, 4, S264_HOOK_RW);
+    op(pl, S264_OP_HOOK, S264_HOOK_PG_OVR, 0x23d29c05cULL, 0xc000000, 4, S264_HOOK_R);
+    op(pl, S264_OP_HOOK, S264_HOOK_PG_OVR, 0x23d29c044ULL, 0xc000000, 4, S264_HOOK_R);
+    {
+        u64 cs = 0;
+        u32 c = L->chip_id;
+        if (c == 0x8103 || c == 0x6000 || c == 0x6001 || c == 0x6002)
+            cs = 0x54000;
+        else if (c == 0x8112 || c == 0x8122 || c == 0x6030)
+            cs = 0x34000;
+        else if (c == 0x6020 || c == 0x6021 || c == 0x6022)
+            cs = 0x28000;
+        else if (c == 0x6031)
+            cs = 0x88000;
+        if (cs) /* die-count absent on J274 -> one die */
+            op(pl, S264_OP_HOOK, S264_HOOK_CPUSTART, pmgr0 + cs, 0, 0x20, S264_HOOK_W);
+    }
+    op_step(pl, S264_STEP_TLBI, 0, 0, 0, 0);
+    op_step(pl, S264_STEP_WRITE_ADT, L->adt_base, 0, pl->adt_len, 0);
+    if (cfg->flags & S264_CFG_F_FB)
+        op_step(pl, S264_STEP_FB, 0, 0, 0, 0);
+    op(pl, S264_OP_MSR, S264_MSR_SPRR_CONFIG_EL1, S264_SYSREG_ENC(3, 6, 15, 1, 0), 1, 0, 0);
+    op(pl, S264_OP_MSR, S264_MSR_GXF_CONFIG_EL1, S264_SYSREG_ENC(3, 6, 15, 1, 2), 1, 0, 0);
+    op_step(pl, S264_STEP_ARM_TRAPS, 0, 0, 0, 0);
+    op_step(pl, S264_STEP_HV_START, L->entry, L->bootargs_base, 0, 0);
+    return pl->err;
+}
+
+/* ------------------------------------------------------------------ result blob */
+static u32 put_sec(u8 *out, u32 cap, u32 *pos, const void *src, u32 len)
+{
+    u32 at = (*pos + 7u) & ~7u;
+    if (at + len > cap)
+        return 0;
+    if (at > *pos)
+        memset(out + *pos, 0, at - *pos);
+    if (src)
+        memcpy(out + at, src, len);
+    *pos = at + len;
+    return at;
+}
+
+u32 s264_result_write(const struct s264_inputs *in, const struct s264_config *cfg,
+                      const struct s264_plan *pl, u32 mode, u8 *out, u32 cap)
+{
+    if (!out || cap < S264_RESULT_HDR)
+        return 0;
+    memset(out, 0, S264_RESULT_HDR);
+    u32 pos = S264_RESULT_HDR;
+    u64 lay[64];
+    u32 nl = 0;
+#define S264_LAYOUT_PUT(n) lay[nl++] = pl->L.n;
+    S264_LAYOUT_FIELDS(S264_LAYOUT_PUT)
+#undef S264_LAYOUT_PUT
+    u32 o_lay = put_sec(out, cap, &pos, lay, nl * 8);
+    u32 o_ops = put_sec(out, cap, &pos, pl->ops, pl->n_ops * (u32)sizeof(struct s264_op));
+    u32 o_adt = put_sec(out, cap, &pos, pl->adt, pl->adt_len);
+    u32 o_ba = put_sec(out, cap, &pos, pl->ba, pl->ba_len);
+    u32 o_agx = put_sec(out, cap, &pos, pl->agx, sizeof(pl->agx));
+    u32 o_aud = put_sec(out, cap, &pos, pl->audio_hdr, sizeof(pl->audio_hdr));
+    u32 o_pm = put_sec(out, cap, &pos, pl->pmgr_addr, pl->n_pmgr * 8);
+    u32 o_st = put_sec(out, cap, &pos, pl->steps, pl->n_steps * 16);
+    u32 o_cfg = put_sec(out, cap, &pos, cfg, (u32)sizeof(*cfg));
+    if (!o_lay || !o_ops || (pl->adt_len && !o_adt) || !o_ba || !o_agx || !o_aud || !o_cfg ||
+        (pl->n_pmgr && !o_pm) || (pl->n_steps && !o_st))
+        return 0;
+    u32 h[24] = {S264_RESULT_MAGIC, S264_VERSION, pos, pl->err, pl->err_arg, nl, pl->n_ops,
+                 pl->adt_len, pl->ba_len, pl->n_pmgr, pl->n_steps, mode,
+                 o_lay, o_ops, o_adt, o_ba, o_agx, o_aud, o_pm, o_st, o_cfg,
+                 (u32)sizeof(struct s264_op), 0, 0};
+    for (u32 i = 0; i < 24; i++)
+        wr32(out + 4 * i, h[i]);
+    u64 iv[8] = {in->heapblock_top, in->iodev, in->midr, in->amx_config_cur, in->actlr_cur,
+                 in->ba_rev, in->adt_size, in->n_carveouts};
+    for (u32 i = 0; i < 8; i++)
+        wr64(out + 96 + 8 * i, iv[i]);
+    return pos;
+}
diff -ruN --exclude=build m1n1-standalone-s264-base/src-g262Q/src/nwoas_s264_plan.h m1n1-standalone-s264/src/nwoas_s264_plan.h
--- m1n1-standalone-s264-base/src-g262Q/src/nwoas_s264_plan.h	1970-01-01 09:00:00
+++ m1n1-standalone-s264/src/nwoas_s264_plan.h	2026-11-19 02:39:13
@@ -0,0 +1,261 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * NWOAS S264: pure (hardware-free) planning half of the C guest launcher.
+ *
+ * Everything here only READS its inputs (a copy of the EL2 ADT, the raw boot
+ * args, a few numbers) and WRITES caller buffers.  No MMIO, no sysregs, no
+ * allocation, no printf.  The same file is compiled
+ *   - into the hypervisor (m1n1 build, nwoas_s264.c executes the plan), and
+ *   - on the build host with -DS264_HOST for the offline equivalence test
+ *     (nwoas_scripts/standalone-s264/host/), so the device dry-run and the
+ *     host model share one implementation.
+ *
+ * What it reproduces (file:line references are in the README inventory):
+ *   m1n1_windows/proxyclient/m1n1/hv/__init__.py  HV.init / setup_adt / load_raw /
+ *   map_essential / start, plus the boot-time effects of the S259 launcher modules
+ *   usb-s174/guest_map.py, smp-s133/pmgr_gate.py, layout-s231/guest_module.py +
+ *   module.py, agx_hv2_module.py, sound-s256/audio_module.py stage A only,
+ *   wifi-s259/wifi_module.py with NWOAS_WIFI=0 only.
+ * HARDWARE-UNVERIFIED.  A plan that matches Python is not a boot result.
+ */
+#ifndef NWOAS_S264_PLAN_H
+#define NWOAS_S264_PLAN_H
+
+#ifdef S264_HOST
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+typedef uint64_t u64;
+#else
+#include "types.h"
+#endif
+
+#define S264_MAGIC        0x34363253u /* 'S264' */
+#define S264_VERSION      1u
+#define S264_RESULT_MAGIC 0x52343653u /* 'S64R' */
+
+#define S264_SZ_16K   0x4000ULL
+#define S264_ALIGN(x) (((x) + S264_SZ_16K - 1) & ~(S264_SZ_16K - 1))
+
+/* iodev numbering = m1n1 iodev.h == proxyclient m1n1/proxy.py IODEV */
+#define S264_IODEV_UART      0
+#define S264_IODEV_FB        1
+#define S264_IODEV_USB_VUART 2
+#define S264_IODEV_USB0      3
+#define S264_IODEV_COUNT     11 /* UART, FB, USB_VUART, USB0..USB7 (Python IODEV) */
+#define S264_IODEV_NONE      0xffffffffu
+#define S264_USAGE_CONSOLE   1u
+#define S264_USAGE_UARTPROXY 2u
+
+/* Sysreg ids used by OP_MSR (the executor has one explicit msr per id). */
+enum s264_msr_id {
+    S264_MSR_HACR_EL2 = 1,
+    S264_MSR_MDCR_EL2,
+    S264_MSR_MDSCR_EL1,
+    S264_MSR_AMX_CONFIG_EL1, /* s3_4_c15_c1_4, RMW EN_EL1 (bit 62) */
+    S264_MSR_VMKEYLO_EL2,
+    S264_MSR_VMKEYHI_EL2,
+    S264_MSR_APSTS_EL12,
+    S264_MSR_ACTLR_EL12,     /* s3_5_c1_c0_1 (part >= Blizzard) */
+    S264_MSR_ACTLR_EL12_PRE, /* s3_6_c15_c14_6 (M1 Firestorm/Icestorm) */
+    S264_MSR_SPRR_CONFIG_EL1,
+    S264_MSR_GXF_CONFIG_EL1,
+};
+/* Packed (op0,op1,CRn,CRm,op2) as the comparator prints it. */
+#define S264_SYSREG_ENC(op0, op1, crn, crm, op2)                                                  \
+    (((u64)(op0) << 16) | ((u64)(op1) << 12) | ((u64)(crn) << 8) | ((u64)(crm) << 4) | (u64)(op2))
+
+/* C hook ids (executor installs the matching function). */
+enum s264_hook_id {
+    S264_HOOK_PMGR = 1,  /* RW, map_essential wh/rh         hv/__init__.py:1970-1979 */
+    S264_HOOK_PG_OVR,    /* R,  pg_overrides lambda          hv/__init__.py:2019-2026 */
+    S264_HOOK_CPUSTART,  /* W,  cpustart_wh + S133 gate      hv/__init__.py:2056-2087 */
+    S264_HOOK_CPUSTATE,  /* R,  cpu_state_rh (runtime only)  hv/__init__.py:2043-2054 */
+    S264_HOOK_NVME,      /* RW, s93-nvme-ecam/bar after S230 fast path owns them */
+    S264_HOOK_WIFI_CTL,  /* RW, wifi-s259-ctl control page, NWOAS_WIFI=0 contents */
+};
+#define S264_HOOK_R  1
+#define S264_HOOK_W  2
+#define S264_HOOK_RW 3
+
+enum s264_op_kind {
+    S264_OP_MAP = 1,   /* a=from b=to(raw PTE as passed to hv_map) c=size d=incr */
+    S264_OP_HOOK,      /* a=from c=size, id=hook id, d=R/W class */
+    S264_OP_VUART,     /* a=base b=irq c=iodev */
+    S264_OP_W64,       /* a=addr b=value */
+    S264_OP_MSR,       /* id=msr id, a=encoding, b=value */
+    S264_OP_IODEV,     /* a=iodev b=usage */
+    S264_OP_COPY,      /* a=dst b=src(0 = launcher payload) c=len */
+    S264_OP_STEP,      /* id=step id, a..d step arguments */
+};
+
+enum s264_step_id {
+    S264_STEP_HV_INIT = 1,
+    S264_STEP_WRITE_BOOTARGS, /* a=dst c=len (blob in plan->ba) */
+    S264_STEP_PMU_RESET,      /* a=spmi base b=slave c=reg (write8 0) */
+    S264_STEP_PCIE_INIT,
+    S264_STEP_NVME_CHECKS,    /* IRQ900 + BAR below RAM + carveout table */
+    S264_STEP_NVME_INIT,      /* a=low_backing b=high_min c=high_max */
+    S264_STEP_GPT_CHECK,
+    S264_STEP_NVME_TAKEOVER,  /* a=link_lbas b=mdts */
+    S264_STEP_AGX_CONFIG,     /* blob in plan->agx */
+    S264_STEP_AUDIO_A,        /* a=window ipa b=buffer pa c=size */
+    S264_STEP_WIFI,           /* a=ctl ipa c=ctl size */
+    S264_STEP_WRITE_ADT,      /* a=dst c=len */
+    S264_STEP_TLBI,
+    S264_STEP_FB,             /* fb_improve_logo + fb_shutdown(true) */
+    S264_STEP_ARM_TRAPS,
+    S264_STEP_HV_START,       /* a=entry b=x0 */
+};
+
+struct s264_op {
+    u32 kind;
+    u32 id;
+    u64 a, b, c, d;
+} __attribute__((packed));
+
+/* Launcher configuration (host -> HV, little endian, fixed layout). */
+#define S264_CFG_F_AGX     (1u << 0)
+#define S264_CFG_F_NVME    (1u << 1)
+#define S264_CFG_F_AUDIO_A (1u << 2) /* map the S256 window, header status 0 (no sound) */
+#define S264_CFG_F_WIFI0   (1u << 3) /* S259 control page with NWOAS_WIFI=0 contents */
+#define S264_CFG_F_PMU     (1u << 4)
+#define S264_CFG_F_FB      (1u << 5)
+#define S264_CFG_F_SPLIT   (1u << 6) /* M1N1_SPLIT_CONSOLE=1 behaviour */
+#define S264_CFG_F_DEFAULT                                                                         \
+    (S264_CFG_F_AGX | S264_CFG_F_NVME | S264_CFG_F_AUDIO_A | S264_CFG_F_WIFI0 | S264_CFG_F_PMU |   \
+     S264_CFG_F_FB | S264_CFG_F_SPLIT)
+
+struct s264_config {
+    u32 magic;   /* S264_MAGIC */
+    u32 version; /* S264_VERSION */
+    u32 size;    /* sizeof(struct s264_config) */
+    u32 flags;   /* S264_CFG_F_* */
+    u64 payload_ptr;  /* launch: PA of the raw payload (guest m1n1 + Mu FD); dry-run may be 0 */
+    u64 payload_size; /* bytes (S259: 33669120) */
+    u64 entry_offset; /* run_guest.py -E default 0x800 */
+    u64 py_heap_size; /* run_guest.py ProxyUtils(heap_size = 768 MiB) */
+    u64 m1n1_heap_reserve; /* proxyutils.py: heap_base += 128 MiB */
+    u64 win_base, win_size, win_skew; /* NWOAS_WIN_BASE/SIZE/SKEW (0, 4 GiB, 0x34000) */
+    u32 exclude_window; /* NWOAS_EXCLUDE_WINDOW (1) */
+    u32 max_transfer;   /* NWOAS_MAX_TRANSFER (1 MiB) -> mdts 8 */
+    u32 agx_mode;       /* 1 log, 2 mediate */
+    u32 agx_scanout_intid;
+    u64 agx_local_ipa, agx_pool_ipa;
+    u32 agx_base_pstate, agx_cfg_flags, agx_dcp_latch_us;
+    u32 link_lbas;      /* must be 0: NS1-only (no NS2 transport) */
+    u64 reserved[8];
+} __attribute__((packed));
+
+/* Everything the planner needs from the running system. */
+struct s264_inputs {
+    const u8 *adt;
+    u32 adt_size;       /* boot_args.devtree_size */
+    const u8 *ba_raw;   /* raw boot args memory at boot_args_addr (>= 1152 bytes readable) */
+    u32 ba_rev;         /* boot args revision (1, 2 or 3) */
+    u64 heapblock_top;  /* heapblock_alloc(0) when the launcher starts */
+    const u64 *carveouts; /* (base, size) pairs, mcc_carveouts order */
+    u32 n_carveouts;
+    u32 iodev;          /* proxy iodev (uartproxy_iodev) or S264_IODEV_NONE */
+    u64 midr;
+    u64 amx_config_cur; /* current s3_4_c15_c1_4 */
+    u64 actlr_cur;      /* current ACTLR_EL12 / ACTLR_EL12_PRE (per MIDR part) */
+};
+
+/* Every field is u64 so the result blob is a flat list (order = S264_LAYOUT_FIELDS). */
+#define S264_LAYOUT_FIELDS(X)                                                                      \
+    X(ba_phys_base) X(ba_mem_size) X(ba_mem_size_actual) X(ba_virt_base) X(video_base)            \
+    X(video_stride) X(video_height) X(py_heap_base) X(py_heap_top) X(phys_base) X(ram_base)        \
+    X(mem_top) X(mem_size) X(mem_size_patched) X(adt_base) X(adt_region) X(tc_base) X(tc_size)     \
+    X(tc_src) X(guest_base) X(entry) X(image_size) X(payload_size) X(sepfw_base) X(sepfw_size)     \
+    X(sepfw_src) X(preoslog_base) X(preoslog_size) X(preoslog_src) X(bootargs_base)                \
+    X(bootargs_size) X(virt_base) X(devtree_va) X(top_of_kernel_data) X(low_backing)               \
+    X(win_backing) X(nvme_buf) X(audio_buf) X(adt_scratch) X(chip_id) X(ba_len) X(iodev)           \
+    X(pmgr_u8id)
+#define S264_LAYOUT_DECL(n) u64 n;
+struct s264_layout {
+    S264_LAYOUT_FIELDS(S264_LAYOUT_DECL)
+};
+
+struct s264_plan {
+    struct s264_layout L;
+    struct s264_op *ops;
+    u32 n_ops, cap_ops;
+    u8 *adt;            /* rewritten guest ADT */
+    u32 adt_len, adt_cap;
+    u8 ba[1152];        /* boot args blob as load_raw writes it (before the S102 patch) */
+    u32 ba_len;
+    u8 agx[512];        /* struct nwoas_agx_config as agx_hv2_module.py packs it */
+    u8 audio_hdr[0x4c]; /* S256 header, status 0 */
+    u64 pmgr_addr[32];
+    u32 n_pmgr;
+    u32 err;            /* first error (S264_E_*), 0 = ok */
+    u32 err_arg;
+    /* executor results, one per STEP op that ran (dry-run: status S264_ST_DRY) */
+    struct {
+        u32 id, status;
+        u64 val;
+    } steps[40];
+    u32 n_steps;
+};
+
+#define S264_ST_OK   1
+#define S264_ST_DRY  2
+#define S264_ST_FAIL 3
+#define S264_ST_SKIP 4
+
+enum s264_err {
+    S264_E_OK = 0,
+    S264_E_CFG = 1,
+    S264_E_ADT = 2,
+    S264_E_MEMMAP = 3,
+    S264_E_LAYOUT = 4,
+    S264_E_OPS_FULL = 5,
+    S264_E_ADT_FULL = 6,
+    S264_E_PMGR = 7,
+    S264_E_IRQ900 = 8,
+    S264_E_WLAN = 9,
+    S264_E_OVERLAP = 10,
+    S264_E_BA = 11,
+    S264_E_PMU = 12,
+};
+
+/* ---- minimal raw ADT reader (offset based, no m1n1 adt.c) ---- */
+int s264_adt_path(const u8 *adt, u32 len, const char *path);
+const u8 *s264_adt_prop(const u8 *adt, u32 len, int node, const char *name, u32 *plen);
+const char *s264_adt_name(const u8 *adt, u32 len, int node);
+/* reg[idx] of an /arm-io child, translated through /arm-io "ranges" (Python get_reg) */
+bool s264_adt_reg(const u8 *adt, u32 len, int node, u32 idx, u64 *addr, u64 *size);
+
+void s264_default_config(struct s264_config *cfg);
+/* guest phys_base = Python heap top (proxyutils.py:102-112 + load_raw:2211) */
+u64 s264_phys_base(const struct s264_inputs *in, const struct s264_config *cfg);
+/* where the guest ADT is assembled before it is copied (top of the Python heap range) */
+u64 s264_adt_scratch(const struct s264_inputs *in, const struct s264_config *cfg);
+/* Whole plan.  Returns 0 or an S264_E_* code (also left in plan->err). */
+int s264_plan_build(const struct s264_inputs *in, const struct s264_config *cfg,
+                    struct s264_plan *plan);
+
+/* Result blob (HV -> host; also written by the host model).  Little endian.
+ * header: 24 x u32 then 8 x u64 inputs, sections 8-byte aligned. */
+#define S264_RESULT_HDR 160u
+u32 s264_result_write(const struct s264_inputs *in, const struct s264_config *cfg,
+                      const struct s264_plan *pl, u32 mode, u8 *out, u32 cap);
+
+/* S259 Wi-Fi control page contents with NWOAS_WIFI=0 (nwoas_wifi_s259.py reg_read). */
+struct s264_wifi_page {
+    u32 state, error, last_cmd, seq, cmd_count, cfg_off, cfg_err;
+    u32 cfg_reads, cfg_writes;
+    u32 mac_lo, mac_hi, cal_len, antenna;
+    u32 board[4];
+    u32 cal[0x1000 / 4];
+};
+int s264_wifi_page_init(const u8 *adt, u32 len, struct s264_wifi_page *w);
+u32 s264_wifi_reg_read(struct s264_wifi_page *w, u32 off);
+void s264_wifi_reg_write(struct s264_wifi_page *w, u32 off, u32 val);
+
+#endif
