+/* SPDX-License-Identifier: MIT */
+/* NWOAS S264: C guest launcher (executor half).  HARDWARE-UNVERIFIED. */
+#ifndef NWOAS_S264_H
+#define NWOAS_S264_H
+
+#include "types.h"
+
+/* P_HV_NWOAS_S264 (0xc3e) sub-operations: request args = (op, a0, a1, a2, a3) */
+#define S264_OP_QUERY    0 /* -> 0x5332363400000001 ('S264' v1) */
+#define S264_OP_DRYRUN   1 /* (cfg_ptr, cfg_size, out_ptr, out_size) -> result bytes or -err */
+#define S264_OP_LAUNCH   2 /* same args; does not return while the guest runs */
+#define S264_OP_COUNTERS 3 /* (out_ptr, out_size) -> bytes */
+
+#define S264_QUERY_MAGIC 0x5332363400000001ULL
+
+u64 nwoas_s264_proxy(u64 op, u64 a0, u64 a1, u64 a2, u64 a3);
+
+/* Armed only by a S264 launch (S264_STEP_ARM_TRAPS); off = byte-identical behaviour. */
+extern bool nwoas_s264_traps_armed;
+/* hv_exc.c: CPU-config sysregs the guest m1n1 prefix touches (Python handle_msr "Pass"/"Skip") */
+struct nwoas_s264_counters {
+    u64 msr_pass, msr_skip;
+    u64 pmgr_reads, pmgr_writes;
+    u64 pg_reads;
+    u64 cpustart_writes, cpustart_gated, cpustate_reads, cpustate_hooks;
+    u64 nvme_unhandled, nvme_first_seen;
+    u64 wifi_reads, wifi_writes, wifi_cmds;
+};
+extern struct nwoas_s264_counters nwoas_s264_cnt;
+void nwoas_s264_print_counters(const char *why);
+
+#endif
