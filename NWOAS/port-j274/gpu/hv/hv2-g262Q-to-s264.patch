diff -ruN --exclude=build m1n1-standalone-s264-base/src-g262Q/src/nwoas_s264.c m1n1-standalone-s264/src/nwoas_s264.c
--- m1n1-standalone-s264-base/src-g262Q/src/nwoas_s264.c	1970-01-01 09:00:00
+++ m1n1-standalone-s264/src/nwoas_s264.c	2026-11-19 02:41:40
@@ -0,0 +1,745 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * NWOAS S264: C guest launcher, executor half.
+ *
+ * Builds the plan (nwoas_s264_plan.c, the same code the host model compiles) and
+ * either returns it (S264_OP_DRYRUN: no MMIO, no sysreg writes, no stage-2 changes)
+ * or executes it and enters the guest (S264_OP_LAUNCH), replacing
+ *   run_guest.py -> hv.init / load_raw / modules / hv.start
+ * for the first milestone configuration: S259 payload, no sound (S256 window with
+ * header status 0), no NS2 transport (NS1-only NVMe), Wi-Fi control page with
+ * NWOAS_WIFI=0 contents, GPU mediation as agx_hv2_module.py.
+ *
+ * The Python trap handlers the guest m1n1 prefix needs (PMGR state reads/writes,
+ * CPU_START writes, CPU-config sysregs) are C handlers here / in hv_exc.c with
+ * counters that match the Python log counts (S259 01:00 log: pass 14, skip 1,
+ * PMGR reads 39 / writes 2, CPU_START writes 14, 7 gated starts).
+ *
+ * HARDWARE-UNVERIFIED.  Building this is not a boot result.
+ */
+#include "nwoas_s264.h"
+#include "nwoas_s264_plan.h"
+
+#include "adt.h"
+#include "cpu_regs.h"
+#include "fb.h"
+#include "heapblock.h"
+#include "hv.h"
+#include "iodev.h"
+#include "mcc.h"
+#include "memory.h"
+#include "nvme.h"
+#include "pcie.h"
+#include "string.h"
+#include "tinf/tinf.h"
+#include "uartproxy.h"
+#include "utils.h"
+#include "xnuboot.h"
+
+#if defined(NWOAS_AGX) && NWOAS_AGX
+#include "nwoas_agx.h"
+#endif
+
+bool nwoas_s264_traps_armed;
+struct nwoas_s264_counters nwoas_s264_cnt;
+
+extern u64 nwoas_nvme_fastpath_control(u64 action, u64 sq_base, u64 sq_size, u64 cq_base,
+                                       u64 cq_size, u64 flags);
+extern bool nwoas_s264_nvme_mmio(struct exc_info *ctx, u64 ipa, u64 *val, bool write, int width);
+
+#define S264_MAX_OPS 640
+static struct s264_op s264_ops[S264_MAX_OPS];
+static struct s264_plan s264_pl;
+static struct s264_config s264_cfg;
+static struct s264_inputs s264_in;
+static u64 s264_carve[2 * 64];
+static struct s264_wifi_page s264_wifi;
+static bool s264_launched;
+
+/* --------------------------------------------------------------- C hooks */
+#define PMGR_MAX 32
+static struct {
+    u64 addr;
+    u32 val;
+    bool have;
+} s264_pmgr_cache[PMGR_MAX];
+
+static u32 *pmgr_slot(u64 addr, bool *have)
+{
+    for (int i = 0; i < PMGR_MAX; i++) {
+        if (s264_pmgr_cache[i].addr == addr) {
+            *have = s264_pmgr_cache[i].have;
+            s264_pmgr_cache[i].have = true;
+            return &s264_pmgr_cache[i].val;
+        }
+    }
+    for (int i = 0; i < PMGR_MAX; i++) {
+        if (!s264_pmgr_cache[i].addr) {
+            s264_pmgr_cache[i].addr = addr;
+            *have = false;
+            s264_pmgr_cache[i].have = true;
+            return &s264_pmgr_cache[i].val;
+        }
+    }
+    return NULL;
+}
+
+/* hv/__init__.py:1970-1979: reads report the first value seen (or what the last write
+ * asked for); writes go to the hardware with the target forced to 0xf and bits 31/10
+ * cleared ("Dangerous write"). */
+static bool s264_hook_pmgr(struct exc_info *ctx, u64 addr, u64 *val, bool write, int width)
+{
+    UNUSED(ctx);
+    UNUSED(width);
+    bool have;
+    if (write) {
+        u32 data = (u32)val[0];
+        nwoas_s264_cnt.pmgr_writes++;
+        if (nwoas_s264_cnt.pmgr_writes <= 64)
+            printf("HVLOG: S264 PMGR W %lx = 0x%x: Dangerous write\n", addr, data);
+        mask32(addr, 0x3ff, (data | 0xf) & ~0x80000400u);
+        u32 *slot = pmgr_slot(addr, &have);
+        if (slot)
+            *slot = (data & 0xfffffc0fu) | ((data & 0xf) << 4);
+    } else {
+        u32 data = read32(addr);
+        u32 *slot = pmgr_slot(addr, &have);
+        u32 ret = data;
+        if (slot) {
+            if (!have)
+                *slot = data;
+            ret = *slot;
+        }
+        nwoas_s264_cnt.pmgr_reads++;
+        if (nwoas_s264_cnt.pmgr_reads <= 64)
+            printf("HVLOG: S264 PMGR R %lx = 0x%x -> 0x%x\n", addr, data, ret);
+        val[0] = ret;
+    }
+    return true;
+}
+
+/* hv/__init__.py:2019-2026: read-only override, writes pass through (SPTE_PROXY_HOOK_R) */
+static bool s264_hook_pg(struct exc_info *ctx, u64 addr, u64 *val, bool write, int width)
+{
+    if (write)
+        return hv_pa_write(ctx, addr, val, width);
+    nwoas_s264_cnt.pg_reads++;
+    val[0] = 0xc000000;
+    return true;
+}
+
+/* hv/__init__.py:2043-2054: CPU state reads for CPUs Python never started lose bits 7:0 */
+static bool s264_hook_cpustate(struct exc_info *ctx, u64 addr, u64 *val, bool write, int width)
+{
+    if (write)
+        return hv_pa_write(ctx, addr, val, width);
+    if (!hv_pa_read(ctx, addr, val, width))
+        return false;
+    u64 data = val[0];
+    val[0] &= ~0xffULL;
+    nwoas_s264_cnt.cpustate_reads++;
+    if (nwoas_s264_cnt.cpustate_reads <= 16)
+        printf("HVLOG: S264 CPU STATE R %lx = 0x%lx -> 0x%lx\n", addr, data, val[0]);
+    return true;
+}
+
+static u64 s264_cpustart_base;
+static u64 s264_cpustate_done[16];
+
+static void s264_tlbi(void)
+{
+    sysop("dsb ishst");
+    sysop("tlbi vmalls12e1is");
+    sysop("dsb ish");
+    sysop("isb");
+}
+
+/* hv/__init__.py:2056-2087 with smp-s133/pmgr_gate.py as start_secondary: the write is
+ * dropped (never reaches PMGR), APs stay parked for PSCI CPU_ON (hv_psci.c). */
+static bool s264_hook_cpustart(struct exc_info *ctx, u64 addr, u64 *val, bool write, int width)
+{
+    if (!write) /* SPTE_PROXY_HOOK_W read path = plain pass-through */
+        return hv_pa_read(ctx, addr, val, width);
+    u64 off = addr - s264_cpustart_base;
+    u32 data = (u32)val[0];
+    nwoas_s264_cnt.cpustart_writes++;
+    if (nwoas_s264_cnt.cpustart_writes <= 32)
+        printf("HVLOG: S264 CPUSTART W %lx+%lx:%d = 0x%x\n", s264_cpustart_base, off, 8 << width,
+               data);
+    if (off >= 8) {
+        if (width != 2) {
+            printf("HVLOG: S264 CPUSTART W width %d ignored (Python asserts 32-bit)\n", 8 << width);
+            return true;
+        }
+        u32 cluster = (u32)(off - 8) / 4;
+        for (u32 i = 0; i < 32; i++) {
+            if (!(data & BIT(i)))
+                continue;
+            nwoas_s264_cnt.cpustart_gated++;
+            if (nwoas_s264_cnt.cpustart_gated <= 16)
+                printf("HVLOG: NWOAS-S133 gate PMGR AP start 0:%u:%u; waiting for PSCI CPU_ON "
+                       "(S264 C gate)\n",
+                       cluster, i);
+            u64 cs = 0x210050100ULL | ((u64)cluster << 24) | ((u64)i << 20);
+            bool seen = false;
+            for (u32 k = 0; k < nwoas_s264_cnt.cpustate_hooks && k < 16; k++)
+                seen |= s264_cpustate_done[k] == cs;
+            if (!seen && nwoas_s264_cnt.cpustate_hooks < 16) {
+                s264_cpustate_done[nwoas_s264_cnt.cpustate_hooks++] = cs;
+                hv_map_hook(cs, s264_hook_cpustate, 8);
+                s264_tlbi();
+            }
+        }
+    }
+    return true;
+}
+
+void nwoas_s264_print_counters(const char *why)
+{
+    struct nwoas_s264_counters *c = &nwoas_s264_cnt;
+    printf("HVLOG: S264 COUNTERS (%s) msr_pass=%lu msr_skip=%lu pmgr_r=%lu pmgr_w=%lu pg_r=%lu "
+           "cpustart_w=%lu gated=%lu cpustate_r=%lu nvme_unhandled=%lu wifi_r=%lu wifi_w=%lu "
+           "wifi_cmd=%lu (Python S259 01:00 log: pass 14 skip 1 pmgr_r 39 pmgr_w 2 cpustart_w 14 "
+           "gated 7)\n",
+           why, c->msr_pass, c->msr_skip, c->pmgr_reads, c->pmgr_writes, c->pg_reads,
+           c->cpustart_writes, c->cpustart_gated, c->cpustate_reads, c->nvme_unhandled,
+           c->wifi_reads, c->wifi_writes, c->wifi_cmds);
+}
+
+/* s93-nvme-ecam / s93-nvme-bar after layout-s231/module.py: the C fast path owns every
+ * access; Python's handlers only raised "unexpected host NVMe access". */
+static bool s264_hook_nvme(struct exc_info *ctx, u64 addr, u64 *val, bool write, int width)
+{
+    if (!nwoas_s264_cnt.nvme_first_seen) {
+        nwoas_s264_cnt.nvme_first_seen = 1;
+        nwoas_s264_print_counters("first guest NVMe access");
+    }
+    if (nwoas_s264_nvme_mmio(ctx, addr, val, write, width))
+        return true;
+    nwoas_s264_cnt.nvme_unhandled++;
+    if (nwoas_s264_cnt.nvme_unhandled <= 8)
+        printf("HVLOG: S264 unexpected NVMe %s %lx/%d (Python S230 would raise)\n",
+               write ? "write" : "read", addr, 8 << width);
+    return false;
+}
+
+/* wifi-s259 control page, NWOAS_WIFI=0 (nwoas_wifi_s259.py hook_read/hook_write) */
+static bool s264_hook_wifi(struct exc_info *ctx, u64 addr, u64 *val, bool write, int width)
+{
+    UNUSED(ctx);
+    u32 off = (u32)(addr - 0x348000000ULL);
+    if (write) {
+        nwoas_s264_cnt.wifi_writes++;
+        if (off == 0x10)
+            nwoas_s264_cnt.wifi_cmds++;
+        if (width == 2 && !(off & 3)) {
+            s264_wifi_reg_write(&s264_wifi, off, (u32)val[0]);
+        } else if (width == 3 && !(off & 7)) {
+            s264_wifi_reg_write(&s264_wifi, off, (u32)val[0]);
+            s264_wifi_reg_write(&s264_wifi, off + 4, (u32)(val[0] >> 32));
+        }
+        return true;
+    }
+    nwoas_s264_cnt.wifi_reads++;
+    u32 base = off & ~3u;
+    if (width == 3) {
+        val[0] = (u64)s264_wifi_reg_read(&s264_wifi, base) |
+                 ((u64)s264_wifi_reg_read(&s264_wifi, base + 4) << 32);
+    } else {
+        u64 v = s264_wifi_reg_read(&s264_wifi, base) >> (8 * (off & 3));
+        val[0] = v & ((1ULL << (8 << width)) - 1);
+    }
+    return true;
+}
+
+static hv_hook_t *s264_hook_fn(u32 id)
+{
+    switch (id) {
+        case S264_HOOK_PMGR:
+            return s264_hook_pmgr;
+        case S264_HOOK_PG_OVR:
+            return s264_hook_pg;
+        case S264_HOOK_CPUSTART:
+            return s264_hook_cpustart;
+        case S264_HOOK_CPUSTATE:
+            return s264_hook_cpustate;
+        case S264_HOOK_NVME:
+            return s264_hook_nvme;
+        case S264_HOOK_WIFI_CTL:
+            return s264_hook_wifi;
+    }
+    return NULL;
+}
+
+/* --------------------------------------------------------------- hardware steps */
+static int hexval(char c)
+{
+    if (c >= '0' && c <= '9')
+        return c - '0';
+    if (c >= 'a' && c <= 'f')
+        return c - 'a' + 10;
+    return -1;
+}
+static bool unhex(const char *s, u8 *out, u32 n)
+{
+    for (u32 i = 0; i < n; i++) {
+        int h = hexval(s[2 * i]), l = hexval(s[2 * i + 1]);
+        if (h < 0 || l < 0)
+            return false;
+        out[i] = (u8)(h << 4 | l);
+    }
+    return s[2 * n] == 0;
+}
+
