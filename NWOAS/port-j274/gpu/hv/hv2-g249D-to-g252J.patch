+/* ===================================================================== */
+/* NWOAS S251: DCP scanout service (J274, iBoot async path)               */
+/* ===================================================================== */
+
+/* Heap the service may take after install: dcp/iboot/AFK/RTKit objects of the
+ * takeover, the async command buffers and ~2 x 31 DART L2 tables (16 KiB each)
+ * for the 952 MiB pool in dart-disp0 and dart-dcp. */
+#define NWOAS_DCP_SERVICE_HEAP_BYTES UINT64_C(0x800000)
+/* One hv_tick() runs service steps for at most this long (the takeover's
+ * display_start_dcp() is one step and may take longer, once). */
+#define NWOAS_DCP_SERVICE_TICK_BUDGET_US 100u
+#define NWOAS_DCP_SERVICE_TICK_STEPS     512u
+#define LOG_BUDGET_GUARD 16
+
+static struct hv_agx_scanout_service scanout_service;
+static bool scanout_service_on;
+static bool dcp_guard_installed;
+static u32 log_guard_n, log_service_n;
+static u64 service_irqs;
+static u64 service_defers, service_forced, defer_since; /* S252I */
+static u32 log_defer_n;
+
+static bool svc_translate(void *opaque, uint64_t ipa, uint64_t *pa)
+{
+    (void)opaque;
+    if (!pa || !hv_ipa_is_normal_rw(ipa))
+        return false;
+    *pa = hv_ipa_to_pa(ipa);
+    return *pa != 0;
+}
+
+/* Upstream scanout_is_ram(): inside local-reserve segment 2 and inside guest RAM. */
+static bool svc_is_ram(void *opaque, uint64_t pa, uint64_t size)
+{
+    u64 base = cfg.memory.boot.ram_base, length = cfg.memory.boot.ram_size;
+    (void)opaque;
+    if (!hv_agx_local_scanout_allows(&local_reserve, pa, size))
+        return false;
+    return size && pa >= base && size <= length && pa - base <= length - size;
+}
+
+static bool svc_reserve_iova(void *opaque, uint64_t size, uint64_t alignment, uint64_t *iova)
+{
+    (void)opaque;
+    return display_nwoas_svc_reserve_iova(size, alignment, iova);
+}
+
+static void svc_free_iova(void *opaque, uint64_t iova, uint64_t size)
+{
+    (void)opaque;
+    display_nwoas_svc_free_iova(iova, size);
+}
+
+static bool svc_map(void *opaque, enum hv_agx_scanout_dart dart, uint64_t iova, uint64_t pa,
+                    uint64_t size)
+{
+    (void)opaque;
+    return display_nwoas_svc_map((unsigned)dart, iova, pa, size);
+}
+
+static void svc_unmap(void *opaque, enum hv_agx_scanout_dart dart, uint64_t iova, uint64_t size)
+{
+    (void)opaque;
+    display_nwoas_svc_unmap((unsigned)dart, iova, size);
+}
+
+/* Absent-device view of the DCP and its two DARTs for the guest once the HV
+ * owns DCP: reads 0, writes dropped, logged with a bound. Nothing in the guest
+ * should reach them by then (the guest m1n1 is gone; Mu and Windows have no
+ * DCP driver); this only keeps a stray access from disturbing the HV's DCP. */
+static bool dcp_guard_hook(struct exc_info *ctx, u64 addr, u64 *value, bool write, int width)
+{
+    if (log_guard_n < LOG_BUDGET_GUARD) {
+        log_guard_n++;
+        printf(PFX "DCP guard: guest %s 0x%lx width=%d value=0x%lx PC=0x%lx ignored "
+                   "(hypervisor owns DCP)\n",
+               write ? "W" : "R", addr, width, write ? *value : 0, ctx ? ctx->elr : 0);
+    }
+    if (!write)
+        *value = 0;
+    return true;
+}
+
+static void dcp_guard_install(void)
+{
+    static const struct {
+        const char *path;
+        int regs;
+    } nodes[] = {{"/arm-io/dcp", 2}, {"/arm-io/dart-dcp", 1}, {"/arm-io/dart-disp0", 2}};
+    u32 hooked = 0;
+
+    if (dcp_guard_installed)
+        return;
+    dcp_guard_installed = true;
+    for (u32 n = 0; n < ARRAY_SIZE(nodes); n++) {
+        int path[8];
+        if (adt_path_offset_trace(adt, nodes[n].path, path) < 0)
+            continue;
+        for (int i = 0; i < nodes[n].regs; i++) {
+            u64 base = 0, size = 0;
+            if (adt_get_reg(adt, path, "reg", i, &base, &size) < 0 || !base || !size ||
+                (base & 0x3fff) || (size & 0x3fff)) {
+                printf(PFX "DCP guard: %s reg[%d] 0x%lx+0x%lx not hooked\n", nodes[n].path, i,
+                       base, size);
+                continue;
+            }
+            int ret = hv_map_hook(base, dcp_guard_hook, size);
+            printf(PFX "DCP guard: %s reg[%d] 0x%lx+0x%lx %s (%d)\n", nodes[n].path, i, base, size,
+                   ret < 0 ? "hook FAILED" : "hooked", ret);
+            hooked += ret >= 0;
+        }
+    }
+    sysop("dsb ishst");
+    sysop("tlbi vmalls12e1is");
+    sysop("dsb ish");
+    sysop("isb");
+    printf(PFX "DCP guard: %u guest ranges now absent\n", hooked);
+}
+
+static enum hv_agx_scanout_async_result svc_result(int r)
+{
+    return r > 0 ? HV_AGX_SCANOUT_ASYNC_APPLIED
+                 : r == 0 ? HV_AGX_SCANOUT_ASYNC_PENDING : HV_AGX_SCANOUT_ASYNC_FAILED;
+}
+
+static enum hv_agx_scanout_async_result svc_owner_poll(void *opaque)
+{
+    int r;
+    (void)opaque;
+    /* The first call runs display_start_dcp() synchronously (RTKit boot and
+     * endpoint start, ~0.1-0.3 s [HYPOTHESIS from the boot modeset times]);
+     * keep the 1 s HV watchdog from barking while this tick is long. */
+    hv_wdt_suspend();
+    r = display_nwoas_svc_owner_poll();
+    hv_wdt_resume();
+    if (r > 0)
+        dcp_guard_install();
+    return svc_result(r);
+}
+
