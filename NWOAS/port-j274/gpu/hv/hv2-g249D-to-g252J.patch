+/* Install-time choice of the scanout sub-window (after local_reserve_select()). */
+static void scanout_select(void)
+{
+    u64 base, bytes;
+    u32 latch_us;
+
+    scanout_service_on = false;
+    hv_agx_scanout_broker_init(&scanout_broker);
+    scanout_broker.capabilities = 0; /* default: no service, exactly as before S251 */
+    if (!(cfg.flags & NWOAS_AGX_CFG_FLAG_DCP_SERVICE))
+        return;
+    if (!display_nwoas_svc_available()) {
+        printf(PFX "DCP scanout service REFUSED: no external DCP display (dcp/external/dptx)\n");
+        return;
+    }
+    if (!hv_agx_local_public_span(&base, &bytes)) {
+        printf(PFX "DCP scanout service REFUSED: no local reserve (pool = segment 2)\n");
+        return;
+    }
+    hv_agx_scanout_broker_init_v2(&scanout_broker, true); /* LATCHED is time based */
+    scanout_broker.capabilities |= HV_AGX_SCANOUT_CAP_DISPLAY_POWER;
+    /* Only BGRA8888 was shown on the J274 iBoot path (S250 hardware test);
+     * RGBA surfaces stay refused (INVALID_SURFACE) until that is tested. */
+    scanout_broker.capabilities &= ~HV_AGX_SCANOUT_CAP_RGBA8888;
+    if (!hv_agx_scanout_broker_set_pool_size(&scanout_broker, bytes)) {
+        printf(PFX "DCP scanout service REFUSED: pool size 0x%lx\n", bytes);
+        hv_agx_scanout_broker_init(&scanout_broker);
+        scanout_broker.capabilities = 0;
+        return;
+    }
+    latch_us = cfg.dcp_latch_us ? cfg.dcp_latch_us : NWOAS_AGX_DCP_LATCH_US_DEFAULT;
+    display_nwoas_svc_configure(latch_us, !(cfg.flags & NWOAS_AGX_CFG_FLAG_DCP_NO_CLEAN));
+    hv_agx_scanout_service_init(&scanout_service, &scanout_service_ops, NULL);
+    scanout_service_on = true;
+    printf(PFX "DCP scanout service armed: ABI v%u caps 0x%x pool IPA 0x%lx bytes 0x%lx "
+               "surface %ux%u stride %u, LATCHED = APPLIED + %u us, vINTID %u; DCP is taken "
+               "over on the first REGISTER_POOL or SET_POWER\n",
+           scanout_broker.abi_version, scanout_broker.capabilities, base, bytes,
+           HV_AGX_SCANOUT_J313_WIDTH, HV_AGX_SCANOUT_J313_HEIGHT, HV_AGX_SCANOUT_J313_STRIDE,
+           latch_us, cfg.scanout_intid);
+}
+
+/* Poll point: end of hv_tick() (5 kHz, the interruptible CPU, bhl held), i.e.
+ * after the proxy/vuart/NVMe servicing of this tick. bhl serialises it with
+ * the broker MMIO handler, the proxy commands and every other DCP user in the
+ * HV, which the HV2 RTKit/AFK send path (no reservation API) requires; the
+ * same context already allocates and prints (NVMe fast path, proxy). */
+void nwoas_agx_tick(void)
+{
+    enum hv_agx_scanout_service_step_result r = HV_AGX_SCANOUT_SERVICE_IDLE_STEP;
+    u32 intid = nwoas_agx_scanout_intid;
+    bool inject = false;
+    u64 t0, budget;
+
+    if (!scanout_service_on || nwoas_agx_mode_armed != NWOAS_AGX_MODE_MEDIATE)
+        return;
+    t0 = get_ticks();
+    budget = (u64)NWOAS_DCP_SERVICE_TICK_BUDGET_US * mrs(CNTFRQ_EL0) / 1000000;
+    spin_lock(&broker_lock);
+    for (u32 i = 0; i < NWOAS_DCP_SERVICE_TICK_STEPS; i++) {
+        r = hv_agx_scanout_service_step(&scanout_service, &scanout_broker);
+        if (r != HV_AGX_SCANOUT_SERVICE_PROGRESSED || get_ticks() - t0 > budget)
+            break;
+    }
+    /* S252I: same guest ESR 0xbf40100b as S6-D49 (2026-09-07), whose cause was a
+     * synthetic SPI taken while another LR was ACTIVE (two ACTIVE LRs -> guest SEI).
+     * Never raise the synthetic scanout line while this vCPU has an ACTIVE LR;
+     * the next 200 us tick retries.  Bounded so a stuck ACTIVE LR cannot starve
+     * vblank completions forever (forced injections are counted and logged). */
+    u64 lrs[8];
+    u32 active = 0;
+    bool want = intid && hv_vgic3_spi_enabled(intid) && !hv_vgic_virq_outstanding(intid) &&
+                hv_vgic3_get_free_lr() >= 0 && hv_agx_scanout_broker_irq_edge_pending(&scanout_broker);
+    if (want) {
+        for (u32 lr = 0; lr < 8; lr++) {
+            lrs[lr] = hv_vgic3_read_lr(lr);
+            active += (lrs[lr] & ICH_LR_STATE_ACTIVE) != 0;
+        }
+        if (active) {
+            if (!defer_since)
+                defer_since = t0;
+            if (get_ticks() - defer_since < mrs(CNTFRQ_EL0) / 20) { /* 50 ms */
+                want = false;
+                service_defers++;
+            } else {
+                service_forced++;
+            }
+            if (log_defer_n < 8) {
+                log_defer_n++;
+                printf(PFX "S252I scanout irq %s: %u ACTIVE LR(s) on cpu%d, defers=%lu forced=%lu\n",
+                       want ? "FORCED" : "deferred", active, smp_id(), service_defers,
+                       service_forced);
+                for (u32 lr = 0; lr < 8; lr++)
+                    if (lrs[lr] & (ICH_LR_STATE_ACTIVE | ICH_LR_STATE_PENDING))
+                        printf(PFX "S252I   lr%u intid=%lu prio=0x%lx %s%s\n", lr,
+                               (lrs[lr] >> ICH_LR_VIRTUAL_SHIFT) & ICH_LR_VIRTUAL_MASK,
+                               (lrs[lr] >> ICH_LR_PRIORITY_SHIFT) & ICH_LR_PRIORITY_MASK,
+                               (lrs[lr] & ICH_LR_STATE_ACTIVE) ? "A" : "",
+                               (lrs[lr] & ICH_LR_STATE_PENDING) ? "P" : "");
+            }
+        }
+    }
+    if (want) {
+        defer_since = 0;
+        inject = hv_agx_scanout_broker_take_irq_edge(&scanout_broker);
+    }
+    spin_unlock(&broker_lock);
+    if (inject) {
+        u8 prio = hv_vgic3_get_priority(intid);
+        hv_vgic3_inject_irq(intid, prio, false, true, false, 0);
+        ++service_irqs;
+        if (service_irqs == 1)
+            printf(PFX "S252I scanout prio=0x%x timer18 prio=0x%x VPMR=0x%lx cpu%d\n", prio,
+                   hv_vgic3_get_priority(18), (mrs(ICH_VMCR_EL2) >> 24) & 0xff, smp_id());
+        if (service_irqs <= 4 && log_service_n < 32) {
+            log_service_n++;
+            printf(PFX "scanout vINTID %u injected (n=%lu)\n", intid, service_irqs);
+        }
+        if ((service_irqs & 4095) == 0)
+            printf(PFX "S252I scanout irqs=%lu defers=%lu forced=%lu\n", service_irqs,
+                   service_defers, service_forced);
+    }
+}
