+    const struct get_hpd_resp *resp = dcp_ib_cmd_async_reply(cmd, &size);
+
+    if (!resp || size < sizeof(*resp))
+        return -1;
+    if (timing_cnt)
+        *timing_cnt = resp->timing_cnt;
+    if (color_cnt)
+        *color_cnt = resp->color_cnt;
+    return !!resp->hpd;
+}
+
+int dcp_ib_cmd_async_timing_modes(const dcp_ib_cmd_async_t *cmd, const dcp_timing_mode_t **modes)
+{
+    size_t size = 0;
+    const struct get_tmode_resp *resp = dcp_ib_cmd_async_reply(cmd, &size);
+
+    if (!resp || size < sizeof(*resp) ||
+        resp->count > (size - sizeof(*resp)) / sizeof(dcp_timing_mode_t))
+        return -1;
+    *modes = resp->modes;
+    return resp->count;
+}
+
+int dcp_ib_cmd_async_color_modes(const dcp_ib_cmd_async_t *cmd, const dcp_color_mode_t **modes)
+{
+    size_t size = 0;
+    const struct get_cmode_resp *resp = dcp_ib_cmd_async_reply(cmd, &size);
+
+    if (!resp || size < sizeof(*resp) ||
+        resp->count > (size - sizeof(*resp)) / sizeof(dcp_color_mode_t))
+        return -1;
+    *modes = resp->modes;
+    return resp->count;
+}
+#endif /* NWOAS S251 */
+
+/* NWOAS S250: deliver a notification parked by the async poller (normal
+ * context only; afk_epic_work() does the same for synchronous callers). */
+int dcp_ib_dispatch_deferred(dcp_iboot_if_t *iboot)
+{
+    return iboot ? afk_epic_dispatch_deferred(iboot->epic) : 0;
+}
+
+/* NWOAS S250: true when no async command owns the iboot endpoint buffers. */
+bool dcp_ib_command_idle(dcp_iboot_if_t *iboot)
+{
+    return iboot && afk_epic_command_idle(iboot->epic);
 }
