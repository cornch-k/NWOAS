+    s32 modes_ret;
+    u32 is_external;
+    u32 n_modes;
+    u64 fb_base;
+    u64 fb_dva;
+    u32 cur_width, cur_height, cur_stride, cur_depth;
+    u32 os_fw_version;
+    u32 iboot_ready;
+    struct nwoas_dcp_mode_rec modes[];
+};
+_Static_assert(sizeof(struct nwoas_dcp_info) == 80, "nwoas_dcp_info layout");
+
+struct nwoas_dcp_poll_out {
+    u32 status;
+    u32 stage;
+    s32 swap_id;
+    s32 cmd_result;
+    u64 elapsed_us;
+    u64 cookie;
+    u64 clean_us;
+    u32 endpoint_idle;
+    u32 pad;
+};
+_Static_assert(sizeof(struct nwoas_dcp_poll_out) == 48, "nwoas_dcp_poll_out layout");
+
+u64 display_nwoas_dcp_probe(void)
+{
+    return NWOAS_DCP_S250_MAGIC;
+}
+
+#if defined(NWOAS_AGX) && NWOAS_AGX
+/* NWOAS S251: != 0 once the hypervisor scanout service started taking DCP
+ * over; the S250 host test commands then refuse with -16 (one DCP owner). */
+static int nwsvc_owner;
+#define NWSVC_CLAIMED() (nwsvc_owner != 0)
+#else
+#define NWSVC_CLAIMED() false
+#endif
+
+static bool nwdcp_idle(void)
+{
+    return iboot && !NWSVC_CLAIMED() && !nwdcp.pending && dcp_ib_command_idle(iboot);
+}
+
+int display_nwoas_dcp_start(u32 flags, u64 info_ptr, u64 info_size)
+{
+    struct nwoas_dcp_info *info = (void *)info_ptr;
+    int ret;
+
+    if (info && info_size < sizeof(*info))
+        return -22;
+    if (NWSVC_CLAIMED())
+        return -16;
+    if (iboot && !nwdcp_idle())
+        return -16;
+
+    if (flags & NWOAS_DCP_START_CONFIGURE)
+        ret = display_configure(NULL);
+    else
+        ret = display_start_dcp();
+
+    if (!nwdcp.swap) {
+        nwdcp.swap = malloc(sizeof(*nwdcp.swap));
+        if (!nwdcp.swap)
+            return -12;
+        dcp_ib_swap_async_init(nwdcp.swap);
+    }
+
+    if (info) {
+        memset(info, 0, sizeof(*info));
+        info->magic = NWOAS_DCP_S250_MAGIC;
+        info->version = 1;
+        info->start_ret = ret;
+        info->is_external = display_is_external;
+        info->fb_base = cur_boot_args.video.base;
+        info->fb_dva = fb_dva;
+        info->cur_width = cur_boot_args.video.width;
+        info->cur_height = cur_boot_args.video.height;
+        info->cur_stride = cur_boot_args.video.stride;
+        info->cur_depth = cur_boot_args.video.depth;
+        info->os_fw_version = os_firmware.version;
+        info->iboot_ready = dcp_ib_is_ready(iboot);
+    }
+
+    if (!iboot)
+        return ret < 0 ? ret : -19;
+
+    int timing_cnt = 0, color_cnt = 0;
+    dcp_work(dcp);
+    int hpd = dcp_ib_get_hpd(iboot, &timing_cnt, &color_cnt);
+    int modes_ret = 0;
+    u32 copied = 0;
+
+    if (hpd > 0 && timing_cnt > 0) {
+        dcp_timing_mode_t *tmodes;
+        modes_ret = dcp_ib_get_timing_modes(iboot, &tmodes);
+        if (info && modes_ret > 0) {
+            u64 cap = (info_size - sizeof(*info)) / sizeof(info->modes[0]);
+            for (u32 i = 0; i < (u32)modes_ret && i < cap; i++) {
+                info->modes[i].valid = tmodes[i].valid;
+                info->modes[i].width = tmodes[i].width;
+                info->modes[i].height = tmodes[i].height;
+                info->modes[i].fps = tmodes[i].fps;
+                copied++;
+            }
+        }
+    }
+
+    printf("display: NWOAS-DCP-S250 start flags=%#x ret=%d hpd=%d timing=%d color=%d modes=%d "
+           "cur=%ldx%ld stride=%ld\n",
+           flags, ret, hpd, timing_cnt, color_cnt, modes_ret, cur_boot_args.video.width,
+           cur_boot_args.video.height, cur_boot_args.video.stride);
+
+    if (info) {
+        info->hpd = hpd;
+        info->timing_cnt = timing_cnt;
+        info->color_cnt = color_cnt;
+        info->modes_ret = modes_ret;
+        info->n_modes = copied;
+        info->iboot_ready = dcp_ib_is_ready(iboot);
+    }
+
+    if (hpd < 0)
+        return hpd;
+    return ret < 0 ? ret : 0;
+}
+
+int display_nwoas_dcp_power(bool on)
+{
+    if (!nwdcp_idle())
+        return -16;
+    int ret = dcp_ib_set_power(iboot, on);
+    printf("display: NWOAS-DCP-S250 set_power(%d) ret=%d\n", on, ret);
+    return ret;
+}
+
+static bool nwdcp_layer(u64 iova, u32 width, u32 height, u32 stride, dcp_layer_t *layer,
+                        dcp_rect_t *src, dcp_rect_t *dst)
+{
+    if (!iova || !width || !height || (u64)stride < (u64)width * 4 || (stride & 3))
+        return false;
+    memset(layer, 0, sizeof(*layer));
+    layer->planes[0].addr = iova;
+    layer->planes[0].stride = stride;
+    layer->planes[0].addr_format = ADDR_PLANAR;
+    layer->plane_cnt = 1;
+    layer->width = width;
+    layer->height = height;
+    layer->surface_fmt = FMT_BGRA;
+    layer->colorspace = 2;
+    layer->eotf = EOTF_GAMMA_SDR;
+    layer->transform = XFRM_NONE;
+    *src = (dcp_rect_t){.w = width, .h = height};
+    *dst = (dcp_rect_t){.w = width, .h = height};
+    return true;
+}
+
+static u64 nwdcp_map(u64 pa, u64 size)
+{
+    int free_slot = -1;
+
+    for (int i = 0; i < NWOAS_DCP_MAX_BUFS; i++) {
+        if (nwdcp.bufs[i].iova && nwdcp.bufs[i].pa == pa && nwdcp.bufs[i].size == size)
+            return nwdcp.bufs[i].iova;
+        if (nwdcp.bufs[i].iova && pa < nwdcp.bufs[i].pa + nwdcp.bufs[i].size &&
+            nwdcp.bufs[i].pa < pa + size)
+            return 0; /* overlapping different mapping */
+        if (!nwdcp.bufs[i].iova && free_slot < 0)
+            free_slot = i;
+    }
+    if (free_slot < 0)
+        return 0;
+
+    /* Same method as display_configure() for a new framebuffer: allocate in the
+     * DCP IOVA domain, then map that IOVA in both dart-disp0 and dart-dcp. */
+    u64 iova = iova_alloc(dcp->iovad_dcp, size);
+    if (!iova)
+        return 0;
+    u64 mapped = display_map_fb(iova, pa, size);
+    if (DART_IS_ERR(mapped) || mapped != iova) {
+        iova_free(dcp->iovad_dcp, iova, size);
+        return 0;
+    }
+    nwdcp.bufs[free_slot].pa = pa;
+    nwdcp.bufs[free_slot].size = size;
+    nwdcp.bufs[free_slot].iova = iova;
+    printf("display: NWOAS-DCP-S250 mapped pa=%#lx size=%#lx iova=%#lx\n", pa, size, iova);
+    return iova;
+}
+
+s64 display_nwoas_dcp_swap(u64 pa, u32 width, u32 height, u32 stride, u32 format, u32 flags)
+{
+    dcp_layer_t layer;
+    dcp_rect_t src, dst;
+
+    if (!nwdcp.swap || !nwdcp_idle())
+        return -16;
+    if (format != NWOAS_DCP_FMT_BGRA8888)
+        return -22;
+    if (width > cur_boot_args.video.width || height > cur_boot_args.video.height)
+        return -22;
+    if (!pa || (pa & (SZ_16K - 1)) || (u64)stride * height == 0)
+        return -22;
+    u64 size = ALIGN_UP((u64)stride * height, SZ_16K);
+    if (pa < cur_boot_args.phys_base || pa + size > cur_boot_args.phys_base + cur_boot_args.mem_size)
+        return -14;
+
+    u64 iova = nwdcp_map(pa, size);
+    if (!iova)
+        return -12;
+    if (!nwdcp_layer(iova, width, height, stride, &layer, &src, &dst))
+        return -22;
+
+    u64 t0 = get_ticks();
+    if (!(flags & NWOAS_DCP_SWAP_NOCLEAN))
+        dc_civac_range((void *)pa, size);
+    nwdcp.clean_ticks = get_ticks() - t0;
+
+    dcp_ib_swap_async_init(nwdcp.swap);
+    nwdcp.submit_ticks = get_ticks();
+    int ret = dcp_ib_swap_async_begin(nwdcp.swap, iboot, &layer, &src, &dst);
+    if (ret) {
+        nwdcp.last_result = ret;
+        return ret < 0 ? ret : -5;
+    }
+    nwdcp.pending = true;
+    nwdcp.pending_iova = iova;
+    if (++nwdcp.cookie == 0)
+        ++nwdcp.cookie;
+    return nwdcp.cookie;
+}
+
+static void nwdcp_poll_once(void)
+{
+    enum dcp_ib_swap_async_result r = dcp_ib_swap_async_poll(nwdcp.swap);
+    dcp_ib_dispatch_deferred(iboot);
+    if (r == DCP_IB_SWAP_ASYNC_PENDING)
+        return;
+    nwdcp.done_ticks = get_ticks();
+    nwdcp.pending = false;
+    nwdcp.last_result = r;
+    if (r == DCP_IB_SWAP_ASYNC_APPLIED)
+        nwdcp.shown_iova = nwdcp.pending_iova;
+}
+
+u64 display_nwoas_dcp_poll(u64 cookie, u32 max_wait_us, u64 out_ptr)
+{
+    u32 status;
+
+    if (!nwdcp.swap || !nwdcp.cookie || cookie != nwdcp.cookie) {
+        status = NWOAS_DCP_POLL_NO_SWAP;
+    } else {
+        if (nwdcp.pending) {
+            u64 deadline = timeout_calculate(max_wait_us);
+            do {
+                nwdcp_poll_once();
+            } while (nwdcp.pending && max_wait_us && !timeout_expired(deadline));
+        }
+        if (nwdcp.pending)
+            status = NWOAS_DCP_POLL_PENDING;
+        else if (nwdcp.last_result == DCP_IB_SWAP_ASYNC_APPLIED)
+            status = NWOAS_DCP_POLL_APPLIED;
+        else
+            status = NWOAS_DCP_POLL_FAILED;
+    }
+
+    u64 elapsed = 0;
+    if (status != NWOAS_DCP_POLL_NO_SWAP)
+        elapsed = ticks_to_usecs((nwdcp.pending ? get_ticks() : nwdcp.done_ticks) -
+                                 nwdcp.submit_ticks);
+    u32 stage = nwdcp.swap ? nwdcp.swap->stage : 0;
+    s32 swap_id = nwdcp.swap ? nwdcp.swap->swap_id : 0;
+
+    if (out_ptr) {
+        struct nwoas_dcp_poll_out *out = (void *)out_ptr;
+        out->status = status;
+        out->stage = stage;
+        out->swap_id = swap_id;
+        out->cmd_result = nwdcp.swap ? nwdcp.swap->command.result : 0;
+        out->elapsed_us = elapsed;
+        out->cookie = nwdcp.cookie;
+        out->clean_us = ticks_to_usecs(nwdcp.clean_ticks);
+        out->endpoint_idle = iboot ? dcp_ib_command_idle(iboot) : 0;
+        out->pad = 0;
+    }
+
+    if (elapsed > 0xffffffffUL)
+        elapsed = 0xffffffffUL;
+    return ((u64)status << 56) | ((u64)(stage & 0xff) << 48) | ((u64)(swap_id & 0xffff) << 32) |
+           elapsed;
+}
+
+int display_nwoas_dcp_shutdown(u32 mode)
+{
+    int result = 0;
+
+    if (NWSVC_CLAIMED())
+        return -16;
+    if (!iboot) {
+        memset(nwdcp.bufs, 0, sizeof(nwdcp.bufs));
+        nwdcp.pending = false;
+        nwdcp.shown_iova = 0;
+        return 0;
+    }
+
+    /* Finish an in-flight swap first (bounded, 1 s). */
+    if (nwdcp.pending) {
+        u64 deadline = timeout_calculate(1000000);
+        while (nwdcp.pending && !timeout_expired(deadline))
+            nwdcp_poll_once();
+    }
+
+    bool restored = !nwdcp.shown_iova;
+    if (!restored && !nwdcp.pending && fb_dva && dcp_ib_command_idle(iboot)) {
+        /* Put the boot framebuffer back before unmapping the test buffers
+         * (same order as UP display_scanout_quiesce_*: APPLIED + 150 ms). */
+        dcp_layer_t layer;
+        dcp_rect_t src, dst;
+        if (nwdcp_layer(fb_dva, cur_boot_args.video.width, cur_boot_args.video.height,
+                        cur_boot_args.video.stride, &layer, &src, &dst)) {
+            dcp_ib_swap_async_init(nwdcp.swap);
+            if (!dcp_ib_swap_async_begin(nwdcp.swap, iboot, &layer, &src, &dst)) {
+                u64 deadline = timeout_calculate(1000000);
+                enum dcp_ib_swap_async_result r;
+                do {
+                    r = dcp_ib_swap_async_poll(nwdcp.swap);
+                    dcp_ib_dispatch_deferred(iboot);
+                } while (r == DCP_IB_SWAP_ASYNC_PENDING && !timeout_expired(deadline));
+                if (r == DCP_IB_SWAP_ASYNC_APPLIED) {
+                    mdelay(150);
+                    restored = true;
+                    nwdcp.shown_iova = 0;
+                }
+            }
+        }
+    }
+    if (restored)
+        result |= NWOAS_DCP_SHUT_RESTORED;
+
+    if (restored && !nwdcp.pending) {
+        for (int i = 0; i < NWOAS_DCP_MAX_BUFS; i++) {
+            if (!nwdcp.bufs[i].iova)
+                continue;
+            dart_unmap(dcp->dart_disp, nwdcp.bufs[i].iova, nwdcp.bufs[i].size);
+            dart_unmap(dcp->dart_dcp, nwdcp.bufs[i].iova, nwdcp.bufs[i].size);
+            iova_free(dcp->iovad_dcp, nwdcp.bufs[i].iova, nwdcp.bufs[i].size);
+        }
+        memset(nwdcp.bufs, 0, sizeof(nwdcp.bufs));
+        result |= NWOAS_DCP_SHUT_UNMAPPED;
+    } else {
+        printf("display: NWOAS-DCP-S250 test buffers stay mapped (boot fb not restored)\n");
+    }
+
+    display_shutdown(mode);
+    /* The DCP/DART objects are re-created by the next start; never reuse
+     * entries that belonged to this instance. */
+    memset(nwdcp.bufs, 0, sizeof(nwdcp.bufs));
+    nwdcp.pending = false;
+    nwdcp.shown_iova = 0;
+    result |= NWOAS_DCP_SHUT_DONE;
+    printf("display: NWOAS-DCP-S250 shutdown mode=%u result=%#x\n", mode, result);
+    return result;
+}
+
+/* ---- end NWOAS S250 ---- */
+
+#if defined(NWOAS_AGX) && NWOAS_AGX
+/* ---- NWOAS S251: hypervisor scanout service backend (iBoot async path) ----
+ * Used only by nwoas_agx_broker.c when the launcher enabled the DCP service.
+ * Every entry point returns promptly: DCP commands are the S250/S251 async
+ * iBoot commands, waits are tick deadlines. The only blocking part is the
+ * takeover's display_start_dcp() (RTKit boot + AFK/iBoot endpoint start, the
+ * same call hv_init() makes on every boot). All callers hold bhl (5 kHz HV
+ * tick on the interruptible CPU), so DCP is driven from one context only.
+ * HARDWARE-UNVERIFIED. */
+
+#define NWSVC_HPD_TRIES       10u     /* x 100 ms (display_configure: 20 x 100 ms) */
+#define NWSVC_HPD_RETRY_US    100000u /* DISPLAY_STATUS_DELAY */
+#define NWSVC_POWER_WAIT_US   100000u /* display_configure "Sonoma bug workaround" */
+#define NWSVC_MODE_RETRY_US   500000u /* display_configure set_mode retry */
+#define NWSVC_QUIESCE_US      150000u /* display_configure / UP quiesce settle */
+#define NWSVC_SYNTHETIC_ID    0x40000000u
+#define NWSVC_WANT_WIDTH      1920u
+#define NWSVC_WANT_HEIGHT     1080u
+
+enum nwsvc_seq {
+    NWSVC_SEQ_IDLE = 0,
+    NWSVC_SEQ_HPD,
+    NWSVC_SEQ_HPD_WAIT,
+    NWSVC_SEQ_POWER_ON,
+    NWSVC_SEQ_POWER_WAIT,
+    NWSVC_SEQ_TIMING,
+    NWSVC_SEQ_COLOR,
+    NWSVC_SEQ_SET_MODE,
+    NWSVC_SEQ_SET_MODE_WAIT,
+    NWSVC_SEQ_SWAP,
+    NWSVC_SEQ_POWER_OFF,
+    NWSVC_SEQ_DONE,
+    NWSVC_SEQ_FAILED,
+};
+
+struct nwsvc_surface {
+    u64 iova, pa, bytes;
+    u32 width, height, stride;
+    bool rgba;
+};
+
+static struct {
+    enum nwsvc_seq seq;
+    u64 wait_until;
+    u32 hpd_tries;
+    bool mode_retried;
+    bool powered;
+    bool power_target;
+    u64 power_cookie;
+    dcp_ib_cmd_async_t *cmd;
+    dcp_ib_swap_async_t *swap;
+    dcp_timing_mode_t tmode;
+    dcp_color_mode_t cmode;
+    struct nwsvc_surface fb;      /* POST framebuffer (Windows basic display) */
+    struct nwsvc_surface active;  /* what DCP shows / shows again at power on */
+    struct nwsvc_surface pending; /* present in flight */
+    bool present_active;
+    bool present_synthetic;
+    bool quiescing;
+    bool quiesce_synthetic;
+    u64 quiesce_after;
+    u64 cookie;
+    u32 synthetic_id;
+    u32 applied_swap_id;
+    u64 applied_ticks;
+    u64 submit_ticks;
+    u64 latch_ticks;
+    bool clean;
+    /* statistics (log only) */
+    u64 takeover_us, seq_us, seq_start;
+    u64 presents, present_failures, apply_us_sum, apply_us_max;
+    u32 log_budget;
+} nwsvc;
+
+static int nwsvc_fail(const char *what, int ret)
+{
+    printf("display: NWOAS-DCP-S251 %s failed (%d) op=%d poll=%d result=%d reply=%u us=%u\n", what,
+           ret, nwsvc.cmd ? nwsvc.cmd->op : -1, nwsvc.cmd ? nwsvc.cmd->last_poll : 0,
+           nwsvc.cmd ? nwsvc.cmd->last_result : 0, nwsvc.cmd ? nwsvc.cmd->last_reply : 0,
+           nwsvc.cmd ? nwsvc.cmd->last_us : 0);
+    nwsvc.seq = NWSVC_SEQ_FAILED;
+    return -1;
+}
+
+bool display_nwoas_svc_available(void)
+{
+    return has_dcp && display_is_external && !display_is_dptx;
+}
+
+void display_nwoas_svc_configure(u32 latch_us, bool clean)
+{
+    nwsvc.latch_ticks = (u64)latch_us * mrs(CNTFRQ_EL0) / 1000000;
+    nwsvc.clean = clean;
+}
+
+static bool nwsvc_seq_busy(void)
+{
+    return nwsvc.seq != NWSVC_SEQ_IDLE && nwsvc.seq != NWSVC_SEQ_DONE &&
+           nwsvc.seq != NWSVC_SEQ_FAILED;
+}
+
+static bool nwsvc_build_layer(const struct nwsvc_surface *sf, dcp_layer_t *layer, dcp_rect_t *src,
+                              dcp_rect_t *dst)
+{
+    if (!nwdcp_layer(sf->iova, sf->width, sf->height, sf->stride, layer, src, dst))
+        return false;
+    if (sf->rgba)
+        layer->surface_fmt = FMT_RGBA;
+    return true;
+}
+
+static int nwsvc_swap_begin(const struct nwsvc_surface *sf)
+{
+    dcp_layer_t layer;
+    dcp_rect_t src, dst;
+
+    if (!nwsvc_build_layer(sf, &layer, &src, &dst))
+        return -22;
+    dcp_ib_swap_async_init(nwsvc.swap);
+    nwsvc.submit_ticks = get_ticks();
+    return dcp_ib_swap_async_begin(nwsvc.swap, iboot, &layer, &src, &dst);
+}
+
+static enum dcp_ib_swap_async_result nwsvc_cmd_poll(void)
+{
+    enum dcp_ib_swap_async_result r = dcp_ib_cmd_async_poll(nwsvc.cmd);
+    dcp_ib_dispatch_deferred(iboot);
+    return r;
+}
+
+static void nwsvc_wait(enum nwsvc_seq next, u32 usec)
+{
+    nwsvc.wait_until = timeout_calculate(usec);
+    nwsvc.seq = next;
+}
+
+static void nwsvc_seq_start_on(void)
+{
+    nwsvc.hpd_tries = 0;
+    nwsvc.mode_retried = false;
+    nwsvc.seq_start = get_ticks();
+    int ret = dcp_ib_get_hpd_async(nwsvc.cmd, iboot);
+    if (ret)
+        nwsvc_fail("get_hpd submit", ret);
+    else
+        nwsvc.seq = NWSVC_SEQ_HPD;
+}
+
+/* One step of the power-on/modeset sequence (display_configure() order for an
+ * external display: HPD -> power on -> 100 ms -> modes -> set_mode -> swap) or
+ * of power off. Returns 1 done, 0 pending, -1 failed. Never waits. */
+static int nwsvc_seq_step(void)
+{
+    enum dcp_ib_swap_async_result r;
+    int ret;
+
+    switch (nwsvc.seq) {
+    case NWSVC_SEQ_IDLE:
+    case NWSVC_SEQ_FAILED:
+        return -1;
+    case NWSVC_SEQ_DONE:
+        return 1;
+    case NWSVC_SEQ_HPD: {
+        int timing_cnt = 0, color_cnt = 0;
+        r = nwsvc_cmd_poll();
+        if (r == DCP_IB_SWAP_ASYNC_PENDING)
+            return 0;
+        int hpd = r == DCP_IB_SWAP_ASYNC_APPLIED
+                      ? dcp_ib_cmd_async_hpd(nwsvc.cmd, &timing_cnt, &color_cnt)
+                      : -1;
+        if (hpd > 0 && timing_cnt > 0 && color_cnt > 0) {
+            ret = dcp_ib_set_power_async(nwsvc.cmd, iboot, true);
+            if (ret)
+                return nwsvc_fail("set_power(1) submit", ret);
+            nwsvc.seq = NWSVC_SEQ_POWER_ON;
+            return 0;
+        }
+        if (++nwsvc.hpd_tries >= NWSVC_HPD_TRIES)
+            return nwsvc_fail("hpd (no display reported)", hpd);
+        nwsvc_wait(NWSVC_SEQ_HPD_WAIT, NWSVC_HPD_RETRY_US);
+        return 0;
+    }
+    case NWSVC_SEQ_HPD_WAIT:
+        if (!timeout_expired(nwsvc.wait_until))
+            return 0;
+        ret = dcp_ib_get_hpd_async(nwsvc.cmd, iboot);
+        if (ret)
+            return nwsvc_fail("get_hpd submit", ret);
+        nwsvc.seq = NWSVC_SEQ_HPD;
+        return 0;
+    case NWSVC_SEQ_POWER_ON:
+        r = nwsvc_cmd_poll();
+        if (r == DCP_IB_SWAP_ASYNC_PENDING)
+            return 0;
+        if (r != DCP_IB_SWAP_ASYNC_APPLIED)
+            return nwsvc_fail("set_power(1)", r);
+        nwsvc_wait(NWSVC_SEQ_POWER_WAIT, NWSVC_POWER_WAIT_US);
+        return 0;
+    case NWSVC_SEQ_POWER_WAIT:
+        if (!timeout_expired(nwsvc.wait_until))
+            return 0;
+        ret = dcp_ib_get_timing_modes_async(nwsvc.cmd, iboot);
+        if (ret)
+            return nwsvc_fail("timing modes submit", ret);
+        nwsvc.seq = NWSVC_SEQ_TIMING;
+        return 0;
+    case NWSVC_SEQ_TIMING: {
+        const dcp_timing_mode_t *modes;
+        dcp_timing_mode_t want = {.valid = 1,
+                                  .width = NWSVC_WANT_WIDTH,
+                                  .height = NWSVC_WANT_HEIGHT,
+                                  .fps = 60 << 16};
+        r = nwsvc_cmd_poll();
+        if (r == DCP_IB_SWAP_ASYNC_PENDING)
+            return 0;
+        int cnt = r == DCP_IB_SWAP_ASYNC_APPLIED ? dcp_ib_cmd_async_timing_modes(nwsvc.cmd, &modes)
+                                                 : -1;
+        if (cnt <= 0)
+            return nwsvc_fail("timing modes", cnt);
+        display_choose_timing_mode((dcp_timing_mode_t *)modes, cnt, &nwsvc.tmode, &want);
+        if (!nwsvc.tmode.valid || nwsvc.tmode.width != NWSVC_WANT_WIDTH ||
+            nwsvc.tmode.height != NWSVC_WANT_HEIGHT)
+            return nwsvc_fail("1920x1080 timing mode", (int)nwsvc.tmode.width);
+        ret = dcp_ib_get_color_modes_async(nwsvc.cmd, iboot);
+        if (ret)
+            return nwsvc_fail("color modes submit", ret);
+        nwsvc.seq = NWSVC_SEQ_COLOR;
+        return 0;
+    }
+    case NWSVC_SEQ_COLOR: {
+        const dcp_color_mode_t *modes;
+        r = nwsvc_cmd_poll();
+        if (r == DCP_IB_SWAP_ASYNC_PENDING)
+            return 0;
+        int cnt = r == DCP_IB_SWAP_ASYNC_APPLIED ? dcp_ib_cmd_async_color_modes(nwsvc.cmd, &modes)
+                                                 : -1;
+        if (cnt <= 0)
+            return nwsvc_fail("color modes", cnt);
+        display_choose_color_mode((dcp_color_mode_t *)modes, cnt, &nwsvc.cmode);
+        ret = dcp_ib_set_mode_async(nwsvc.cmd, iboot, &nwsvc.tmode, &nwsvc.cmode);
+        if (ret)
+            return nwsvc_fail("set_mode submit", ret);
+        nwsvc.seq = NWSVC_SEQ_SET_MODE;
+        return 0;
+    }
+    case NWSVC_SEQ_SET_MODE:
+        r = nwsvc_cmd_poll();
+        if (r == DCP_IB_SWAP_ASYNC_PENDING)
+            return 0;
+        if (r != DCP_IB_SWAP_ASYNC_APPLIED) {
+            if (nwsvc.mode_retried)
+                return nwsvc_fail("set_mode (twice)", r);
+            nwsvc.mode_retried = true;
+            nwsvc_wait(NWSVC_SEQ_SET_MODE_WAIT, NWSVC_MODE_RETRY_US);
+            return 0;
+        }
+        ret = nwsvc_swap_begin(&nwsvc.active);
+        if (ret)
+            return nwsvc_fail("swap submit", ret);
+        nwsvc.seq = NWSVC_SEQ_SWAP;
+        return 0;
+    case NWSVC_SEQ_SET_MODE_WAIT:
+        if (!timeout_expired(nwsvc.wait_until))
+            return 0;
+        ret = dcp_ib_set_mode_async(nwsvc.cmd, iboot, &nwsvc.tmode, &nwsvc.cmode);
+        if (ret)
+            return nwsvc_fail("set_mode submit", ret);
+        nwsvc.seq = NWSVC_SEQ_SET_MODE;
+        return 0;
+    case NWSVC_SEQ_SWAP:
+        r = dcp_ib_swap_async_poll(nwsvc.swap);
+        dcp_ib_dispatch_deferred(iboot);
+        if (r == DCP_IB_SWAP_ASYNC_PENDING)
+            return 0;
+        if (r != DCP_IB_SWAP_ASYNC_APPLIED)
+            return nwsvc_fail("swap of the active surface", r);
+        nwsvc.applied_swap_id = nwsvc.swap->swap_id;
+        nwsvc.applied_ticks = get_ticks();
+        nwsvc.seq_us = ticks_to_usecs(get_ticks() - nwsvc.seq_start);
+        printf("display: NWOAS-DCP-S251 modeset %ux%u %u.%02u Hz bpp=%u, surface iova=%#lx "
+               "swap_id=%u in %lu us\n",
+               nwsvc.tmode.width, nwsvc.tmode.height, nwsvc.tmode.fps >> 16,
+               ((nwsvc.tmode.fps & 0xffff) * 100 + 0x7fff) >> 16, nwsvc.cmode.bpp,
+               nwsvc.active.iova, nwsvc.applied_swap_id, nwsvc.seq_us);
+        nwsvc.seq = NWSVC_SEQ_DONE;
+        return 1;
+    case NWSVC_SEQ_POWER_OFF:
+        r = nwsvc_cmd_poll();
+        if (r == DCP_IB_SWAP_ASYNC_PENDING)
+            return 0;
+        if (r != DCP_IB_SWAP_ASYNC_APPLIED)
+            return nwsvc_fail("set_power(0)", r);
+        nwsvc.seq = NWSVC_SEQ_DONE;
+        return 1;
+    }
+    return -1;
+}
+
+/* 1 = owned, 0 = taking over, -1 = failed (stays failed until the HV restarts). */
+int display_nwoas_svc_owner_poll(void)
+{
+    if (nwsvc_owner == 2)
+        return 1;
+    if (nwsvc_owner < 0)
+        return -1;
+    if (nwsvc_owner == 0) {
+        if (!display_nwoas_svc_available() || nwdcp.pending) {
+            nwsvc_owner = -1;
+            printf("display: NWOAS-DCP-S251 takeover refused (dcp=%d external=%d test=%d)\n",
+                   has_dcp, display_is_external, nwdcp.pending);
+            return -1;
+        }
+        for (int i = 0; i < NWOAS_DCP_MAX_BUFS; i++) {
+            if (nwdcp.bufs[i].iova) {
+                nwsvc_owner = -1;
+                printf("display: NWOAS-DCP-S251 takeover refused (S250 test buffers mapped)\n");
+                return -1;
+            }
+        }
+        nwsvc_owner = 1; /* from here on the S250 test commands refuse */
+        nwoas_dcp_iova_end = 0x60000000; /* 1.25 GiB window for the 952 MiB pool */
+        u64 t0 = get_ticks();
+        int ret = display_start_dcp();
+        nwsvc.takeover_us = ticks_to_usecs(get_ticks() - t0);
+        printf("display: NWOAS-DCP-S251 takeover: display_start_dcp()=%d in %lu us "
+               "(fb_dva=%#lx %ldx%ld stride %ld)\n",
+               ret, nwsvc.takeover_us, fb_dva, cur_boot_args.video.width,
+               cur_boot_args.video.height, cur_boot_args.video.stride);
+        if (ret < 0 || !iboot || !dcp || !fb_dva || !cur_boot_args.video.width ||
+            !cur_boot_args.video.height ||
+            cur_boot_args.video.stride < cur_boot_args.video.width * 4) {
+            nwsvc_owner = -1;
+            return -1;
+        }
+        nwsvc.cmd = malloc(sizeof(*nwsvc.cmd));
+        nwsvc.swap = malloc(sizeof(*nwsvc.swap));
+        if (!nwsvc.cmd || !nwsvc.swap) {
+            nwsvc_owner = -1;
+            printf("display: NWOAS-DCP-S251 takeover: out of memory\n");
+            return -1;
+        }
+        memset(nwsvc.cmd, 0, sizeof(*nwsvc.cmd));
+        dcp_ib_swap_async_init(nwsvc.swap);
+        nwsvc.fb = (struct nwsvc_surface){
+            .iova = fb_dva,
+            .pa = cur_boot_args.video.base,
+            .bytes = cur_boot_args.video.stride * cur_boot_args.video.height,
+            .width = cur_boot_args.video.width,
+            .height = cur_boot_args.video.height,
+            .stride = cur_boot_args.video.stride,
+        };
+        nwsvc.active = nwsvc.fb;
+        nwsvc_seq_start_on();
+        if (nwsvc.seq == NWSVC_SEQ_FAILED) {
+            nwsvc_owner = -1;
+            return -1;
+        }
+        return 0;
+    }
+    /* nwsvc_owner == 1: modeset sequence of the takeover */
+    int r = nwsvc_seq_step();
+    if (r == 0)
+        return 0;
+    if (r < 0) {
+        nwsvc_owner = -1;
+        printf("display: NWOAS-DCP-S251 takeover FAILED; scanout requests fail closed\n");
+        return -1;
+    }
+    nwsvc.powered = true;
+    nwsvc.seq = NWSVC_SEQ_IDLE;
+    nwsvc_owner = 2;
+    printf("display: NWOAS-DCP-S251 DCP owned by the hypervisor (POST framebuffer shown)\n");
+    return 1;
+}
+
+bool display_nwoas_svc_owned(void)
+{
+    return nwsvc_owner == 2;
+}
+
+static bool nwsvc_ready(void)
+{
+    return nwsvc_owner == 2 && dcp && iboot && dcp->iovad_dcp && !nwsvc_seq_busy() &&
+           !nwsvc.present_active && !nwsvc.quiescing;
+}
+
+bool display_nwoas_svc_reserve_iova(u64 size, u64 alignment, u64 *iova)
+{
+    if (!iova || !size || !alignment || (alignment & (alignment - 1)) || alignment > SZ_16K ||
+        nwsvc_owner != 2 || !dcp)
+        return false;
+    u64 allocated = iova_alloc(dcp->iovad_dcp, size);
+    if (!allocated || (allocated & (alignment - 1))) {
+        if (allocated)
+            iova_free(dcp->iovad_dcp, allocated, size);
+        return false;
+    }
+    *iova = allocated;
+    return true;
+}
+
+void display_nwoas_svc_free_iova(u64 iova, u64 size)
+{
+    if (nwsvc_owner == 2 && dcp && iova && size)
+        iova_free(dcp->iovad_dcp, iova, size);
+}
+
+bool display_nwoas_svc_map(unsigned dart_index, u64 iova, u64 pa, u64 size)
+{
+    if (nwsvc_owner != 2 || !dcp || dart_index > 1 || !iova || !pa || !size)
+        return false;
+    dart_dev_t *dart = dart_index == 0 ? dcp->dart_disp : dcp->dart_dcp;
+    return dart_map(dart, iova, (void *)(uintptr_t)pa, size) == 0;
+}
+
+void display_nwoas_svc_unmap(unsigned dart_index, u64 iova, u64 size)
+{
+    if (nwsvc_owner != 2 || !dcp || dart_index > 1 || !iova || !size)
+        return;
+    dart_dev_t *dart = dart_index == 0 ? dcp->dart_disp : dcp->dart_dcp;
+    dart_unmap(dart, iova, size);
+}
+
+bool display_nwoas_svc_present_begin(u64 iova, u64 pa, u32 width, u32 height, u32 stride,
+                                     bool rgba, u64 bytes, u64 *cookie)
+{
+    if (!cookie || !nwsvc_ready() || !iova || !pa || !width || !height ||
+        (u64)stride < (u64)width * 4 || (u64)stride * height > bytes)
+        return false;
+    nwsvc.pending = (struct nwsvc_surface){iova, pa, bytes, width, height, stride, rgba};
+    if (nwsvc.clean)
+        dc_civac_range((void *)(uintptr_t)pa, (size_t)stride * height);
+    nwsvc.present_synthetic = !nwsvc.powered;
+    if (!nwsvc.present_synthetic && nwsvc_swap_begin(&nwsvc.pending))
+        return false;
+    nwsvc.present_active = true;
+    if (++nwsvc.cookie == 0)
+        ++nwsvc.cookie;
+    *cookie = nwsvc.cookie;
+    return true;
+}
+
+/* 1 = APPLIED (swap_id set), 0 = pending, -1 = failed */
+int display_nwoas_svc_present_poll(u64 cookie, u32 *swap_id)
+{
+    if (!swap_id || !nwsvc.present_active || cookie != nwsvc.cookie)
+        return -1;
+    if (nwsvc.present_synthetic) {
+        /* Display off: nothing is scanned out; the surface becomes the one
+         * shown again at power on and retires on the time base. */
+        if (++nwsvc.synthetic_id == 0)
+            nwsvc.synthetic_id = 1;
+        nwsvc.applied_swap_id = NWSVC_SYNTHETIC_ID | (nwsvc.synthetic_id & 0x3fffffffu);
+    } else {
+        enum dcp_ib_swap_async_result r = dcp_ib_swap_async_poll(nwsvc.swap);
+        dcp_ib_dispatch_deferred(iboot);
+        if (r == DCP_IB_SWAP_ASYNC_PENDING)
+            return 0;
+        if (r != DCP_IB_SWAP_ASYNC_APPLIED || nwsvc.swap->swap_id <= 0) {
+            nwsvc.present_active = false;
+            nwsvc.present_failures++;
+            if (nwsvc.log_budget < 16) {
+                nwsvc.log_budget++;
+                printf("display: NWOAS-DCP-S251 present FAILED stage=%d result=%d\n",
+                       nwsvc.swap->stage, nwsvc.swap->command.result);
+            }
+            return -1;
+        }
+        nwsvc.applied_swap_id = (u32)nwsvc.swap->swap_id;
+        u64 us = ticks_to_usecs(get_ticks() - nwsvc.submit_ticks);
+        nwsvc.apply_us_sum += us;
+        if (us > nwsvc.apply_us_max)
+            nwsvc.apply_us_max = us;
+    }
+    nwsvc.present_active = false;
+    nwsvc.applied_ticks = get_ticks();
+    nwsvc.active = nwsvc.pending;
+    nwsvc.presents++;
+    if (nwsvc.presents <= 4 || !(nwsvc.presents & 0x3ff))
+        printf("display: NWOAS-DCP-S251 present #%lu iova=%#lx swap_id=%#x apply avg %lu max %lu us "
+               "failures %lu%s\n",
+               nwsvc.presents, nwsvc.active.iova, nwsvc.applied_swap_id,
+               nwsvc.presents ? nwsvc.apply_us_sum / nwsvc.presents : 0, nwsvc.apply_us_max,
+               nwsvc.present_failures, nwsvc.present_synthetic ? " (display off)" : "");
+    *swap_id = nwsvc.applied_swap_id;
+    return 1;
+}
+
+/* Time-based LATCHED: APPLIED (SWAP_END reply) + the configured delay. */
+int display_nwoas_svc_latch_poll(u32 expected_swap_id)
+{
+    if (!expected_swap_id || expected_swap_id != nwsvc.applied_swap_id)
+        return -2;
+    return get_ticks() - nwsvc.applied_ticks >= nwsvc.latch_ticks ? 1 : 0;
+}
+
+/* RELEASE: put the POST framebuffer back before the pool is unmapped
+ * (UP display_scanout_quiesce_*: APPLIED + 150 ms). */
+bool display_nwoas_svc_quiesce_begin(u64 *cookie)
+{
+    if (!cookie || !nwsvc_ready())
+        return false;
+    nwsvc.pending = nwsvc.fb;
+    nwsvc.quiesce_synthetic = !nwsvc.powered;
+    if (!nwsvc.quiesce_synthetic && nwsvc_swap_begin(&nwsvc.fb))
+        return false;
+    nwsvc.quiescing = true;
+    nwsvc.quiesce_after = 0;
+    if (++nwsvc.cookie == 0)
+        ++nwsvc.cookie;
+    *cookie = nwsvc.cookie;
+    return true;
+}
+
+int display_nwoas_svc_quiesce_poll(u64 cookie)
+{
+    if (!nwsvc.quiescing || cookie != nwsvc.cookie)
+        return -1;
+    if (nwsvc.quiesce_synthetic) {
+        nwsvc.active = nwsvc.fb;
+        nwsvc.quiescing = false;
+        return 1;
+    }
+    if (!nwsvc.quiesce_after) {
+        enum dcp_ib_swap_async_result r = dcp_ib_swap_async_poll(nwsvc.swap);
+        dcp_ib_dispatch_deferred(iboot);
+        if (r == DCP_IB_SWAP_ASYNC_PENDING)
+            return 0;
+        if (r != DCP_IB_SWAP_ASYNC_APPLIED) {
+            nwsvc.quiescing = false;
+            printf("display: NWOAS-DCP-S251 restoring the POST framebuffer FAILED\n");
+            return -1;
+        }
+        nwsvc.applied_swap_id = (u32)nwsvc.swap->swap_id;
+        nwsvc.applied_ticks = get_ticks();
+        nwsvc.active = nwsvc.fb;
+        nwsvc.quiesce_after = timeout_calculate(NWSVC_QUIESCE_US);
+        return 0;
+    }
+    if (!timeout_expired(nwsvc.quiesce_after))
+        return 0;
+    nwsvc.quiescing = false;
+    printf("display: NWOAS-DCP-S251 pool released, POST framebuffer shown again\n");
+    return 1;
+}
+
+bool display_nwoas_svc_power_begin(bool on, u64 *cookie)
+{
+    if (!cookie || !nwsvc_ready())
+        return false;
+    nwsvc.power_target = on;
+    if (on) {
+        nwsvc_seq_start_on(); /* full modeset, then the active surface is presented again */
+    } else {
+        nwsvc.seq_start = get_ticks();
+        int ret = dcp_ib_set_power_async(nwsvc.cmd, iboot, false);
+        if (ret)
+            nwsvc_fail("set_power(0) submit", ret);
+        else
+            nwsvc.seq = NWSVC_SEQ_POWER_OFF;
+    }
+    if (nwsvc.seq == NWSVC_SEQ_FAILED) {
+        nwsvc.seq = NWSVC_SEQ_IDLE;
+        return false;
+    }
+    if (++nwsvc.cookie == 0)
+        ++nwsvc.cookie;
+    nwsvc.power_cookie = *cookie = nwsvc.cookie;
+    printf("display: NWOAS-DCP-S251 display power %s requested\n", on ? "on" : "off");
+    return true;
+}
+
+int display_nwoas_svc_power_poll(u64 cookie)
+{
+    if (cookie != nwsvc.power_cookie || nwsvc.seq == NWSVC_SEQ_IDLE)
+        return -1;
+    int r = nwsvc_seq_step();
+    if (r == 0)
+        return 0;
+    nwsvc.seq = NWSVC_SEQ_IDLE;
+    if (r < 0) {
+        printf("display: NWOAS-DCP-S251 display power %s FAILED\n",
+               nwsvc.power_target ? "on" : "off");
+        return -1;
+    }
+    nwsvc.powered = nwsvc.power_target;
+    printf("display: NWOAS-DCP-S251 display power %s done in %lu us\n",
+           nwsvc.powered ? "on" : "off", ticks_to_usecs(get_ticks() - nwsvc.seq_start));
+    return 1;
+}
+
+/* ---- end NWOAS S251 ---- */
+#endif
 
