+const void *dcp_ib_cmd_async_reply(const dcp_ib_cmd_async_t *cmd, size_t *payload_size)
+{
+    size_t size;
+
+    if (!cmd || cmd->active || cmd->failed)
+        return NULL;
+    size = afk_epic_command_reply_size(&cmd->command);
+    if (size < sizeof(struct rxcmd))
+        return NULL;
+    if (payload_size)
+        *payload_size = size - sizeof(struct rxcmd);
+    return ((const struct rxcmd *)cmd->rxbuf)->payload;
+}
+
+int dcp_ib_cmd_async_hpd(const dcp_ib_cmd_async_t *cmd, int *timing_cnt, int *color_cnt)
+{
