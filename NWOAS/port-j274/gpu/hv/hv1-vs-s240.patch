diff -ruN m1n1-gpu-s240/src/nwoas_agx.c m1n1-gpu-hv1/src/nwoas_agx.c
--- m1n1-gpu-s240/src/nwoas_agx.c	1970-01-01 09:00:00
+++ m1n1-gpu-hv1/src/nwoas_agx.c	2026-11-15 21:55:47
@@ -0,0 +1,368 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * NWOAS gpu-hv1 (step 1): read-only AGX probe for J274. See nwoas_agx.h for the
+ * contract (ADT reads + printf only; no power, no map, no MMIO, no RAM access).
+ */
+
+#include "nwoas_agx.h"
+#include "adt.h"
+#include "firmware.h"
+#include "hv_agx_g2.generated.h"
+#include "memory.h"
+#include "soc.h"
+#include "string.h"
+#include "utils.h"
+
+#if !NWOAS_AGX
+#error "nwoas_agx.c is built only with make NWOAS_AGX=1"
+#endif
+
+#define PFX "NWOAS-AGX: "
+
+#define AGX_PAGE      0x4000ULL /* 16 KiB, GPU/UAT page size */
+#define MAX_REGS      8
+
+u64 nwoas_agx_gpu_base, nwoas_agx_gpu_size;
+u64 nwoas_agx_handoff_base, nwoas_agx_handoff_size;
+u64 nwoas_agx_shared_base, nwoas_agx_shared_size;
+u32 nwoas_agx_sgx_irqs[NWOAS_AGX_MAX_IRQS];
+u32 nwoas_agx_sgx_irq_count;
+
+static bool probe_done;
+static bool probe_ok;
+static const char *refusal = "probe not run";
+
+bool nwoas_agx_probe_ok(void)
+{
+    return probe_ok;
+}
+
+const char *nwoas_agx_refusal(void)
+{
+    return probe_ok ? NULL : refusal;
+}
+
+static const char *agx_first_string(int node, const char *prop)
+{
+    u32 len = 0;
+    const char *s = adt_getprop(adt, node, prop, &len);
+
+    if (!s || !len || s[len - 1] != '\0')
+        return "(missing)";
+    return s;
+}
+
+/* Reads a u64 property; false if absent or not exactly 8 bytes. */
+static bool agx_get_u64(int node, const char *prop, u64 *out)
+{
+    u32 len = 0;
+    const void *p = adt_getprop(adt, node, prop, &len);
+
+    if (!p || len != sizeof(u64))
+        return false;
+    memcpy(out, p, sizeof(u64));
+    return true;
+}
+
+static void agx_print_u32_prop(int node, const char *prop)
+{
+    u32 len = 0;
+    const void *p = adt_getprop(adt, node, prop, &len);
+    u32 v;
+
+    if (!p || len != sizeof(u32)) {
+        printf(PFX "  sgx %s: missing (len=%u)\n", prop, p ? len : 0);
+        return;
+    }
+    memcpy(&v, p, sizeof(v));
+    printf(PFX "  sgx %s = %u (0x%x)\n", prop, v, v);
+}
+
+/* Prints every "reg" entry of a node (translated through the parent ranges by
+ * adt_get_reg). Returns the number of entries found. */
+static int agx_print_regs(const char *label, int *path, u64 *first_base, u64 *first_size)
+{
+    int n = 0;
+
+    for (int i = 0; i < MAX_REGS; i++) {
+        u64 base = 0, size = 0;
+
+        if (adt_get_reg(adt, path, "reg", i, &base, &size) < 0)
+            break;
+        printf(PFX "  %s reg[%d] = 0x%lx size 0x%lx\n", label, i, base, size);
+        if (i == 0) {
+            *first_base = base;
+            *first_size = size;
+        }
+        n++;
+    }
+    if (!n)
+        printf(PFX "  %s reg: none\n", label);
+    return n;
+}
+
+/* Reads a u32 array property (e.g. "interrupts") into out[], max cap entries. */
+static int agx_read_u32_list(int node, const char *prop, u32 *out, int cap, u32 *total)
+{
+    u32 len = 0;
+    const u8 *p = adt_getprop(adt, node, prop, &len);
+    int n;
+
+    *total = 0;
+    if (!p || !len || (len % sizeof(u32)))
+        return -1;
+    *total = len / sizeof(u32);
+    n = (int)min(*total, (u32)cap);
+    for (int i = 0; i < n; i++)
+        memcpy(&out[i], p + i * sizeof(u32), sizeof(u32));
+    return n;
+}
+
+static void agx_print_u32_list(const char *label, const u32 *v, int n, u32 total)
+{
+    printf(PFX "  %s interrupts (%u):", label, total);
+    for (int i = 0; i < n; i++)
+        printf(" %u", v[i]);
+    if (total > (u32)n)
+        printf(" ...(+%u not shown)", total - (u32)n);
+    printf("\n");
+}
+
+static bool agx_range_ok(u64 base, u64 size)
+{
+    return base && size && !(base & (AGX_PAGE - 1)) && !(size & (AGX_PAGE - 1)) &&
+           base + size > base;
+}
+
+/* One sgx "<name>-base" / "<name>-size" pair (same names kboot_gpu.c uses). */
+static bool agx_read_region(int sgx, const char *name, u64 *base, u64 *size)
+{
+    char prop[48];
+    bool have_b, have_s;
+
+    snprintf(prop, sizeof(prop), "%s-base", name);
+    have_b = agx_get_u64(sgx, prop, base);
+    snprintf(prop, sizeof(prop), "%s-size", name);
+    have_s = agx_get_u64(sgx, prop, size);
+
+    if (!have_b || !have_s) {
+        printf(PFX "  sgx %s: MISSING (%s%s)\n", name, have_b ? "" : "base ",
+               have_s ? "" : "size");
+        return false;
+    }
+    bool in_dram = *base >= ram_base && *base + *size > *base &&
+                   *base + *size <= ram_base + mem_size_actual;
+    printf(PFX "  sgx %s = 0x%lx size 0x%lx (%s, %s DRAM [0x%lx, 0x%lx))\n", name, *base,
+           *size, agx_range_ok(*base, *size) ? "16K-aligned" : "NOT 16K-aligned/empty",
+           in_dram ? "inside" : "OUTSIDE", ram_base, ram_base + mem_size_actual);
+    return agx_range_ok(*base, *size);
+}
+
+static bool agx_overlaps(u64 a, u64 an, u64 b, u64 bn)
+{
+    return an && bn && a < b + bn && b < a + an;
+}
+
+/* Walks /chosen/carveout-memory-map (same iteration as upstream
+ * local_reserve_carveouts_allow(), nwoas_agx_mmio.c.orig_ref:470-495). Prints the
+ * region-id-* entries that overlap the three GPU ranges and the largest entry
+ * (the normal-DRAM owner candidate; J313 upstream hard-codes region-id-24).
+ * Information for step 2 only; never gates the probe. */
+static void agx_print_carveouts(u64 gb, u64 gs, u64 hb, u64 hs, u64 sb, u64 ss)
+{
+    int node = adt_path_offset(adt, "/chosen/carveout-memory-map");
+    int count, offset, found = 0;
+    const char *big_name = NULL;
+    u64 big[2] = {0, 0};
+
+    if (node < 0) {
+        printf(PFX "  /chosen/carveout-memory-map: not found\n");
+        return;
+    }
+    count = adt_get_property_count(adt, node);
+    offset = adt_first_property_offset(adt, node);
+    for (int i = 0; i < count; i++) {
+        const char *name = NULL;
+        u32 bytes = 0;
+        const void *value = adt_getprop_by_offset(adt, offset, &name, &bytes);
+        u64 r[2];
+
+        if (!value || !name || bytes > 0x100000) {
+            printf(PFX "  carveout walk stopped at property %d (bad entry)\n", i);
+            break;
+        }
+        if (!strncmp(name, "region-id-", 10) && bytes == sizeof(r)) {
+            memcpy(r, value, sizeof(r));
+            found++;
+            if (r[1] > big[1]) {
+                big[0] = r[0];
+                big[1] = r[1];
+                big_name = name;
+            }
+            if (agx_overlaps(r[0], r[1], gb, gs) || agx_overlaps(r[0], r[1], hb, hs) ||
+                agx_overlaps(r[0], r[1], sb, ss))
+                printf(PFX "  carveout %s = 0x%lx size 0x%lx%s%s%s\n", name, r[0], r[1],
+                       agx_overlaps(r[0], r[1], gb, gs) ? " [gpu-region]" : "",
+                       agx_overlaps(r[0], r[1], hb, hs) ? " [gfx-handoff]" : "",
+                       agx_overlaps(r[0], r[1], sb, ss) ? " [gfx-shared-region]" : "");
+        }
+        offset += sizeof(struct adt_property) + ALIGN_UP(bytes, 4);
+    }
+    if (big_name)
+        printf(PFX "  carveout largest: %s = 0x%lx size 0x%lx (normal-DRAM owner candidate)\n",
+               big_name, big[0], big[1]);
+    printf(PFX "  carveout region-id-* entries: %d\n", found);
+}
+
+static bool agx_irq_in_j313_contract(u32 irq)
+{
+    static const struct hv_agx_g2_interrupt_route j313[HV_AGX_G2_INTERRUPT_ROUTE_COUNT] =
+        HV_AGX_G2_INTERRUPT_ROUTE_VALUES;
+
+    for (u32 i = 0; i < HV_AGX_G2_INTERRUPT_ROUTE_COUNT; i++)
+        if (j313[i].physical_intid == irq)
+            return true;
+    return false;
+}
+
+static void agx_refuse(const char *why)
+{
+    refusal = why;
+    printf(PFX "REFUSED: %s (nothing armed; globals stay 0)\n", why);
+}
+
+void nwoas_agx_probe(void)
+{
+    int sgx_path[8] = {0}, asc_path[8] = {0};
+    int sgx, asc;
+    u64 sgx_base = 0, sgx_size = 0, asc_base = 0, asc_size = 0;
+    u64 gb = 0, gs = 0, hb = 0, hs = 0, sb = 0, ss = 0;
+    u32 sgx_irqs[NWOAS_AGX_MAX_IRQS], asc_irqs[NWOAS_AGX_MAX_IRQS];
+    u32 irq_total = 0, asc_irq_total = 0;
+    int nirq, nasc_irq = -1;
+    bool regions_ok = true;
+
+    if (probe_done) {
+        printf(PFX "probe already ran: %s\n", probe_ok ? "OK" : refusal);
+        return;
+    }
+    probe_done = true;
+
+    printf(PFX "probe start (step 1, read-only: ADT reads only; no power, no map, no MMIO)\n");
+    printf(PFX "  chip_id=0x%x board_id=0x%x target-type=%s\n", chip_id, board_id,
+           agx_first_string(0, "target-type"));
+    printf(PFX "  OS firmware %s, system firmware %s\n",
+           os_firmware.string ? os_firmware.string : "(unknown)",
+           system_firmware.string ? system_firmware.string : "(unknown)");
+
+    /* /arm-io/sgx */
+    sgx = adt_path_offset_trace(adt, "/arm-io/sgx", sgx_path);
+    if (sgx < 0) {
+        agx_refuse("ADT /arm-io/sgx not found");
+        return;
+    }
+    printf(PFX "  /arm-io/sgx compatible=%s\n", agx_first_string(sgx, "compatible"));
+    agx_print_regs("sgx", sgx_path, &sgx_base, &sgx_size);
+    if (sgx_base)
+        printf(PFX "  sgx reg[0] %s the J313 contract aperture (0x%llx size 0x%llx)\n",
+               (sgx_base == HV_AGX_G2_SGX_MMIO_BASE && sgx_size == HV_AGX_G2_SGX_MMIO_SIZE)
+                   ? "EQUALS"
+                   : "DIFFERS FROM",
+               HV_AGX_G2_SGX_MMIO_BASE, HV_AGX_G2_SGX_MMIO_SIZE);
+
+    nirq = agx_read_u32_list(sgx, "interrupts", sgx_irqs, NWOAS_AGX_MAX_IRQS, &irq_total);
+    if (nirq < 0) {
+        printf(PFX "  sgx interrupts: missing/malformed\n");
+    } else {
+        int in_j313 = 0;
+
+        agx_print_u32_list("sgx", sgx_irqs, nirq, irq_total);
+        for (int i = 0; i < nirq; i++)
+            in_j313 += agx_irq_in_j313_contract(sgx_irqs[i]);
+        printf(PFX "  sgx interrupts: %d of %d are in the J313 contract set (%u entries); "
+                   "the HV delivers AIC IRQs identity-mapped (vINTID == hwirq)\n",
+               in_j313, nirq, HV_AGX_G2_INTERRUPT_ROUTE_COUNT);
+    }
+
+    agx_print_u32_prop(sgx, "perf-state-count");
+    agx_print_u32_prop(sgx, "perf-state-table-count");
+    agx_print_u32_prop(sgx, "gpu-num-perf-states");
+    agx_print_u32_prop(sgx, "gpu-perf-base-pstate");
+    agx_print_u32_prop(sgx, "gpu-power-sample-period");
+    {
+        u32 len = 0;
+        const void *p = adt_getprop(adt, sgx, "perf-states", &len);
+        printf(PFX "  sgx perf-states: %s (len %u)\n", p ? "present" : "missing", p ? len : 0);
+    }
+
+    regions_ok &= agx_read_region(sgx, "gpu-region", &gb, &gs);
+    regions_ok &= agx_read_region(sgx, "gfx-handoff", &hb, &hs);
+    regions_ok &= agx_read_region(sgx, "gfx-shared-region", &sb, &ss);
+
+    /* /arm-io/gfx-asc */
+    asc = adt_path_offset_trace(adt, "/arm-io/gfx-asc", asc_path);
+    if (asc < 0) {
+        printf(PFX "  /arm-io/gfx-asc: not found\n");
+    } else {
+        printf(PFX "  /arm-io/gfx-asc compatible=%s\n", agx_first_string(asc, "compatible"));
+        agx_print_regs("gfx-asc", asc_path, &asc_base, &asc_size);
+        nasc_irq = agx_read_u32_list(asc, "interrupts", asc_irqs, NWOAS_AGX_MAX_IRQS, &asc_irq_total);
+        if (nasc_irq < 0)
+            printf(PFX "  gfx-asc interrupts: missing/malformed\n");
+        else {
+            int in_j313 = 0;
+
+            agx_print_u32_list("gfx-asc", asc_irqs, nasc_irq, asc_irq_total);
+            for (int i = 0; i < nasc_irq; i++)
+                in_j313 += agx_irq_in_j313_contract(asc_irqs[i]);
+            printf(PFX "  gfx-asc interrupts: %d of %d are in the J313 contract set\n", in_j313,
+                   nasc_irq);
+        }
+    }
+
+    agx_print_carveouts(gb, gs, hb, hs, sb, ss);
+
+    /* Gates. Order = most basic first; the first failure is the refusal. */
+    if (chip_id != T8103) {
+        agx_refuse("chip is not T8103");
+        return;
+    }
+    if (board_id != NWOAS_AGX_BOARD_J274) {
+        agx_refuse("board-id is not J274 (0x22)");
+        return;
+    }
+    if (!sgx_base || !sgx_size) {
+        agx_refuse("sgx reg[0] missing");
+        return;
+    }
+    if (nirq <= 0 || irq_total > NWOAS_AGX_MAX_IRQS) {
+        agx_refuse("sgx interrupts missing or more than NWOAS_AGX_MAX_IRQS");
+        return;
+    }
+    if (asc < 0 || !asc_base || !asc_size) {
+        agx_refuse("gfx-asc node or reg[0] missing");
+        return;
+    }
+    if (!regions_ok) {
+        agx_refuse("gpu-region / gfx-handoff / gfx-shared-region missing or not 16K-aligned");
+        return;
+    }
+    if (agx_overlaps(gb, gs, hb, hs) || agx_overlaps(gb, gs, sb, ss) || agx_overlaps(hb, hs, sb, ss)) {
+        agx_refuse("gpu-region / gfx-handoff / gfx-shared-region overlap each other");
+        return;
+    }
+
+    nwoas_agx_gpu_base = gb;
+    nwoas_agx_gpu_size = gs;
+    nwoas_agx_handoff_base = hb;
+    nwoas_agx_handoff_size = hs;
+    nwoas_agx_shared_base = sb;
+    nwoas_agx_shared_size = ss;
+    memcpy(nwoas_agx_sgx_irqs, sgx_irqs, (size_t)nirq * sizeof(u32));
+    nwoas_agx_sgx_irq_count = (u32)nirq;
+    probe_ok = true;
+    refusal = NULL;
+    printf(PFX "probe OK: gpu-region 0x%lx+0x%lx handoff 0x%lx+0x%lx shared 0x%lx+0x%lx, "
+               "%u sgx irqs. Step 1 is inert: nothing powered, mapped or hooked.\n",
+           gb, gs, hb, hs, sb, ss, nwoas_agx_sgx_irq_count);
+}
