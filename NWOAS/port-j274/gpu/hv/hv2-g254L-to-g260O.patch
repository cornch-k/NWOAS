+/* NWOAS S260: read-only SLC state for measurement.  out[2*i] = PLANE_CACHE_ENABLE,
+ * out[2*i+1] = PLANE_CACHE_STATUS for every MCC plane (T8103: 1 MCC x 4 planes).
+ * Returns the number of words written, or -1 when the MCC was not initialised. */
+int mcc_cache_status(u32 *out, int max_words)
+{
+    int n = 0;
+
+    if (!mcc_initialized)
+        return -1;
+    for (int mcc = 0; mcc < mcc_count; mcc++) {
+        for (int plane = 0; plane < mcc_regs[mcc].plane_count; plane++) {
+            if (n + 2 > max_words)
+                return n;
+            out[n++] = plane_read32(mcc, plane, PLANE_CACHE_ENABLE);
+            out[n++] = plane_read32(mcc, plane, PLANE_CACHE_STATUS);
+        }
+    }
+    return n;
+}
