+/* NWOAS S260 phase 0: per-SQ-slot doorbell time and the source of the current
+ * processing call (doorbell trap or CPU0 tick).  Boot-local, under bhl. */
+static u64 nwoas_pwr_sq_ts[NWOAS_NVME_MAX_IO_DEPTH];
+static bool nwoas_pwr_from_doorbell;
+
+static void nwoas_pwr_nvme_done(const struct nwoas_nvme_guest_cmd *cmd, u64 elapsed)
+{
+    struct nwoas_pwr_nvme *n = &nwoas_pwr_nvme;
+    u64 now = mrs(CNTPCT_EL0);
+    if (nwoas_pwr_from_doorbell)
+        n->doorbell_cmds++;
+    else
+        n->tick_cmds++;
+    if (cmd->nsid == 2) {
+        n->ns2_cmds++;
+        return;
+    }
+    if (cmd->nsid != 1) {
+        n->other_cmds++;
+        return;
+    }
+    n->ns1_cmds++;
+    n->exec_sum_ticks += elapsed;
+    u32 blocks = (cmd->cdw12 & 0xffff) + 1;
+    if (cmd->opcode == 2)
+        n->read_blocks += blocks;
+    else if (cmd->opcode == 1)
+        n->write_blocks += blocks;
+    u16 size = nwoas_nvme_fp.sq_size;
+    u64 depth = size ? (nwoas_nvme_fp.sq_tail + size - nwoas_nvme_fp.sq_head) % size : 0;
+    n->depth_sum += depth;
+    n->depth_samples++;
+    if (depth > n->depth_max)
+        n->depth_max = depth;
+    u64 ts = nwoas_pwr_sq_ts[nwoas_nvme_fp.sq_head % NWOAS_NVME_MAX_IO_DEPTH];
+    if (!ts || ts > now)
+        return;
+    u64 lat = now - ts;
+    u64 us = lat * 1000000 / mrs(CNTFRQ_EL0);
+    n->lat_count++;
+    n->lat_sum_ticks += lat;
+    if (lat > n->lat_max_ticks)
+        n->lat_max_ticks = lat;
+    n->lat_hist[us < 20 ? 0 : us < 100 ? 1 : us < 500 ? 2 : us < 2000 ? 3 : us < 10000 ? 4 : 5]++;
+}
