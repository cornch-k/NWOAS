+    }
+    u64 pctl = mrs(CNTP_CTL_EL02);
+    if ((pctl & (CNTx_CTL_ENABLE | CNTx_CTL_IMASK)) == CNTx_CTL_ENABLE) {
+        u64 d = mrs(CNTP_CVAL_EL02);
+        if (d < best)
+            best = d;
+    }
+    if (best < hv_cval) {
+        msr(CNTP_CVAL_EL0, best);
+        NWOAS_PWR_INC(wake_armed);
+    }
