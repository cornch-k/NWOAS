+/* NWOAS S260: read-only key read (same message layout as proxyclient m1n1/fw/smc.py
+ * SMCReadKey: TYPE 7:0, SIZE 23:16, KEY 63:32; result VALUE 63:32 for size <= 4). */
+int smc_read_key(smc_dev_t *smc, u32 key, void *buf, u32 size)
+{
+    if (!size || size > 4)
+        return -1;
+    u64 msg = FIELD_PREP(SMC_MSG_TYPE, SMC_READ_KEY);
+    msg |= FIELD_PREP(SMC_WRITE_KEY_SIZE, size);
+    msg |= FIELD_PREP(SMC_WRITE_KEY_KEY, key);
+    u64 result = 0;
+    int ret = smc_cmd_result(smc, msg, &result);
+    if (ret)
+        return ret;
+    u32 value = FIELD_GET(SMC_RESULT_VALUE, result);
+    memcpy(buf, &value, size);
+    return 0;
+}
