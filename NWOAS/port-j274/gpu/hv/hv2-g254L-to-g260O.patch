+/* NWOAS S260 C-1: may this CPU really sleep for a trapped guest WFI?
+ * Called on the bhl-free WFI fast path right after hv_update_fiq().  Returns 0 to
+ * sleep, 1 = an interrupt is already deliverable/pending, 2 = a guest timer route is
+ * masked (fired but injected/outstanding/rate-limited, so its expiry would not wake
+ * EL2 by itself). */
+static int nwoas_wfi_sleep_check(void)
+{
+    if (mrs(ISR_EL1) & (0x80 | 0x40)) /* physical IRQ/FIQ already pending at EL2 */
+        return 1;
+    if (PERCPU(ipi_pending) || PERCPU(pmc_pending))
+        return 1;
+#ifdef ENABLE_VGIC_MODULE
+    /* S260 fix 2: the NVMe IRQ is bridged only here (interruptible CPU).  While its
+     * level is up but not yet injected (e.g. the 50 us re-assert gap), keep the old
+     * busy NOP-advance so hv_update_fiq() retries at once instead of after a tick. */
+    {
+        int icpu = hv_pinned_cpu == -1 ? boot_cpu_idx : hv_pinned_cpu;
+        if ((int)smp_id() == icpu && (nwoas_nvme_irq_host_level || nwoas_nvme_irq_fast_level) &&
+            hv_vgic3_spi_enabled(900) && !hv_vgic_virq_outstanding(900))
+            return 4;
+    }
+    u64 used = ~mrs(ICH_ELRSR_EL2) & 0xffULL;
+    for (int lr = 0; lr < 8; lr++)
+        if ((used & BIT(lr)) && (hv_vgic3_read_lr(lr) & ICH_LR_STATE_PENDING))
+            return 1;
+    if (PERCPU(irq_queue).head != PERCPU(irq_queue).tail ||
+        PERCPU(sgi_queue).head != PERCPU(sgi_queue).tail ||
+        PERCPU(timer_queue).head != PERCPU(timer_queue).tail)
+        return 1;
+#endif
+    u64 both = VM_TMR_FIQ_ENA_ENA_V | VM_TMR_FIQ_ENA_ENA_P;
+    if ((mrs(SYS_IMP_APL_VM_TMR_FIQ_ENA_EL2) & both) != both)
+        return 2;
+    return 0;
+}
