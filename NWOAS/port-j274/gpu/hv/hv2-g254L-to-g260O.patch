+
+/* Never NULL, never out of bounds: a CPU index outside 0..7 (not expected on J274)
+ * counts into a spare slot instead of aliasing another CPU's counters. */
+static inline struct nwoas_pwr_cpu *nwoas_pwr_me(void)
+{
+    u64 id = mrs(TPIDR_EL2);
+    return id < NWOAS_PWR_NCPU ? &nwoas_pwr_cpu[id] : &nwoas_pwr_cpu_spare;
+}
+#define NWOAS_PWR_INC(field) (nwoas_pwr_me()->field++)
+
+u64 nwoas_pwr_proxy(u64 op, u64 a0, u64 a1, u64 a2, u64 a3);
