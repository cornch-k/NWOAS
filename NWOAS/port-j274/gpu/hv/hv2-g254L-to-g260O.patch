diff -ruN a/src/nwoas_pwr.c b/src/nwoas_pwr.c
--- a/src/nwoas_pwr.c	1970-01-01 09:00:00
+++ b/src/nwoas_pwr.c	2026-11-18 17:21:30
@@ -0,0 +1,330 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * NWOAS S260: phase-0 measurement + phase-1 small hypervisor fixes.
+ * See nwoas_pwr.h.  Everything here is inert until P_HV_NWOAS_PWR CONFIG.
+ * HARDWARE-UNVERIFIED.
+ */
+#include "nwoas_pwr.h"
+#include "cpu_regs.h"
+#include "hv.h"
+#include "iodev.h"
+#include "mcc.h"
+#include "nvme.h"
+#include "smc.h"
+#include "smp.h"
+#include "string.h"
+#include "utils.h"
+
+extern spinlock_t bhl;
+extern u64 hv_tick_interval;
+extern int hv_pinned_cpu;
+
+volatile u32 nwoas_pwr_flags;
+u64 nwoas_pwr_sec_interval;
+u64 nwoas_pwr_timer_gap_ticks;
+struct nwoas_pwr_cpu nwoas_pwr_cpu[NWOAS_PWR_NCPU];
+struct nwoas_pwr_cpu nwoas_pwr_cpu_spare;
+struct nwoas_pwr_nvme nwoas_pwr_nvme;
+u64 nwoas_pwr_hv_ticks;
+u64 nwoas_pwr_proxy_ticks;
+
+static bool nwoas_pwr_started;
+static u32 nwoas_pwr_sec_hz;
+static u64 nwoas_pwr_print_ticks, nwoas_pwr_next_print, nwoas_pwr_prints;
+static u64 nwoas_pwr_smc_reads, nwoas_pwr_smc_errors;
+static struct nwoas_pwr_snapshot nwoas_pwr_last; /* previous periodic print (deltas) */
+
+#define NWOAS_PWR_MAX_PRINTS 4000
+#define NWOAS_SMC_KEY(a, b, c, d)                                                                  \
+    (((u32)(a) << 24) | ((u32)(b) << 16) | ((u32)(c) << 8) | (u32)(d))
+
+void nwoas_pwr_guest_starting(void)
+{
+    nwoas_pwr_started = true;
+}
+
+static u64 nwoas_pwr_configure(u64 flags, u64 sec_hz, u64 gap_us, u64 print_s)
+{
+    u64 frq = mrs(CNTFRQ_EL0);
+
+    if (flags & ~(u64)NWOAS_PWR_F_ALL)
+        return 0;
+    if (flags & NWOAS_PWR_F_SEC_TICK) {
+        if (!sec_hz)
+            sec_hz = 100;
+        if (sec_hz < 10 || sec_hz > 5000)
+            return 0;
+    }
+    if ((flags & NWOAS_PWR_F_TIMER_GAP) && gap_us > 62500)
+        return 0;
+    if (print_s > 3600)
+        return 0;
+
+    nwoas_pwr_sec_hz = (flags & NWOAS_PWR_F_SEC_TICK) ? sec_hz : 0;
+    nwoas_pwr_sec_interval = nwoas_pwr_sec_hz ? frq / nwoas_pwr_sec_hz : 0;
+    nwoas_pwr_timer_gap_ticks = frq * gap_us / 1000000;
+    nwoas_pwr_print_ticks = print_s * frq;
+    nwoas_pwr_next_print = 0;
+    sysop("dmb ish");
+    nwoas_pwr_flags = (u32)flags; /* published last; readers only test bits */
+    sysop("dsb ish");
+    printf("NWOAS-PWR: config flags=0x%lx sec_tick_hz=%lu timer_gap_us=%lu print_s=%lu "
+           "started=%d\n",
+           flags, (u64)nwoas_pwr_sec_hz, gap_us, print_s, nwoas_pwr_started);
+    return (1ULL << 32) | flags;
+}
+
+static void nwoas_pwr_fill(struct nwoas_pwr_snapshot *s)
+{
+    memset(s, 0, sizeof(*s));
+    s->magic = NWOAS_PWR_MAGIC;
+    s->version = NWOAS_PWR_VERSION;
+    s->size = sizeof(*s);
+    s->ncpu = NWOAS_PWR_NCPU;
+    s->cntpct = mrs(CNTPCT_EL0);
+    s->cntfrq = mrs(CNTFRQ_EL0);
+    s->flags = nwoas_pwr_flags;
+    s->sec_tick_interval = nwoas_pwr_sec_interval;
+    s->timer_gap_ticks = nwoas_pwr_timer_gap_ticks;
+    s->hv_tick_interval = hv_tick_interval;
+    s->hv_ticks = nwoas_pwr_hv_ticks;
+    s->prints = nwoas_pwr_prints;
+    s->smc_reads = nwoas_pwr_smc_reads;
+    s->smc_errors = nwoas_pwr_smc_errors;
+    s->proxy_ticks = nwoas_pwr_proxy_ticks;
+    memcpy(s->cpu, nwoas_pwr_cpu, sizeof(s->cpu));
+    memcpy(&s->nvme, &nwoas_pwr_nvme, sizeof(s->nvme));
+}
+
+/* Read-only SMC key reads.  Same start/stop pattern as m1n1 dcp.c and the S259
+ * Wi-Fi module (init -> commands -> smc_shutdown), bounded by a 200 ms deadline
+ * per wait.  Each out[i] = value (bits 31:0, raw little-endian key bytes) |
+ * status << 32 (0 = ok). */
+static u64 nwoas_pwr_smc_read(const u32 *keys, u64 count, u64 *out)
+{
+    if (!(nwoas_pwr_flags & NWOAS_PWR_F_SMC_SENSE) || !count || count > 8 || !keys || !out)
+        return 0;
+    u64 ok = 0;
+    smc_set_deadline_us(200000);
+    smc_dev_t *smc = smc_init();
+    if (!smc) {
+        nwoas_pwr_smc_errors++;
+        smc_set_deadline_us(0);
+        for (u64 i = 0; i < count; i++)
+            out[i] = 0xffffffffULL << 32;
+        return 0;
+    }
+    for (u64 i = 0; i < count; i++) {
+        u32 v = 0;
+        int rc = smc_read_key(smc, keys[i], &v, 4);
+        out[i] = (u64)v | ((u64)(u32)rc << 32);
+        if (rc)
+            nwoas_pwr_smc_errors++;
+        else
+            ok++;
+    }
+    smc_shutdown(smc);
+    smc_set_deadline_us(0);
+    nwoas_pwr_smc_reads++;
+    return ok;
+}
+
+u64 nwoas_pwr_proxy(u64 op, u64 a0, u64 a1, u64 a2, u64 a3)
+{
+    switch (op) {
+        case NWOAS_PWR_OP_QUERY:
+            return ((u64)NWOAS_PWR_MAGIC << 32) | NWOAS_PWR_VERSION;
+        case NWOAS_PWR_OP_CONFIG:
+            return nwoas_pwr_configure(a0, a1, a2, a3);
+        case NWOAS_PWR_OP_SNAPSHOT: {
+            static struct nwoas_pwr_snapshot snap;
+            if (!a0 || a1 < sizeof(snap))
+                return 0;
+            nwoas_pwr_fill(&snap);
+            memcpy((void *)a0, &snap, sizeof(snap));
+            return sizeof(snap);
+        }
+        case NWOAS_PWR_OP_SMC_READ:
+            return nwoas_pwr_smc_read((const u32 *)a0, a1, (u64 *)a2);
+        case NWOAS_PWR_OP_SLC: {
+            if (!a0)
+                return 0;
+            if (nwoas_pwr_started)
+                return (u64)-2; /* only before the guest runs */
+            int rc = mcc_enable_cache();
+            printf("NWOAS-PWR: mcc_enable_cache() = %d\n", rc);
+            return (u64)(s64)rc;
+        }
+        case NWOAS_PWR_OP_MCC_STAT:
+            if (!a0 || a1 < 2 || a1 > 64)
+                return (u64)-1;
+            return (u64)(s64)mcc_cache_status((u32 *)a0, (int)a1);
+        default:
+            return (u64)-1;
+    }
+}
+
+/* C-2: interval for hv_arm_tick(true).  The slow interval is used only while both
+ * guest timer FIQ routes are open, i.e. a guest timer expiry raises its own FIQ.
+ * While a route is masked (a timer fired and was injected, deduplicated or
+ * rate-limited) the HV must re-run hv_update_fiq() soon, exactly as the 5 kHz tick
+ * does today, so the fast interval is kept. */
+u64 nwoas_pwr_secondary_interval(u64 default_interval, u64 fast_interval)
+{
+    if (!(nwoas_pwr_flags & NWOAS_PWR_F_SEC_TICK) || !nwoas_pwr_sec_interval)
+        return default_interval;
+    u64 ena = mrs(SYS_IMP_APL_VM_TMR_FIQ_ENA_EL2);
+    u64 both = VM_TMR_FIQ_ENA_ENA_V | VM_TMR_FIQ_ENA_ENA_P;
+    if ((ena & both) != both)
+        return fast_interval;
+    return nwoas_pwr_sec_interval;
+}
+
+/* Called at the end of hv_update_fiq(): on a secondary with the slow tick, pull an
+ * already-armed slow tick in to the fast interval when hv_update_fiq() just masked a
+ * timer route (covers the slow path, where hv_arm_tick() ran before hv_update_fiq()). */
+void nwoas_pwr_after_update_fiq(void)
+{
+    if (!(nwoas_pwr_flags & NWOAS_PWR_F_SEC_TICK))
+        return;
+    int icpu = hv_pinned_cpu == -1 ? boot_cpu_idx : hv_pinned_cpu;
+    if (smp_id() == icpu)
+        return;
+    u64 ena = mrs(SYS_IMP_APL_VM_TMR_FIQ_ENA_EL2);
+    u64 both = VM_TMR_FIQ_ENA_ENA_V | VM_TMR_FIQ_ENA_ENA_P;
+    if ((ena & both) == both)
+        return;
+    u64 now = mrs(CNTPCT_EL0);
+    u64 want = now + hv_tick_interval;
+    if (mrs(CNTP_CVAL_EL0) > want) {
+        msr(CNTP_CVAL_EL0, want);
+        NWOAS_PWR_INC(tick_shortened);
+    }
+}
+
+/* S260 fix 2: the NVMe IRQ bridge (hv_bridge_nvme_irq) injects only on the
+ * interruptible CPU, from hv_update_fiq().  With C-1 that CPU may be asleep in EL2
+ * wfi until its next 200 us tick, which added ~25 us per random read on hardware
+ * (qd8 11455 -> 8712 IOPS).  On a rising level raised by another CPU, wake it. */
+void nwoas_pwr_kick_irq_cpu(void)
+{
+    if (!(nwoas_pwr_flags & NWOAS_PWR_F_WFI_SLEEP))
+        return;
+    int icpu = hv_pinned_cpu == -1 ? boot_cpu_idx : hv_pinned_cpu;
+    if (icpu < 0 || smp_id() == icpu)
+        return;
+    smp_send_ipi(icpu);
+    NWOAS_PWR_INC(nvme_kicks);
+}
+
+static u64 nwoas_pwr_sum(const struct nwoas_pwr_snapshot *s, int field)
+{
+    u64 v = 0;
+    for (int i = 0; i < NWOAS_PWR_NCPU; i++)
+        v += ((const u64 *)&s->cpu[i])[field];
+    return v;
+}
+
+#define F(name) ((int)(__builtin_offsetof(struct nwoas_pwr_cpu, name) / 8))
+
+/* hv_tick() on the interruptible CPU (bhl held). */
+void nwoas_pwr_tick(void)
+{
+    nwoas_pwr_hv_ticks++;
+    if (!(nwoas_pwr_flags & NWOAS_PWR_F_PRINT) || !nwoas_pwr_print_ticks)
+        return;
+    u64 now = mrs(CNTPCT_EL0);
+    if (now < nwoas_pwr_next_print)
+        return;
+    nwoas_pwr_next_print = now + nwoas_pwr_print_ticks;
+    if (nwoas_pwr_prints >= NWOAS_PWR_MAX_PRINTS)
+        return;
+
+    static struct nwoas_pwr_snapshot cur;
+    nwoas_pwr_fill(&cur);
+    struct nwoas_pwr_snapshot *o = &nwoas_pwr_last;
+    if (o->magic == NWOAS_PWR_MAGIC && cur.cntpct > o->cntpct) {
+        u64 dt = cur.cntpct - o->cntpct;
+        u32 pm[NWOAS_PWR_NCPU];
+        for (int i = 0; i < NWOAS_PWR_NCPU; i++)
+            pm[i] = (u32)((cur.cpu[i].wfi_sleep_ticks - o->cpu[i].wfi_sleep_ticks) * 1000 / dt);
+        u64 lc = cur.nvme.lat_count - o->nvme.lat_count;
+        u64 lsum = cur.nvme.lat_sum_ticks - o->nvme.lat_sum_ticks;
+        printf("NWOAS-PWR: dt_ms=%lu wfi=%lu sleeps=%lu sleep_pm=%u,%u,%u,%u,%u,%u,%u,%u "
+               "fiq=%lu tick=%lu irq=%lu sync=%lu tinj=%lu tgate=%lu nvme=%lu lat_us=%lu "
+               "hvt=%lu\n",
+               dt * 1000 / cur.cntfrq,
+               nwoas_pwr_sum(&cur, F(wfi_traps)) - nwoas_pwr_sum(o, F(wfi_traps)),
+               nwoas_pwr_sum(&cur, F(wfi_sleeps)) - nwoas_pwr_sum(o, F(wfi_sleeps)), pm[0],
+               pm[1], pm[2], pm[3], pm[4], pm[5], pm[6], pm[7],
+               nwoas_pwr_sum(&cur, F(fiq)) - nwoas_pwr_sum(o, F(fiq)),
+               nwoas_pwr_sum(&cur, F(fiq_tick)) - nwoas_pwr_sum(o, F(fiq_tick)),
+               nwoas_pwr_sum(&cur, F(irq)) - nwoas_pwr_sum(o, F(irq)),
+               nwoas_pwr_sum(&cur, F(sync)) - nwoas_pwr_sum(o, F(sync)),
+               nwoas_pwr_sum(&cur, F(timer_inj)) - nwoas_pwr_sum(o, F(timer_inj)),
+               nwoas_pwr_sum(&cur, F(timer_gated)) - nwoas_pwr_sum(o, F(timer_gated)), lc,
+               lc ? lsum * 1000000 / cur.cntfrq / lc : 0, cur.hv_ticks - o->hv_ticks);
+        nwoas_pwr_prints++;
+    }
+    memcpy(o, &cur, sizeof(cur));
+}
+
+/* bhl is recursive for its owner; another owner normally releases it within one
+ * slow-path exit.  Bound the wait so a wedged CPU cannot stop the reset. */
+static bool nwoas_pwr_take_bhl(void)
+{
+    u64 deadline = timeout_calculate(200000);
+    while (!timeout_expired(deadline)) {
+        s64 owner = __atomic_load_n(&bhl.lock, __ATOMIC_ACQUIRE);
+        if (owner == -1 || owner == smp_id()) {
+            spin_lock(&bhl);
+            return true;
+        }
+    }
+    return false;
+}
+
+void nwoas_pwr_system_down(bool off)
+{
+    u32 f = nwoas_pwr_flags;
+    printf("NWOAS-PWR: PSCI %s cpu=%d flags=0x%x\n", off ? "SYSTEM_OFF" : "SYSTEM_RESET",
+           smp_id(), f);
+    if (!(f & (NWOAS_PWR_F_NVME_SHUT | NWOAS_PWR_F_SMC_OFF)) ||
+        (!off && !(f & NWOAS_PWR_F_NVME_SHUT))) {
+        iodev_console_flush();
+        return;
+    }
+    hv_wdt_suspend();
+    bool locked = nwoas_pwr_take_bhl();
+
+    if (f & NWOAS_PWR_F_NVME_SHUT) {
+        u64 t0 = mrs(CNTPCT_EL0);
+        bool flushed = nvme_flush(1);
+        nvme_shutdown();
+        printf("NWOAS-PWR: ANS flush=%d shutdown in %lu us (bhl=%d)\n", flushed,
+               (mrs(CNTPCT_EL0) - t0) * 1000000 / mrs(CNTFRQ_EL0), locked);
+    }
+
+    if (off && (f & NWOAS_PWR_F_SMC_OFF)) {
+        const u32 mbse = NWOAS_SMC_KEY('M', 'B', 'S', 'E');
+        smc_set_deadline_us(500000);
+        smc_dev_t *smc = smc_init();
+        if (!smc) {
+            printf("NWOAS-PWR: SMC init failed, falling back to reboot\n");
+        } else {
+            /* Linux macsmc-reboot order: MBSE=offw (power-off warning, LED off on the
+             * Mac mini), then MBSE=off1.  Linux also sets a PMU nvmem shutdown_flag
+             * bit before off1 ("without this, the device will just reboot"); that
+             * SPMI write is NOT done here (roadmap: observe first). */
+            int rw = smc_write_u32(smc, mbse, NWOAS_SMC_KEY('o', 'f', 'f', 'w'));
+            printf("NWOAS-PWR: SMC MBSE=offw rc=%d; sending MBSE=off1\n", rw);
+            iodev_console_flush();
+            int r1 = smc_write_u32(smc, mbse, NWOAS_SMC_KEY('o', 'f', 'f', '1'));
+            mdelay(2000);
+            printf("NWOAS-PWR: still running 2 s after MBSE=off1 (rc=%d); rebooting\n", r1);
+            smc_shutdown(smc);
+        }
+        smc_set_deadline_us(0);
+    }
+    iodev_console_flush();
+}
diff -ruN a/src/nwoas_pwr.h b/src/nwoas_pwr.h
--- a/src/nwoas_pwr.h	1970-01-01 09:00:00
+++ b/src/nwoas_pwr.h	2026-11-18 17:21:30
@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * NWOAS S260: power / idle measurement and the small phase-1 hypervisor fixes
+ * (ROADMAP-2026-11-17.md phase 0 + phase 1).
+ *
+ * Every behaviour change is OFF until the launcher module power-s260/power_module.py
+ * sends P_HV_NWOAS_PWR op CONFIG before the guest starts.  With no CONFIG the only
+ * difference to g254L is a handful of per-CPU counter increments.
+ *
+ * HARDWARE-UNVERIFIED.  Build success is not boot success.
+ */
+#ifndef NWOAS_PWR_H
+#define NWOAS_PWR_H
+
+#ifdef NWOAS_PWR_HOST_TEST
+#include <stdint.h>
+typedef uint64_t u64;
+typedef uint32_t u32;
+#define NWOAS_PWR_ALIGNED64 __attribute__((aligned(64)))
+#else
+#include "types.h"
+#include "utils.h"
+#define NWOAS_PWR_ALIGNED64 ALIGNED(64)
+#endif
+
+#define NWOAS_PWR_MAGIC   0x5057524eU /* "NRWP" */
+#define NWOAS_PWR_VERSION 1U
+#define NWOAS_PWR_NCPU    8
+
+/* P_HV_NWOAS_PWR (proxy 0xc3a) operations: args[0] = op */
+#define NWOAS_PWR_OP_QUERY    0 /* -> (MAGIC << 32) | VERSION */
+#define NWOAS_PWR_OP_CONFIG   1 /* (flags, sec_tick_hz, timer_gap_us, print_period_s) -> accepted flags | 1<<63 */
+#define NWOAS_PWR_OP_SNAPSHOT 2 /* (ptr, size) -> bytes copied */
+#define NWOAS_PWR_OP_SMC_READ 3 /* (keys_ptr, count<=8, out_ptr) -> number of keys read OK (needs F_SMC_SENSE) */
+#define NWOAS_PWR_OP_SLC      4 /* (enable) -> mcc_enable_cache() rc (enable=1, before guest start only) */
+#define NWOAS_PWR_OP_MCC_STAT 5 /* (out_ptr, max) -> number of u32 plane cache status words */
+
+/* CONFIG flags (each one is a separate A/B switch) */
+#define NWOAS_PWR_F_WFI_SLEEP  (1U << 0) /* C-1: idle guest WFI -> EL2 wfi */
+#define NWOAS_PWR_F_SEC_TICK   (1U << 1) /* C-2: slow secondary HV tick (adaptive) */
+#define NWOAS_PWR_F_TIMER_GAP  (1U << 2) /* C-4: kernel-phase timer PPI min gap override */
+#define NWOAS_PWR_F_NVME_SHUT  (1U << 3) /* S-1: ANS flush + clean shutdown before reset/off */
+#define NWOAS_PWR_F_SMC_OFF    (1U << 4) /* PSCI SYSTEM_OFF -> SMC MBSE offw/off1, reboot fallback */
+#define NWOAS_PWR_F_SMC_SENSE  (1U << 5) /* allow OP_SMC_READ (read-only SMC keys) */
+#define NWOAS_PWR_F_PRINT      (1U << 6) /* periodic one-line summary from the CPU0 tick */
+#define NWOAS_PWR_F_ALL        0x7fU
+
+struct nwoas_pwr_cpu {
+    u64 wfi_traps;        /* guest WFI trapped (TWI) */
+    u64 wfe_traps;        /* guest WFE trapped (TWE is not set, expect 0) */
+    u64 wfi_sleeps;       /* EL2 wfi executed */
+    u64 wfi_sleep_ticks;  /* CNTPCT ticks spent in EL2 wfi */
+    u64 wfi_skip_pending; /* not slept: vIRQ pending in an LR / queue / physical IRQ */
+    u64 wfi_skip_route;   /* not slept: a guest timer FIQ route was masked (gated/outstanding) */
+    u64 fiq;              /* hv_exc_fiq entries */
+    u64 fiq_tick;         /* ... of which the HV tick timer fired */
+    u64 fiq_fast;         /* ... handled on the non-interruptible fast path */
+    u64 irq;              /* hv_exc_irq entries */
+    u64 sync;             /* hv_exc_sync entries (all classes) */
+    u64 timer_inj;        /* guest timer PPI 17/18 injected or queued */
+    u64 timer_gated;      /* skipped by the min-gap rate limit */
+    u64 timer_dedup;      /* skipped: already pending/active */
+    u64 tick_shortened;   /* secondary slow tick re-armed fast (route masked) */
+    u64 wake_armed;       /* HV tick moved earlier to a guest timer deadline before wfi */
+    u64 sync_dabort;      /* hv_exc_sync by class: data abort (MMIO) */
+    u64 sync_msr;         /* ... trapped system register */
+    u64 sync_smc;         /* ... SMC (PSCI) */
+    u64 sync_hvc;         /* ... HVC */
+    u64 bhl_wait_ticks;   /* CNTPCT ticks waiting for the global HV lock (slow paths) */
+    u64 slow_entries;     /* hv_exc_entry() calls (bhl taken) */
+    u64 ipi_sent;         /* guest SGIs forwarded as physical IPIs */
+    u64 proxy_calls;      /* host (Python) proxy round trips started on this CPU */
+    u64 ipi_rx;           /* physical fast IPIs seen in hv_exc_fiq on this CPU */
+    u64 wake_ipi;         /* EL2 wfi ended with a fast IPI pending */
+    u64 wake_tick;        /* ... with the HV tick timer fired */
+    u64 wake_vtimer;      /* ... with a guest timer fired */
+    u64 wake_irq;         /* ... with a physical IRQ pending (device / AIC) */
+    u64 wake_other;       /* ... none of the above visible */
+    u64 nvme_kicks;       /* IPIs sent from this CPU to wake the NVMe IRQ CPU */
+    u64 wfi_skip_nvme;    /* not slept: NVMe IRQ level pending on the delivering CPU */
+} NWOAS_PWR_ALIGNED64;
+
+struct nwoas_pwr_nvme {
+    u64 ns1_cmds, ns2_cmds, other_cmds;
+    u64 doorbell_cmds;  /* executed from the SQ doorbell trap */
+    u64 tick_cmds;      /* executed later from the CPU0 tick (deferred) */
+    u64 lat_count, lat_sum_ticks, lat_max_ticks; /* SQ doorbell -> CQE posted, NS1 only */
+    u64 lat_hist[6];    /* <20us <100us <500us <2ms <10ms >=10ms */
+    u64 exec_sum_ticks; /* NS1 time inside nvme_rw_guest/flush */
+    u64 depth_sum, depth_samples, depth_max; /* SQ entries outstanding when a CQE is posted */
+    u64 read_blocks, write_blocks;            /* 4 KiB blocks, NS1 */
+};
+
+struct nwoas_pwr_snapshot {
+    u32 magic, version;
+    u32 size, ncpu;
+    u64 cntpct, cntfrq;
+    u64 flags, sec_tick_interval, timer_gap_ticks, hv_tick_interval;
+    u64 hv_ticks;       /* hv_tick() calls on the interruptible CPU */
+    u64 prints;         /* periodic summary lines printed */
+    u64 smc_reads, smc_errors;
+    u64 proxy_ticks;    /* total CNTPCT ticks spent in host proxy round trips (stolen time) */
+    u64 reserved[3];
+    struct nwoas_pwr_cpu cpu[NWOAS_PWR_NCPU];
+    struct nwoas_pwr_nvme nvme;
+    u64 tail_pad[4]; /* keeps the size a multiple of 64 without implicit padding */
+};
+
+#ifndef NWOAS_PWR_HOST_TEST
+_Static_assert(sizeof(struct nwoas_pwr_cpu) == 256, "nwoas_pwr_cpu layout");
+_Static_assert(sizeof(struct nwoas_pwr_nvme) == 20 * 8, "nwoas_pwr_nvme layout");
+_Static_assert(sizeof(struct nwoas_pwr_snapshot) == 128 + 8 * 256 + 20 * 8 + 32,
