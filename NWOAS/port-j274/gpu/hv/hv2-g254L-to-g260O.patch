+ * the guest timer is never later than today even if its FIQ route did not wake an
+ * EL2 wfi [hypothesis: on M1 it does, the reference project relies on it]. */
+static void nwoas_wfi_arm_wake(void)
+{
+    u64 hv_cval = mrs(CNTP_CVAL_EL0);
+    u64 best = hv_cval;
+    u64 vctl = mrs(CNTV_CTL_EL02);
