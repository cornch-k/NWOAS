+/*
+ * NWOAS-J274 PATCH P1 (new file, not part of upstream windows-on-m1).
+ *
+ * Board selection for the Apple AGX Windows driver.  Upstream hard-codes the
+ * J313 (MacBook Air M1, board-id 0x26, 8 GB) physical layout.  This header
+ * moves the board-dependent physical addresses behind one switch so the same
+ * sources build either for J313 (default, byte-for-byte the upstream values)
+ * or for J274 (Mac mini M1 2020, board-id 0x22, 16 GB).
+ *
+ * Select J274 with the preprocessor definition APPLE_AGX_BOARD_J274=1
+ * (MSBuild: /p:AppleAgxBoard=J274).  Without it every value below is the
+ * upstream J313 value, so J313 behaviour is unchanged.
+ *
+ * Every J274 value is labelled FACT or HYPOTHESIS.  Nothing in this file has
+ * been validated on J274 hardware.  A build that compiles is NOT a GPU that
+ * works.  See port-j274/gpu/driver/PATCHES.md and INVENTORY.md.
+ */
+#ifndef APPLE_AGX_BOARD_H
+#define APPLE_AGX_BOARD_H
+
+#if defined(APPLE_AGX_BOARD_J274) && defined(APPLE_AGX_BOARD_J313)
+#error "Select exactly one Apple AGX board (APPLE_AGX_BOARD_J274 or APPLE_AGX_BOARD_J313)"
+#endif
+
+#if defined(APPLE_AGX_BOARD_J274) && APPLE_AGX_BOARD_J274
+
+#define APPLE_AGX_BOARD_NAME "J274"
+/* FACT: m1n1 prints "Board-ID: 0x22" on this Mac mini
+ * (nwoas_scripts/logs/appark-chainload-1558.log:49). */
+#define APPLE_AGX_BOARD_ID 0x22u
+#define APPLE_AGX_BOARD_CHIP_ID 0x8103u
+
+/* FACT: m1n1 maps a 0x4000-byte Normal-NC pmap-io-range at 0xbfffb8000 and
+ * another at 0xbfff70000 on this Mac mini, both with OS firmware 13.5
+ * (appark-chainload-1558.log:108-109) and with Tahoe mBoot-18000.121.3
+ * (usb-s159-20260909-234847.C3i6zw:68-69).  J313 has the same two 0x4000
+ * ranges at 0x9fffb8000 (gpu) and 0x9fff70000 (handoff) = 8 GB top - same
+ * offsets.
+ * HYPOTHESIS (high): these are the J274 sgx gpu-region and gfx-handoff
+ * regions.  Must be confirmed from the live J274 ADT (/arm-io/sgx
+ * gpu-region-base, gfx-handoff-base) under the 13.5 stub. */
+#define APPLE_AGX_BOARD_GPU_REGION_BASE 0xbfffb8000ULL
+#define APPLE_AGX_BOARD_HANDOFF_BASE 0xbfff70000ULL
+/* HYPOTHESIS (medium): gfx-shared-region keeps the J313 offset
+ * (handoff + 0x8000, size 0x40000).  No J274 log shows this region; it is
+ * not a pmap-io-range on either board.  Needs a live ADT read. */
+#define APPLE_AGX_BOARD_SHARED_REGION_BASE 0xbfff78000ULL
+
+/* FACT: in the upstream generated HwDataB profile the 8-byte J313
+ * gpu-region-base value 0x9fffb8000 occurs exactly once, at byte offset
+ * 0xa78 (apple_agx_hwdata_profile.generated.h AgxHwdataBProfile); m1n1's
+ * AGXHWDataB has a gpu_region_base field filled from the ADT
+ * (m1n1_windows/proxyclient/m1n1/fw/agx/initdata.py:1143,1372).
+ * HYPOTHESIS (high): 0xa78 is that field. */
+#define APPLE_AGX_BOARD_HWDATA_B_GPU_REGION_BASE_OFFSET 0xa78u
+
+#else /* default: upstream J313 */
+
+#ifndef APPLE_AGX_BOARD_J313
+#define APPLE_AGX_BOARD_J313 1
+#endif
+#define APPLE_AGX_BOARD_NAME "J313"
+#define APPLE_AGX_BOARD_ID 0x26u
+#define APPLE_AGX_BOARD_CHIP_ID 0x8103u
+#define APPLE_AGX_BOARD_GPU_REGION_BASE 0x9fffb8000ULL
+#define APPLE_AGX_BOARD_HANDOFF_BASE 0x9fff70000ULL
+#define APPLE_AGX_BOARD_SHARED_REGION_BASE 0x9fff78000ULL
+#define APPLE_AGX_BOARD_HWDATA_B_GPU_REGION_BASE_OFFSET 0xa78u
+
+#endif
+
+#endif /* APPLE_AGX_BOARD_H */
