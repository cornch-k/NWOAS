+
+/* NWOAS-J274 PATCH P45: D3D10/11 pixel shaders get SV_Position at the pixel
+ * centre (default on). Off = the 2779 behaviour (integer coordinates):
+ *   APPLE_AGX_D3D_PIXEL_CENTER=0|1 (this process), else
+ *   HKLM\SOFTWARE\NWOAS\AgxD3d D3d11PixelCenter (REG_DWORD) 0 = off, for every
+ *   process including DWM. Read once per process: shaders made before and
+ *   after a change must not disagree. */
+BOOL AgxD3d10WindowsPixelCenter(VOID) {
+  static volatile LONG cached = -1;
+  LONG value = InterlockedCompareExchange(&cached, -1, -1);
+  if (value < 0) {
+    char text[4];
+    DWORD length = GetEnvironmentVariableA("APPLE_AGX_D3D_PIXEL_CENTER", text, sizeof(text));
+    if (length == 1 && (text[0] == '0' || text[0] == '1')) {
+      value = text[0] == '1' ? 1 : 0;
+    } else {
+      DWORD data = 1u, bytes = sizeof(data);
+      if (RegGetValueW(HKEY_LOCAL_MACHINE, L"SOFTWARE\\NWOAS\\AgxD3d", L"D3d11PixelCenter",
+                       RRF_RT_REG_DWORD, NULL, &data, &bytes) != ERROR_SUCCESS)
+        data = 1u;
+      value = data != 0u ? 1 : 0;
+    }
+    InterlockedExchange(&cached, value);
+    const UINT values[2] = {(UINT)value, length};
+    AgxD3d10WindowsDiagnostic("measure-d3d11-pixel-center", S_OK, values, 2u);
+  }
+  return value ? TRUE : FALSE;
 }
 
