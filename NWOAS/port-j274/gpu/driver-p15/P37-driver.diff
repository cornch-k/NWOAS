+; NWOAS-J274 PATCH P37: x64 (Prism-emulated processes) counterpart of
+; compiler-arm64.ini. The builder is an ARM64 Windows guest whose clang-cl is
+; the aarch64-hosted LLVM 20.1.8, so the target is explicit.
+[constants]
+# builder root: APPLE AGX\active (8.3 alias, no space)
+agx = 'C:/Users/pauls/APB12E~1/active'
+
+[binaries]
+c = [agx / 'AD04-asahi-windows-compiler/llvm20/bin/clang-cl.exe', '--target=x86_64-pc-windows-msvc']
+cpp = [agx / 'AD04-asahi-windows-compiler/llvm20/bin/clang-cl.exe', '--target=x86_64-pc-windows-msvc']
+ar = agx / 'AD04-asahi-windows-compiler/llvm20/bin/llvm-lib.exe'
+strip = agx / 'AD04-asahi-windows-compiler/llvm20/bin/llvm-strip.exe'
+
+[host_machine]
+system = 'windows'
+cpu_family = 'x86_64'
+cpu = 'x86_64'
+endian = 'little'
+
+[properties]
+# x64 executables run under emulation on the ARM64 builder, but configure
+# must not depend on that (same as the ARM64 configuration).
+needs_exe_wrapper = true
