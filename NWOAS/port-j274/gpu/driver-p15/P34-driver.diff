+/* P34 diagnostic: when the folder C:\NWOAS\umdtrace-seen exists, every
+ * process that runs the registry probe leaves one line per outcome there
+ * (seen-<image>-<pid>.txt: stage and Win32 error), so a trace that never
+ * arms shows where it stopped (2765-2769: no file from DWM or Edge). */
+static VOID AdmissionUmdRegTraceSeen(PCWSTR Base, UINT Stage, DWORD Error) {
+  static volatile LONG seenMask;
+  WCHAR path[MAX_PATH];
+  static const WCHAR dir[] = L"C:\\NWOAS\\umdtrace-seen";
+  DWORD attributes = GetFileAttributesW(dir), at = 0u, i, pid, digits = 0u;
+  WCHAR number[12];
+  char line[96];
+  int used;
+  HANDLE file;
+  if (attributes == INVALID_FILE_ATTRIBUTES ||
+      (attributes & FILE_ATTRIBUTE_DIRECTORY) == 0u || Stage >= 31u ||
+      (InterlockedOr(&seenMask, (LONG)(1u << Stage)) & (LONG)(1u << Stage)) != 0)
+    return;
+  for (i = 0u; dir[i] != L'\0'; ++i) path[at++] = dir[i];
+  path[at++] = L'\\'; path[at++] = L's'; path[at++] = L'e'; path[at++] = L'e';
+  path[at++] = L'n'; path[at++] = L'-';
+  for (i = 0u; Base != NULL && Base[i] != L'\0' && at + 20u < ARRAYSIZE(path); ++i)
+    path[at++] = Base[i];
+  pid = GetCurrentProcessId();
+  do { number[digits++] = (WCHAR)(L'0' + pid % 10u); pid /= 10u; } while (pid != 0u);
+  path[at++] = L'-';
+  while (digits != 0u) path[at++] = number[--digits];
+  path[at++] = L'.'; path[at++] = L't'; path[at++] = L'x'; path[at++] = L't';
+  path[at] = L'\0';
+  file = CreateFileW(path, FILE_APPEND_DATA,
+      FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+      OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+  if (file == INVALID_HANDLE_VALUE) return;
+  used = _snprintf_s(line, sizeof(line), _TRUNCATE, "stage=%u error=%lu\r\n",
+                     Stage, (unsigned long)Error);
+  if (used > 0) { DWORD written; (void)WriteFile(file, line, (DWORD)used, &written, NULL); }
+  CloseHandle(file);
+}
