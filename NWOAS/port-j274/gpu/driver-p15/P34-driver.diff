+/* NWOAS-J274 PATCH P34 (policy 0x80, APPLE_AGX_D3D_MSAA_CAPS): the
+ * MULTISAMPLE_RENDERTARGET bit on every render-target member (and depth
+ * member, and typeless parent) of a cast family, with no 2x/4x levels.
+ * ANGLE's D3D11 backend fills a format's GL sample counts only when this
+ * bit is set (renderer11_utils GenerateTextureFormatCaps: "Assume 1x"), and
+ * Skia's GrGLCaps leaves a format unrenderable when GL_NUM_SAMPLE_COUNTS is
+ * 0 -- Edge's GPU process then stops at skia_output_surface_impl.cc
+ * (backend_format.isValid()=0). The levels stay those of the policy's
+ * families (none without 0x10/0x20), so the EXP1288 rules hold: no levels
+ * above a parent, no bit on a read-only member. */
+BOOL AgxD3d10WindowsMsaaRenderTargetBitOnly(DXGI_FORMAT Format, UINT Caps) {
+  enum AgxD3d10CastRole role;
+  (void)AgxD3d10CastParent(Format, &role);
+  switch (role) {
+  case AgxCastTarget: return (Caps & D3D10_DDI_FORMAT_SUPPORT_RENDERTARGET) != 0u;
+  case AgxCastDepth: return TRUE;
+  case AgxCastParent: return TRUE;
+  default: return FALSE;
+  }
+}
