+_Use_decl_annotations_ void AdmissionRecordPoolTimeline(
+    ADMISSION_CONTEXT *Context, const ADMISSION_POOL_TIMELINE_ENTRY *Entry) {
+  ADMISSION_PAGING_RECEIPTS *receipts;
+  ADMISSION_POOL_TIMELINE *t;
+  BOOLEAN write = FALSE;
+  LARGE_INTEGER frequency;
+  ULONGLONG now;
+  KIRQL oldIrql;
+  if (Context == NULL || Entry == NULL || KeGetCurrentIrql() > DISPATCH_LEVEL)
+    return;
+  receipts = (ADMISSION_PAGING_RECEIPTS *)Context->PagingReceipts;
+  if (receipts == NULL) return;
+  now = (ULONGLONG)KeQueryPerformanceCounter(&frequency).QuadPart;
+  KeAcquireSpinLock(&receipts->Lock, &oldIrql);
+  t = &receipts->Timeline;
+  if (t->Version == 0u) {
+    t->Version = ADMISSION_POOL_TIMELINE_VERSION;
+    t->Bytes = (unsigned int)sizeof(*t);
+    t->EntryBytes = (unsigned int)sizeof(t->Ring[0]);
+    t->Capacity = ADMISSION_POOL_TIMELINE_ENTRIES;
+    t->QpcFrequency = (unsigned long long)frequency.QuadPart;
+    t->StartQpc = now;
+  }
+  {
+    /* VidMm maps a large allocation with one UpdatePageTable per leaf table
+     * (hundreds per GiB). Fold an update into one of the last four entries
+     * of the same allocation, process and placement class (segment 3 or
+     * not): Pages/PoolPages/OtherPages add up, Va/AllocationOffset/PoolBase
+     * stay the first update's, Reserved counts folded updates and Qpc is
+     * the latest. */
+    ADMISSION_POOL_TIMELINE_ENTRY *e = NULL;
+    ULONGLONG back;
+    if (Entry->Kind == ADMISSION_POOL_TIMELINE_UPDATE) {
+      for (back = 1u; back <= 4u && back <= t->Total; ++back) {
+        ADMISSION_POOL_TIMELINE_ENTRY *c =
+            &t->Ring[(t->Total - back) % ADMISSION_POOL_TIMELINE_ENTRIES];
+        if (c->Kind == ADMISSION_POOL_TIMELINE_UPDATE &&
+            c->Allocation == Entry->Allocation &&
+            c->OsProcessId == Entry->OsProcessId &&
+            (c->PoolPages != 0u) == (Entry->PoolPages != 0u) &&
+            (c->OtherPages != 0u) == (Entry->OtherPages != 0u) &&
+            (c->PoolBase == MAXULONGLONG || Entry->PoolBase == MAXULONGLONG ||
+             c->PoolBase == Entry->PoolBase)) {
+          e = c;
+          break;
+        }
+      }
+    }
+    if (e != NULL) {
+      e->Pages += Entry->Pages;
+      e->PoolPages += Entry->PoolPages;
+      e->OtherPages += Entry->OtherPages;
+      if (e->PoolBase == MAXULONGLONG) e->PoolBase = Entry->PoolBase;
+      ++e->Reserved;
+      e->Qpc = now;
+    } else {
+      e = &t->Ring[t->Total % ADMISSION_POOL_TIMELINE_ENTRIES];
+      *e = *Entry;
+      e->Qpc = now;
+      e->Reserved = 0u;
+      e->Sequence = ++t->Total;
+    }
+  }
+  /* Written: every census that found pages outside segment 3, and the end
+   * of every allocation of 1 GiB or more (so a passing size is on record
+   * too), at most ADMISSION_POOL_TIMELINE_WRITES times per KMD start. */
+  if (Entry->Kind == ADMISSION_POOL_TIMELINE_CENSUS ||
+      (Entry->Kind == ADMISSION_POOL_TIMELINE_DESTROY &&
+       Entry->AllocationBytes >= 0x40000000ULL)) {
+    if (Entry->Kind == ADMISSION_POOL_TIMELINE_CENSUS &&
+        ++t->CensusEvents == 1u)
+      receipts->TimelineFirstPending = 1u;
+    if (t->Writes < ADMISSION_POOL_TIMELINE_WRITES) {
+      ++t->Writes;
+      t->WrittenQpc = now;
+      write = TRUE;
+    }
+  }
+  KeReleaseSpinLock(&receipts->Lock, oldIrql);
+  if (write)
+    AdmissionPagingReceiptStage(Context, AdmissionPagingReceiptPoolTimeline,
+                                NULL);
+}
