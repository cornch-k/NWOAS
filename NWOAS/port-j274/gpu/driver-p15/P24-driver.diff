+/* NWOAS-J274 PATCH P24: D3D10/11 capability trace (APPLE_AGX_UMD_TRACE_CAPS=1).
+ * Wraps the Mesa frontend's GetCaps and CreateDevice; behaviour unchanged. */
+static PFND3D10_2DDI_GETCAPS AdmissionUmdMesaGetCaps;
+static PFND3D10DDI_CREATEDEVICE AdmissionUmdMesaCreateDevice;
+static HRESULT APIENTRY AdmissionUmdTraceGetCaps(D3D10DDI_HADAPTER Adapter,
+                                                 const D3D10_2DDIARG_GETCAPS *Caps) {
+  HRESULT hr = AdmissionUmdMesaGetCaps(Adapter, Caps);
+  if (AdmissionUmdCapsTrace()) {
+    UINT v[6] = {Caps ? (UINT)Caps->Type : 0u, Caps ? Caps->DataSize : 0u};
+    if (SUCCEEDED(hr) && Caps && Caps->pData)
+      for (UINT i = 0; i < 4u && (i + 1u) * 4u <= Caps->DataSize; ++i)
+        v[2 + i] = ((const UINT *)Caps->pData)[i];
+    AdmissionUmdDiagnostic("measure-caps-d3d11", hr, v, 6u);
+  }
+  return hr;
+}
+static HRESULT APIENTRY AdmissionUmdTraceCreateDevice(D3D10DDI_HADAPTER Adapter,
+                                                      D3D10DDIARG_CREATEDEVICE *Args) {
+  HRESULT hr = AdmissionUmdMesaCreateDevice(Adapter, Args);
+  if (AdmissionUmdCapsTrace()) {
+    const UINT v[3] = {Args ? Args->Interface : 0u, Args ? Args->Version : 0u, Args ? Args->Flags : 0u};
+    AdmissionUmdDiagnostic("measure-caps-d3d11-device", hr, v, 3u);
+  }
+  return hr;
+}
+#endif
