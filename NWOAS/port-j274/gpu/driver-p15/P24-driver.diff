+/* NWOAS-J274 PATCH P24: opt-in capability trace. APPLE_AGX_UMD_TRACE_CAPS=1
+ * (with APPLE_AGX_UMD_TRACE_FILE) records what an application asks the
+ * driver at start-up: D3D12 GetCaps types with the answer's first words,
+ * D3D12 CheckFormatSupport / multisample levels, D3D10/11 GetCaps and the
+ * D3D11 CreateDevice interface and flags. Lines start "measure-caps-" so the
+ * refusals-only filter keeps them; at most 4000 lines per process. */
+static INIT_ONCE AdmissionUmdCapsOnce = INIT_ONCE_STATIC_INIT;
+static BOOL AdmissionUmdCapsOn;
+static volatile LONG AdmissionUmdCapsLines;
+static BOOL CALLBACK AdmissionUmdCapsLoad(PINIT_ONCE Once, PVOID Parameter, PVOID *Context) {
+  WCHAR value[2];
+  UNREFERENCED_PARAMETER(Once);
+  UNREFERENCED_PARAMETER(Parameter);
+  UNREFERENCED_PARAMETER(Context);
+  AdmissionUmdCapsOn =
+      GetEnvironmentVariableW(L"APPLE_AGX_UMD_TRACE_CAPS", value, 2) == 1u && value[0] == L'1';
+  return TRUE;
+}
+BOOL AdmissionUmdCapsTrace(VOID) {
+  DWORD saved = GetLastError();
+  BOOL on;
+  (void)InitOnceExecuteOnce(&AdmissionUmdCapsOnce, AdmissionUmdCapsLoad, NULL, NULL);
+  on = AdmissionUmdCapsOn && InterlockedIncrement(&AdmissionUmdCapsLines) <= 4000;
+  SetLastError(saved);
+  return on;
+}
