+/* NWOAS-J274 PATCH P35: D3D10/11 multisampling is on by default -- the
+ * cast-family caps policy 0x20 (BGRA8/BGRX8/D24S8/D32S8 and RGBA8/RGBA16/
+ * R32/R16 families, 2x and 4x, read-only members none: the EXP1288/EXP1289
+ * runtime rules, accepted by the runtime since EXP1290) and the screen's
+ * multisampled render targets (4x renders correct since EXP1310, 5b081276).
+ * Why: without MULTISAMPLE_RENDERTARGET ANGLE's D3D11 backend gives every
+ * format an empty GL sample-count list and Skia treats BGRA8/RGBA8 as
+ * unrenderable (2769 K36: Edge FATAL skia_output_surface_impl.cc:1228,
+ * backend_format.isValid()=0); with policy 0x20 + screen MSAA Edge ran on
+ * this driver (2770 K37f fatals 0), as it does through D3D11On12, whose
+ * D3D12 UMD has always reported 2x/4x (agx_d3d12_ddi.cpp C32).
+ * Switches, in this order:
+ *   APPLE_AGX_D3D_MSAA_CAPS=<hex>, APPLE_AGX_D3D_SCREEN_MSAA=0|1 (process);
+ *   HKLM\SOFTWARE\NWOAS\AgxD3d D3d11Msaa (REG_DWORD) 0 = off, the 2769
+ *   answers for every process including DWM (read at most every 5 s, so a
+ *   device restart after setting it takes effect); default on. */
+static LONG AgxD3d10WindowsMsaaRegistry(VOID) {
+  static volatile LONG cached = -1;
+  static volatile LONGLONG due;
+  LONGLONG now = (LONGLONG)GetTickCount64();
+  LONG value = InterlockedCompareExchange(&cached, -1, -1);
+  if (value < 0 || now >= InterlockedCompareExchange64(&due, 0, 0)) {
+    DWORD data = 1u, bytes = sizeof(data);
+    if (RegGetValueW(HKEY_LOCAL_MACHINE, L"SOFTWARE\\NWOAS\\AgxD3d", L"D3d11Msaa",
+                     RRF_RT_REG_DWORD, NULL, &data, &bytes) != ERROR_SUCCESS)
+      data = 1u;
+    value = data != 0u ? 1 : 0;
+    InterlockedExchange(&cached, value);
+    InterlockedExchange64(&due, now + 5000);
+  }
+  return value;
+}
+
 UINT AgxD3d10WindowsMsaaProbe(VOID) {
   static volatile LONG cached = -1;
   LONG value = InterlockedCompareExchange(&cached, -1, -1);
@@ -782,11 +814,24 @@ UINT AgxD3d10WindowsMsaaProbe(VOID) {
       if (digit < 0) { value = 0; break; }
       value = ((value << 4) | digit) & 0xff;
     }
+    /* No (valid) process value: -2 = follow the registry/default. */
+    if (!length || length >= sizeof(text)) value = -2;
     InterlockedExchange(&cached, value);
   }
+  if (value == -2)
+    return AgxD3d10WindowsMsaaRegistry() ? 0x20u : 0u;
   return (UINT)value;
 }
 
+/* P35: the screen's multisampled render targets follow the same switch. */
+BOOL AgxD3d10WindowsScreenMsaa(VOID) {
+  char value[8];
+  DWORD length = GetEnvironmentVariableA("APPLE_AGX_D3D_SCREEN_MSAA", value, sizeof(value));
+  if (length == 1 && (value[0] == '0' || value[0] == '1'))
+    return value[0] == '1';
+  return AgxD3d10WindowsMsaaRegistry() ? TRUE : FALSE;
+}
