+/* P40 (NWOAS-J274, 2776, test switches; all off = 2775 behaviour). Read once
+ * per process from the environment (set before the application starts):
+ *   APPLE_AGX_CPU_POOL_REHOME_ROUNDS=<n>   rc107 repair rounds per submission
+ *                                         or CPU map (default 2, 1..64)
+ *   APPLE_AGX_CPU_POOL_REHOME_SLEEP_MS=<ms> sleep before every repair round
+ *                                         after the first (default 0, <=1000)
+ *   APPLE_AGX_CPU_POOL_PRIORITY=1|2        MakeResident priority HIGH|MAXIMUM
+ *                                         for SystemDirect (CPU-visible pool)
+ *                                         slots (default NORMAL)
+ * Context (RESULT-2775.md 11): VidMm paged both 64 MiB staging buffers out to
+ * segment 0 just before placing a large DEFAULT buffer over their range, and
+ * both repair rounds (within ~0.2 s) found them in segment 0 again. */
+static UINT p40_env(const char *name, UINT fallback, UINT maximum) {
+  char text[16] = {};
+  DWORD saved = GetLastError();
+  DWORD n = GetEnvironmentVariableA(name, text, sizeof(text));
+  SetLastError(saved);
+  if (n == 0u || n >= sizeof(text)) return fallback;
+  UINT v = 0u;
+  for (DWORD i = 0u; i < n; ++i) {
+    if (text[i] < '0' || text[i] > '9') return fallback;
+    v = v * 10u + (UINT)(text[i] - '0');
+    if (v > maximum) return maximum;
+  }
+  return v;
+}
+static UINT p40_rehome_rounds(void) {
+  static volatile LONG cached = -1;
+  LONG v = InterlockedCompareExchange(&cached, -1, -1);
+  if (v < 0) {
+    UINT r = p40_env("APPLE_AGX_CPU_POOL_REHOME_ROUNDS", ADMISSION_UMD_REHOME_ROUNDS, 64u);
+    v = (LONG)(r ? r : 1u);
+    InterlockedExchange(&cached, v);
+  }
+  return (UINT)v;
+}
+static UINT p40_rehome_sleep_ms(void) {
+  static volatile LONG cached = -1;
+  LONG v = InterlockedCompareExchange(&cached, -1, -1);
+  if (v < 0) {
+    v = (LONG)p40_env("APPLE_AGX_CPU_POOL_REHOME_SLEEP_MS", 0u, 1000u);
+    InterlockedExchange(&cached, v);
+  }
+  return (UINT)v;
+}
+static UINT p40_system_direct_priority(void) {
+  static volatile LONG cached = -1;
+  LONG v = InterlockedCompareExchange(&cached, -1, -1);
+  if (v < 0) {
+    UINT m = p40_env("APPLE_AGX_CPU_POOL_PRIORITY", 0u, 2u);
+    v = (LONG)(m == 2u ? D3DDDI_ALLOCATIONPRIORITY_MAXIMUM :
+               m == 1u ? D3DDDI_ALLOCATIONPRIORITY_HIGH :
+                         D3DDDI_ALLOCATIONPRIORITY_NORMAL);
+    InterlockedExchange(&cached, v);
+  }
+  return (UINT)v;
+}
 
