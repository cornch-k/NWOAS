+/* NWOAS-J274 PATCH P29: processes that cannot be given an environment
+ * (dwm.exe, started by Windows) are traced through
+ * HKLM\SOFTWARE\NWOAS\AgxUmdTrace: Dir (REG_SZ, a writable directory),
+ * Process (REG_SZ, an image name such as dwm.exe, or *), RefusalsOnly
+ * (REG_DWORD, default 1).  Read at most every 2 s until it matches, so a
+ * running DWM picks it up without a restart; the file is
+ * Dir\<image>-<pid>.log and stops at 16 MiB.  The environment variables
+ * keep precedence. */
+static WCHAR AdmissionUmdRegTracePath[MAX_PATH];
+static volatile LONG AdmissionUmdRegTraceOn;
+static volatile LONGLONG AdmissionUmdRegTraceNextTick;
+static BOOL AdmissionUmdRegTraceRefusals = TRUE;
+#define ADMISSION_UMD_REG_TRACE_KEY L"SOFTWARE\\NWOAS\\AgxUmdTrace"
+#define ADMISSION_UMD_REG_TRACE_MAX_BYTES (16LL * 1024 * 1024)
+
+static VOID AdmissionUmdRegTraceProbe(VOID) {
+  LONGLONG now = (LONGLONG)GetTickCount64();
+  LONGLONG next = InterlockedCompareExchange64(&AdmissionUmdRegTraceNextTick, 0, 0);
+  WCHAR dir[200], process[64], image[MAX_PATH];
+  DWORD bytes, refusals = 1u, length, i, at = 0u, pid, digits = 0u;
+  WCHAR number[12];
+  PCWSTR base;
+  if (now < next ||
+      InterlockedCompareExchange64(&AdmissionUmdRegTraceNextTick, now + 2000,
+                                   next) != next)
+    return;
+  bytes = sizeof(dir);
+  if (RegGetValueW(HKEY_LOCAL_MACHINE, ADMISSION_UMD_REG_TRACE_KEY, L"Dir",
+                   RRF_RT_REG_SZ, NULL, dir, &bytes) != ERROR_SUCCESS)
+    return;
+  bytes = sizeof(process);
+  if (RegGetValueW(HKEY_LOCAL_MACHINE, ADMISSION_UMD_REG_TRACE_KEY, L"Process",
+                   RRF_RT_REG_SZ, NULL, process, &bytes) != ERROR_SUCCESS)
+    return;
+  bytes = sizeof(refusals);
+  (void)RegGetValueW(HKEY_LOCAL_MACHINE, ADMISSION_UMD_REG_TRACE_KEY,
+                     L"RefusalsOnly", RRF_RT_REG_DWORD, NULL, &refusals, &bytes);
+  length = GetModuleFileNameW(NULL, image, ARRAYSIZE(image));
+  if (length == 0u || length >= ARRAYSIZE(image)) return;
+  base = image;
+  for (i = 0u; i < length; ++i)
+    if (image[i] == L'\\') base = &image[i + 1u];
+  if (!(process[0] == L'*' && process[1] == L'\0') && _wcsicmp(process, base) != 0)
+    return;
+  for (i = 0u; dir[i] != L'\0' && at + 1u < ARRAYSIZE(AdmissionUmdRegTracePath); ++i)
+    AdmissionUmdRegTracePath[at++] = dir[i];
+  if (at + 1u < ARRAYSIZE(AdmissionUmdRegTracePath))
+    AdmissionUmdRegTracePath[at++] = L'\\';
+  for (i = 0u; base[i] != L'\0' && at + 1u < ARRAYSIZE(AdmissionUmdRegTracePath); ++i)
+    AdmissionUmdRegTracePath[at++] = base[i];
+  pid = GetCurrentProcessId();
+  do { number[digits++] = (WCHAR)(L'0' + pid % 10u); pid /= 10u; } while (pid != 0u);
+  if (at + digits + 6u >= ARRAYSIZE(AdmissionUmdRegTracePath)) return;
+  AdmissionUmdRegTracePath[at++] = L'-';
+  while (digits != 0u) AdmissionUmdRegTracePath[at++] = number[--digits];
+  AdmissionUmdRegTracePath[at++] = L'.';
+  AdmissionUmdRegTracePath[at++] = L'l';
+  AdmissionUmdRegTracePath[at++] = L'o';
+  AdmissionUmdRegTracePath[at++] = L'g';
+  AdmissionUmdRegTracePath[at] = L'\0';
+  AdmissionUmdRegTraceRefusals = refusals != 0u;
+  InterlockedExchange(&AdmissionUmdRegTraceOn, 1);
+}
