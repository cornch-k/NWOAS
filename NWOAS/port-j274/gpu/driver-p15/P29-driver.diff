 /* The trace file path, or NULL when tracing is off. */
 static PCWSTR AdmissionUmdTraceConfig(BOOL *RefusalsOnly) {
   (void)InitOnceExecuteOnce(&AdmissionUmdTraceOnce, AdmissionUmdTraceLoad,
                             NULL, NULL);
+  if (AdmissionUmdTracePath[0] != L'\0') {
+    *RefusalsOnly = AdmissionUmdTraceRefusalsOnly;
+    return AdmissionUmdTracePath;
+  }
+  if (InterlockedCompareExchange(&AdmissionUmdRegTraceOn, 0, 0) == 0) {
+    AdmissionUmdRegTraceProbe();
+  } else {
+    /* Deleting the key turns the trace off again (checked every 2 s). */
+    static volatile LONGLONG offCheck;
+    LONGLONG now = (LONGLONG)GetTickCount64();
+    LONGLONG due = InterlockedCompareExchange64(&offCheck, 0, 0);
+    if (now >= due &&
+        InterlockedCompareExchange64(&offCheck, now + 2000, due) == due) {
+      WCHAR dir[200];
