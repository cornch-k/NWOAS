+/* NWOAS-J274 PATCH P29: unconditional, bounded DDI rings for the paths a
+ * windowed blt-model present can take.  Each ring keeps the last 16 calls
+ * (24 words each) behind an 8-word header {version, calls, failures, next
+ * slot, skipped MMIO flips, writes, 0, 0}.  The ring is written at PASSIVE
+ * for its first 48 writes, then for a failure (at most 64 more) or at most
+ * once a second.  Observational only: every wrapper returns the inner
+ * DDI's status unchanged. */
+#define ADMISSION_DDI_RING_SLOTS 16u
+#define ADMISSION_DDI_RING_WORDS 24u
+typedef struct _ADMISSION_DDI_RING {
+  ULONG Header[8];
+  ULONG Entries[ADMISSION_DDI_RING_SLOTS][ADMISSION_DDI_RING_WORDS];
+} ADMISSION_DDI_RING;
+typedef struct _ADMISSION_DDI_RING_STATE {
+  ADMISSION_DDI_RING Ring;
+  volatile LONG Calls, Failures, Skipped, Writes, FailureWrites;
+  volatile LONGLONG LastQpc;
+} ADMISSION_DDI_RING_STATE;
+static ADMISSION_DDI_RING_STATE AdmissionPresentRing, AdmissionStdAllocRing,
+    AdmissionOpenAllocRing, AdmissionCreateAllocRing;
+
+static VOID AdmissionDdiRingRecord(ADMISSION_DDI_RING_STATE *State,
+    PDEVICE_OBJECT DeviceObject, PCWSTR Name, const ULONG *Entry,
+    NTSTATUS Status) {
+  LONG calls = InterlockedIncrement(&State->Calls);
+  LONG failures = NT_SUCCESS(Status) ? State->Failures
+                                     : InterlockedIncrement(&State->Failures);
+  ULONG slot = (ULONG)(calls - 1) % ADMISSION_DDI_RING_SLOTS;
+  LARGE_INTEGER frequency;
+  LONGLONG now, last;
+  BOOLEAN write = FALSE;
+  HANDLE key = NULL;
+  RtlCopyMemory(State->Ring.Entries[slot], Entry,
+                ADMISSION_DDI_RING_WORDS * sizeof(ULONG));
+  State->Ring.Entries[slot][ADMISSION_DDI_RING_WORDS - 1u] = (ULONG)Status;
+  if (DeviceObject == NULL || KeGetCurrentIrql() != PASSIVE_LEVEL)
+    return;
+  now = KeQueryPerformanceCounter(&frequency).QuadPart;
+  last = State->LastQpc;
+  if (State->Writes < 48)
+    write = TRUE;
+  else if (!NT_SUCCESS(Status) && State->FailureWrites < 64) {
+    InterlockedIncrement(&State->FailureWrites);
+    write = TRUE;
+  } else if (now - last >= frequency.QuadPart)
+    write = TRUE;
+  if (!write)
+    return;
+  InterlockedExchange64(&State->LastQpc, now);
+  State->Ring.Header[0] = 1u;
+  State->Ring.Header[1] = (ULONG)calls;
+  State->Ring.Header[2] = (ULONG)failures;
+  State->Ring.Header[3] = (ULONG)calls % ADMISSION_DDI_RING_SLOTS;
+  State->Ring.Header[4] = (ULONG)State->Skipped;
+  State->Ring.Header[5] = (ULONG)InterlockedIncrement(&State->Writes);
+  if (!NT_SUCCESS(IoOpenDeviceRegistryKey(DeviceObject,
+          PLUGPLAY_REGKEY_DEVICE, KEY_SET_VALUE, &key)))
+    return;
+  WriteBinary(key, Name, &State->Ring, sizeof(State->Ring));
+  ZwClose(key);
+}
+
+/* Width, height, format, type of an opened allocation, or ~0 and a reason. */
+static VOID AdmissionDdiRingEndpoint(HANDLE Handle, ULONG *Out) {
+  const ADMISSION_OPEN_ALLOCATION *opened =
+      (const ADMISSION_OPEN_ALLOCATION *)Handle;
+  Out[0] = Out[1] = Out[2] = Out[3] = 0u;
+  if (opened == NULL) { Out[3] = 0xfffffff1u; return; }
+  if (opened->Magic != ADMISSION_OPEN_ALLOCATION_MAGIC ||
+      opened->Allocation == NULL ||
+      opened->Allocation->Magic != ADMISSION_ALLOCATION_OBJECT_MAGIC) {
+    Out[3] = 0xfffffff2u;
+    return;
+  }
+  Out[0] = opened->Allocation->Description.Width;
+  Out[1] = opened->Allocation->Description.Height;
+  Out[2] = opened->Allocation->Description.Format;
+  Out[3] = opened->Allocation->Description.Type |
+           (opened->Allocation->Description.CpuVisible ? 0x100u : 0u);
+}
+
+static PDEVICE_OBJECT AdmissionDdiRingDeviceObject(ADMISSION_DEVICE *Device) {
+  ADMISSION_CONTEXT *adapter;
+  if (Device == NULL || Device->Object.Magic != ADMISSION_OBJECT_DEVICE_MAGIC ||
+      Device->Object.Adapter == NULL ||
+      Device->Object.Adapter->Magic != ADMISSION_OBJECT_ADAPTER_MAGIC)
+    return NULL;
+  adapter = CONTAINING_RECORD(Device->Object.Adapter, ADMISSION_CONTEXT,
+                              ObjectAdapter);
+  return adapter->PhysicalDeviceObject;
+}
+
+/* Wom1PresentDdiRing entry: pid, context flags, present flags, NumSrc |
+ * NumDst << 16, pointer bits (DMA, allocation info, allocation list,
+ * private data, sub-rects), SrcRect, DstRect, sub-rect count, source
+ * {w,h,format,type}, destination {w,h,format,type}, flip interval, color,
+ * status.  DWM's MMIO flips (no DMA, flags 0x4/0xc, one source) are only
+ * counted (header word 4). */
+_Use_decl_annotations_ NTSTATUS AdmissionTraceDdiPresent(
+    HANDLE Context, DXGKARG_PRESENT *Present) {
+  ADMISSION_RENDER_CONTEXT *renderContext = (ADMISSION_RENDER_CONTEXT *)Context;
+  ADMISSION_DEVICE *device = NULL;
+  ULONG entry[ADMISSION_DDI_RING_WORDS];
+  ULONG flags = Present != NULL ? Present->Flags.Value : ~0u;
+  HANDLE src = NULL, dst = NULL;
+  NTSTATUS status;
+  RtlZeroMemory(entry, sizeof(entry));
+  if (renderContext != NULL &&
+      renderContext->Object.Magic == ADMISSION_OBJECT_CONTEXT_MAGIC &&
+      renderContext->Object.Device != NULL &&
+      renderContext->Object.Device->Magic == ADMISSION_OBJECT_DEVICE_MAGIC)
+    device = CONTAINING_RECORD(renderContext->Object.Device,
+                               ADMISSION_DEVICE, Object);
+  else if (Context != NULL &&
+           ((ADMISSION_DEVICE *)Context)->Object.Magic ==
+               ADMISSION_OBJECT_DEVICE_MAGIC)
+    device = (ADMISSION_DEVICE *)Context;
+  if (Present != NULL) {
+    entry[0] = HandleToULong(PsGetCurrentProcessId());
+    if (renderContext != NULL &&
+        renderContext->Object.Magic == ADMISSION_OBJECT_CONTEXT_MAGIC)
+      entry[1] = renderContext->Object.Flags;
+    entry[2] = flags;
+    entry[3] = Present->NumSrcAllocations | (Present->NumDstAllocations << 16);
+    entry[4] = (Present->pDmaBuffer != NULL ? 1u : 0u) |
+               (Present->pAllocationInfo != NULL ? 2u : 0u) |
+               (Present->pAllocationList != NULL ? 4u : 0u) |
+               (Present->pPrivateDriverData != NULL ? 8u : 0u) |
+               (Present->pDstSubRects != NULL ? 16u : 0u);
+    RtlCopyMemory(&entry[5], &Present->SrcRect, sizeof(RECT));
+    RtlCopyMemory(&entry[9], &Present->DstRect, sizeof(RECT));
+    entry[13] = Present->SubRectCnt;
+    if (Present->pAllocationInfo != NULL) {
+      src = Present->pAllocationInfo[DXGK_PRESENT_SOURCE_INDEX].hDeviceSpecificAllocation;
+      dst = Present->pAllocationInfo[DXGK_PRESENT_DESTINATION_INDEX].hDeviceSpecificAllocation;
+    } else if (Present->pAllocationList != NULL) {
+      src = Present->pAllocationList[DXGK_PRESENT_SOURCE_INDEX].hDeviceSpecificAllocation;
+      dst = Present->pAllocationList[DXGK_PRESENT_DESTINATION_INDEX].hDeviceSpecificAllocation;
+    }
+    AdmissionDdiRingEndpoint(src, &entry[14]);
+    AdmissionDdiRingEndpoint(dst, &entry[18]);
+    entry[22] = (ULONG)Present->FlipInterval | (Present->Color << 8);
+  }
+  status = AdmissionDdiPresent(Context, Present);
+  if (Present != NULL && entry[4] == 2u && (flags & ~0x8u) == 0x4u &&
+      Present->NumSrcAllocations == 1u && Present->NumDstAllocations == 0u &&
+      NT_SUCCESS(status)) {
+    InterlockedIncrement(&AdmissionPresentRing.Skipped);
+    return status;
+  }
+  if (Present != NULL && (entry[4] & 1u) == 0u && (flags & ~0x8u) == 0x4u &&
+      Present->NumSrcAllocations == 0u && NT_SUCCESS(status)) {
+    InterlockedIncrement(&AdmissionPresentRing.Skipped);
+    return status;
+  }
+  AdmissionDdiRingRecord(&AdmissionPresentRing,
+      AdmissionDdiRingDeviceObject(device), L"Wom1PresentDdiRing", entry, status);
+  return status;
+}
+
+/* Wom1StdAllocRing entry: pid, standard type, then {w, h, format, surface
+ * type, surface flags} of the primary / shadow / GDI surface, pitch out,
+ * private size. */
+_Use_decl_annotations_ NTSTATUS AdmissionTraceDdiGetStandardAllocationDriverData(
+    HANDLE Adapter, DXGKARG_GETSTANDARDALLOCATIONDRIVERDATA *Args) {
+  ADMISSION_CONTEXT *context = (ADMISSION_CONTEXT *)Adapter;
+  ULONG entry[ADMISSION_DDI_RING_WORDS];
+  NTSTATUS status;
+  RtlZeroMemory(entry, sizeof(entry));
+  entry[0] = HandleToULong(PsGetCurrentProcessId());
+  if (Args != NULL) {
+    entry[1] = (ULONG)Args->StandardAllocationType;
+    switch (Args->StandardAllocationType) {
+    case D3DKMDT_STANDARDALLOCATION_SHAREDPRIMARYSURFACE:
+      if (Args->pCreateSharedPrimarySurfaceData != NULL) {
+        entry[2] = Args->pCreateSharedPrimarySurfaceData->Width;
+        entry[3] = Args->pCreateSharedPrimarySurfaceData->Height;
+        entry[4] = (ULONG)Args->pCreateSharedPrimarySurfaceData->Format;
+        entry[5] = Args->pCreateSharedPrimarySurfaceData->VidPnSourceId;
+      }
+      break;
+    case D3DKMDT_STANDARDALLOCATION_SHADOWSURFACE:
+      if (Args->pCreateShadowSurfaceData != NULL) {
+        entry[2] = Args->pCreateShadowSurfaceData->Width;
+        entry[3] = Args->pCreateShadowSurfaceData->Height;
+        entry[4] = (ULONG)Args->pCreateShadowSurfaceData->Format;
+      }
+      break;
+    case D3DKMDT_STANDARDALLOCATION_GDISURFACE:
+      if (Args->pCreateGdiSurfaceData != NULL) {
+        entry[2] = Args->pCreateGdiSurfaceData->Width;
+        entry[3] = Args->pCreateGdiSurfaceData->Height;
+        entry[4] = (ULONG)Args->pCreateGdiSurfaceData->Format;
+        entry[5] = (ULONG)Args->pCreateGdiSurfaceData->Type;
+        entry[6] = Args->pCreateGdiSurfaceData->Flags.Value;
+      }
+      break;
+    default:
+      break;
+    }
+    entry[8] = Args->AllocationPrivateDriverDataSize;
+  }
+  status = AdmissionDdiGetStandardAllocationDriverData(Adapter, Args);
+  if (Args != NULL) {
+    if (Args->StandardAllocationType == D3DKMDT_STANDARDALLOCATION_GDISURFACE &&
+        Args->pCreateGdiSurfaceData != NULL)
+      entry[7] = Args->pCreateGdiSurfaceData->Pitch;
+    else if (Args->StandardAllocationType == D3DKMDT_STANDARDALLOCATION_SHADOWSURFACE &&
+             Args->pCreateShadowSurfaceData != NULL)
+      entry[7] = Args->pCreateShadowSurfaceData->Pitch;
+  }
+  AdmissionDdiRingRecord(&AdmissionStdAllocRing,
+      context != NULL ? context->PhysicalDeviceObject : NULL,
+      L"Wom1StdAllocRing", entry, status);
+  return status;
+}
+
+/* Wom1OpenAllocRing entry: pid, count, then the first allocation's private
+ * size and {w, h, format, type|cpu<<8, pitch} when its private data is our
+ * description.  Recorded for failures and for the first 48 calls. */
+_Use_decl_annotations_ NTSTATUS AdmissionTraceDdiOpenAllocation(
+    HANDLE Device, const DXGKARG_OPENALLOCATION *Args) {
+  ULONG entry[ADMISSION_DDI_RING_WORDS];
+  NTSTATUS status = AdmissionDdiOpenAllocation(Device, Args);
+  if (NT_SUCCESS(status) && AdmissionOpenAllocRing.Writes >= 48)
+    return status;
+  RtlZeroMemory(entry, sizeof(entry));
+  entry[0] = HandleToULong(PsGetCurrentProcessId());
+  if (Args != NULL) {
+    entry[1] = Args->NumAllocations;
+    entry[2] = Args->PrivateDriverSize;
+    entry[3] = Args->Flags.Value;
+    if (Args->NumAllocations != 0u && Args->pOpenAllocation != NULL) {
+      const DXGK_OPENALLOCATIONINFO *info = &Args->pOpenAllocation[0];
+      entry[4] = info->PrivateDriverDataSize;
+      if (info->pPrivateDriverData != NULL &&
+          info->PrivateDriverDataSize >= sizeof(ADMISSION_ALLOCATION_DESCRIPTION)) {
+        const ADMISSION_ALLOCATION_DESCRIPTION *d =
+            (const ADMISSION_ALLOCATION_DESCRIPTION *)info->pPrivateDriverData;
+        entry[5] = d->Magic; entry[6] = d->Width; entry[7] = d->Height;
+        entry[8] = d->Format; entry[9] = d->Type | (d->CpuVisible ? 0x100u : 0u);
+        entry[10] = d->Pitch;
+      }
+    }
+  }
+  AdmissionDdiRingRecord(&AdmissionOpenAllocRing,
+      AdmissionDdiRingDeviceObject((ADMISSION_DEVICE *)Device),
+      L"Wom1OpenAllocRing", entry, status);
+  return status;
+}
+
+/* Wom1CreateAllocRing (failures only): pid, count, resource private size,
+ * flags, first allocation's private size and the first 8 words of it. */
+_Use_decl_annotations_ NTSTATUS AdmissionTraceDdiCreateAllocation(
+    HANDLE Adapter, DXGKARG_CREATEALLOCATION *Args) {
+  ADMISSION_CONTEXT *context = (ADMISSION_CONTEXT *)Adapter;
+  ULONG entry[ADMISSION_DDI_RING_WORDS];
+  NTSTATUS status = AdmissionDdiCreateAllocation(Adapter, Args);
+  if (NT_SUCCESS(status))
+    return status;
+  RtlZeroMemory(entry, sizeof(entry));
+  entry[0] = HandleToULong(PsGetCurrentProcessId());
+  if (Args != NULL) {
+    entry[1] = Args->NumAllocations;
+    entry[2] = Args->PrivateDriverDataSize;
+    entry[3] = Args->Flags.Value;
+    if (Args->NumAllocations != 0u && Args->pAllocationInfo != NULL) {
+      const DXGK_ALLOCATIONINFO *info = &Args->pAllocationInfo[0];
+      entry[4] = info->PrivateDriverDataSize;
+      entry[5] = info->Flags.Value;
+      if (info->pPrivateDriverData != NULL) {
+        ULONG words = info->PrivateDriverDataSize / sizeof(ULONG);
+        if (words > 8u) words = 8u;
+        RtlCopyMemory(&entry[6], info->pPrivateDriverData, words * sizeof(ULONG));
+      }
+    }
+  }
+  AdmissionDdiRingRecord(&AdmissionCreateAllocRing,
+      context != NULL ? context->PhysicalDeviceObject : NULL,
+      L"Wom1CreateAllocRing", entry, status);
+  return status;
+}
