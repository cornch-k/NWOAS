+        InterlockedExchange(&AdmissionUmdRegTraceOn, 0);
+        InterlockedExchange64(&AdmissionUmdRegTraceNextTick, now + 2000);
+      }
+    }
+  }
+  if (InterlockedCompareExchange(&AdmissionUmdRegTraceOn, 0, 0) != 0) {
+    *RefusalsOnly = AdmissionUmdRegTraceRefusals;
+    return AdmissionUmdRegTracePath;
+  }
   *RefusalsOnly = AdmissionUmdTraceRefusalsOnly;
-  return AdmissionUmdTracePath[0] != L'\0' ? AdmissionUmdTracePath : NULL;
+  return NULL;
 }
 
