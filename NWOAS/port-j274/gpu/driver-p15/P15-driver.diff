+/* After the pending flip is recorded: raise LATCHED and run the ISR path. */
+static VOID AdmissionScanoutSoftKick(ADMISSION_SCANOUT_RUNTIME *R) {
+  if (InterlockedCompareExchange(&R->SoftLatchPending, 0, 0) != 0)
+    (void)KeInsertQueueDpc(&R->SoftLatchDpc, NULL, NULL);
+}
