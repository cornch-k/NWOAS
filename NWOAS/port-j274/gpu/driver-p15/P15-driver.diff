+static APPLE_AGX_SCANOUT_U32 AdmissionScanoutSoftRead32(
+    ADMISSION_SCANOUT_RUNTIME *R, APPLE_AGX_SCANOUT_U32 Reg) {
+  switch (Reg) {
+  case APPLE_AGX_SCANOUT_REG_MAGIC: return APPLE_AGX_SCANOUT_MAGIC;
+  case APPLE_AGX_SCANOUT_REG_ABI_VERSION: return APPLE_AGX_SCANOUT_ABI_VERSION_V2;
+  case APPLE_AGX_SCANOUT_REG_CAPABILITIES:
+    return APPLE_AGX_SCANOUT_V2_PRESENT_CAPABILITIES;
+  case APPLE_AGX_SCANOUT_REG_STATE: return R->SoftState;
+  case APPLE_AGX_SCANOUT_REG_RESULT: return R->SoftResult;
+  case APPLE_AGX_SCANOUT_REG_IRQ_STATUS:
+    return (APPLE_AGX_SCANOUT_U32)InterlockedCompareExchange(&R->SoftIrqStatus, 0, 0);
+  case APPLE_AGX_SCANOUT_REG_IRQ_ENABLE: return R->SoftIrqEnable;
+  case APPLE_AGX_SCANOUT_REG_SWAP_ID: return R->SoftSwapId;
+  case APPLE_AGX_SCANOUT_REG_WIDTH: return R->SoftWidth;
+  case APPLE_AGX_SCANOUT_REG_HEIGHT: return R->SoftHeight;
+  case APPLE_AGX_SCANOUT_REG_STRIDE: return R->SoftStride;
+  case APPLE_AGX_SCANOUT_REG_FORMAT: return R->SoftFormat;
+  default: return 0u;
+  }
+}
+
+static APPLE_AGX_SCANOUT_U64 AdmissionScanoutSoftRead64(
+    ADMISSION_SCANOUT_RUNTIME *R, APPLE_AGX_SCANOUT_U32 Reg) {
+  switch (Reg) {
+  case APPLE_AGX_SCANOUT_REG_RECEIPT_SEQUENCE:
+    return (APPLE_AGX_SCANOUT_U64)InterlockedCompareExchange64(&R->SoftReceipt, 0, 0);
+  case APPLE_AGX_SCANOUT_REG_APPLIED_SEQUENCE:
+    return (APPLE_AGX_SCANOUT_U64)InterlockedCompareExchange64(&R->SoftApplied, 0, 0);
+  case APPLE_AGX_SCANOUT_REG_LATCHED_SEQUENCE:
+    return (APPLE_AGX_SCANOUT_U64)InterlockedCompareExchange64(&R->SoftLatched, 0, 0);
+  case APPLE_AGX_SCANOUT_REG_ACTIVE_OFFSET: return R->SoftActiveOffset;
+  case APPLE_AGX_SCANOUT_REG_POOL_PA: return R->SoftPoolIpa;
+  case APPLE_AGX_SCANOUT_REG_ACCEPTED_REQUESTS: return R->SoftAccepted;
+  case APPLE_AGX_SCANOUT_REG_REJECTED_REQUESTS: return R->SoftRejected;
+  case APPLE_AGX_SCANOUT_REG_POOL_IPA: return R->SoftReqPoolIpa;
+  case APPLE_AGX_SCANOUT_REG_POOL_SIZE: return R->SoftReqPoolSize;
+  case APPLE_AGX_SCANOUT_REG_SURFACE_OFFSET: return R->SoftSurfaceOffset;
+  case APPLE_AGX_SCANOUT_REG_SURFACE_SIZE: return R->SoftSurfaceSize;
+  case APPLE_AGX_SCANOUT_REG_REQUEST_SEQUENCE: return R->SoftRequestSequence;
+  default: return 0ULL;
+  }
+}
+
+/* PRESENT: linear BGRA8888 rows of the pool surface into the framebuffer.
+ * Both mappings are non-paged write-combined, so any IRQL may copy. */
+static APPLE_AGX_SCANOUT_U32 AdmissionScanoutSoftPresent(
+    ADMISSION_SCANOUT_RUNTIME *R) {
+  ULONGLONG bytes = (ULONGLONG)R->SoftStride * R->SoftHeight;
+  ULONG row;
+  if (R->SoftState != APPLE_AGX_SCANOUT_STATE_READY &&
+      R->SoftState != APPLE_AGX_SCANOUT_STATE_ACTIVE)
+    return APPLE_AGX_SCANOUT_BROKER_INVALID_POOL;
+  if (R->SoftFb == NULL || R->SoftPool == NULL ||
+      R->SoftWidth != APPLE_AGX_SCANOUT_J313_WIDTH ||
+      R->SoftHeight != APPLE_AGX_SCANOUT_J313_HEIGHT ||
+      R->SoftStride != APPLE_AGX_SCANOUT_J313_STRIDE ||
+      R->SoftFormat != APPLE_AGX_SCANOUT_FORMAT_BGRA8888 ||
+      R->SoftSurfaceSize < bytes ||
+      (R->SoftSurfaceOffset & (APPLE_AGX_SCANOUT_ALIGNMENT - 1ULL)) != 0ULL ||
+      R->SoftSurfaceOffset > R->SoftPoolBytes ||
+      bytes > R->SoftPoolBytes - R->SoftSurfaceOffset ||
+      (ULONGLONG)R->SoftFbPitch * R->SoftHeight > R->SoftFbBytes ||
+      (ULONGLONG)R->SoftWidth * 4u > R->SoftFbPitch)
+    return APPLE_AGX_SCANOUT_BROKER_INVALID_SURFACE;
+  for (row = 0u; row < R->SoftHeight; ++row)
+    RtlCopyMemory((PVOID)(R->SoftFb + (SIZE_T)row * R->SoftFbPitch),
+                  (const VOID *)(R->SoftPool + R->SoftSurfaceOffset +
+                                 (SIZE_T)row * R->SoftStride),
+                  (SIZE_T)R->SoftWidth * 4u);
+  R->SoftActiveOffset = R->SoftSurfaceOffset;
+  if (++R->SoftSwapId == 0u)
+    R->SoftSwapId = 1u;
+  R->SoftState = APPLE_AGX_SCANOUT_STATE_ACTIVE;
+  R->SoftPresentCount++;
+  return APPLE_AGX_SCANOUT_BROKER_OK;
+}
+
+static VOID AdmissionScanoutSoftCommand(ADMISSION_SCANOUT_RUNTIME *R,
+                                        APPLE_AGX_SCANOUT_U32 Command) {
+  ULONGLONG seq = R->SoftRequestSequence;
+  APPLE_AGX_SCANOUT_U32 result = APPLE_AGX_SCANOUT_BROKER_OK;
+  if (seq == 0ULL ||
+      seq <= (ULONGLONG)InterlockedCompareExchange64(&R->SoftReceipt, 0, 0)) {
+    R->SoftResult = APPLE_AGX_SCANOUT_BROKER_STALE_SEQUENCE;
+    R->SoftRejected++;
+    return;
+  }
+  switch (Command) {
+  case APPLE_AGX_SCANOUT_CMD_QUERY:
+    break;
+  case APPLE_AGX_SCANOUT_CMD_REGISTER_POOL:
+    if (R->SoftState != APPLE_AGX_SCANOUT_STATE_UNREGISTERED)
+      result = APPLE_AGX_SCANOUT_BROKER_BUSY;
+    else if (R->SoftPool == NULL || R->SoftFb == NULL ||
+             R->SoftReqPoolIpa != R->SoftPoolIpa ||
+             R->SoftReqPoolSize == 0ULL ||
+             R->SoftReqPoolSize > R->SoftPoolBytes)
+      result = APPLE_AGX_SCANOUT_BROKER_INVALID_POOL;
+    else
+      R->SoftState = APPLE_AGX_SCANOUT_STATE_READY;
+    break;
+  case APPLE_AGX_SCANOUT_CMD_PRESENT:
+    result = AdmissionScanoutSoftPresent(R);
+    if (result == APPLE_AGX_SCANOUT_BROKER_OK) {
+      InterlockedExchange64(&R->SoftLatched, (LONG64)seq);
+      InterlockedExchange(&R->SoftLatchPending, 1);
+    }
+    break;
+  case APPLE_AGX_SCANOUT_CMD_RELEASE:
+    R->SoftState = APPLE_AGX_SCANOUT_STATE_UNREGISTERED;
+    break;
+  default:
+    result = APPLE_AGX_SCANOUT_BROKER_INVALID_COMMAND;
+    break;
+  }
+  R->SoftResult = result;
+  if (result == APPLE_AGX_SCANOUT_BROKER_OK) {
+    InterlockedExchange64(&R->SoftApplied, (LONG64)seq);
+    R->SoftAccepted++;
+  } else {
+    R->SoftRejected++;
+  }
+  InterlockedExchange64(&R->SoftReceipt, (LONG64)seq);
+}
+
+static VOID AdmissionScanoutSoftWrite32(ADMISSION_SCANOUT_RUNTIME *R,
+                                        APPLE_AGX_SCANOUT_U32 Reg,
+                                        APPLE_AGX_SCANOUT_U32 Value) {
+  switch (Reg) {
+  case APPLE_AGX_SCANOUT_REG_IRQ_STATUS:
+    InterlockedAnd(&R->SoftIrqStatus, ~(LONG)Value);
+    break;
+  case APPLE_AGX_SCANOUT_REG_IRQ_ENABLE: R->SoftIrqEnable = Value; break;
+  case APPLE_AGX_SCANOUT_REG_WIDTH: R->SoftWidth = Value; break;
+  case APPLE_AGX_SCANOUT_REG_HEIGHT: R->SoftHeight = Value; break;
+  case APPLE_AGX_SCANOUT_REG_STRIDE: R->SoftStride = Value; break;
+  case APPLE_AGX_SCANOUT_REG_FORMAT: R->SoftFormat = Value; break;
+  case APPLE_AGX_SCANOUT_REG_COMMAND: AdmissionScanoutSoftCommand(R, Value); break;
+  default: break;
+  }
+}
+
+static VOID AdmissionScanoutSoftWrite64(ADMISSION_SCANOUT_RUNTIME *R,
+                                        APPLE_AGX_SCANOUT_U32 Reg,
+                                        APPLE_AGX_SCANOUT_U64 Value) {
+  switch (Reg) {
+  case APPLE_AGX_SCANOUT_REG_POOL_IPA: R->SoftReqPoolIpa = Value; break;
+  case APPLE_AGX_SCANOUT_REG_POOL_SIZE: R->SoftReqPoolSize = Value; break;
+  case APPLE_AGX_SCANOUT_REG_SURFACE_OFFSET: R->SoftSurfaceOffset = Value; break;
+  case APPLE_AGX_SCANOUT_REG_SURFACE_SIZE: R->SoftSurfaceSize = Value; break;
+  case APPLE_AGX_SCANOUT_REG_REQUEST_SEQUENCE: R->SoftRequestSequence = Value; break;
+  default: break;
+  }
+}
+
+static VOID AdmissionScanoutSoftUnmap(ADMISSION_SCANOUT_RUNTIME *R) {
+  if (R->SoftFb != NULL)
+    MmUnmapIoSpace((PVOID)R->SoftFb, R->SoftFbBytes);
+  if (R->SoftPool != NULL)
+    MmUnmapIoSpace((PVOID)R->SoftPool, R->SoftPoolBytes);
+  R->SoftFb = NULL;
+  R->SoftPool = NULL;
+}
+
+/* PASSIVE.  Adopt only the exact POST geometry the J274 build offers. */
+static NTSTATUS AdmissionScanoutSoftMap(ADMISSION_CONTEXT *Context,
+                                        ADMISSION_SCANOUT_RUNTIME *R,
+                                        const ADMISSION_SCANOUT_MEMORY_VIEW *Memory) {
+  const DXGK_DISPLAY_INFORMATION *post = &Context->PostDisplayInformation;
+  PHYSICAL_ADDRESS pa;
+  if (post->Width != APPLE_AGX_SCANOUT_J313_WIDTH ||
+      post->Height != APPLE_AGX_SCANOUT_J313_HEIGHT ||
+      post->Pitch < APPLE_AGX_SCANOUT_J313_WIDTH * 4u ||
+      post->PhysicAddress.QuadPart == 0 ||
+      (post->ColorFormat != D3DDDIFMT_A8R8G8B8 &&
+       post->ColorFormat != D3DDDIFMT_X8R8G8B8))
+    return STATUS_GRAPHICS_INVALID_DISPLAY_ADAPTER;
+  R->SoftFbPitch = post->Pitch;
+  R->SoftFbBytes = (SIZE_T)post->Pitch * post->Height;
+  R->SoftFb = (volatile UCHAR *)MmMapIoSpaceEx(
+      post->PhysicAddress, R->SoftFbBytes, PAGE_READWRITE | PAGE_WRITECOMBINE);
+  if (R->SoftFb == NULL)
+    return STATUS_INSUFFICIENT_RESOURCES;
+  pa.QuadPart = (LONGLONG)Memory->GuestIpaAddress;
+  R->SoftPoolIpa = Memory->GuestIpaAddress;
+  R->SoftPoolBytes = (SIZE_T)Memory->PoolBytes;
+  R->SoftPool = (volatile UCHAR *)MmMapIoSpaceEx(
+      pa, R->SoftPoolBytes, PAGE_READWRITE | PAGE_WRITECOMBINE);
+  if (R->SoftPool == NULL) {
+    AdmissionScanoutSoftUnmap(R);
+    return STATUS_INSUFFICIENT_RESOURCES;
+  }
+  R->SoftState = APPLE_AGX_SCANOUT_STATE_UNREGISTERED;
+  return STATUS_SUCCESS;
+}
