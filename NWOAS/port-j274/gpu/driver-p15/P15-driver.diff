+++ driver-p15/drivers/apple-agx/shared/include/apple_agx_fixed_panel_modes.h	2026-11-16 13:05:38
@@ -15,6 +15,16 @@
  * dcp_iomfb_present_build_v13_5: stride & 63 must be zero); 1366x768 is
  * therefore not offered.  Every height is even, so Stride * Height is a
  * multiple of 128 and the cache-line padded UMD allocation size equals it. */
+#if defined(APPLE_AGX_BOARD_J274)
+/* NWOAS-J274 PATCH P15: one source mode, the POST HDMI framebuffer.  The
+ * software scanout broker never advertises CAP_SCALED_SOURCE. */
+#define APPLE_AGX_FIXED_PANEL_MODE_COUNT 1u
+
+static const unsigned int
+    AppleAgxFixedPanelModeSizes[APPLE_AGX_FIXED_PANEL_MODE_COUNT][2] = {
+        {1920u, 1080u},
+};
+#else
 #define APPLE_AGX_FIXED_PANEL_MODE_COUNT 11u
 
 static const unsigned int
@@ -23,6 +33,7 @@
         {1680u, 1050u}, {1600u, 900u},  {1440u, 900u},  {1280u, 800u},
         {1280u, 720u},  {1024u, 768u},  {800u, 600u},
 };
+#endif
 
 /* Index of Width x Height in the table, or APPLE_AGX_FIXED_PANEL_MODE_COUNT
  * when it is not an offered source mode. */
diff -ru driver-p14/drivers/apple-agx/shared/include/apple_agx_scanout.h driver-p15/drivers/apple-agx/shared/include/apple_agx_scanout.h
--- driver-p14/drivers/apple-agx/shared/include/apple_agx_scanout.h	2026-11-15 19:39:30
+++ driver-p15/drivers/apple-agx/shared/include/apple_agx_scanout.h	2026-11-16 13:05:38
@@ -41,10 +41,21 @@
    APPLE_AGX_SCANOUT_CAP_REPEATED_PRESENT |                                  \
    APPLE_AGX_SCANOUT_CAP_LATCHED_RECEIPT | APPLE_AGX_SCANOUT_CAP_LATCHED_IRQ)
 
+#if defined(APPLE_AGX_BOARD_J274)
+/* NWOAS-J274 PATCH P15: the Mac mini has no fixed panel.  The native source
+ * is the HDMI linear framebuffer m1n1 hands over at POST (1920x1080, 32 bpp,
+ * stride 7680; S244 probe on the 13.5 stub).  Any other POST geometry is
+ * refused by the post-display route exactly like a non-J313 panel. */
+#define APPLE_AGX_SCANOUT_J313_WIDTH 1920u
+#define APPLE_AGX_SCANOUT_J313_HEIGHT 1080u
+#define APPLE_AGX_SCANOUT_J313_STRIDE 7680u
+#define APPLE_AGX_SCANOUT_J313_SURFACE_SIZE 0x7e9000ULL
+#else
 #define APPLE_AGX_SCANOUT_J313_WIDTH 2560u
 #define APPLE_AGX_SCANOUT_J313_HEIGHT 1600u
 #define APPLE_AGX_SCANOUT_J313_STRIDE 10240u
 #define APPLE_AGX_SCANOUT_J313_SURFACE_SIZE 0xfa0000ULL
+#endif
 /* M2-f2c: the pool is segment 2 of the receipt-sized reserve; this is its
  * J313 maximum (a 1 GiB reserve less the private span and backend arena). */
 #define APPLE_AGX_SCANOUT_J313_POOL_MAX_SIZE 0x3b800000ULL
