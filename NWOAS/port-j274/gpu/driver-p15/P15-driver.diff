+/* DIRQL (DxgkCbSynchronizeExecution): publish the software latch exactly
+ * like the HV broker's LATCHED interrupt, then run the normal ISR path. */
+static BOOLEAN AdmissionScanoutSoftInterrupt(PVOID Opaque) {
+  ADMISSION_SCANOUT_RUNTIME *runtime = Opaque;
+  if (runtime == NULL)
+    return FALSE;
+  if (InterlockedExchange(&runtime->SoftLatchPending, 0) != 0 &&
+      (runtime->SoftIrqEnable & APPLE_AGX_SCANOUT_IRQ_LATCHED) != 0u)
+    InterlockedOr(&runtime->SoftIrqStatus, (LONG)APPLE_AGX_SCANOUT_IRQ_LATCHED);
+  (void)AdmissionScanoutProcessInterrupt(runtime->Adapter, FALSE);
+  return TRUE;
+}
