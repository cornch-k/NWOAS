+_Use_decl_annotations_ VOID AdmissionScanoutResetSnapshot(
+    ADMISSION_CONTEXT *Context, ULONGLONG *Out) {
+  ADMISSION_SCANOUT_RUNTIME *runtime = AdmissionScanoutGet(Context);
+  RtlZeroMemory(Out, 8u * sizeof(*Out));
+  Out[0] = (ULONGLONG)(Context->SourceVisible ? 1u : 0u) |
+           ((ULONGLONG)(ULONG)InterlockedCompareExchange(&Context->DisplayModes.LastVisible, 0, 0) << 8) |
+           ((ULONGLONG)(ULONG)InterlockedCompareExchange(&Context->DisplayModes.VisibilityCalls, 0, 0) << 16);
+  Out[1] = (ULONGLONG)(ULONG)InterlockedCompareExchange(&Context->DisplayModes.DeferredFlips, 0, 0);
+  if (runtime == NULL)
+    return;
+  Out[2] = (ULONGLONG)(ULONG)InterlockedCompareExchange(&runtime->PendingValid, 0, 0) |
+           ((ULONGLONG)(ULONG)InterlockedCompareExchange(&runtime->PresentGate, 0, 0) << 8) |
+           ((ULONGLONG)(ULONG)InterlockedCompareExchange(&runtime->IrqEnabled, 0, 0) << 16) |
+           ((ULONGLONG)(ULONG)InterlockedCompareExchange(&runtime->VsyncNotifyEnabled, 0, 0) << 24) |
+           ((ULONGLONG)(runtime->TimerArmed ? 1u : 0u) << 32) |
+           ((ULONGLONG)(runtime->Timeline.Running ? 1u : 0u) << 40) |
+           ((ULONGLONG)(runtime->Timeline.Enabled ? 1u : 0u) << 48) |
+           ((ULONGLONG)(runtime->Panel.Visible ? 1u : 0u) << 56);
+  Out[3] = (ULONGLONG)InterlockedCompareExchange64(&runtime->DeferredPrimaryAddress, 0, 0);
+  Out[4] = (ULONGLONG)InterlockedCompareExchange64(&runtime->PendingPhysicalAddress, 0, 0);
+  Out[5] = runtime->Timeline.ActiveAddress;
+#if defined(APPLE_AGX_BOARD_J274)
+  Out[6] = runtime->SoftPresentCount | ((ULONGLONG)(ULONG)
+           InterlockedCompareExchange(&runtime->SoftCopyPending, 0, 0) << 48) |
+           ((ULONGLONG)(ULONG)InterlockedCompareExchange(&runtime->SoftLatchPending, 0, 0) << 56);
+#endif
+  Out[7] = KeQueryInterruptTime() / 10000ULL;
+}
