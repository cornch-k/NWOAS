+    APPLE_AGX_SCANOUT_CLIENT *Client, APPLE_AGX_SCANOUT_BOOL On,
+    APPLE_AGX_SCANOUT_U64 DeadlineMs) {
+  APPLE_AGX_SCANOUT_RESULT result;
+  APPLE_AGX_SCANOUT_U64 sequence = 0ULL, start_ms;
+  APPLE_AGX_SCANOUT_U32 polls;
+
+  if (Client == APPLE_AGX_SCANOUT_NULL || !Client->Qualified ||
+      (Client->Capabilities & APPLE_AGX_SCANOUT_CAP_DISPLAY_POWER) == 0u)
+    return AppleAgxScanoutInvalidArgument;
+  if (Client->PresentPending)
+    return AppleAgxScanoutNotQuiesced;
+  result = AppleAgxScanoutTakeSequence(Client, &sequence);
+  if (result != AppleAgxScanoutOk)
+    return result;
+  if (!AppleAgxScanoutWrite32(Client, APPLE_AGX_SCANOUT_REG_POWER,
+                              On ? 1u : 0u) ||
+      !AppleAgxScanoutWrite64(Client, APPLE_AGX_SCANOUT_REG_REQUEST_SEQUENCE,
+                              sequence) ||
+      !AppleAgxScanoutWrite32(Client, APPLE_AGX_SCANOUT_REG_COMMAND,
+                              APPLE_AGX_SCANOUT_CMD_SET_POWER))
+    return AppleAgxScanoutTransportFailed;
+  start_ms = Client->Io.NowMs(Client->Io.Context);
+  for (polls = 0u; polls < Client->MaxPolls; ++polls) {
+    APPLE_AGX_SCANOUT_U64 receipt, applied, now;
+    APPLE_AGX_SCANOUT_U32 broker;
+    if (!AppleAgxScanoutRead64(Client, APPLE_AGX_SCANOUT_REG_RECEIPT_SEQUENCE,
+                               &receipt) ||
+        !AppleAgxScanoutRead32(Client, APPLE_AGX_SCANOUT_REG_RESULT, &broker) ||
+        !AppleAgxScanoutRead64(Client, APPLE_AGX_SCANOUT_REG_APPLIED_SEQUENCE,
+                               &applied))
+      return AppleAgxScanoutTransportFailed;
+    now = Client->Io.NowMs(Client->Io.Context);
+    if (now < start_ms)
+      return AppleAgxScanoutClockRegression;
+    if (now > DeadlineMs)
+      return AppleAgxScanoutTimeout;
+    Client->LastBrokerResult = broker;
+    if (receipt > sequence)
+      return AppleAgxScanoutInconsistentReceipt;
+    if (receipt == sequence) {
+      if (broker != APPLE_AGX_SCANOUT_BROKER_OK)
+        return AppleAgxScanoutMapBrokerResult(broker);
+      return applied == sequence ? AppleAgxScanoutOk
+                                 : AppleAgxScanoutInconsistentReceipt;
+    }
+    if (Client->Io.Pause != APPLE_AGX_SCANOUT_NULL &&
+        !Client->Io.Pause(Client->Io.Context))
+      return AppleAgxScanoutTransportFailed;
+  }
+  return AppleAgxScanoutTimeout;
+}
diff -ruN -x * external/windows-on-m1/drivers/apple-agx/shared/tests/apple_agx_fixed_panel_j274_test.c port-j274/gpu/driver-p15/drivers/apple-agx/shared/tests/apple_agx_fixed_panel_j274_test.c
--- external/windows-on-m1/drivers/apple-agx/shared/tests/apple_agx_fixed_panel_j274_test.c	1970-01-01 09:00:00
+++ port-j274/gpu/driver-p15/drivers/apple-agx/shared/tests/apple_agx_fixed_panel_j274_test.c	2026-11-16 19:36:32
@@ -0,0 +1,434 @@
+/* NWOAS-J274 P21: host test of the J274 source-mode table and the scaled
+ * source contract against a fake ABI v2 broker.  Build only with the J274
+ * switch (the J313 table is covered by apple_agx_fixed_panel_test.c):
+ *   clang -std=c11 -Wall -Wextra -DAPPLE_AGX_BOARD_J274=1 \
+ *     -Ishared/include -Irender-admission/include \
+ *     shared/tests/apple_agx_fixed_panel_j274_test.c \
+ *     shared/src/apple_agx_fixed_panel.c shared/src/apple_agx_scanout.c \
+ *     render-admission/src/render_allocation.c
+ * Nothing here runs on, or proves anything about, the Mac mini. */
+#if !defined(APPLE_AGX_BOARD_J274)
+#error "apple_agx_fixed_panel_j274_test.c needs -DAPPLE_AGX_BOARD_J274=1"
+#endif
+
+#include "apple_agx_fixed_panel.h"
+#include "apple_agx_fixed_panel_modes.h"
+#include "render_allocation.h"
+
+#include <assert.h>
+#include <string.h>
+
+#define NATIVE_W 1920u
+#define NATIVE_H 1080u
+#define POOL_IPA 0x80000000ULL
+#define POOL_BYTES 0x3b800000ULL
+
+/* The capability word the KMD's software broker (P15) answers
+ * (scanout_windows.c AdmissionScanoutSoftRead32) and the one the gpu-hv2
+ * DCP scanout service with scaled sources is expected to report. */
+#define SOFT_BROKER_CAPS APPLE_AGX_SCANOUT_V2_PRESENT_CAPABILITIES
+#define HV_SCALED_CAPS 0x37fu
+
+typedef struct _FAKE_BROKER {
+  APPLE_AGX_SCANOUT_U32 Capabilities;
+  APPLE_AGX_SCANOUT_U32 State;
+  APPLE_AGX_SCANOUT_U64 Receipt;
+  APPLE_AGX_SCANOUT_U64 Request;
+  APPLE_AGX_SCANOUT_U64 PoolIpa;
+  APPLE_AGX_SCANOUT_U64 PoolSize;
+  APPLE_AGX_SCANOUT_U64 SurfaceOffset;
+  APPLE_AGX_SCANOUT_U64 SurfaceSize;
+  APPLE_AGX_SCANOUT_U64 NowMs;
+  APPLE_AGX_SCANOUT_U32 Width, Height, Stride, Format;
+  APPLE_AGX_SCANOUT_U32 DestOrigin, DestSize, DestWrites;
+} FAKE_BROKER;
+
+static APPLE_AGX_SCANOUT_U32 reg(APPLE_AGX_SCANOUT_U32 Offset) {
+  assert(Offset >= APPLE_AGX_SCANOUT_MMIO_OFFSET);
+  assert(Offset - APPLE_AGX_SCANOUT_MMIO_OFFSET < APPLE_AGX_SCANOUT_MMIO_SIZE);
+  return Offset - APPLE_AGX_SCANOUT_MMIO_OFFSET;
+}
+
+static APPLE_AGX_SCANOUT_BOOL read32(void *Context,
+                                      APPLE_AGX_SCANOUT_U32 Offset,
+                                      APPLE_AGX_SCANOUT_U32 *Value) {
+  FAKE_BROKER *fake = Context;
+  switch (reg(Offset)) {
+  case APPLE_AGX_SCANOUT_REG_MAGIC: *Value = APPLE_AGX_SCANOUT_MAGIC; break;
+  case APPLE_AGX_SCANOUT_REG_ABI_VERSION:
+    *Value = APPLE_AGX_SCANOUT_ABI_VERSION_V2;
+    break;
+  case APPLE_AGX_SCANOUT_REG_CAPABILITIES: *Value = fake->Capabilities; break;
+  case APPLE_AGX_SCANOUT_REG_STATE: *Value = fake->State; break;
+  case APPLE_AGX_SCANOUT_REG_RESULT: *Value = APPLE_AGX_SCANOUT_BROKER_OK; break;
+  default: return APPLE_AGX_SCANOUT_FALSE;
+  }
+  return APPLE_AGX_SCANOUT_TRUE;
+}
+
+static APPLE_AGX_SCANOUT_BOOL read64(void *Context,
+                                      APPLE_AGX_SCANOUT_U32 Offset,
+                                      APPLE_AGX_SCANOUT_U64 *Value) {
+  FAKE_BROKER *fake = Context;
+  switch (reg(Offset)) {
+  case APPLE_AGX_SCANOUT_REG_RECEIPT_SEQUENCE:
+  case APPLE_AGX_SCANOUT_REG_APPLIED_SEQUENCE:
+    *Value = fake->Receipt;
+    break;
+  default: return APPLE_AGX_SCANOUT_FALSE;
+  }
+  return APPLE_AGX_SCANOUT_TRUE;
+}
+
+static APPLE_AGX_SCANOUT_BOOL write32(void *Context,
+                                       APPLE_AGX_SCANOUT_U32 Offset,
+                                       APPLE_AGX_SCANOUT_U32 Value) {
+  FAKE_BROKER *fake = Context;
+  switch (reg(Offset)) {
+  case APPLE_AGX_SCANOUT_REG_COMMAND:
+    fake->State = APPLE_AGX_SCANOUT_STATE_PENDING;
+    return APPLE_AGX_SCANOUT_TRUE;
+  case APPLE_AGX_SCANOUT_REG_WIDTH: fake->Width = Value; break;
+  case APPLE_AGX_SCANOUT_REG_HEIGHT: fake->Height = Value; break;
+  case APPLE_AGX_SCANOUT_REG_STRIDE: fake->Stride = Value; break;
+  case APPLE_AGX_SCANOUT_REG_FORMAT: fake->Format = Value; break;
+  case APPLE_AGX_SCANOUT_REG_DEST_ORIGIN:
+  case APPLE_AGX_SCANOUT_REG_DEST_SIZE:
+    /* The software broker has no destination rectangle; a write here
+     * without CAP_SCALED_SOURCE is a contract violation. */
+    if ((fake->Capabilities & APPLE_AGX_SCANOUT_CAP_SCALED_SOURCE) == 0u)
+      return APPLE_AGX_SCANOUT_FALSE;
+    ++fake->DestWrites;
+    if (reg(Offset) == APPLE_AGX_SCANOUT_REG_DEST_ORIGIN)
+      fake->DestOrigin = Value;
+    else
+      fake->DestSize = Value;
+    break;
+  default: return APPLE_AGX_SCANOUT_FALSE;
+  }
+  return APPLE_AGX_SCANOUT_TRUE;
+}
+
+static APPLE_AGX_SCANOUT_BOOL write64(void *Context,
+                                       APPLE_AGX_SCANOUT_U32 Offset,
+                                       APPLE_AGX_SCANOUT_U64 Value) {
+  FAKE_BROKER *fake = Context;
+  switch (reg(Offset)) {
+  case APPLE_AGX_SCANOUT_REG_REQUEST_SEQUENCE: fake->Request = Value; break;
+  case APPLE_AGX_SCANOUT_REG_POOL_IPA: fake->PoolIpa = Value; break;
+  case APPLE_AGX_SCANOUT_REG_POOL_SIZE: fake->PoolSize = Value; break;
+  case APPLE_AGX_SCANOUT_REG_SURFACE_OFFSET: fake->SurfaceOffset = Value; break;
+  case APPLE_AGX_SCANOUT_REG_SURFACE_SIZE: fake->SurfaceSize = Value; break;
+  default: return APPLE_AGX_SCANOUT_FALSE;
+  }
+  return APPLE_AGX_SCANOUT_TRUE;
+}
+
+static APPLE_AGX_SCANOUT_U64 now_ms(void *Context) {
+  return ((FAKE_BROKER *)Context)->NowMs;
+}
+
+static APPLE_AGX_SCANOUT_BOOL pause_broker(void *Context) {
+  FAKE_BROKER *fake = Context;
+  ++fake->NowMs;
+  fake->Receipt = fake->Request;
+  fake->State = APPLE_AGX_SCANOUT_STATE_READY;
+  return APPLE_AGX_SCANOUT_TRUE;
+}
+
+static APPLE_AGX_FIXED_PANEL make_panel(FAKE_BROKER *Fake,
+                                        APPLE_AGX_SCANOUT_U32 Caps) {
+  APPLE_AGX_SCANOUT_IO io;
+  APPLE_AGX_FIXED_PANEL panel;
+  memset(Fake, 0, sizeof(*Fake));
+  memset(&io, 0, sizeof(io));
+  memset(&panel, 0, sizeof(panel));
+  Fake->Capabilities = Caps;
+  io.Context = Fake;
+  io.NowMs = now_ms;
+  io.Read32 = read32;
+  io.Read64 = read64;
+  io.Write32 = write32;
+  io.Write64 = write64;
+  io.Pause = pause_broker;
+  assert(AppleAgxFixedPanelInitialize(&panel, &io, POOL_IPA, POOL_BYTES, 1ULL,
+                                      8u) == AppleAgxFixedPanelOk);
+  assert(AppleAgxFixedPanelStart(&panel, 20ULL) == AppleAgxFixedPanelOk);
+  return panel;
+}
+
+/* One PRESENT, then stand in for the LATCHED interrupt path
+ * (AppleAgxScanoutConsumeInterrupt) so the next one may be queued. */
+static APPLE_AGX_FIXED_PANEL_RESULT queue_latched(APPLE_AGX_FIXED_PANEL *Panel,
+                                                  APPLE_AGX_SCANOUT_U64 Offset) {
+  APPLE_AGX_SCANOUT_U64 sequence = 0ULL;
+  APPLE_AGX_FIXED_PANEL_RESULT result =
+      AppleAgxFixedPanelQueuePresent(Panel, 2u, Offset, &sequence);
+  if (result == AppleAgxFixedPanelOk) {
+    assert(sequence != 0ULL);
+    Panel->Scanout.PresentPending = APPLE_AGX_SCANOUT_FALSE;
+  }
+  return result;
+}
+
+/* The P20 start probe (scanout_windows.c AdmissionScanoutStart): the HV
+ * service is used when ABI v2 caps contain both of these. */
+static int p20_selects_hv(APPLE_AGX_SCANOUT_U32 Caps) {
+  const APPLE_AGX_SCANOUT_U32 want = APPLE_AGX_SCANOUT_V2_PRESENT_CAPABILITIES |
+                                     APPLE_AGX_SCANOUT_CAP_DISPLAY_POWER;
+  return (Caps & want) == want;
+}
+
+typedef struct _EXPECTED_MODE {
+  APPLE_AGX_SCANOUT_U32 W, H;
+  /* AspectRatioCenteredMax rectangle inside 1920x1080 */
+  APPLE_AGX_SCANOUT_U32 X, Y, RW, RH;
+} EXPECTED_MODE;
+
+static const EXPECTED_MODE expected[] = {
+    {1920u, 1080u, 0u, 0u, 1920u, 1080u},
+    {1680u, 1050u, 96u, 0u, 1728u, 1080u}, /* 16:10 pillarbox */
+    {1600u, 900u, 0u, 0u, 1920u, 1080u},   /* 16:9 fills */
+    {1440u, 900u, 96u, 0u, 1728u, 1080u},
+    {1280u, 800u, 96u, 0u, 1728u, 1080u},
+    {1280u, 720u, 0u, 0u, 1920u, 1080u},
+    {1024u, 768u, 240u, 0u, 1440u, 1080u}, /* 4:3 pillarbox */
+    {800u, 600u, 240u, 0u, 1440u, 1080u},
+};
+
+/* WHAT REAL BUG OR INVARIANT WILL THIS TEST CATCH?  Every J274 source mode
+ * must pass every gate a flip goes through: the header rules (width % 16,
+ * even height), DCP's stride & 63 == 0, the UMD primary size (128-byte
+ * padded size == Stride * Height, else the KMD flip gate refuses it), the
+ * 64 KiB span the flip translates (EXP2055 0xc0000141), and the 1920x1080
+ * native rectangle. */
+static void test_j274_table_passes_every_gate(void) {
+  APPLE_AGX_SCANOUT_U32 i, j;
+  assert(APPLE_AGX_FIXED_PANEL_MODE_COUNT == 8u);
+  assert(sizeof(expected) / sizeof(expected[0]) ==
+         APPLE_AGX_FIXED_PANEL_MODE_COUNT);
+  assert(APPLE_AGX_SCANOUT_J313_WIDTH == NATIVE_W &&
+         APPLE_AGX_SCANOUT_J313_HEIGHT == NATIVE_H &&
+         APPLE_AGX_SCANOUT_J313_STRIDE == NATIVE_W * 4u &&
+         APPLE_AGX_SCANOUT_J313_SURFACE_SIZE == 7680ULL * 1080u);
+  for (i = 0u; i < APPLE_AGX_FIXED_PANEL_MODE_COUNT; ++i) {
+    const APPLE_AGX_SCANOUT_U32 w = AppleAgxFixedPanelModeSizes[i][0];
+    const APPLE_AGX_SCANOUT_U32 h = AppleAgxFixedPanelModeSizes[i][1];
+    APPLE_AGX_FIXED_PANEL_SOURCE_MODE mode;
+    APPLE_AGX_FIXED_PANEL_RECT rect;
+    ADMISSION_ALLOCATION_DESCRIPTION alloc;
+    unsigned long long kmd_bytes = 0ULL;
+    unsigned long long span;
+
+    assert(w == expected[i].W && h == expected[i].H);
+    assert(w <= NATIVE_W && h <= NATIVE_H);
+    assert(w % 16u == 0u && h % 2u == 0u);
+    assert(AppleAgxFixedPanelModeIndex(w, h) == i);
+    for (j = 0u; j < i; ++j)
+      assert(AppleAgxFixedPanelModeSizes[j][0] != w ||
+             AppleAgxFixedPanelModeSizes[j][1] != h);
+
+    assert(AppleAgxFixedPanelSourceModeAt(i, APPLE_AGX_SCANOUT_TRUE, &mode));
+    assert(mode.Width == w && mode.Height == h && mode.Stride == w * 4u);
+    assert((mode.Stride & 63u) == 0u);
+    assert(mode.SurfaceBytes == (APPLE_AGX_SCANOUT_U64)mode.Stride * h);
+
+    /* UMD primary (umd.c): AdmissionAllocationDescribe + 128-byte pad. */
+    assert(AdmissionAllocationDescribe(w, h, 4u, 1u, 21u, 0u, &alloc));
+    assert(alloc.Pitch == mode.Stride);
+    alloc.Size = (alloc.Size + 127ULL) & ~127ULL;
+    assert(alloc.Size == mode.SurfaceBytes);
+    assert(AdmissionAllocationDescriptionValid(&alloc));
+    assert(AppleAgxFixedPanelPrimaryGeometryOffered(w, h, alloc.Pitch,
+                                                    alloc.Size));
+    /* KMD allocation is 64 KiB-rounded; the flip translates the rounded
+     * span (scanout_windows.c, EXP2055), which must fit in it. */
+    assert(AdmissionAllocationAlign64K(alloc.Size, &kmd_bytes));
+    span = (mode.SurfaceBytes + (APPLE_AGX_SCANOUT_ALIGNMENT - 1ULL)) &
+           ~(APPLE_AGX_SCANOUT_ALIGNMENT - 1ULL);
+    assert(span % APPLE_AGX_SCANOUT_ALIGNMENT == 0ULL);
+    assert(span >= mode.SurfaceBytes && span <= kmd_bytes);
+
+    /* Scaling rules: identity only at native size. */
+    if (i == 0u) {
+      assert(AppleAgxFixedPanelScalingSupport(w, h, APPLE_AGX_SCANOUT_TRUE) ==
+             APPLE_AGX_FIXED_PANEL_SCALING_BIT(
+                 AppleAgxFixedPanelScalingIdentity));
+    } else {
+      assert(AppleAgxFixedPanelScalingSupport(w, h, APPLE_AGX_SCANOUT_TRUE) ==
+             (APPLE_AGX_FIXED_PANEL_SCALING_BIT(
+                  AppleAgxFixedPanelScalingCentered) |
+              APPLE_AGX_FIXED_PANEL_SCALING_BIT(
+                  AppleAgxFixedPanelScalingStretched) |
+              APPLE_AGX_FIXED_PANEL_SCALING_BIT(
+                  AppleAgxFixedPanelScalingAspectRatioCenteredMax)));
+      assert(AppleAgxFixedPanelScalingSupport(w, h, APPLE_AGX_SCANOUT_FALSE) ==
+             0u);
+    }
+    assert(AppleAgxFixedPanelDestination(
+        w, h,
+        i == 0u ? AppleAgxFixedPanelScalingIdentity
+                : AppleAgxFixedPanelScalingAspectRatioCenteredMax,
+        &rect));
+    assert(rect.X == expected[i].X && rect.Y == expected[i].Y &&
+           rect.Width == expected[i].RW && rect.Height == expected[i].RH);
+    assert(rect.X + rect.Width <= NATIVE_W && rect.Y + rect.Height <= NATIVE_H);
+  }
+  /* Not offered on J274: larger than native, or a stride DCP refuses. */
+  assert(AppleAgxFixedPanelModeIndex(2560u, 1600u) ==
+         APPLE_AGX_FIXED_PANEL_MODE_COUNT);
+  assert(AppleAgxFixedPanelModeIndex(1920u, 1200u) ==
+         APPLE_AGX_FIXED_PANEL_MODE_COUNT);
+  assert(AppleAgxFixedPanelModeIndex(2048u, 1280u) ==
+         APPLE_AGX_FIXED_PANEL_MODE_COUNT);
+  assert(AppleAgxFixedPanelModeIndex(1366u, 768u) ==
+         APPLE_AGX_FIXED_PANEL_MODE_COUNT);
+}
+
+/* WHAT REAL BUG OR INVARIANT WILL THIS TEST CATCH?  The software broker
+ * (P15, no DCP service) copies only the native POST geometry.  With its
+ * capability word the guest must offer one mode, refuse every scaled
+ * commit and never touch DEST_ORIGIN/DEST_SIZE. */
+static void test_soft_broker_keeps_exactly_one_mode(void) {
+  FAKE_BROKER fake;
+  APPLE_AGX_FIXED_PANEL panel = make_panel(&fake, SOFT_BROKER_CAPS);
+  APPLE_AGX_FIXED_PANEL_SOURCE_MODE mode;
+  APPLE_AGX_SCANOUT_U32 i;
+
+  assert((SOFT_BROKER_CAPS & APPLE_AGX_SCANOUT_CAP_SCALED_SOURCE) == 0u);
+  assert(!p20_selects_hv(SOFT_BROKER_CAPS));
+  assert(!AppleAgxFixedPanelScaledSourceSupported(&panel));
+  assert(AppleAgxFixedPanelSourceModeCount(APPLE_AGX_SCANOUT_FALSE) == 1u);
+  assert(AppleAgxFixedPanelSourceModeAt(0u, APPLE_AGX_SCANOUT_FALSE, &mode));
+  assert(mode.Width == NATIVE_W && mode.Height == NATIVE_H &&
+         mode.Stride == 7680u && mode.SurfaceBytes == 0x7e9000ULL);
+  assert(!AppleAgxFixedPanelSourceModeAt(1u, APPLE_AGX_SCANOUT_FALSE, &mode));
+  for (i = 1u; i < APPLE_AGX_FIXED_PANEL_MODE_COUNT; ++i) {
+    const APPLE_AGX_SCANOUT_U32 w = AppleAgxFixedPanelModeSizes[i][0];
+    const APPLE_AGX_SCANOUT_U32 h = AppleAgxFixedPanelModeSizes[i][1];
+    assert(!AppleAgxFixedPanelSourceModeFind(w, h, w * 4u,
+                                             APPLE_AGX_SCANOUT_FALSE, 0));
+    assert(AppleAgxFixedPanelCommitMode(
+               &panel, 0u, 0u, w, h, w * 4u,
+               APPLE_AGX_SCANOUT_FORMAT_BGRA8888,
+               AppleAgxFixedPanelScalingAspectRatioCenteredMax) ==
+           AppleAgxFixedPanelInvalidMode);
+    assert(AppleAgxFixedPanelCommitMode(
+               &panel, 0u, 0u, w, h, w * 4u,
+               APPLE_AGX_SCANOUT_FORMAT_BGRA8888,
+               AppleAgxFixedPanelScalingCentered) ==
+           AppleAgxFixedPanelInvalidMode);
+  }
+  assert(AppleAgxFixedPanelCommit(&panel, 0u, 0u, NATIVE_W, NATIVE_H, 7680u,
+                                  APPLE_AGX_SCANOUT_FORMAT_BGRA8888) ==
+         AppleAgxFixedPanelOk);
+  assert(queue_latched(&panel, 0x1000000ULL) == AppleAgxFixedPanelOk);
+  assert(fake.Width == NATIVE_W && fake.Height == NATIVE_H &&
+         fake.Stride == 7680u && fake.SurfaceSize == 0x7e9000ULL);
+  assert(fake.DestWrites == 0u);
+}
+
+/* WHAT REAL BUG OR INVARIANT WILL THIS TEST CATCH?  The new HV (0x37f) must
+ * still be picked by the P20 probe, and with CAP_SCALED_SOURCE every scaled
+ * commit must reach the broker with its own geometry plus the centred
+ * rectangle inside 1920x1080; the native commit writes the full rectangle. */
+static void test_hv_scaled_service_carries_geometry_and_rectangle(void) {
+  FAKE_BROKER fake;
+  APPLE_AGX_FIXED_PANEL panel = make_panel(&fake, HV_SCALED_CAPS);
+  APPLE_AGX_SCANOUT_U32 i;
+  const APPLE_AGX_SCANOUT_U64 tail = POOL_BYTES - 0x200000ULL;
+
+  assert(p20_selects_hv(HV_SCALED_CAPS));
+  assert((HV_SCALED_CAPS & APPLE_AGX_SCANOUT_CAP_SCALED_SOURCE) != 0u);
+  assert(AppleAgxFixedPanelScaledSourceSupported(&panel));
+  assert(AppleAgxFixedPanelSourceModeCount(APPLE_AGX_SCANOUT_TRUE) ==
+         APPLE_AGX_FIXED_PANEL_MODE_COUNT);
+  for (i = 1u; i < APPLE_AGX_FIXED_PANEL_MODE_COUNT; ++i) {
+    const APPLE_AGX_SCANOUT_U32 w = expected[i].W, h = expected[i].H;
+    fake.DestWrites = 0u;
+    /* identity is native-only */
+    assert(AppleAgxFixedPanelCommitMode(
+               &panel, 0u, 0u, w, h, w * 4u,
+               APPLE_AGX_SCANOUT_FORMAT_BGRA8888,
+               AppleAgxFixedPanelScalingIdentity) ==
+           AppleAgxFixedPanelInvalidMode);
+    /* a padded stride is not an offered geometry */
+    assert(AppleAgxFixedPanelCommitMode(
+               &panel, 0u, 0u, w, h, w * 4u + 64u,
+               APPLE_AGX_SCANOUT_FORMAT_BGRA8888,
+               AppleAgxFixedPanelScalingAspectRatioCenteredMax) ==
+           AppleAgxFixedPanelInvalidMode);
+    assert(AppleAgxFixedPanelCommitMode(
+               &panel, 0u, 0u, w, h, w * 4u,
+               APPLE_AGX_SCANOUT_FORMAT_BGRA8888,
+               AppleAgxFixedPanelScalingAspectRatioCenteredMax) ==
+           AppleAgxFixedPanelOk);
+    assert(queue_latched(&panel, 0x1000000ULL) == AppleAgxFixedPanelOk);
+    assert(fake.Width == w && fake.Height == h && fake.Stride == w * 4u &&
+           fake.SurfaceSize == (APPLE_AGX_SCANOUT_U64)w * 4u * h);
+    assert(fake.Format == APPLE_AGX_SCANOUT_FORMAT_BGRA8888);
+    assert(fake.DestWrites == 2u);
+    assert(fake.DestOrigin == (expected[i].X | (expected[i].Y << 16u)));
+    assert(fake.DestSize == (expected[i].RW | (expected[i].RH << 16u)));
+    /* stretched fills the native rectangle */
+    assert(AppleAgxFixedPanelCommitMode(
+               &panel, 0u, 0u, w, h, w * 4u,
+               APPLE_AGX_SCANOUT_FORMAT_BGRA8888,
+               AppleAgxFixedPanelScalingStretched) == AppleAgxFixedPanelOk);
+    assert(panel.Scanout.PresentDestOrigin == 0u &&
+           panel.Scanout.PresentDestSize == (NATIVE_W | (NATIVE_H << 16u)));
+  }
+  /* 1280x720 centered (no scale): 640x360 offset, 1:1 size. */
+  assert(AppleAgxFixedPanelCommitMode(
+             &panel, 0u, 0u, 1280u, 720u, 5120u,
+             APPLE_AGX_SCANOUT_FORMAT_BGRA8888,
+             AppleAgxFixedPanelScalingCentered) == AppleAgxFixedPanelOk);
+  assert(panel.Scanout.PresentDestOrigin == (320u | (180u << 16u)) &&
+         panel.Scanout.PresentDestSize == (1280u | (720u << 16u)));
+  /* The surface bound follows the committed mode: 800x600 fits in the
+   * last 2 MiB of the pool, the native primary does not. */
+  assert(AppleAgxFixedPanelCommitMode(
+             &panel, 0u, 0u, 800u, 600u, 3200u,
+             APPLE_AGX_SCANOUT_FORMAT_BGRA8888,
+             AppleAgxFixedPanelScalingAspectRatioCenteredMax) ==
+         AppleAgxFixedPanelOk);
+  assert(queue_latched(&panel, tail) ==
+         AppleAgxFixedPanelOk);
+  /* Native on the scaled service: identity, full rectangle. */
+  assert(AppleAgxFixedPanelCommit(&panel, 0u, 0u, NATIVE_W, NATIVE_H, 7680u,
+                                  APPLE_AGX_SCANOUT_FORMAT_BGRA8888) ==
+         AppleAgxFixedPanelOk);
+  assert(queue_latched(&panel, tail) ==
+         AppleAgxFixedPanelInvalidSurface);
+  fake.DestWrites = 0u;
+  assert(queue_latched(&panel, 0x1000000ULL) == AppleAgxFixedPanelOk);
+  assert(fake.Width == NATIVE_W && fake.Height == NATIVE_H &&
+         fake.Stride == 7680u && fake.SurfaceSize == 0x7e9000ULL);
+  assert(fake.DestWrites == 2u && fake.DestOrigin == 0u &&
+         fake.DestSize == (NATIVE_W | (NATIVE_H << 16u)));
+  /* 0x37f has no CAP_RGBA8888 (bit 7): an RGBA commit is refused. */
+  assert((HV_SCALED_CAPS & APPLE_AGX_SCANOUT_CAP_RGBA8888) == 0u);
+  assert(AppleAgxFixedPanelCommit(&panel, 0u, 0u, NATIVE_W, NATIVE_H, 7680u,
+                                  APPLE_AGX_SCANOUT_FORMAT_RGBA8888) ==
+         AppleAgxFixedPanelInvalidMode);
+}
+
+/* WHAT REAL BUG OR INVARIANT WILL THIS TEST CATCH?  The P20 probe must keep
+ * the older HV (no scaled sources, 0x27f) on the service path, and must not
+ * pick a broker without display power (0x17f) or the soft caps. */
+static void test_p20_probe_selection(void) {
+  assert(p20_selects_hv(0x27fu));
+  assert(p20_selects_hv(0x37fu));
+  assert(p20_selects_hv(0x3ffu));
+  assert(!p20_selects_hv(0x17fu));
+  assert(!p20_selects_hv(0x07fu));
+  assert(!p20_selects_hv(0x33fu)); /* no LATCHED_IRQ */
+}
+
+int main(void) {
+  test_j274_table_passes_every_gate();
+  test_soft_broker_keeps_exactly_one_mode();
+  test_hv_scaled_service_carries_geometry_and_rectangle();
+  test_p20_probe_selection();
+  return 0;
+}
