+static KSTART_ROUTINE AdmissionScanoutSoftThread;
+
+_Use_decl_annotations_ static VOID AdmissionScanoutSoftThread(PVOID Opaque) {
+  ADMISSION_SCANOUT_RUNTIME *R = Opaque;
+  (void)KeSetPriorityThread(KeGetCurrentThread(), LOW_REALTIME_PRIORITY);
+  for (;;) {
+    (void)KeWaitForSingleObject(&R->SoftWake, Executive, KernelMode, FALSE, NULL);
+    if (InterlockedCompareExchange(&R->SoftThreadStop, 0, 0) != 0)
