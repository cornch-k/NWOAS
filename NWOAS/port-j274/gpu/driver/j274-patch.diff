+  LONGLONG t0, t1;
+  if (parts - 1u > R->SoftHelpersLive)
+    parts = 1u;
+  t0 = KeQueryPerformanceCounter(NULL).QuadPart;
+  R->SoftJobParts = parts;
+  InterlockedExchange64(&R->SoftJobOffset, (LONG64)Offset);
+  for (i = 0u; i + 1u < parts; ++i)
+    (void)KeSetEvent(&R->SoftHelper[i].Go, IO_NO_INCREMENT, FALSE);
+  AdmissionScanoutSoftRowSlice(0u, parts, &row0, &row1);
+  AdmissionScanoutSoftCopyRows(R, Offset, row0, row1);
+  for (i = 0u; i + 1u < parts; ++i)
+    (void)KeWaitForSingleObject(&R->SoftHelper[i].Done, Executive,
+                                KernelMode, FALSE, NULL);
+  t1 = KeQueryPerformanceCounter(NULL).QuadPart;
+  AdmissionScanoutSoftStat(R, t0, t1);
+  if (R->SoftOverlay) {
+    const volatile ULONG *src0 = (const volatile ULONG *)(R->SoftPool + Offset);
+    ULONG nz = 0u, x;
