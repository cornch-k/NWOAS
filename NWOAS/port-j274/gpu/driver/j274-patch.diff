+static VOID AdmissionScanoutSoftRowSlice(ULONG Part, ULONG Parts,
+                                         ULONG *Row0, ULONG *Row1) {
+  *Row0 = APPLE_AGX_SCANOUT_J313_HEIGHT * Part / Parts;
+  *Row1 = APPLE_AGX_SCANOUT_J313_HEIGHT * (Part + 1u) / Parts;
