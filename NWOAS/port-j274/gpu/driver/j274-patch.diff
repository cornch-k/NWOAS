+static KDEFERRED_ROUTINE AdmissionScanoutSoftLatchDpc;
+
+/* After the pending flip is recorded: raise LATCHED and run the ISR path. */
+static VOID AdmissionScanoutSoftKick(ADMISSION_SCANOUT_RUNTIME *R) {
+  if (InterlockedCompareExchange(&R->SoftCopyPending, 0, 0) != 0)
+    (void)KeInsertQueueDpc(&R->SoftWakeDpc, NULL, NULL);
+}
