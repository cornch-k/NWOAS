+static KSTART_ROUTINE AdmissionScanoutSoftHelperThread;
+
+_Use_decl_annotations_ static VOID AdmissionScanoutSoftHelperThread(PVOID Opaque) {
+  ADMISSION_SCANOUT_SOFT_HELPER *h = Opaque;
+  ULONG row0, row1;
+  (void)KeSetPriorityThread(KeGetCurrentThread(), LOW_REALTIME_PRIORITY);
+  if (h->R->SoftFastCpus != 0)
+    (void)KeSetSystemAffinityThreadEx(h->R->SoftFastCpus);
+  for (;;) {
+    (void)KeWaitForSingleObject(&h->Go, Executive, KernelMode, FALSE, NULL);
+    if (InterlockedCompareExchange(&h->R->SoftThreadStop, 0, 0) != 0)
+      break;
+    AdmissionScanoutSoftRowSlice(h->Index + 1u, h->R->SoftJobParts,
+                                 &row0, &row1);
+    AdmissionScanoutSoftCopyRows(
+        h->R, (ULONGLONG)InterlockedCompareExchange64(&h->R->SoftJobOffset, 0, 0),
+        row0, row1);
+    (void)KeSetEvent(&h->Done, IO_NO_INCREMENT, FALSE);
+  }
+  PsTerminateSystemThread(STATUS_SUCCESS);
+}
+
+static ULONG AdmissionScanoutSoftParts(ULONG Mode) {
+  return Mode == 2u ? 8u : Mode == 1u ? 4u : 1u;
+}
+
+/* Thread only (PASSIVE). */
+static VOID AdmissionScanoutSoftCopy(ADMISSION_SCANOUT_RUNTIME *R,
+                                     ULONGLONG Offset) {
+  ULONG i, row0, row1, parts = AdmissionScanoutSoftParts(R->SoftMode);
+  LONGLONG t0, t1;
+  if (parts - 1u > R->SoftHelpersLive)
+    parts = 1u;
+  t0 = KeQueryPerformanceCounter(NULL).QuadPart;
+  R->SoftJobParts = parts;
+  InterlockedExchange64(&R->SoftJobOffset, (LONG64)Offset);
+  for (i = 0u; i + 1u < parts; ++i)
+    (void)KeSetEvent(&R->SoftHelper[i].Go, IO_NO_INCREMENT, FALSE);
+  AdmissionScanoutSoftRowSlice(0u, parts, &row0, &row1);
+  AdmissionScanoutSoftCopyRows(R, Offset, row0, row1);
+  for (i = 0u; i + 1u < parts; ++i)
+    (void)KeWaitForSingleObject(&R->SoftHelper[i].Done, Executive,
+                                KernelMode, FALSE, NULL);
+  t1 = KeQueryPerformanceCounter(NULL).QuadPart;
+  AdmissionScanoutSoftStat(R, t0, t1);
+  if (R->SoftOverlay) {
+    const volatile ULONG *src0 = (const volatile ULONG *)(R->SoftPool + Offset);
+    ULONG nz = 0u, x;
+    for (x = 0u; x < APPLE_AGX_SCANOUT_J313_WIDTH; ++x)
+      if ((src0[x] & 0x00ffffffu) != 0u) ++nz;
+    AdmissionScanoutSoftBar(R, 16u, (ULONG)(R->SoftCopies * 8u % 1920u) + 8u, 0xffff00ffu);
+    AdmissionScanoutSoftBar(R, 32u, nz, 0xffffff00u);
+  }
+}
+
+static KSTART_ROUTINE AdmissionScanoutSoftThread;
+
+_Use_decl_annotations_ static VOID AdmissionScanoutSoftThread(PVOID Opaque) {
+  ADMISSION_SCANOUT_RUNTIME *R = Opaque;
+  (void)KeSetPriorityThread(KeGetCurrentThread(), LOW_REALTIME_PRIORITY);
+  if (R->SoftFastCpus != 0)
+    (void)KeSetSystemAffinityThreadEx(R->SoftFastCpus);
+  for (;;) {
+    (void)KeWaitForSingleObject(&R->SoftWake, Executive, KernelMode, FALSE, NULL);
+    if (InterlockedCompareExchange(&R->SoftThreadStop, 0, 0) != 0)
+      break;
+    {
+      LONG blank = InterlockedExchange(&R->SoftBlankRequest, 0);
+      if (blank == 1) {
+        ULONG row;
+        for (row = 0u; row < APPLE_AGX_SCANOUT_J313_HEIGHT; ++row)
+          RtlZeroMemory((PVOID)(R->SoftFb + (SIZE_T)row * R->SoftFbPitch),
+                        (SIZE_T)APPLE_AGX_SCANOUT_J313_WIDTH * 4u);
+      } else if (blank == 2 && R->SoftState == APPLE_AGX_SCANOUT_STATE_ACTIVE) {
+        AdmissionScanoutSoftCopyRows(R, R->SoftActiveOffset, 0u,
+                                     APPLE_AGX_SCANOUT_J313_HEIGHT);
+      }
+    }
+    while (InterlockedExchange(&R->SoftCopyPending, 0) != 0) {
+      ULONGLONG offset = (ULONGLONG)InterlockedCompareExchange64(&R->SoftCopyOffset, 0, 0);
+      LONG64 seq = InterlockedCompareExchange64(&R->SoftCopySeq, 0, 0);
+      AdmissionScanoutSoftCopy(R, offset);
+      InterlockedExchange64(&R->SoftLatched, seq);
+      InterlockedExchange(&R->SoftLatchPending, 1);
+      if (InterlockedCompareExchange(&R->Stopping, 0, 0) == 0)
+        (void)KeInsertQueueDpc(&R->SoftLatchDpc, NULL, NULL);
+    }
+  }
+  PsTerminateSystemThread(STATUS_SUCCESS);
+}
