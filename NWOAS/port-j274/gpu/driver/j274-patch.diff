+static KDEFERRED_ROUTINE AdmissionScanoutSoftWakeDpc;
+
+_Use_decl_annotations_ static VOID AdmissionScanoutSoftWakeDpc(
+    KDPC *Dpc, PVOID Opaque, PVOID Arg1, PVOID Arg2) {
+  ADMISSION_SCANOUT_RUNTIME *R = Opaque;
+  UNREFERENCED_PARAMETER(Dpc);
+  UNREFERENCED_PARAMETER(Arg1);
+  UNREFERENCED_PARAMETER(Arg2);
+  if (R != NULL)
+    (void)KeSetEvent(&R->SoftWake, IO_NO_INCREMENT, FALSE);
+}
