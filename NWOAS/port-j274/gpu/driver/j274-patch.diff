+/* PASSIVE.  Adopt only the exact POST geometry the J274 build offers. */
+static NTSTATUS AdmissionScanoutSoftMap(ADMISSION_CONTEXT *Context,
+                                        ADMISSION_SCANOUT_RUNTIME *R,
+                                        const ADMISSION_SCANOUT_MEMORY_VIEW *Memory) {
+  const DXGK_DISPLAY_INFORMATION *post = &Context->PostDisplayInformation;
+  PHYSICAL_ADDRESS pa;
+  if (post->Width != APPLE_AGX_SCANOUT_J313_WIDTH ||
+      post->Height != APPLE_AGX_SCANOUT_J313_HEIGHT ||
+      post->Pitch < APPLE_AGX_SCANOUT_J313_WIDTH * 4u ||
+      post->PhysicAddress.QuadPart == 0 ||
+      (post->ColorFormat != D3DDDIFMT_A8R8G8B8 &&
+       post->ColorFormat != D3DDDIFMT_X8R8G8B8))
+    return STATUS_GRAPHICS_INVALID_DISPLAY_ADAPTER;
+  AdmissionScanoutSoftOptions(Context, R);
+  R->SoftFbPitch = post->Pitch;
+  R->SoftFbBytes = (SIZE_T)post->Pitch * post->Height;
+  R->SoftFb = (volatile UCHAR *)MmMapIoSpaceEx(
+      post->PhysicAddress, R->SoftFbBytes, PAGE_READWRITE | PAGE_WRITECOMBINE);
+  if (R->SoftFb == NULL)
+    return STATUS_INSUFFICIENT_RESOURCES;
+  pa.QuadPart = (LONGLONG)Memory->GuestIpaAddress;
+  R->SoftPoolIpa = Memory->GuestIpaAddress;
+  R->SoftPoolBytes = (SIZE_T)Memory->PoolBytes;
+  R->SoftPool = (volatile UCHAR *)MmMapIoSpaceEx(
+      pa, R->SoftPoolBytes,
+      R->SoftPoolCached ? PAGE_READWRITE : (PAGE_READWRITE | PAGE_WRITECOMBINE));
+  if (R->SoftPool == NULL) {
+    AdmissionScanoutSoftUnmap(R);
+    return STATUS_INSUFFICIENT_RESOURCES;
+  }
+  R->SoftState = APPLE_AGX_SCANOUT_STATE_UNREGISTERED;
+  AdmissionScanoutSoftBench(Context, R);
+  {
+    LARGE_INTEGER f;
+    (void)KeQueryPerformanceCounter(&f);
+    R->SoftQpcFreq = f.QuadPart;
+  }
+  KeInitializeEvent(&R->SoftWake, SynchronizationEvent, FALSE);
+  KeInitializeDpc(&R->SoftWakeDpc, AdmissionScanoutSoftWakeDpc, R);
+  {
+    HANDLE thread = NULL;
+    OBJECT_ATTRIBUTES attributes;
+    NTSTATUS status;
+    InitializeObjectAttributes(&attributes, NULL, OBJ_KERNEL_HANDLE, NULL, NULL);
+    status = PsCreateSystemThread(&thread, THREAD_ALL_ACCESS, &attributes,
+                                  NULL, NULL, AdmissionScanoutSoftThread, R);
+    if (!NT_SUCCESS(status)) {
+      AdmissionScanoutSoftUnmap(R);
+      return status;
+    }
+    R->SoftThread = thread;
+  }
+  {
+    ULONG i;
+    for (i = 0u; i < ADMISSION_SOFT_HELPERS; ++i) {
+      HANDLE helper = NULL;
+      OBJECT_ATTRIBUTES helperAttributes;
+      R->SoftHelper[i].R = R;
+      R->SoftHelper[i].Index = i;
+      KeInitializeEvent(&R->SoftHelper[i].Go, SynchronizationEvent, FALSE);
+      KeInitializeEvent(&R->SoftHelper[i].Done, SynchronizationEvent, FALSE);
+      InitializeObjectAttributes(&helperAttributes, NULL, OBJ_KERNEL_HANDLE,
+                                 NULL, NULL);
+      if (!NT_SUCCESS(PsCreateSystemThread(&helper, THREAD_ALL_ACCESS,
+              &helperAttributes, NULL, NULL, AdmissionScanoutSoftHelperThread,
+              &R->SoftHelper[i])))
+        break;
+      R->SoftHelper[i].Thread = helper;
+      R->SoftHelpersLive++;
+    }
+  }
+  if (R->SoftOverlay)
+    AdmissionScanoutSoftBar(R, 0u, APPLE_AGX_SCANOUT_J313_WIDTH, 0xff00ff00u);
+  return STATUS_SUCCESS;
+}
