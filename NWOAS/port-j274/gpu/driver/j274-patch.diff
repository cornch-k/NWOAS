+/* PRESENT: linear BGRA8888 rows of the pool surface into the framebuffer.
+ * Both mappings are non-paged write-combined, so any IRQL may copy. */
+
+/* NWOAS-J274 P15 debug overlay (diagnostic build 2745): rows 0-15 green at
+ * start, rows 16-31 magenta bar = present count * 8 px, rows 32-47 yellow bar
+ * = non-zero pixels in the first source row.  Removed once scanout works. */
+static VOID AdmissionScanoutSoftBar(ADMISSION_SCANOUT_RUNTIME *R, ULONG Row0,
+                                    ULONG Width, ULONG Color) {
+  ULONG y, x;
+  if (Width > APPLE_AGX_SCANOUT_J313_WIDTH)
+    Width = APPLE_AGX_SCANOUT_J313_WIDTH;
+  for (y = Row0; y < Row0 + 16u; ++y) {
+    volatile ULONG *line = (volatile ULONG *)(R->SoftFb + (SIZE_T)y * R->SoftFbPitch);
+    for (x = 0u; x < APPLE_AGX_SCANOUT_J313_WIDTH; ++x)
+      line[x] = x < Width ? Color : 0xff202020u;
+  }
+}
+/* NWOAS-J274 P16: the frame copy runs on a PASSIVE system thread.  PRESENT
+ * (reached from SetVidPnSourceAddress, possibly at DIRQL) only validates and
+ * records the surface; SoftKick queues SoftWakeDpc, which sets SoftWake; the
+ * thread copies the newest surface, then publishes LATCHED through
+ * SoftLatchDpc.  Timing goes to NwSoftStats every 128 copies (build 2747). */
+static VOID AdmissionScanoutSoftWriteStats(ADMISSION_SCANOUT_RUNTIME *R) {
+  HANDLE key = NULL;
+  UNICODE_STRING name;
+  if (KeGetCurrentIrql() != PASSIVE_LEVEL || R->Adapter == NULL ||
+      R->Adapter->PhysicalDeviceObject == NULL)
+    return;
+  if (NT_SUCCESS(IoOpenDeviceRegistryKey(R->Adapter->PhysicalDeviceObject,
+          PLUGPLAY_REGKEY_DEVICE, KEY_SET_VALUE, &key))) {
+    RtlInitUnicodeString(&name, L"NwSoftStats");
+    (void)ZwSetValueKey(key, &name, 0, REG_BINARY, R->SoftSnap,
+                        sizeof(R->SoftSnap));
+    ZwClose(key);
+  }
+}
+
+static VOID AdmissionScanoutSoftFillSnap(ADMISSION_SCANOUT_RUNTIME *R) {
+  ULONG i;
+  RtlZeroMemory(R->SoftSnap, sizeof(R->SoftSnap));
+  R->SoftSnap[0] = 0x3150534eULL | (4ULL << 32); /* 'NSP1', version 4 */
+  R->SoftSnap[1] = (ULONGLONG)R->SoftQpcFreq;
+  R->SoftSnap[2] = R->SoftCopies;
+  for (i = 0u; i < ADMISSION_SOFT_MODES; ++i) {
+    R->SoftSnap[3u + 2u * i] = R->SoftModeTicks[i];
+    R->SoftSnap[4u + 2u * i] = R->SoftModeCount[i];
+  }
+  R->SoftSnap[9] = R->SoftGapTicks;
+  R->SoftSnap[10] = R->SoftMode | ((ULONGLONG)R->SoftModeLocked << 8);
+  R->SoftSnap[11] = R->SoftMaxIrql;
+  R->SoftSnap[12] = (ULONGLONG)(ULONG)InterlockedCompareExchange(
+      &R->Adapter->NwPagingStaleDrops, 0, 0) |
+      ((ULONGLONG)(ULONG)InterlockedCompareExchange(
+      &R->Adapter->NwPagingStaleLast, 0, 0) << 32);
+  R->SoftSnap[13] = R->SoftHelpersLive;
+  R->SoftSnap[14] = R->SoftPresentCount;
+  R->SoftSnap[15] = 2756u;
+}
+
+/* Thread only.  Gap = time between successive copies. */
+static VOID AdmissionScanoutSoftStat(ADMISSION_SCANOUT_RUNTIME *R,
+                                     LONGLONG T0, LONGLONG T1) {
+  ULONGLONG copy = (ULONGLONG)(T1 - T0), gap = 0ULL;
+  if (R->SoftLastQpc != 0 && T0 > R->SoftLastQpc)
+    gap = (ULONGLONG)(T0 - R->SoftLastQpc);
+  R->SoftLastQpc = T0;
+  R->SoftCopies++;
+  R->SoftCopyTicks += copy;
+  if (copy > R->SoftCopyMax) R->SoftCopyMax = copy;
+  R->SoftGapTicks += gap;
+  if (gap > R->SoftGapMax) R->SoftGapMax = gap;
+  R->SoftModeTicks[R->SoftMode] += copy;
+  R->SoftModeCount[R->SoftMode]++;
+  if (++R->SoftWinPresents < 128u) return;
+  AdmissionScanoutSoftFillSnap(R);
+  AdmissionScanoutSoftWriteStats(R);
+  R->SoftWinPresents = 0u;
+  if (R->SoftModeLocked)
+    return;
+  if (R->SoftMode + 1u < ADMISSION_SOFT_MODES &&
+      R->SoftHelpersLive == ADMISSION_SOFT_HELPERS) {
+    R->SoftMode++;
+  } else {
+    ULONG i, best = 0u;
+    for (i = 1u; i < ADMISSION_SOFT_MODES; ++i)
+      if (R->SoftModeCount[i] != 0u &&
+          R->SoftModeTicks[i] * R->SoftModeCount[best] <
+              R->SoftModeTicks[best] * R->SoftModeCount[i])
+        best = i;
+    R->SoftMode = best;
+    R->SoftModeLocked = 1u;
+  }
+}
+
+static VOID AdmissionScanoutSoftCopyRows(ADMISSION_SCANOUT_RUNTIME *R,
+                                         ULONGLONG Offset, ULONG Row0,
+                                         ULONG Row1) {
+  ULONG row;
+  for (row = Row0; row < Row1; ++row)
+    RtlCopyMemory((PVOID)(R->SoftFb + (SIZE_T)row * R->SoftFbPitch),
+                  (const VOID *)(R->SoftPool + Offset +
+                                 (SIZE_T)row * APPLE_AGX_SCANOUT_J313_STRIDE),
+                  (SIZE_T)APPLE_AGX_SCANOUT_J313_WIDTH * 4u);
+}
+
+static VOID AdmissionScanoutSoftRowSlice(ULONG Part, ULONG Parts,
+                                         ULONG *Row0, ULONG *Row1) {
+  *Row0 = APPLE_AGX_SCANOUT_J313_HEIGHT * Part / Parts;
+  *Row1 = APPLE_AGX_SCANOUT_J313_HEIGHT * (Part + 1u) / Parts;
+}
