+/* Any IRQL: validate and record; the copy happens on SoftThread. */
+static APPLE_AGX_SCANOUT_U32 AdmissionScanoutSoftPresent(
+    ADMISSION_SCANOUT_RUNTIME *R, LONG64 Seq) {
+  ULONGLONG bytes = (ULONGLONG)R->SoftStride * R->SoftHeight;
+  KIRQL irql = KeGetCurrentIrql();
+  if ((ULONG)irql > R->SoftMaxIrql) R->SoftMaxIrql = (ULONG)irql;
+  if (R->SoftState != APPLE_AGX_SCANOUT_STATE_READY &&
+      R->SoftState != APPLE_AGX_SCANOUT_STATE_ACTIVE)
+    return APPLE_AGX_SCANOUT_BROKER_INVALID_POOL;
+  if (R->SoftFb == NULL || R->SoftPool == NULL || R->SoftThread == NULL ||
+      R->SoftWidth != APPLE_AGX_SCANOUT_J313_WIDTH ||
+      R->SoftHeight != APPLE_AGX_SCANOUT_J313_HEIGHT ||
+      R->SoftStride != APPLE_AGX_SCANOUT_J313_STRIDE ||
+      R->SoftFormat != APPLE_AGX_SCANOUT_FORMAT_BGRA8888 ||
+      R->SoftSurfaceSize < bytes ||
+      (R->SoftSurfaceOffset & (APPLE_AGX_SCANOUT_ALIGNMENT - 1ULL)) != 0ULL ||
+      R->SoftSurfaceOffset > R->SoftPoolBytes ||
+      bytes > R->SoftPoolBytes - R->SoftSurfaceOffset ||
+      (ULONGLONG)R->SoftFbPitch * R->SoftHeight > R->SoftFbBytes ||
+      (ULONGLONG)R->SoftWidth * 4u > R->SoftFbPitch)
+    return APPLE_AGX_SCANOUT_BROKER_INVALID_SURFACE;
+  InterlockedExchange64(&R->SoftCopyOffset, (LONG64)R->SoftSurfaceOffset);
+  InterlockedExchange64(&R->SoftCopySeq, Seq);
+  if (InterlockedExchange(&R->SoftCopyPending, 1) != 0)
+    R->SoftCoalesced++;
+  R->SoftActiveOffset = R->SoftSurfaceOffset;
+  if (++R->SoftSwapId == 0u)
+    R->SoftSwapId = 1u;
+  R->SoftState = APPLE_AGX_SCANOUT_STATE_ACTIVE;
+  R->SoftPresentCount++;
+  return APPLE_AGX_SCANOUT_BROKER_OK;
+}
+
+static VOID AdmissionScanoutSoftCommand(ADMISSION_SCANOUT_RUNTIME *R,
+                                        APPLE_AGX_SCANOUT_U32 Command) {
+  ULONGLONG seq = R->SoftRequestSequence;
+  APPLE_AGX_SCANOUT_U32 result = APPLE_AGX_SCANOUT_BROKER_OK;
+  if (seq == 0ULL ||
+      seq <= (ULONGLONG)InterlockedCompareExchange64(&R->SoftReceipt, 0, 0)) {
+    R->SoftResult = APPLE_AGX_SCANOUT_BROKER_STALE_SEQUENCE;
+    R->SoftRejected++;
+    return;
+  }
+  switch (Command) {
+  case APPLE_AGX_SCANOUT_CMD_QUERY:
+    break;
+  case APPLE_AGX_SCANOUT_CMD_REGISTER_POOL:
+    if (R->SoftState != APPLE_AGX_SCANOUT_STATE_UNREGISTERED)
+      result = APPLE_AGX_SCANOUT_BROKER_BUSY;
+    else if (R->SoftPool == NULL || R->SoftFb == NULL ||
+             R->SoftReqPoolIpa != R->SoftPoolIpa ||
+             R->SoftReqPoolSize == 0ULL ||
+             R->SoftReqPoolSize > R->SoftPoolBytes)
+      result = APPLE_AGX_SCANOUT_BROKER_INVALID_POOL;
+    else
+      R->SoftState = APPLE_AGX_SCANOUT_STATE_READY;
+    break;
+  case APPLE_AGX_SCANOUT_CMD_PRESENT:
+    /* LATCHED follows from SoftThread once the copy is done. */
+    result = AdmissionScanoutSoftPresent(R, (LONG64)seq);
+    break;
+  case APPLE_AGX_SCANOUT_CMD_RELEASE:
+    R->SoftState = APPLE_AGX_SCANOUT_STATE_UNREGISTERED;
+    break;
+  default:
+    result = APPLE_AGX_SCANOUT_BROKER_INVALID_COMMAND;
+    break;
+  }
+  R->SoftResult = result;
+  if (result == APPLE_AGX_SCANOUT_BROKER_OK) {
+    InterlockedExchange64(&R->SoftApplied, (LONG64)seq);
+    R->SoftAccepted++;
+  } else {
+    R->SoftRejected++;
+  }
+  InterlockedExchange64(&R->SoftReceipt, (LONG64)seq);
+}
+
+static VOID AdmissionScanoutSoftWrite32(ADMISSION_SCANOUT_RUNTIME *R,
+                                        APPLE_AGX_SCANOUT_U32 Reg,
+                                        APPLE_AGX_SCANOUT_U32 Value) {
+  switch (Reg) {
+  case APPLE_AGX_SCANOUT_REG_IRQ_STATUS:
+    InterlockedAnd(&R->SoftIrqStatus, ~(LONG)Value);
+    break;
+  case APPLE_AGX_SCANOUT_REG_IRQ_ENABLE: R->SoftIrqEnable = Value; break;
+  case APPLE_AGX_SCANOUT_REG_WIDTH: R->SoftWidth = Value; break;
+  case APPLE_AGX_SCANOUT_REG_HEIGHT: R->SoftHeight = Value; break;
+  case APPLE_AGX_SCANOUT_REG_STRIDE: R->SoftStride = Value; break;
+  case APPLE_AGX_SCANOUT_REG_FORMAT: R->SoftFormat = Value; break;
+  case APPLE_AGX_SCANOUT_REG_COMMAND: AdmissionScanoutSoftCommand(R, Value); break;
+  default: break;
+  }
+}
+
+static VOID AdmissionScanoutSoftWrite64(ADMISSION_SCANOUT_RUNTIME *R,
+                                        APPLE_AGX_SCANOUT_U32 Reg,
+                                        APPLE_AGX_SCANOUT_U64 Value) {
+  switch (Reg) {
+  case APPLE_AGX_SCANOUT_REG_POOL_IPA: R->SoftReqPoolIpa = Value; break;
+  case APPLE_AGX_SCANOUT_REG_POOL_SIZE: R->SoftReqPoolSize = Value; break;
+  case APPLE_AGX_SCANOUT_REG_SURFACE_OFFSET: R->SoftSurfaceOffset = Value; break;
+  case APPLE_AGX_SCANOUT_REG_SURFACE_SIZE: R->SoftSurfaceSize = Value; break;
+  case APPLE_AGX_SCANOUT_REG_REQUEST_SEQUENCE: R->SoftRequestSequence = Value; break;
+  default: break;
+  }
+}
+
+static VOID AdmissionScanoutSoftUnmap(ADMISSION_SCANOUT_RUNTIME *R) {
+  /* PASSIVE (start unwind / stop).  Stop the copy thread before unmapping. */
+  if (R->SoftThread != NULL) {
+    InterlockedExchange(&R->SoftThreadStop, 1);
+    (void)KeSetEvent(&R->SoftWake, IO_NO_INCREMENT, FALSE);
+    {
+      PVOID object = NULL;
+      if (NT_SUCCESS(ObReferenceObjectByHandle(R->SoftThread, SYNCHRONIZE,
+              *PsThreadType, KernelMode, &object, NULL))) {
+        (void)KeWaitForSingleObject(object, Executive, KernelMode, FALSE, NULL);
+        ObDereferenceObject(object);
+      }
+    }
+    ZwClose(R->SoftThread);
+    R->SoftThread = NULL;
+    {
+      ULONG i;
+      for (i = 0u; i < ADMISSION_SOFT_HELPERS; ++i) {
+        PVOID object = NULL;
+        if (R->SoftHelper[i].Thread == NULL)
+          continue;
+        (void)KeSetEvent(&R->SoftHelper[i].Go, IO_NO_INCREMENT, FALSE);
+        if (NT_SUCCESS(ObReferenceObjectByHandle(R->SoftHelper[i].Thread,
+                SYNCHRONIZE, *PsThreadType, KernelMode, &object, NULL))) {
+          (void)KeWaitForSingleObject(object, Executive, KernelMode, FALSE, NULL);
+          ObDereferenceObject(object);
+        }
+        ZwClose(R->SoftHelper[i].Thread);
+        R->SoftHelper[i].Thread = NULL;
+      }
+      R->SoftHelpersLive = 0u;
+    }
+    (void)KeRemoveQueueDpc(&R->SoftWakeDpc);
+    (void)KeRemoveQueueDpc(&R->SoftLatchDpc);
+    KeFlushQueuedDpcs();
+    if (R->SoftCopies != 0u) {
+      AdmissionScanoutSoftFillSnap(R);
+      AdmissionScanoutSoftWriteStats(R);
+    }
+  }
+  if (R->SoftFb != NULL)
+    MmUnmapIoSpace((PVOID)R->SoftFb, R->SoftFbBytes);
+  if (R->SoftPool != NULL)
+    MmUnmapIoSpace((PVOID)R->SoftPool, R->SoftPoolBytes);
+  R->SoftFb = NULL;
+  R->SoftPool = NULL;
+}
+
+/* PASSIVE.  NwScanoutPath = 1 hypervisor service / 2 driver soft broker;
+ * NwScanoutHwCaps = the broker capabilities read at start. */
+static VOID AdmissionScanoutRecordPath(ADMISSION_CONTEXT *Context, ULONG Path,
+                                       ULONG Caps) {
+  HANDLE key = NULL;
+  UNICODE_STRING name;
+  if (KeGetCurrentIrql() != PASSIVE_LEVEL ||
+      !NT_SUCCESS(IoOpenDeviceRegistryKey(Context->PhysicalDeviceObject,
+          PLUGPLAY_REGKEY_DEVICE, KEY_SET_VALUE, &key)))
+    return;
+  RtlInitUnicodeString(&name, L"NwScanoutPath");
+  (void)ZwSetValueKey(key, &name, 0, REG_DWORD, &Path, sizeof(Path));
+  RtlInitUnicodeString(&name, L"NwScanoutHwCaps");
+  (void)ZwSetValueKey(key, &name, 0, REG_DWORD, &Caps, sizeof(Caps));
+  ZwClose(key);
+}
+
+static ULONG AdmissionScanoutSoftReadDword(HANDLE Key, PCWSTR Name) {
+  UNICODE_STRING name;
+  UCHAR buffer[sizeof(KEY_VALUE_PARTIAL_INFORMATION) + sizeof(ULONG)];
+  KEY_VALUE_PARTIAL_INFORMATION *info = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+  ULONG got = 0u, value = 0u;
+  RtlInitUnicodeString(&name, Name);
+  if (NT_SUCCESS(ZwQueryValueKey(Key, &name, KeyValuePartialInformation,
+                                 info, sizeof(buffer), &got)) &&
+      info->Type == REG_DWORD && info->DataLength == sizeof(ULONG))
+    RtlCopyMemory(&value, info->Data, sizeof(value));
+  return value;
+}
+
+/* PASSIVE.  Device-key options; absent means 0. */
+static VOID AdmissionScanoutSoftOptions(ADMISSION_CONTEXT *Context,
+                                        ADMISSION_SCANOUT_RUNTIME *R) {
+  HANDLE key = NULL;
+  R->SoftPoolCached = 0u;
+  R->SoftOverlay = 0u;
+  if (!NT_SUCCESS(IoOpenDeviceRegistryKey(Context->PhysicalDeviceObject,
+          PLUGPLAY_REGKEY_DEVICE, KEY_READ, &key)))
+    return;
+  R->SoftPoolCached = AdmissionScanoutSoftReadDword(key, L"NwSoftPoolCached") ? 1u : 0u;
+  R->SoftOverlay = AdmissionScanoutSoftReadDword(key, L"NwSoftOverlay") ? 1u : 0u;
+  R->SoftForce = AdmissionScanoutSoftReadDword(key, L"NwSoftForce") ? 1u : 0u;
+  ZwClose(key);
+}
+
+/* build 2750: one-shot read benchmark at start (PASSIVE), NwSoftBench =
+ * {magic|version, QPC frequency, ticks: RAM->RAM, pool (current map)->RAM,
+ * pool fresh cached map->RAM, pool fresh WC map->RAM, pool fresh nocache
+ * map->RAM, status bits}.  Each read is 8 MB, timed on the second pass. */
+static LONGLONG AdmissionScanoutSoftBenchRead(PUCHAR Dst, const volatile UCHAR *Src,
+                                              SIZE_T Bytes) {
+  LONGLONG t0, t1;
+  ULONG pass;
+  t0 = t1 = 0;
+  for (pass = 0u; pass < 2u; ++pass) {
+    t0 = KeQueryPerformanceCounter(NULL).QuadPart;
+    RtlCopyMemory(Dst, (const VOID *)Src, Bytes);
+    t1 = KeQueryPerformanceCounter(NULL).QuadPart;
+  }
+  return t1 - t0;
+}
+
+static VOID AdmissionScanoutSoftBench(ADMISSION_CONTEXT *Context,
+                                      ADMISSION_SCANOUT_RUNTIME *R) {
+  const SIZE_T bytes = (SIZE_T)APPLE_AGX_SCANOUT_J313_WIDTH * 4u * APPLE_AGX_SCANOUT_J313_HEIGHT;
+  ULONGLONG out[64];
+  PUCHAR a, b;
+  PHYSICAL_ADDRESS pa;
+  volatile UCHAR *m;
+  HANDLE key = NULL;
+  UNICODE_STRING name;
+  LARGE_INTEGER f;
+  static const ULONG protect[3] = {
+      PAGE_READWRITE, PAGE_READWRITE | PAGE_WRITECOMBINE,
+      PAGE_READWRITE | PAGE_NOCACHE};
+  ULONG i;
+  RtlZeroMemory(out, sizeof(out));
+  out[0] = 0x3142534eULL | (1ULL << 32); /* 'NSB1' */
+  (void)KeQueryPerformanceCounter(&f);
+  out[1] = (ULONGLONG)f.QuadPart;
+  a = (PUCHAR)ExAllocatePool2(POOL_FLAG_NON_PAGED, bytes, ADMISSION_SCANOUT_TAG);
+  b = (PUCHAR)ExAllocatePool2(POOL_FLAG_NON_PAGED, bytes, ADMISSION_SCANOUT_TAG);
+  if (a != NULL && b != NULL && R->SoftPool != NULL && R->SoftPoolBytes >= bytes) {
+    out[2] = (ULONGLONG)AdmissionScanoutSoftBenchRead(a, b, bytes);
+    out[3] = (ULONGLONG)AdmissionScanoutSoftBenchRead(a, R->SoftPool, bytes);
+    pa.QuadPart = (LONGLONG)R->SoftPoolIpa;
+    for (i = 0u; i < 3u; ++i) {
+      m = (volatile UCHAR *)MmMapIoSpaceEx(pa, bytes, protect[i]);
+      if (m == NULL) {
+        out[7] |= 1ULL << i;
+        continue;
+      }
+      out[4u + i] = (ULONGLONG)AdmissionScanoutSoftBenchRead(a, m, bytes);
+      MmUnmapIoSpace((PVOID)m, bytes);
+    }
+    /* build 2752: pinned to each CPU: out[8+i] pool read, out[24+i] RAM
+     * copy, out[40+i] integer loop ticks; out[56] EfficiencyClass bytes
+     * (CPU 0-7), out[57] fast mask, out[58] CPU count.  Fast = pool read
+     * within 1.5x of the fastest CPU (2751: CPU 0-3 5.7 ms, 4-7 34.6 ms,
+     * all EfficiencyClass 0). */
+    {
+      ULONG cpus = KeQueryActiveProcessorCountEx(ALL_PROCESSOR_GROUPS), cpu;
+      ULONGLONG best = ~0ULL;
+      KAFFINITY fast = 0;
+      if (cpus > 16u) cpus = 16u;
+      for (cpu = 0u; cpu < cpus; ++cpu) {
+        PROCESSOR_NUMBER number;
+        UCHAR info[256];
+        ULONG length = sizeof(info);
+        UCHAR cls = 0xffu;
+        if (!NT_SUCCESS(KeGetProcessorNumberFromIndex(cpu, &number)) || number.Group != 0u)
+          continue;
+        if (NT_SUCCESS(KeQueryLogicalProcessorRelationship(&number,
+                RelationProcessorCore,
+                (PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX)info, &length)))
+          cls = ((PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX)info)->Processor.EfficiencyClass;
+        if (cpu < 8u) out[56] |= (ULONGLONG)cls << (8u * cpu);
+        {
+          KAFFINITY old = KeSetSystemAffinityThreadEx((KAFFINITY)1 << number.Number);
+          volatile ULONG acc = 1u;
+          ULONG k;
+          LONGLONG t0, t1;
+          out[8u + cpu] = (ULONGLONG)AdmissionScanoutSoftBenchRead(a, R->SoftPool, bytes);
+          out[24u + cpu] = (ULONGLONG)AdmissionScanoutSoftBenchRead(a, b, bytes);
+          t0 = KeQueryPerformanceCounter(NULL).QuadPart;
+          for (k = 0u; k < 20000000u; ++k)
+            acc = acc * 1664525u + 1013904223u;
+          t1 = KeQueryPerformanceCounter(NULL).QuadPart;
+          out[40u + cpu] = (ULONGLONG)(t1 - t0);
+          KeRevertToUserAffinityThreadEx(old);
+        }
+        if (out[8u + cpu] < best) best = out[8u + cpu];
+      }
+      for (cpu = 0u; cpu < cpus && cpu < 16u; ++cpu)
+        if (out[8u + cpu] != 0u && out[8u + cpu] * 2u <= best * 3u)
+          fast |= (KAFFINITY)1 << cpu;
+      R->SoftFastCpus = fast;
+      out[57] = (ULONGLONG)fast;
+      out[58] = cpus;
+    }
+  } else {
+    out[7] |= 0x100u;
+  }
+  if (a != NULL) ExFreePoolWithTag(a, ADMISSION_SCANOUT_TAG);
+  if (b != NULL) ExFreePoolWithTag(b, ADMISSION_SCANOUT_TAG);
+  if (NT_SUCCESS(IoOpenDeviceRegistryKey(Context->PhysicalDeviceObject,
+          PLUGPLAY_REGKEY_DEVICE, KEY_SET_VALUE, &key))) {
+    RtlInitUnicodeString(&name, L"NwSoftBench");
+    (void)ZwSetValueKey(key, &name, 0, REG_BINARY, out, sizeof(out));
+    ZwClose(key);
+  }
+}
