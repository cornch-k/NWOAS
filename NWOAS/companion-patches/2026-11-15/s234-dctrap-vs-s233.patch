+/* S234 USB-A read-corruption experiment (hypothesis until hardware-validated):
+ * with HCR_EL2.VM=1 the architecture turns an EL1 "DC IVAC" (invalidate) into
+ * clean+invalidate, so a guest that invalidates a DMA-read buffer AFTER a
+ * non-coherent device wrote it gets its own stale dirty lines written back
+ * over the device data. NWOAS_DC_TRAP sets HCR_EL2.TPCP and emulates the
+ * trapped EL0/EL1 cache-maintenance-by-VA instructions at EL2 on the PA.
+ * NWOAS_DC_IVAC_TRUE=1: DC IVAC is a real invalidate (bare-metal semantics);
+ * 0: DC IVAC is emulated as clean+invalidate (control = untrapped behaviour). */
+#ifndef NWOAS_DC_TRAP
+#define NWOAS_DC_TRAP 1
+#endif
+#ifndef NWOAS_DC_IVAC_TRUE
+#define NWOAS_DC_IVAC_TRUE 0
+#endif
+struct exc_info;
+bool nwoas_dc_emulate(struct exc_info *ctx, u32 op1, u32 crm, u32 op2, u64 va);
 u64 hv_pt_walk(u64 addr);
 bool hv_handle_dabort(struct exc_info *ctx);
 bool hv_pa_write(struct exc_info *ctx, u64 addr, u64 *val, int width);
