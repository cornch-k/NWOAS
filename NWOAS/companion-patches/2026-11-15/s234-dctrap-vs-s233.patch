+        u64 dc_iss = ec == ESR_EC_MSR ? FIELD_GET(ESR_ISS, ctx->esr) : ctx->afsr1;
+        if (!(dc_iss & ESR_ISS_MSR_DIR) && FIELD_GET(ESR_ISS_MSR_OP0, dc_iss) == 1 &&
+            FIELD_GET(ESR_ISS_MSR_CRn, dc_iss) == 7) {
+            u64 dc_rt = FIELD_GET(ESR_ISS_MSR_Rt, dc_iss);
