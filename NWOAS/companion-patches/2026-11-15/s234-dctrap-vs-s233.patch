+                                 dc_rt == 31 ? 0 : ctx->regs[dc_rt])) {
+                ctx->elr += 4;
+                hv_set_elr(ctx->elr);
+                hv_update_fiq();
+                return;
+            }
+        }
+    }
+#endif
