            nwoas_fl_mc.xcap, nwoas_fl_mc.xout, nwoas_fl_mc.xstrm, nwoas_fl_mc.evt,
            NWOAS_FL_EVT_NO_INVALIDATE ? "civac" : "ivac", nwoas_fl_mc.erst, nwoas_fl_mc.keep,
            nwoas_fl_mc.keepring);
+    nwoas_dc_report();
 }
 
