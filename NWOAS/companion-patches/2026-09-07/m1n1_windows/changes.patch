+def _link_guarded(fn):
+    """NWOAS: bound the proxy round-trips a guest-event handler performs.
+
+    Root cause of the 1.5M-baud (and low-probability 115200) guest-boot hangs:
+    HV.start() sets ``iface.dev.timeout = None`` right before guest entry and
+    never restores a finite value, so a single dropped VDM-serial byte inside the
+    per-trap ExcInfo readmem blocks ``readfull()`` forever. readmem's chunk retry
+    and ``_resync_link()`` can only fire once a ``UartTimeout`` is actually raised,
+    which ``timeout=None`` makes impossible -> one lost byte == whole-run hang.
+
+    When ``NWOAS_HV_READ_TIMEOUT`` is set, apply that finite ``dev.timeout`` for the
+    duration of a handler ONLY -- the guest event has already arrived, so every
+    proxy I/O the handler issues (ExcInfo readmem, _commit_context writemem, msr,
+    p.exit, ...) is a bounded round-trip and readmem's retry/resync path can
+    engage. The previous timeout (``None`` during normal operation) is restored on
+    exit via ``finally`` so the idle "wait for the next guest event" read in
+    ``reply()`` -- which runs OUTSIDE any handler -- stays infinite (the guest may
+    be quiet for minutes; a timeout there would be a false positive).
+
+    Nesting (e.g. handle_exception -> _switch_context -> wait_and_handle_boot ->
+    a nested CPU_SWITCH handler) is handled by saving/restoring the *previous*
+    value rather than forcing None, so the inner exit leaves the finite timeout in
+    place and only the outermost exit restores None.
+
+    Unset / empty / invalid env -> ``_hv_read_timeout`` is None -> the handler runs
+    exactly as before, touching ``dev.timeout`` on no code path (byte-identical
+    default behavior; this session cannot validate on real hardware, so the
+    default MUST stay unchanged).
+
+    This guard lives on the handler *methods themselves* (not at set_handler
+    registration) on purpose: -m scripts such as pcie_emul.py capture the bound
+    method (``_nl_orig_handle_exception = hv.handle_exception``) and delegate to
+    it, so guarding the method also protects those monkeypatched paths. Their
+    ``_NWOASNullLoopStop`` sentinel subclasses BaseException, so it slips past the
+    ``except (UartTimeout, UartChecksumError)`` below and only trips ``finally``.
+    """
+    @functools.wraps(fn)
+    def wrapper(self, *args, **kwargs):
+        t = getattr(self, "_hv_read_timeout", None)
+        if t is None:
+            # Default / disabled path: identical to the un-decorated handler.
+            return fn(self, *args, **kwargs)
+        dev = self.iface.dev
+        prev = dev.timeout
+        dev.timeout = t
+        try:
+            return fn(self, *args, **kwargs)
+        except (UartTimeout, UartChecksumError) as e:
+            # readmem/writemem exhausted their retry+resync budget: this is a lost
+            # link, not a slow guest. Surface a clear marker instead of a silent
+            # hang, then re-raise so the run aborts via the existing crash path.
+            print(f"NWOAS-LINK-LOST: proxy link unrecoverable in {fn.__name__} "
+                  f"after timeout+retry ({e}); aborting run", flush=True)
+            raise
+        finally:
+            dev.timeout = prev
+    return wrapper
+
