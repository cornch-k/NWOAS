+    def readmem(self, addr, size):
+        if size == 0:
+            return b""
+
+        # NWOAS: the macvdmtool VDM serial occasionally drops a byte mid-transfer,
+        # which used to abort the read with a UartTimeout/UartChecksumError — fatal
+        # even for the tiny exception-context reads the hv does on EVERY guest trap
+        # (the boot stalls were dropped bytes in those reads). Read in bounded
+        # chunks and retry each chunk after resyncing the link, so an intermittent
+        # drop costs one re-read instead of crashing the run. Applies to small
+        # reads too; on success there is no retry overhead.
+        CHUNK = 0x8000  # 32 KiB
