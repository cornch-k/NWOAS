+               read32(op_base + 0x1c), read32(op_base + 0x18),
+               read32(op_base + 0x34), read32(op_base + 0x30),
+               read32(rt_base + 0x28),
+               read32(rt_base + 0x34), read32(rt_base + 0x30),
