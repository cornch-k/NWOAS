+    u8 prio = hv_vgic3_get_priority(NWOAS_USB_SPI);
+    if (hv_vgic3_get_free_lr() != -1) {
+        hv_vgic3_inject_irq(NWOAS_USB_SPI, prio, false, true, false, 0);
