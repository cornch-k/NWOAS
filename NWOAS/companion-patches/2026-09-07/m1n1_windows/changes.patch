+        if (target < (u64)_base || target >= (u64)_end || (target & 3)) {
+            if (spurious_logged < 4) {
+                spurious_logged++;
+                printf("HVLOG: NWOAS smp cpu%d spurious target 0x%lx (spin_table "
+                       "corrupted by guest) - ignoring\n",
+                       target_cpu, target);
+            }
+            me->target = 0;
+            sysop("dmb sy");
+            continue;
+        }
         sysop("dmb sy");
         me->flag++;
         sysop("dmb sy");
