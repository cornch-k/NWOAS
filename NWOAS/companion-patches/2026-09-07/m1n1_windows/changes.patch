+    def _resync_link(self):
+        # NWOAS: re-establish proxy framing after a dropped-byte transfer error.
+        # (Serial.reset_input_buffer is a deliberate no-op in this client, so we
+        # rely on nop()'s reply parser to skip any leftover bytes as TTY noise.)
+        for _ in range(4):
+            try:
+                self.nop()
+                return
+            except UartError:
+                continue
