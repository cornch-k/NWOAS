+# because the next stage (run_guest.py) opens its own link and re-bootstraps
+# (its bootstrap_port has the same 15-retry resync).
+_to = iface.dev.timeout
+iface.dev.timeout = 1.5
+_last = None
+for _ in range(15):
+    try:
+        iface.nop()
