+
+/*
+ * ---------------------------------------------------------------------------
+ *  Idle-port activation (NWOAS): bring an unattached CD321x host-interface
+ *  back to a state where its firmware policy engine senses CC and can source
+ *  VBUS, so a USB drive on that connector enumerates.
+ *
+ *  These helpers operate directly on (i2c, addr) instead of a tps6598x_dev_t
+ *  so they are trivially callable from the proxy as `p.call(addr, action)`
+ *  via a self-contained entry point (tps6598x_port_enable) below.
+ *
+ *  HARDWARE-UNVERIFIED. Builds, but whether it activates the port can only be
+ *  confirmed on a real M1. See the per-step confidence notes in the design.
+ * ---------------------------------------------------------------------------
+ */
+
+/* Bounded 4CC command. Unlike tps6598x_command() this never spins forever:
+ * an idle/asleep port may simply never consume the command, and an infinite
+ * poll would wedge the proxy. Detects completion (CMD1 -> all zero) and the
+ * "!CMD" rejection marker by raw bytes, so it is endianness-agnostic. */
+static int tps_cmd(i2c_dev_t *i2c, u8 addr, const char *cmd4, const u8 *din, size_t lin,
+                   int timeout_ms)
+{
+    if (lin && i2c_smbus_write(i2c, addr, TPS_REG_DATA1, din, lin) < 0)
+        return -1;
+    if (i2c_smbus_write(i2c, addr, TPS_REG_CMD1, (const u8 *)cmd4, 4) < 0)
+        return -1;
+
+    for (int i = 0; i <= timeout_ms; i++) {
+        u8 st[4];
+        if (i2c_smbus_read(i2c, addr, TPS_REG_CMD1, st, 4) == 4) {
+            if (!st[0] && !st[1] && !st[2] && !st[3])
+                return 0; // consumed / completed
+            if (st[0] == '!' && st[1] == 'C' && st[2] == 'M' && st[3] == 'D')
+                return -2; // command rejected (!CMD)
+        }
+        udelay(1000);
+    }
+    return -3; // timeout: command engine is not servicing this port
+}
+
+/* Wake an idle port whose host interface has dropped to a low-power state in
+ * which it is permitted to NAK I2C and require retries (0x70 Sleep Config).
+ * Hammer a trivial read until it ACKs, then force "never sleep" + always-
+ * responsive I2C so subsequent commands are not silently dropped. */
+static int tps_wake(i2c_dev_t *i2c, u8 addr)
+{
+    u8 mode[4];
+    int ok = -1;
+    for (int i = 0; i < 64; i++) {
+        if (i2c_smbus_read(i2c, addr, TPS_REG_MODE, mode, 4) == 4) {
+            ok = 0;
+            break;
+        }
+        udelay(2000);
+    }
+    if (ok)
+        return -1;
+
+    /* 0x70: byte1 SleepTime=000 (never sleep), byte2=0xFF (maintain I2C
+     * responsiveness in every power state). Best-effort; ignore failure. */
+    static const u8 sleepcfg[2] = {0x00, 0xff};
+    i2c_smbus_write(i2c, addr, TPS_REG_SLEEP_CONFIG, sleepcfg, sizeof(sleepcfg));
+    return 0;
+}
+
+/* Read-only snapshot of the registers that decide whether a port can host. */
+void tps6598x_port_dump(i2c_dev_t *i2c, u8 addr)
+{
+    u8 mode[4] = {0};
+    u32 status = 0, sysconf = 0, ctrlconf = 0, pd = 0;
+    u16 pwr = 0;
+
+    i2c_smbus_read(i2c, addr, TPS_REG_MODE, mode, 4);
+    i2c_smbus_read32(i2c, addr, TPS_REG_STATUS, &status);
+    i2c_smbus_read32(i2c, addr, TPS_REG_SYS_CONFIG, &sysconf);
+    i2c_smbus_read32(i2c, addr, TPS_REG_CTRL_CONFIG, &ctrlconf);
+    i2c_smbus_read16(i2c, addr, TPS_REG_POWER_STATUS, &pwr);
+    i2c_smbus_read32(i2c, addr, TPS_REG_PD_STATUS, &pd);
+
+    printf("tps[0x%02x]: Mode=%c%c%c%c Status=%08x ConnState=%u PortInfo=%u "
+           "SysConf=%08x CtrlConf=%08x PwrStatus=%04x PDStatus=%08x\n",
+           addr, mode[0] ? mode[0] : '?', mode[1] ? mode[1] : '?', mode[2] ? mode[2] : '?',
+           mode[3] ? mode[3] : '?', status, (status >> 1) & 0x7, sysconf & TPS_PORTINFO_MASK,
+           sysconf, ctrlconf, pwr, pd);
+}
+
+/*
+ * Self-contained proxy entry point. Opens i2c0 itself so it can be driven from
+ * run_guest.py without a full m1n1 reflash:
+ *
+ *     from m1n1.loadobjs import LinkedProgram
+ *     c = LinkedProgram(u)
+ *     c.tps6598x_port_enable(0x3f, 0)   # dump only (safe)
+ *     c.tps6598x_port_enable(0x3f, 1)   # wake + warm-reset (Gaid)
+ *     c.tps6598x_port_enable(0x3f, 2)   # wake + force Source role + DISC re-enable
+ *
+ * Returns 0 when the chosen path completed. NOTE: return 0 does NOT prove the
+ * port now sources VBUS — only a physical attach test on real hardware does.
+ */
+int tps6598x_port_enable(u8 addr, u32 action)
+{
+    /*
+     * Safety guard (NWOAS): the destructive actions (Gaid warm-reset, DISC, the
+     * PortInfo write) must NEVER hit 0x38 -- that CD321x governs the macvdmtool
+     * serial-console port and shares i2c0 with the target. A one-character typo
+     * (0x38 vs 0x3f) would reset the debug serial out from under us. Only the
+     * idle Back-right target (0x3f) may be perturbed; action 0 (dump) is read-only
+     * and allowed on either for comparison.
+     */
+    if (action != 0 && addr != 0x3f) {
+        printf("tps[0x%02x]: refusing destructive action %u; only 0x3f allowed "
+               "(0x38 = serial console)\n",
+               addr, action);
+        return -1;
+    }
+
+    i2c_dev_t *i2c = i2c_init("/arm-io/i2c0");
+    if (!i2c) {
+        printf("tps: i2c0 init failed\n");
+        return -1;
+    }
+
+    int ret = -1;
+
+    if (tps_wake(i2c, addr) < 0) {
+        printf("tps[0x%02x]: wake failed (host interface not responding)\n", addr);
+        goto out;
+    }
+    tps6598x_port_dump(i2c, addr);
+
+    if (action == 0) {
+        ret = 0;
+        goto out;
+    }
+
+    if (action == 2) {
+        /*
+         * Force the port to a source-default role. Only PortInfo (the role) is
+         * touched; the VBUS power-switch selection (PP_5V0/PP_HV/PP_EXT in this
+         * same register) is board-specific and is deliberately left as Apple
+         * configured it -- Macs already source VBUS to bus-powered peripherals,
+         * so the source FET is presumed wired. We read-modify-write the whole
+         * 17-byte register (partial writes of multi-byte regs are unreliable).
+         *
+         * Then apply it with DISC (simulate disconnect, 1s auto-reconnect),
+         * which re-runs Type-C attach with the new config but, unlike Gaid,
+         * does NOT reset the host-interface registers back to firmware defaults.
+         */
+        u8 cfg[17] = {0};
+        if (i2c_smbus_read(i2c, addr, TPS_REG_SYS_CONFIG, cfg, sizeof(cfg)) != (int)sizeof(cfg)) {
+            printf("tps[0x%02x]: read SysConfig(0x28) failed\n", addr);
+            goto out;
+        }
+        u8 was = cfg[0] & TPS_PORTINFO_MASK;
+        cfg[0] = (cfg[0] & ~TPS_PORTINFO_MASK) | TPS_PORTINFO_DRP_DEF_SRC_DR;
+        if (i2c_smbus_write(i2c, addr, TPS_REG_SYS_CONFIG, cfg, sizeof(cfg)) < 0) {
+            printf("tps[0x%02x]: write SysConfig(0x28) failed\n", addr);
+            goto out;
+        }
+
+        u8 chk[17] = {0};
+        i2c_smbus_read(i2c, addr, TPS_REG_SYS_CONFIG, chk, sizeof(chk));
+        printf("tps[0x%02x]: PortInfo %u -> %u (readback %u)\n", addr, was,
+               TPS_PORTINFO_DRP_DEF_SRC_DR, chk[0] & TPS_PORTINFO_MASK);
+        if ((chk[0] & TPS_PORTINFO_MASK) != TPS_PORTINFO_DRP_DEF_SRC_DR) {
+            printf("tps[0x%02x]: 0x28 did not stick -> role config is locked, "
+                   "cannot change role from the I2C host interface\n",
+                   addr);
+            goto out; // honest dead-end signal
+        }
+
+        u8 disc_delay = 1; // seconds; non-zero => auto-reconnect with new config
+        int c = tps_cmd(i2c, addr, "DISC", &disc_delay, 1, 200);
+        printf("tps[0x%02x]: DISC -> %d\n", addr, c);
+        udelay(100000);
+        tps6598x_port_dump(i2c, addr);
+        ret = (c == 0) ? 0 : -1;
+        goto out;
+    }
+
+    /*
+     * action == 1: warm-restart the PD controller CPU (Gaid). This clears any
+     * latched modal/Disabled state and restarts the autonomous policy engine
+     * from its flashed config -- the most likely lever to un-stick a wedged or
+     * Type-C-disabled idle port. Gaid "never completes" normally (the CPU
+     * reboots and CMD1 returns to 0), and the chip NAKs I2C while rebooting, so
+     * we fire-and-wait instead of polling.
+     */
+    if (i2c_smbus_write(i2c, addr, TPS_REG_CMD1, (const u8 *)"Gaid", 4) < 0) {
+        printf("tps[0x%02x]: Gaid write failed\n", addr);
+        goto out;
+    }
+    udelay(150000); // ~150ms for the warm reboot
+    if (tps_wake(i2c, addr) < 0)
+        printf("tps[0x%02x]: did not re-appear after Gaid\n", addr);
+    else
+        tps6598x_port_dump(i2c, addr);
+    ret = 0;
+
+out:
+    i2c_shutdown(i2c);
+    return ret;
+}
