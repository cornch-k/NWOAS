+__all__ = ["ProxyUtils", "RegMonitor", "GuardedHeap", "bootstrap_port", "s5l_actual_baud",
+           "LINK_UNRELIABLE_BAUDS"]
+
+# NWOAS: the target's s5l UART only hits an integer-exact bit rate for baud
+# values where UART_CLOCK/(16*baud) is an integer (src/uart.c:106-112,
+# UART_CLOCK=24MHz). uart_setbaud() computes the divider with the same
+# integer-truncating arithmetic as the C code below, so this mirrors it
+# exactly rather than approximating.
+S5L_UART_CLOCK = 24000000
+
+# NWOAS: 1500000 (UBRDIV=0) IS integer-exact by the UBRDIV math below (error
+# 0%), so s5l_actual_baud() alone can't flag it. It's excluded anyway: the
+# macvdmtool VDM serial channel itself (not the UART divider) has been
+# observed to drop bytes at 1.5 Mbaud, causing guest-boot hangs from lost
+# trap-handshake bytes (see the M1N1_KEEP_BAUD comment in bootstrap_port()
+# below). This is a link-layer finding, not something derivable from the
+# divider math, so both the M1N1_BAUD gate here and
+# proxyclient/tools/baud_ladder.py's candidate filter consult this set
+# explicitly.
+LINK_UNRELIABLE_BAUDS = {1500000}
+
+def s5l_actual_baud(requested):
+    '''Compute the s5l UART's actual bit rate for a requested baud, mirroring
+    uart_setbaud()'s integer divider math (src/uart.c:106-112):
+        UBRDIV = ((UART_CLOCK / baudrate + 7) / 16) - 1   (C integer division)
+        actual = UART_CLOCK / (16 * (UBRDIV + 1))
+    Returns (ubrdiv, actual_baud, error_fraction). error_fraction is
+    abs(actual - requested) / requested; only baud rates where this is ~0
+    (UART_CLOCK is an exact multiple of 16*baud) are safe to use -- anything
+    else aliases to a nearby rate the far end never asked for.'''
+    requested = int(requested)
+    if requested <= 0:
+        raise ValueError(f"invalid baud rate: {requested}")
+    ubrdiv = ((S5L_UART_CLOCK // requested + 7) // 16) - 1
+    if ubrdiv < 0:
+        ubrdiv = 0
+    actual = S5L_UART_CLOCK / (16 * (ubrdiv + 1))
+    error = abs(actual - requested) / requested
+    return ubrdiv, actual, error
 
