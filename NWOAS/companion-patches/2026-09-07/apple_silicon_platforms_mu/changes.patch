+// ============================================================================
+// NWOAS: PCIe (apcie) DART IOMMU translation for the USB-A xHCI (Fresco Logic
+// FL1100). The stock driver only sets the DWC3 (USB-C) DARTs to bypass and never
+// finished the PCIe path -- but PCIe DARTs do NOT support bypass, so USB-A DMA
+// needs real IOVA->PA translation. We set up one shared flat page table over a
+// <4GB IOVA aperture, point all three apcie DARTs' streams at it, and translate
+// on Map(). Page-table format per m1n1 dart8020 / Corellium apple-dart.
+// ============================================================================
+#define NUM_APCIE_DARTS   3
+STATIC CONST UINT64 mApcieDartBase[NUM_APCIE_DARTS] = {
+  0x681008000ULL, 0x682008000ULL, 0x683008000ULL
+};
+STATIC UINT64  *mApcieL1        = NULL;
+STATIC UINT64  *mApcieL2        = NULL;               // flat L2 covering [0, 4GB)
+STATIC UINT64   mApcieIovaNext  = 0x00100000ULL;      // bump allocator, 16KB-aligned
+STATIC BOOLEAN  mApcieDartReady = FALSE;
+
+// NWOAS EXP-5 DART STATIC WINDOW fix (2026-07-10): 5-agent analysis + HW logs ruled out geometry
+// (backing VERIFIED), skew, DART fault (ERR=0), WC coherence (m1n1 HCR_EL2.FWB=0 so guest WC wins,
+// ring is truly uncached), and IOVA exhaustion (33% used) as the cause of the EXP-5 UEFI xHCI read
+// stall. The remaining difference from the working no-EXP-5 path: EXP-5 uses the DYNAMIC per-Map
+// path (bump-alloc + L2 write) 41k times with the per-Map DART TLB flush deliberately DROPPED
+// (see the B-1a comment) on the assumption "fresh IOVA never reused -> no stale TLB entry" -- an
+// assumption that may not hold for the Apple t8020 DART (walk/prefetch cache). FIX: install the
+// SAME static full-window L2 map the EBS handler installs, but at BOOT (SetupApcieDarts), and have
+// Map() return the window IPA directly for window buffers -- no per-transfer L2 write / TLB churn,
+// exactly like the working no-EXP-5 static DART. 1 = static window ON (fix); 0 = prior dynamic path.
+// (Set to 0: mapping the FULL 4GB IOVA to live RAM removed the unmapped-IOVA safety net, so a
+//  stray device DMA during UEFI boot corrupted guest RAM -> deterministic UEFI wedge at
+//  0x235200010 before bootmgfw, 3/3 on HW. Kept gated-off as reference.)
+#define NWOAS_DART_STATIC_WINDOW 0
+#if NWOAS_DART_STATIC_WINDOW
+STATIC BOOLEAN  mApcieStaticWindow = FALSE;
+#endif
+
+// NWOAS EXP-5 DART per-Map TLB flush (2026-07-10): the canonical Asahi/m1n1 DART driver
+// (m1n1 src/dart.c dart_map_flags:565) calls tlb_invalidate() after EVERY map -- the t8020 DART
+// REQUIRES a TLB flush on map. Cache-cleaning the new PTE to RAM is NOT enough: the DART's own
+// TLB / page-table-walk cache must be invalidated (dma_wmb + STREAM_SELECT + STREAM_COMMAND
+// INVALIDATE) for the hardware to pick up the freshly written L2 entry. AppleDartIoMmuDxe dropped
+// this per-Map flush for latency (the "B-1a" comment's "fresh IOVA never needs a flush" assumption
+// is wrong per the canonical driver). Re-add it (gated, keeps the SAFE sparse map) to fix the EXP-5
+// UEFI xHCI read stall: without the flush the DART can translate this fresh IOVA from a stale
+// entry, so the FL1100's completion DMA lands at the wrong PA and the CPU never sees the event.
+// 1 = per-Map DART TLB flush ON (fix); 0 = prior (dropped-flush) behavior.
+#define NWOAS_DART_PERMAP_FLUSH 1
+
+// NWOAS EXP-5 DART BOUNCE (2026-07-10): the real EXP-5 read-stall root = FL1100 HSE (controller
+// memory-access error) when it DMAs to an OUT-OF-WINDOW buffer. HW proof: the HSE-triggering
+// buffer (0xAE0FC8000) sits in Method A's Reserved high-RAM region [0x83D14C000,0xAE0FCC000)
+// (MEMMAP type=0), NOT in the low window, so it is identity-mapped to a high PA the FL1100 cannot
+// reach -> HSE -> halt. (no-EXP-5 has no such per-Map path.) FIX: for a transient (non-CommonBuffer)
+// transfer whose host buffer is outside the window, allocate a WINDOW bounce buffer (Conventional,
+// DART-reachable via backing), copy caller->bounce for device-reads, map the bounce, and copy
+// bounce->caller on Unmap for device-writes. CommonBuffers must already be window (AllocateBuffer).
+// 1 = bounce ON; 0 = prior (identity out-of-window -> HSE).
+// ROOT (v30 OOW dump): the out-of-window DMA buffers are UEFI STACK locals -- the stack sits at
+// [SystemMemoryTop-128KB, SystemMemoryTop) which, under Method A, is the Reserved region just below
+// the window backing, so small stack DMA buffers are un-reachable by the FL1100 (HSE). v28 bounce cut
+// HSE 414->7 (right direction) but "Unable to boot": suspected a short device-write leaving the
+// bounce tail as garbage that Unmap copied back -> FS-metadata corruption. v31: pre-copy BOTH
+// directions (below) so the bounce always mirrors the caller before the transfer.
+// v31 (pre-copy both dirs) STILL failed: bounce covers all OOW buffers yet breaks enumeration
+// (persistent xHCI structs on the stack need a STABLE address, not a fresh per-Map bounce). Reverted
+// to 0 (v26 baseline). Real fix = relocate the UEFI stack into the window (see exp5-hse-root memory).
+#define NWOAS_DART_BOUNCE_OOW 0
