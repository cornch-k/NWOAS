+// NWOAS EXP-5: the per-Map "NWOAS MAP host=..." log fires thousands of times per boot -> massive
+// serial traffic that slows the boot and worsens the flaky S5L-UART poll wedge (0x235200010).
+// Off by default; flip to 1 only when debugging the Map path.
+#define NWOAS_MAP_VERBOSE 0
