+      Info->HostAddress   = HostAddress;
+      Info->NumberOfBytes = *NumberOfBytes;
+      Info->Operation     = Operation;
+#if NWOAS_DART_BOUNCE_OOW
+      Info->Bounce        = NwoasBounce;
+      Info->OrigHost      = NwoasOrigHost;
+      Info->BouncePages   = NwoasBncPages;
+#else
+      Info->Bounce        = NULL;
+      Info->OrigHost      = NULL;
+      Info->BouncePages   = 0;
+#endif
+    }
