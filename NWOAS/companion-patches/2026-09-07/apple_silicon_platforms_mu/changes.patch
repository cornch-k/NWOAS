+STATIC EFI_STATUS EFIAPI AppleDartIoMmuAllocateBufferReal(
+    IN EDKII_IOMMU_PROTOCOL *This,
+    IN EFI_ALLOCATE_TYPE Type,
+    IN EFI_MEMORY_TYPE MemoryType,
+    IN UINTN Pages,
+    IN OUT VOID **HostAddress,
+    IN UINT64 Attributes
+    )
+{
+  VOID *Buf;
+  if (MemoryType == EfiRuntimeServicesData) {
+    Buf = AllocateAlignedRuntimePages(Pages, DART_PAGE_SIZE);
+  } else {
+    Buf = AllocateAlignedPages(Pages, DART_PAGE_SIZE);
+  }
+  if (Buf == NULL) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+  //
+  // NWOAS EXP-5 5c (non-coherent DMA fix): this IOMMU AllocateBuffer path serves ONLY xHCI COMMON
+  // buffers (DCBAA / command ring / event ring / device contexts) -- NOT bulk data (boot.wim uses
+  // BusMasterRead/Write with Map/Unmap coherence). Under Method A those rings live in the low DMA
+  // window (an m1n1 hv map_hw alias), and the apcie DART DMA is NOT cache-coherent for the EL1 guest
+  // under the EL2 stage-2 (AppleDartIoMmuMapReal B-2). For a POLLED event ring (mapped once, never
+  // Unmapped) the one-shot Map cache-clean is not enough: the CPU polls STALE cache and never sees
+  // the device's completion event -> "Enable Slot: Time out" (observed exp5c-v3, DART ERR=0 so the
+  // device DMA itself succeeds). Mapping these ring buffers uncacheable makes CPU polls hit RAM
+  // directly -> coherent. hv map_hw uses PTE_MEMATTR_UNCHANGED, so the stage-1 UC set here is the
+  // effective type. Rings are tiny, so the UC cost is negligible; bulk data stays cacheable.
+  {
+    // EFI_MEMORY_UC is Unsupported on this window (GCD capabilities from the MemoryInitPeiLib
+    // resource attributes include WRITE_COMBINEABLE/WRITE_THROUGH/WRITE_BACK but NOT UNCACHEABLE).
+    // EFI_MEMORY_WC (write-combining = non-cacheable Normal) IS in the capabilities and makes reads
+    // uncached -> the CPU's event-ring poll hits RAM instead of stale cache.
+    EFI_STATUS AttrStatus = gDS->SetMemorySpaceAttributes (
+                              (EFI_PHYSICAL_ADDRESS)(UINTN)Buf,
+                              EFI_PAGES_TO_SIZE (Pages),
+                              EFI_MEMORY_WC
+                              );
+    if (EFI_ERROR (AttrStatus)) {
+      // Non-fatal: keep the (cacheable) buffer rather than failing the allocation; log so a run
+      // that still times out points here.
+      DEBUG ((DEBUG_ERROR, "HVLOG: NWOAS AllocBuffer WC set FAILED %r @0x%lx pages=%u (cacheable, may be stale)\n",
+              AttrStatus, (UINT64)(UINTN)Buf, (UINT32)Pages));
+    } else {
+      DEBUG ((DEBUG_ERROR, "HVLOG: NWOAS AllocBuffer WC @0x%lx pages=%u (ring buffer non-cacheable for DMA coherence)\n",
+              (UINT64)(UINTN)Buf, (UINT32)Pages));
+    }
+  }
+  *HostAddress = Buf;
+  return EFI_SUCCESS;
+}
