+#define NWOAS_WINDOW_AFTER_RAM 1
+#endif
+#define APCIE_WIN_SIZE      0x0000000100000000ULL    // 4GB (EXP-5 5c-v7: 0xE0000000 -> 0x100000000; base+size == 0x100000000)
+
+//
+// NWOAS memory/DMA fix: low DMA-window DART backing PA, computed ONCE at DXE init from BootArgs
+// (phys_base + mem_size - APCIE_WIN_SIZE) so it equals the m1n1 hv map_hw alias (pcie_emul.py) and
+// the AdtParser carve-out, NOT PcdSystemMemoryBase+PcdSystemMemorySize which THIS module reads
+// UNPATCHED (see the long comment at the DXE-init computation site). Cached because the
+// ExitBootServices handler may run after the boot_args copy at PcdBootArgsPointer (0x840000000,
+// unreserved conventional RAM) has been reclaimed by the Windows loader's RAMDisk allocations.
+//
+STATIC UINT64   mApcieBackingPa = 0;
+
+#define APCIE_IOVA_END    0xF0000000ULL
+#define APCIE_L2_ENTRIES  (SIZE_4GB / DART_PAGE_SIZE)               // 256K
+#define APCIE_L2_BYTES    (APCIE_L2_ENTRIES * sizeof(UINT64))       // 2MB
+#define APCIE_L1_ENTRIES  (APCIE_L2_BYTES / DART_PAGE_SIZE)         // 128
+#define APCIE_PTE_FLAGS   0x3ULL                                    // VALID | SP_PROT_DIS
+#define APCIE_PTE_SP_END  (((UINT64)0xfff) << 40)
+#define APCIE_L2_PAGE(pa) (((pa) & ~(UINT64)DART_PAGE_MASK) | APCIE_PTE_FLAGS | APCIE_PTE_SP_END)
+
+#if NWOAS_WIDE_DART
+//
+// NWOAS WIDE-DART geometry (T8020-class apcie DART; verified vs m1n1 dart8020.py L1_OFF=25/L2_OFF=14/
+// IDX_BITS=11). The existing flat L2 (APCIE_L2_ENTRIES) covers ONLY L1[0..APCIE_L1_ENTRIES-1] =
+// IOVA[0,4GB). The high-RAM identity map uses SEPARATE, freshly allocated 16KB L2 tables wired into
+// the ALREADY-allocated single-page L1 (mApcieL1 holds APCIE_L1_TABLE_ENTRIES=2048 entries -> the
+// full 64GB TTBR0 span), at L1 indices [phys_base>>25 .. (backing-1)>>25] (~1053..1393 on 16GB).
+//
+#define APCIE_L1_SHIFT         25                                   // IOVA L1 index = (iova >> 25) & 0x7FF; each L1 entry spans 32MB
+#define APCIE_L2_SHIFT         14                                   // IOVA L2 index = (iova >> 14) & 0x7FF; 16KB pages
+#define APCIE_L1_TABLE_ENTRIES (DART_PAGE_SIZE / sizeof(UINT64))    // 2048 entries in the 16KB L1 page (and per L2 table)
+#define APCIE_LX_MASK          (APCIE_L1_TABLE_ENTRIES - 1)         // 0x7FF
+
+STATIC UINT64  mWideDartPhysBase = 0;     // advertised guest RAM base (boot_args phys_base), low bound of the identity range
+STATIC UINT64 *mWideDartL2       = NULL;   // contiguous block of high-RAM identity L2 tables (mWideDartTables * 16KB)
+STATIC UINTN   mWideDartL1Lo     = 0;      // first L1 index of the high range (== phys_base >> 25)
+STATIC UINTN   mWideDartL1Hi     = 0;      // last  L1 index of the high range (== (backing-1) >> 25)
+STATIC UINTN   mWideDartTables   = 0;      // number of 16KB L2 tables allocated (== L1Hi - L1Lo + 1)
+#endif // NWOAS_WIDE_DART
+
+STATIC VOID ApcieDartFlushAll(VOID) {
+  UINTN d;
+  __asm__ volatile ("dsb sy");
+  for (d = 0; d < NUM_APCIE_DARTS; d++) {
+    MmioWrite32(mApcieDartBase[d] + DART_T8020_TLB_SIDMASK, 0xFFFF);
+    MmioWrite32(mApcieDartBase[d] + DART_T8020_TLB_CMD, DART_T8020_TLB_CMD_FLUSH);
+    while ((MmioRead32(mApcieDartBase[d] + DART_T8020_TLB_CMD) & DART_T8020_TLB_CMD_BUSY) != 0) {
+      continue;
+    }
+  }
+}
+
+// NWOAS EXP-5 diag (2026-07-10): the FL1100 HSE-halts under EXP-5 on DMA to an OUT-OF-WINDOW
+// (high-physical) buffer at ~0xAE0FC8000 (identity-mapped, unreachable). Dump the EFI memory map
+// ONCE to learn what that region's Type is (Conventional=window-leak / Reserved / Runtime / etc.),
+// so we fix the right thing instead of guessing again. Logs only entries near the target + high RAM.
+STATIC BOOLEAN mNwoasMemMapDumped = FALSE;
+STATIC VOID NwoasDumpMemMapOnce(EFI_PHYSICAL_ADDRESS Target) {
+  EFI_STATUS              St;
+  UINTN                   MapSize = 0, MapKey = 0, DescSize = 0, i, Count;
+  UINT32                  DescVer = 0;
+  EFI_MEMORY_DESCRIPTOR  *Map = NULL, *Desc;
+
+  if (mNwoasMemMapDumped) return;
+  mNwoasMemMapDumped = TRUE;
+
+  St = gBS->GetMemoryMap(&MapSize, NULL, &MapKey, &DescSize, &DescVer);
+  if (DescSize == 0) return;
+  MapSize += 16 * DescSize;
+  Map = AllocatePool(MapSize);
+  if (Map == NULL) return;
+  St = gBS->GetMemoryMap(&MapSize, Map, &MapKey, &DescSize, &DescVer);
+  if (EFI_ERROR(St)) { FreePool(Map); return; }
+
+  Count = MapSize / DescSize;
+  DEBUG((DEBUG_ERROR, "HVLOG: NWOAS MEMMAP dump begin (%u entries) target=0x%lx\n", (UINT32)Count, (UINT64)Target));
+  Desc = Map;
+  for (i = 0; i < Count; i++) {
+    EFI_PHYSICAL_ADDRESS s = Desc->PhysicalStart;
+    EFI_PHYSICAL_ADDRESS e = s + LShiftU64(Desc->NumberOfPages, 12);
+    BOOLEAN hit = (Target >= s && Target < e);
+    if (hit || (s >= 0xA00000000ULL && s < 0xC00000000ULL)) {
+      DEBUG((DEBUG_ERROR, "HVLOG: NWOAS MEMMAP type=%u start=0x%lx pages=0x%lx attr=0x%lx%s\n",
+             (UINT32)Desc->Type, (UINT64)s, (UINT64)Desc->NumberOfPages, (UINT64)Desc->Attribute,
+             hit ? " <== TARGET" : ""));
+    }
+    Desc = (EFI_MEMORY_DESCRIPTOR *)((UINT8 *)Desc + DescSize);
+  }
+  DEBUG((DEBUG_ERROR, "HVLOG: NWOAS MEMMAP dump end\n"));
+  FreePool(Map);
+}
+
+STATIC VOID SetupApcieDarts(VOID) {
+  UINTN  d, sid, i;
+  UINT64 l1phys, l2phys, base;
+
+  // NWOAS S6-D43: these tables remain the live hardware page tables after
+  // ExitBootServices.  Boot-services allocations become ordinary Windows RAM
+  // and D42 proved that Windows reclaimed/zeroed low-L2 entries while the DART
+  // TTBR still pointed here.  Runtime allocations stay reserved in the OS
+  // memory map, preserving both the low window and high identity mappings.
+  mApcieL2 = AllocateAlignedRuntimePages(EFI_SIZE_TO_PAGES(APCIE_L2_BYTES), DART_PAGE_SIZE);
+  mApcieL1 = AllocateAlignedRuntimePages(EFI_SIZE_TO_PAGES(DART_PAGE_SIZE), DART_PAGE_SIZE);
+  if (mApcieL2 == NULL || mApcieL1 == NULL) {
+    DEBUG((DEBUG_ERROR, "SetupApcieDarts: page-table allocation failed\n"));
+    return;
+  }
+  ZeroMem(mApcieL2, APCIE_L2_BYTES);
+  ZeroMem(mApcieL1, DART_PAGE_SIZE);
+
+  //
+  // ★ NWOAS EXP-5 5c ROOT-CAUSE FIX: the DART's OWN page tables (L1/L2) and the TTBR/L1 pointers
+  // must be given to the DART hardware as REAL host PAs. Under Method A the DXE pool is the low
+  // DMA window (an m1n1 hv map_hw ALIAS: window IPA != host PA), so mApcieL1/mApcieL2 land at
+  // window IPAs. The DART hardware reads its tables via the programmed address AS A HOST PA -- so a
+  // raw window-IPA TTBR/L1 makes the DART walk garbage -> every device DMA fails (xHCI USBSTS.HSE,
+  // controller stays halted, Enable Slot times out; observed 5c). §4.3 only translates DATA buffer
+  // addresses, NOT the DART's own structure addresses -- THIS was the gap. 5a/5b worked because the
+  // tables were in identity RAM (window IPA == host PA). Translate window IPA -> backing PA here,
+  // exactly as §4.3 / the EBS static window do. Backing computed locally from boot_args (mApcieBackingPa
+  // may not be set yet at DART-init); non-window (identity) allocations pass through unchanged.
+  //
+  {
+    struct boot_args *NwoasBA = (struct boot_args *)FixedPcdGet64 (PcdBootArgsPointer);
+    UINT64 NwoasBacking = ((NwoasBA->phys_base >= 0x800000000ULL) && (NwoasBA->mem_size > APCIE_WIN_SIZE))
+                          ? (NwoasBA->phys_base + NwoasBA->mem_size - APCIE_WIN_SIZE) : 0;
+    #define NWOAS_WIN2BACK(a) \
+      ( (NwoasBacking != 0 && (UINT64)(a) >= APCIE_WIN_IOVA_BASE && \
+         (UINT64)(a) < APCIE_WIN_IOVA_BASE + APCIE_WIN_SIZE) \
+        ? (NwoasBacking + ((UINT64)(a) - APCIE_WIN_IOVA_BASE)) : (UINT64)(a) )
+
+    // Each L1 entry points to one 16KB chunk of the flat L2 table -- as a REAL host PA.
+    l2phys = NWOAS_WIN2BACK((UINT64)(UINTN)mApcieL2);
+    for (i = 0; i < APCIE_L1_ENTRIES; i++) {
+      mApcieL1[i] = (l2phys & ~(UINT64)DART_PAGE_MASK) | APCIE_PTE_FLAGS;
+      l2phys += DART_PAGE_SIZE;
+    }
+#if NWOAS_WIDE_DART
+    //
+    // NWOAS WIDE-DART: ALLOCATE the high-RAM identity L2 tables and WIRE the L1 pointers HERE (DXE
+    // init -- allocation is legal now; the EBS callback must not allocate). The tables are zeroed so
+    // the high IOVA range stays UNMAPPED during UEFI boot (nothing DMAs to high IOVA before handoff:
+    // XhciDxe uses bump IOVAs < APCIE_IOVA_END, the window uses IOVA[0,4GB)); the identity PTEs are
+    // filled at ExitBootServices so the map is live exactly when Windows takes over. This is fully
+    // additive: it touches only L1[phys_base>>25 .. (backing-1)>>25], never the flat-L2 window L1[0..127].
+    //
+    if (NwoasBacking != 0) {
+      mWideDartPhysBase = NwoasBA->phys_base;                       // low bound; backing already in mApcieBackingPa
+      UINTN L1Lo = (UINTN)(mWideDartPhysBase >> APCIE_L1_SHIFT);
+      UINTN L1Hi = (UINTN)((NwoasBacking - 1) >> APCIE_L1_SHIFT);
+      if (L1Lo < APCIE_L1_ENTRIES) {
+        L1Lo = APCIE_L1_ENTRIES;                                    // never overlap the flat-L2 window L1[0..127]
+      }
+      if (L1Hi >= APCIE_L1_TABLE_ENTRIES) {
+        L1Hi = APCIE_L1_TABLE_ENTRIES - 1;                          // clamp to the 2048-entry L1 page / 64GB TTBR0 span
+      }
+      if (L1Hi >= L1Lo) {
+        UINTN NTables = L1Hi - L1Lo + 1;
+        mWideDartL2 = AllocateAlignedRuntimePages(EFI_SIZE_TO_PAGES(NTables * DART_PAGE_SIZE), DART_PAGE_SIZE);
+        if (mWideDartL2 != NULL) {
+          ZeroMem(mWideDartL2, NTables * DART_PAGE_SIZE);           // all-invalid until the EBS identity fill
+          UINT64 t2phys = NWOAS_WIN2BACK((UINT64)(UINTN)mWideDartL2);  // real host PA of the table block (passthrough when >4GB)
+          for (UINTN li = L1Lo; li <= L1Hi; li++) {
+            mApcieL1[li] = (t2phys & ~(UINT64)DART_PAGE_MASK) | APCIE_PTE_FLAGS;
+            t2phys += DART_PAGE_SIZE;
+          }
+          // Flush the freshly zeroed tables to the RAM the DART reads (the L1 page itself is flushed by
+          // the WriteBackInvalidate below, which covers all 2048 entries including the ones set here).
+          WriteBackInvalidateDataCacheRange((VOID *)mWideDartL2, NTables * DART_PAGE_SIZE);
+          mWideDartL1Lo   = L1Lo;
+          mWideDartL1Hi   = L1Hi;
+          mWideDartTables = NTables;
+          DEBUG((DEBUG_ERROR, "HVLOG: NWOAS WIDE-DART reserved L1[%u..%u] tables=%u l2base=0x%lx phys_base=0x%lx backing=0x%lx\n",
+                 (UINT32)L1Lo, (UINT32)L1Hi, (UINT32)NTables, (UINT64)(UINTN)mWideDartL2, mWideDartPhysBase, NwoasBacking));
+        } else {
+          DEBUG((DEBUG_ERROR, "HVLOG: NWOAS WIDE-DART L2 alloc FAILED (%u tables) -- wide map disabled, window-only\n",
+                 (UINT32)NTables));
+        }
+      } else {
+        DEBUG((DEBUG_ERROR, "HVLOG: NWOAS WIDE-DART empty high range (L1Lo=%u L1Hi=%u) -- skipped\n",
+               (UINT32)L1Lo, (UINT32)L1Hi));
+      }
+    }
+#endif // NWOAS_WIDE_DART
+#if NWOAS_DART_STATIC_WINDOW
+    // NWOAS EXP-5 fix: pre-fill the flat L2 with the STATIC full-window map NOW (boot), the same
+    // IOVA[0,4GB) -> backing[0,4GB) map the EBS handler installs at ExitBootServices. Then the
+    // UEFI xHCI read uses a static DART (like the working no-EXP-5 path) and Map() returns the
+    // window IPA directly -- no dynamic per-Map L2 write / TLB churn -> no stale-translation loss.
+    // Only installs when the low DMA window is real (Method A boot: NwoasBacking != 0).
+    if (NwoasBacking != 0) {
+      UINTN Bi  = (UINTN)(APCIE_WIN_IOVA_BASE / DART_PAGE_SIZE);
+      UINTN Cnt = (UINTN)(APCIE_WIN_SIZE / DART_PAGE_SIZE);
+      UINTN k;
+      for (k = 0; k < Cnt; k++) {
+        mApcieL2[Bi + k] = APCIE_L2_PAGE(NwoasBacking + (UINT64)k * DART_PAGE_SIZE);
+      }
+      mApcieStaticWindow = TRUE;
+      DEBUG ((DEBUG_ERROR, "HVLOG: NWOAS DART BOOT static window IOVA 0x%lx..0x%lx -> backing 0x%lx (%u entries)\n",
+              APCIE_WIN_IOVA_BASE, APCIE_WIN_IOVA_BASE + APCIE_WIN_SIZE, NwoasBacking, (UINT32)Cnt));
+    }
+#endif
+    // Flush the CPU's writes (done via the window-IPA alias) out to the backing RAM the DART reads.
+    WriteBackInvalidateDataCacheRange((VOID *)mApcieL1, DART_PAGE_SIZE);
+    WriteBackInvalidateDataCacheRange((VOID *)mApcieL2, APCIE_L2_BYTES);
+
+    l1phys = NWOAS_WIN2BACK((UINT64)(UINTN)mApcieL1);   // TTBR gets the backing PA, not the window IPA
+    DEBUG ((DEBUG_ERROR, "HVLOG: NWOAS DART tables backing=0x%lx L1 ipa=0x%lx->phys=0x%lx L2 ipa=0x%lx->phys=0x%lx\n",
+            NwoasBacking, (UINT64)(UINTN)mApcieL1, l1phys, (UINT64)(UINTN)mApcieL2, NWOAS_WIN2BACK((UINT64)(UINTN)mApcieL2)));
+    #undef NWOAS_WIN2BACK
+  }
+  for (d = 0; d < NUM_APCIE_DARTS; d++) {
+    base = mApcieDartBase[d];
+    for (sid = 0; sid < 16; sid++) {
+      MmioWrite32(base + DART_T8020_TCR_BASE + 4 * sid, 0);
+    }
+    for (sid = 0; sid < 16; sid++) {
+      for (i = 0; i < 4; i++) {
+        MmioWrite32(base + DART_T8020_TTBR_BASE + 16 * sid + 4 * i, 0);
+      }
+    }
+    // <4GB IOVA -> only TTBR[sid][0] is used; point it at the shared L1.
+    for (sid = 0; sid < 16; sid++) {
+      MmioWrite32(base + DART_T8020_TTBR_BASE + 16 * sid,
+                  (UINT32)((l1phys >> DART_TTBR_SHIFT) | DART_T8020_TTBR_VALID));
+    }
+    MmioWrite32(base + DART_T8020_SID_ENABLE, 0xFFFF);
+    for (sid = 0; sid < 16; sid++) {
+      MmioWrite32(base + DART_T8020_TCR_BASE + 4 * sid, DART_T8020_TCR_TRANSLATE_ENABLE);
+    }
+  }
+  ApcieDartFlushAll();
+  mApcieDartReady = TRUE;
+  DEBUG((DEBUG_ERROR, "HVLOG: SetupApcieDarts DONE ready=1 runtime-reserved=1 L1=0x%llx L2=0x%llx\n",
+         l1phys, (UINT64)(UINTN)mApcieL2));
+}
+
+STATIC EFI_STATUS EFIAPI AppleDartIoMmuMapReal(
+    IN EDKII_IOMMU_PROTOCOL *This,
+    IN EDKII_IOMMU_OPERATION Operation,
+    IN VOID *HostAddress,
+    IN OUT UINTN *NumberOfBytes,
+    OUT EFI_PHYSICAL_ADDRESS *DeviceAddress,
+    OUT VOID **Mapping
+    )
+{
+  UINT64 Host, Pa, Off, Iova;
+  UINTN  Size, NumPages, i, BaseIdx;
+  STATIC BOOLEAN sFirstMap = TRUE;
+
+  if (sFirstMap) {
+    sFirstMap = FALSE;
+    DEBUG((DEBUG_ERROR, "HVLOG: DartMap FIRST ready=%d Host=0x%llx bytes=0x%llx op=%d\n",
+           mApcieDartReady, (UINT64)(UINTN)HostAddress, (UINT64)*NumberOfBytes, Operation));
+  }
+
+  if (!mApcieDartReady) {
+    *DeviceAddress = (EFI_PHYSICAL_ADDRESS)(UINTN)HostAddress;
+    *Mapping = NULL;
+    return EFI_SUCCESS;
+  }
+
+  //
+  // NWOAS B-0: on every Map, sample the 3 apcie DART error-status registers. If a prior
+  // transfer's DMA faulted in the DART, ERR is sticky (W1C); we catch + log + clear it here.
+  // This is the decisive eval signal on the USB-bulk-stall frontier: DART ERR set (with an
+  // IOVA in the failing transfer's range) => DMA/DART fault; ERR clear => DART innocent, the
+  // stall is an FL1100/USB bulk-IN data-stage wedge (fix xHCI-side, not the IOMMU).
+  //
+  {
+    UINTN  d;
+    UINT32 Err;
+    for (d = 0; d < NUM_APCIE_DARTS; d++) {
+      Err = MmioRead32(mApcieDartBase[d] + DART_T8020_ERROR);
+      // Only a REAL fault sets the FLAG bit (bit31). The idle status register reads a constant
+      // non-zero value (e.g. 0x0F000400) with FLAG clear — do NOT log that (it would flood the
+      // serial and slow the boot). Log + clear only when FLAG is set.
+      if ((Err & 0x80000000U) != 0) {
+        UINT32 Lo = MmioRead32(mApcieDartBase[d] + DART_T8020_ERROR_ADDR_LO);
+        UINT32 Hi = MmioRead32(mApcieDartBase[d] + DART_T8020_ERROR_ADDR_HI);
+        DEBUG((DEBUG_ERROR, "HVLOG: DART%d ERR=0x%08x IOVA=0x%x%08x\n", (UINT32)d, Err, Hi, Lo));
+        MmioWrite32(mApcieDartBase[d] + DART_T8020_ERROR, Err);
+      }
+    }
+  }
+
+  Host = (UINT64)(UINTN)HostAddress;
+#if NWOAS_DART_BOUNCE_OOW
+  //
+  // NWOAS EXP-5 fix: if the caller's buffer is OUTSIDE the low window (a Reserved/high-RAM address the
+  // FL1100 cannot reach -> HSE), transparently bounce it through a WINDOW buffer that the DART maps to
+  // the backing RAM. CommonBuffers are excluded (they are shared and must already be window-allocated
+  // via AllocateBuffer). The redirect below makes all downstream translate/cache/DeviceAddress logic
+  // operate on the bounce; Unmap copies the bounce back to the caller for device-writes and frees it.
+  //
+  VOID  *NwoasBounce   = NULL;
+  VOID  *NwoasOrigHost = HostAddress;
+  UINTN  NwoasBncPages = 0;
+  {
+    UINT64  HB       = Host & ~(UINT64)DART_PAGE_MASK;
+    BOOLEAN InWin    = (HB >= APCIE_WIN_IOVA_BASE) && (HB < APCIE_WIN_IOVA_BASE + APCIE_WIN_SIZE);
+    BOOLEAN IsCommon = (Operation == EdkiiIoMmuOperationBusMasterCommonBuffer ||
+                        Operation == EdkiiIoMmuOperationBusMasterCommonBuffer64);
+    if (mApcieDartReady && (mApcieBackingPa != 0) && !InWin && !IsCommon) {
+      UINT64 Boff = Host - HB;
+      NwoasBncPages = (UINTN)((Boff + (UINT64)*NumberOfBytes + DART_PAGE_MASK) / DART_PAGE_SIZE);
+      NwoasBounce   = AllocateAlignedPages (NwoasBncPages, DART_PAGE_SIZE);
+      if (NwoasBounce != NULL) {
+        UINT64 BB = (UINT64)(UINTN)NwoasBounce;
+        if (BB < APCIE_WIN_IOVA_BASE || BB >= APCIE_WIN_IOVA_BASE + APCIE_WIN_SIZE) {
+          FreeAlignedPages (NwoasBounce, NwoasBncPages);   // bounce itself not in window -> useless
+          NwoasBounce = NULL;
+          DEBUG ((DEBUG_ERROR, "HVLOG: NWOAS BOUNCE alloc out-of-window 0x%lx -- skip\n", BB));
+        } else {
+          VOID *Bh = (VOID *)((UINT8 *)NwoasBounce + Boff);
+          // Mirror the caller's current bytes into the bounce for BOTH directions: device-reads need
+          // the payload; device-writes need it too so a short/partial device write leaves the un-written
+          // tail equal to the caller's original (Unmap copies the whole bounce back) -- otherwise the
+          // tail would be garbage and corrupt e.g. FS-metadata reads into small stack buffers.
+          CopyMem (Bh, NwoasOrigHost, *NumberOfBytes);
+          HostAddress = Bh;                 // redirect translate/cache/DeviceAddr to the DART-reachable bounce
+          Host        = (UINT64)(UINTN)Bh;
+        }
+      }
+    }
+  }
+#endif
+#if NWOAS_DART_WINDOW_AWARE
+  //
+  // NWOAS EXP-5 §4.3 (REQUIRED prerequisite for Method A): when this Map's host buffer falls in the
+  // low DMA window, translate to the real backing PA (== hv map_hw alias == the EBS static window)
+  // instead of identity. Under Method A the window is the ONLY Conventional pool, so UEFI-boot DMA
+  // buffers (e.g. XhciDxe reading boot.wim) allocate INSIDE the window; without this the DART would
+  // map a raw sub-4GB void IPA and the device would DMA into nothing -> BAR abort / corruption.
+  // mApcieBackingPa is DXE-init-computed from boot_args, the same value the EBS static window uses,
+  // so boot-time (per-Map) and Windows-time (static) translations resolve to the same physical RAM.
+  //
+  {
+    UINT64 HostBase = Host & ~(UINT64)DART_PAGE_MASK;
+    if ((HostBase >= APCIE_WIN_IOVA_BASE) &&
+        (HostBase <  APCIE_WIN_IOVA_BASE + APCIE_WIN_SIZE)) {
+      Pa = mApcieBackingPa + (HostBase - APCIE_WIN_IOVA_BASE);   // window IPA -> real backing PA
+    } else {
+      Pa = HostBase;                                             // high RAM: identity (unchanged)
+      NwoasDumpMemMapOnce(HostBase);   // NWOAS diag: what IS this out-of-window buffer? (HSE root)
+      {
+        // NWOAS diag: dump the out-of-window (HSE-triggering) buffer's first 32 bytes + size + op ONCE,
+        // to identify what it is (USB descriptor / xHCI context / disk data) and hence who allocates it.
+        STATIC BOOLEAN NwoasOowLogged = FALSE;
+        if (!NwoasOowLogged) {
+          CONST UINT64 *W = (CONST UINT64 *)(UINTN)(Host & ~7ULL);
+          NwoasOowLogged = TRUE;
+          DEBUG ((DEBUG_ERROR, "HVLOG: NWOAS OOW host=0x%lx bytes=0x%lx op=%u w0=0x%lx w1=0x%lx w2=0x%lx w3=0x%lx\n",
+                  (UINT64)Host, (UINT64)*NumberOfBytes, (UINT32)Operation, W[0], W[1], W[2], W[3]));
+        }
+      }
+    }
+    Off = Host - HostBase;
+  }
+#else
+  // NWOAS EXP-5 5c-pre: window-aware translation OFF (identity Map), to isolate Method-A boot-ability.
+  Pa   = Host & ~(UINT64)DART_PAGE_MASK;
+  Off  = Host - Pa;
+#endif
+  Size = *NumberOfBytes + (UINTN)Off;
+  NumPages = (Size + DART_PAGE_MASK) / DART_PAGE_SIZE;
+
+#if NWOAS_DART_STATIC_WINDOW
+  if (mApcieStaticWindow &&
+      ((Host & ~(UINT64)DART_PAGE_MASK) >= APCIE_WIN_IOVA_BASE) &&
