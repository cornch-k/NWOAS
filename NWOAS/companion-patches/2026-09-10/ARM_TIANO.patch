diff --git a/ArmPkg/Drivers/CpuDxe/AArch64/Mmu.c b/ArmPkg/Drivers/CpuDxe/AArch64/Mmu.c
index 62fa685957..87ae128018 100644
--- a/ArmPkg/Drivers/CpuDxe/AArch64/Mmu.c
+++ b/ArmPkg/Drivers/CpuDxe/AArch64/Mmu.c
@@ -57,6 +57,10 @@ PageAttributeToGcdAttribute (
     case TT_ATTR_INDX_DEVICE_MEMORY:
       GcdAttributes = EFI_MEMORY_UC;
       break;
+    // NWOAS: Device-nGnRE (Apple PCIe MMIO, MAIR index 4) reports as UC to the GCD
+    case TT_ATTR_INDX_DEVICE_MEMORY_NGNRE:
+      GcdAttributes = EFI_MEMORY_UC;
+      break;
     case TT_ATTR_INDX_MEMORY_NON_CACHEABLE:
       GcdAttributes = EFI_MEMORY_WC;
       break;
diff --git a/ArmPkg/Library/ArmMmuLib/AArch64/ArmMmuLibCore.c b/ArmPkg/Library/ArmMmuLib/AArch64/ArmMmuLibCore.c
index 65804deb66..cc9fa46e5a 100644
